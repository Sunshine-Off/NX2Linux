+@nvn('nvnDeviceGetTexelFetchHandle')
+def _(n, r): ret(r, r[1] & M32)
+@nvn('nvnDeviceSetWindowOriginMode')
+def _(n, r): n.get(r[0])['origin'] = r[1] & M32
