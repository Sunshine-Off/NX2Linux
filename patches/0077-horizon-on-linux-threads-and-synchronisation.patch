+for _name, _key in (('Target', 'target'), ('Width', 'width'), ('Height', 'height'), ('Depth', 'depth'), ('Levels', 'levels'), ('Format', 'format'), ('Samples', 'samples'), ('Flags', 'flags'), ('Stride', 'stride'), ('MemoryPool', 'pool'), ('MemoryOffset', 'off')):
