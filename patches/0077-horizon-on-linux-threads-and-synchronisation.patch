+        out = []
+        def waiter():
+            hz.local.thread = hh.KThread(hz, 0, 0, 0, 44, 0); out.append(self.call(hz, 0x1c, self.MUTEX, self.KEY, self.WAITER, (1 << 64) - 1)[0])
