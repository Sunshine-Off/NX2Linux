+# ---- descriptor pools ----
+@nvn('nvnTexturePoolInitialize')
+def _(n, r): n.o[r[0]] = Obj(kind='texpool', pool=r[1], off=r[2], count=r[3] & M32, tex={}); ret(r, 1)
