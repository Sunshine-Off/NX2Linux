+# ---- textures ----
+def desc_of(b): return nvn_layout.Desc(**{k: b.get(k, getattr(nvn_layout.Desc, k)) for k in ('target', 'width', 'height', 'depth', 'levels', 'samples', 'format', 'flags', 'stride', 'pkg_block_h')})
