+                        f'{dyn}/build/externals/zydis/libZydis.a', f'{dyn}/build/externals/zydis/zycore/libZycore.a']
+                cmd = ['clang++', '-shared', *objs, table_obj(table, base, d, n), table_obj(stubs, base, d, f'{n}s'), *lls.values(), '-o', so, '-Wl,--start-group', *libs, '-Wl,--end-group', '-lpthread', '-Wl,--no-undefined']
+            else:
+                cmd = ['clang++', '-shared', '-std=c++17', *base, str(HERE / 'aot_runtime.cpp'), table, stubs, *lls.values(), '-o', so, '-Wl,--no-undefined']
+            r = subprocess.run(cmd, capture_output=True, text=True)
+            if not r.returncode: break
             missing = missing_symbols(r.stderr)
+            if stub_unliftable:
+                lacking = [m for m in missing if not m.startswith('sub_')]   # a sub_ symbol is a function nobody gave: that stays an error
+                bad = {a: ll for a, ll in lls.items() if any(re.search(rf'@{re.escape(m)}\b', Path(ll).read_text()) for m in lacking)}
+                for a, ll in bad.items():
+                    text = Path(ll).read_text()
+                    self.unlifted[a] = f'function {a:#x}: its code needs ' + ', '.join(m for m in lacking if re.search(rf'@{re.escape(m)}\b', text)) + ', which the runtime does not define'
+                    del lls[a]
+                if bad: continue
             if missing: raise LinkError('the runtime does not define: ' + ', '.join(missing) + ' (an instruction class not translated yet)')
             raise LinkError('build failed:\n' + r.stderr[-2000:])
+        else:
+            raise LinkError('build failed: functions kept failing to link')
         self.lib = ctypes.CDLL(so)
         L = self.lib
