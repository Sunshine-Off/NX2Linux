+// The stub of a function the translator could not lift (generated by aot_lift.py): a direct `bl` to it still links, and runs the function through the JIT, or stops with the reason
+Memory *aot_unlifted(State *st, uint64_t pc, Memory *m, const char *why) {
+    count(AOT_S_UNLIFTED); count(S_FALLBACK);
+    if (aot_fallback) return aot_fallback(st, pc, m, 0);
+    fail("call to %#llx, a function that was not translated (%s), and no JIT fallback", (unsigned long long)pc, why);
+}
