index 0000000..02e4fb1
--- /dev/null
+++ b/dm/tools/movie_codec.py
@@ -0,0 +1,74 @@
+"""The decoders of libnx2linux_movie.so (linux/host/movie.c): VP8 / VP9 to NV12 and Vorbis to PCM 16-bit, for horizon_movie.py. NX2LINUX_MOVIE_LIB names the library
+(default ~/.cache/nx2linux/build-host/libnx2linux_movie.so)."""
+import ctypes as C, os
+from pathlib import Path
+
+
+def library_path():
+    p = os.environ.get('NX2LINUX_MOVIE_LIB') or str(Path.home() / '.cache/nx2linux/build-host/libnx2linux_movie.so')
+    return p if os.path.exists(p) else None
+
+
+class CodecError(Exception):
+    pass
+
+
+_lib = None
+
+
+def lib():
+    global _lib
+    if _lib is None:
+        path = library_path()
+        if not path: raise CodecError('libnx2linux_movie.so is not built (cmake --build ~/.cache/nx2linux/build-host)')
+        L = _lib = C.CDLL(path)
+        L.nx2mv_error.restype = C.c_char_p; L.nx2mv_vpx_version.restype = C.c_char_p
+        L.nx2mv_vpx_open.argtypes = [C.c_int, C.c_int, C.c_int, C.c_int]; L.nx2mv_vpx_open.restype = C.c_void_p
+        L.nx2mv_vpx_close.argtypes = [C.c_void_p]
+        L.nx2mv_vpx_decode.argtypes = [C.c_void_p, C.c_char_p, C.c_int, C.c_void_p, C.c_int, C.c_int, C.POINTER(C.c_int), C.POINTER(C.c_int)]; L.nx2mv_vpx_decode.restype = C.c_int
+        L.nx2mv_vorbis_open.argtypes = [C.c_char_p, C.c_int, C.c_char_p, C.c_int, C.POINTER(C.c_int), C.POINTER(C.c_int)]; L.nx2mv_vorbis_open.restype = C.c_void_p
+        L.nx2mv_vorbis_packet.argtypes = [C.c_void_p, C.c_char_p, C.c_int, C.c_void_p, C.c_int]; L.nx2mv_vorbis_packet.restype = C.c_int
+        L.nx2mv_vorbis_close.argtypes = [C.c_void_p]
+    return _lib
+
+
+def error(): return lib().nx2mv_error().decode()
+
+
+class Video:
+    """A VP8 or VP9 decoder; frames come out as NV12 of the size given (stride = width), padded with black or cropped when the stream's size differs"""
+    def __init__(self, vp9, width, height, threads=2):
+        self.w, self.h = width, height
+        self.handle = lib().nx2mv_vpx_open(int(bool(vp9)), threads, width, height)
+        if not self.handle: raise CodecError(error())
+        self.version = lib().nx2mv_vpx_version().decode()
+
+    def decode(self, packet):
+        """(NV12 bytes or None when the packet makes no picture, the picture's own size); CodecError on a decode error"""
+        out = C.create_string_buffer(self.w * self.h * 3 // 2); dw, dh = C.c_int(), C.c_int()
+        r = lib().nx2mv_vpx_decode(self.handle, packet, len(packet), out, self.w, self.h, C.byref(dw), C.byref(dh))
+        if r < 0: raise CodecError(error())
+        return (out.raw if r == 1 else None), (dw.value, dh.value)
+
+    def close(self):
+        if self.handle: lib().nx2mv_vpx_close(self.handle); self.handle = None
+
+
+class Vorbis:
+    """A Vorbis decoder from the identification and setup headers (the codec-specific data of a WebM track)"""
+    def __init__(self, ident, setup):
+        ch, rate = C.c_int(), C.c_int()
+        self.handle = lib().nx2mv_vorbis_open(ident, len(ident), setup, len(setup), C.byref(ch), C.byref(rate))
+        if not self.handle: raise CodecError(error())
+        self.channels, self.rate = ch.value, rate.value
+
+    def decode(self, packet, cap=8192 * 8 * 2):
+        """The PCM 16-bit interleaved samples of a packet (empty for the first one, which only primes the overlap)"""
+        out = C.create_string_buffer(cap)
+        r = lib().nx2mv_vorbis_packet(self.handle, packet, len(packet), out, cap)
+        if r == -2: raise CodecError(f'a Vorbis packet gives more than {cap} bytes')
+        if r < 0: raise CodecError(error())
+        return out.raw[:r]
+
+    def close(self):
+        if self.handle: lib().nx2mv_vorbis_close(self.handle); self.handle = None
