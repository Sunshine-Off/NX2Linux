+++ b/dm/tools/movie_probe.py
@@ -0,0 +1,141 @@
+"""Plays a movie of the game's RomFS through the SDK's own movie player pieces, inside the running process, and checks what comes out (NX2Linux S7bis, milestone E). The game's movie::Extractor (lifted SDK code) demuxes a WebM file
+on the RomFS, and the Decoder of horizon_movie.py decodes its packets; the pictures and the samples are compared with ffmpeg's decoding of the same file (extracted from the RomFS image into a temporary folder, never kept).
+This is how a decoder is verified without playing the game up to a movie: NX2LINUX_MOVIE_PROBE=<path in the RomFS>[:packets] runs it once, 20 seconds in, on a guest thread of the game (where the SDK may be called).
+The probe prints addresses, counts and checksums only."""
+import hashlib, shutil, struct, subprocess, tempfile, time
+from pathlib import Path
+
+import horizon_movie as hm
+import horizon_overrides as ho
+
+M32, M64 = 0xFFFFFFFF, 0xFFFFFFFFFFFFFFFF
+D = '_ZN5movie7Decoder'
+E = '_ZN5movie9Extractor'
+
+
+def rom_file(hz, path):
+    rom = next((m for m in hz.fs.mounts.values() if hasattr(m, 'index')), None)
+    if rom is None: raise RuntimeError('the RomFS is not mounted')
+    st = rom.stat(path)
+    if st is None: raise RuntimeError(f'{path} is not in the RomFS')
+    return rom.read(path, 0, st[2])
+
+
+class Probe:
+    def __init__(self, hz, path, packets=120, say=None):
+        self.hz, self.path, self.packets = hz, path, packets
+        self.g = hm.guest_of(hz); self.say = say or (lambda m: hz.log('[probe] ' + m))
+
+    def new(self, size):
+        p = self.g.call('_Znwm', x0=size); self.hz.wr(p, bytes(size)); return p
+
+    def call(self, sym, **regs): return self.g.call(sym, **regs) & M64
+
+    def h(self, suffix, *args):
+        """A method of the host's Decoder, as the game's player would call it"""
+        r = [0] * 39; r[:len(args)] = args
+        ho.TABLE[D + suffix][0](self.hz, r); return r[0] & M32
+
+    def run(self):
+        hz, g, say = self.hz, self.g, self.say
+        data = rom_file(hz, self.path); work = Path(tempfile.mkdtemp(prefix='movie_probe_'))
+        try:
+            (work / 'm.webm').write_bytes(data); say(f'{self.path}: {len(data)} bytes')
+            ex, container, tracks = 0, None, 0
+            word = self.new(64)
+            for c in range(0, 9):
+                ex = self.new(0x2000); self.call(E + 'C1ENS_13ContainerTypeE', x0=ex, x1=c)
+                ret = self.call(E + '13SetDataSourceEPKc', x0=ex, x1=g.key(f'rom:/{self.path}')) & M32
+                tret = self.call(E + '13GetTrackCountEPi', x0=ex, x1=word) & M32; tracks = hz.rd32(word)
+                t0 = time.monotonic()
+                while ret == 0 and tret == 0 and not tracks and time.monotonic() - t0 < 6.0:   # the opening goes on in the extractor's own thread
+                    time.sleep(0.05); tret = self.call(E + '13GetTrackCountEPi', x0=ex, x1=word) & M32; tracks = hz.rd32(word)
+                say(f'container type {c}: SetDataSource -> {ret:#x}, GetTrackCount -> {tret:#x} ({tracks} tracks after {time.monotonic() - t0:.2f} s)')
+                if ret == 0 and tret == 0 and tracks: container = c; break
+            if container is None: return {'ok': False, 'why': 'no container type opened the file'}
+            kinds = {}
+            for t in range(tracks):
+                md = self.new(0x400); self.call('_ZN5movie9MediaDataC1Ev', x0=md)
+                ret = self.call(E + '21GetTrackConfigurationEiPNS_9MediaDataE', x0=ex, x1=t, x2=md) & M32
+                w, hh, ch, rate = g.find_i32(md, 'width'), g.find_i32(md, 'height'), g.find_i32(md, 'channel-count'), g.find_i32(md, 'sample-rate')
+                kinds[t] = dict(kind='video' if w else 'audio', md=md, w=w, h=hh, ch=ch, rate=rate)
+                say(f'track {t}: GetTrackConfiguration -> {ret:#x}: ' + (f'video {w}x{hh}' if w else f'audio {ch} channels {rate} Hz'))
+                say(f'  SelectTrack -> {self.call(E + "11SelectTrackEi", x0=ex, x1=t) & M32:#x}')
+            decs = {}
+            for t, k in kinds.items():
+                obj = self.new(0x200); evs = self.new(0x40); signalled = []
+                for i in range(4):
+                    e = self.new(0x100); self.call('_ZN2nn2os15InitializeEventEPNS0_9EventTypeEbNS0_14EventClearModeE', x0=e, x1=0, x2=0); hz.wr64(evs + 8 * i, e)
+                self.h('C1ENS_11DecoderTypeENS_19DecoderOutputFormatE', obj, 3 if k['kind'] == 'video' else 5, 3 if k['kind'] == 'video' else 1)
+                say(f'track {t}: Configure -> {self.h("9ConfigureEPNS_9MediaDataE", obj, k["md"]):#x}, RegisterClientEvents -> {self.h("20RegisterClientEventsEPNS_13DecoderEventsE", obj, evs):#x}, Start -> {self.h("5StartEv", obj):#x}')
+                decs[t] = dict(obj=obj, ibuf=self.new(0x100), obuf=self.new(0x100), frames=[], pcm=bytearray())
+                for b in (decs[t]['ibuf'], decs[t]['obuf']): self.call('_ZN5movie6BufferC1Ev', x0=b)
+            # an output buffer of the player's own, as big as the decoder says
+            for t, dd in decs.items():
+                self.h('19GetOutputBufferSizeEPiS1_', dd['obj'], word, word + 4); cap = hz.rd32(word); dd['mem'] = self.call('_Znwm', x0=cap)
+                self.call('_ZN5movie6Buffer18SetDataAndCapacityEPvm', x0=dd['obuf'], x1=dd['mem'], x2=cap); say(f'track {t}: an output buffer of {cap} bytes')
+            rbuf = self.new(0x100); self.call('_ZN5movie6BufferC1Em', x0=rbuf, x1=2 << 20)
+            counts = {t: 0 for t in kinds}
+            for n in range(self.packets):
+                ret = self.call(E + '29GetTrackIndexForAvailableDataEPm', x0=ex, x1=word) & M32
+                if ret: say(f'GetTrackIndexForAvailableData -> {ret:#x} after {n} packets'); break
+                t = hz.rd64(word) & M32
+                ret = self.call(E + '4ReadEPNS_6BufferE', x0=ex, x1=rbuf) & M32
+                size = g.size(rbuf); pk = hz.rd(g.data(rbuf), size) if size else b''
+                tret = self.call(E + '13GetSampleTimeEPl', x0=ex, x1=word); pts = struct.unpack('<q', hz.rd(word, 8))[0]
+                if n < 3: say(f'packet {n}: track {t}, Read -> {ret:#x}, {size} bytes, time {pts}')
+                self.call(E + '7AdvanceEv', x0=ex)
+                dd = decs.get(t)
+                if dd is None or not pk: continue
+                if self.h('23AcquireInputBufferIndexEPiS1_', dd['obj'], word, word + 4): say(f'track {t}: no input free at packet {n}'); break
+                i = hz.rd32(word); self.h('14GetInputBufferEiPNS_6BufferE', dd['obj'], i, dd['ibuf']); hz.wr(g.data(dd['ibuf']), pk)
+                self.h('24SendInputBufferForDecodeEiiilj', dd['obj'], i, 0, len(pk), pts, 0)
+                counts[t] += 1
+                while not self.h('24AcquireOutputBufferIndexEPiPlPjS1_', dd['obj'], word, word + 8, word + 16, word + 24):
+                    oi = hz.rd32(word); self.h('15GetOutputBufferEiPNS_6BufferE', dd['obj'], oi, dd['obuf']); b = g.size(dd['obuf'])
+                    out = hz.rd(g.data(dd['obuf']), b)
+                    (dd['frames'].append(out) if kinds[t]['kind'] == 'video' else dd['pcm'].extend(out)); self.h('24ReleaseOutputBufferIndexEi', dd['obj'], oi)
+            return dict(ok=True, container=container, kinds=kinds, decs=decs, counts=counts, work=work, data=data)
+        except Exception:
+            shutil.rmtree(work, ignore_errors=True); raise
+
+
+def check(res, say):
+    """The pictures and the samples against ffmpeg's decoding of the same file"""
+    work, ok = res['work'], bool(res['decs'])
+    try:
+        for t, dd in res['decs'].items():
+            k = res['kinds'][t]
+            if k['kind'] == 'video':
+                n = len(dd['frames']); w, h = k['w'], k['h']
+                subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(work / 'm.webm'), '-map', '0:v:0', '-frames:v', str(n), '-f', 'rawvideo', '-pix_fmt', 'nv12', str(work / 'v.yuv')], check=True, capture_output=True)
+                want = (work / 'v.yuv').read_bytes(); size = w * h * 3 // 2
+                equal = sum(1 for i, f in enumerate(dd['frames']) if want[i * size:(i + 1) * size] == f)
+                say(f'track {t}: {n} pictures {w}x{h} decoded, {equal} identical to ffmpeg\'s; first picture sha {hashlib.sha256(dd["frames"][0]).hexdigest()[:12] if n else "-"}'); ok = ok and n > 0 and equal == n
+            else:
+                subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(work / 'm.webm'), '-map', '0:a:0', '-f', 's16le', '-ac', str(k['ch']), '-ar', str(k['rate']), str(work / 'a.raw')], check=True, capture_output=True)
+                want = (work / 'a.raw').read_bytes(); got = bytes(dd['pcm']); m = min(len(got), len(want)) // 2
+                if m > 100000:
+                    a, b = struct.unpack(f'<{m}h', got[:2 * m]), struct.unpack(f'<{m}h', want[:2 * m])
+                    starts = range(8192, m - 40000 - 8192, 40000)   # the louder windows of the reference: a silent start compares nothing
+                    at = max(starts, key=lambda o: sum(abs(x) for x in b[o:o + 40000:16]))
+                    err = min(sum(abs(x - y) for x, y in zip(a[at + s:at + s + 40000], b[at:at + 40000])) / 40000 for s in range(-4096, 4097, 2)); rms = (sum(x * x for x in b[at:at + 40000]) / 40000) ** 0.5
+                    say(f'track {t}: {len(got) // (2 * k["ch"])} samples decoded ({len(got) / (2 * k["ch"] * k["rate"]):.1f} s), mean error against ffmpeg {err:.1f} in the loudest window (rms of the signal {rms:.0f}{", a silent track" if rms < 1 else ""}; our own peak {max(map(abs, a))})'); ok = ok and err < max(250, rms * 0.05) and (rms > 100 or max(map(abs, a)) <= 2)   # a silent reference (XC2's movie tracks are: -91 dB in ffmpeg too) must come out silent
+                else: say(f'track {t}: {len(got)} bytes of PCM decoded: too few to compare'); ok = False
+    finally: shutil.rmtree(work, ignore_errors=True)
+    return ok
+
+
+def probe_once(hz):
+    """Called on a guest thread of the game: runs the probe named by NX2LINUX_MOVIE_PROBE once, 20 s after the start"""
+    import os, time
+    spec = os.environ.get('NX2LINUX_MOVIE_PROBE')
+    if not spec or getattr(hz, 'movie_probed', False) or time.monotonic() - hz.start < 20: return
+    hz.movie_probed = True
+    path, _, n = spec.partition(':')
+    try:
+        res = Probe(hz, path, int(n or 120)).run()
+        if res.get('ok'): hz.log(f'[probe] {"PASSED" if check(res, lambda m: hz.log("[probe] " + m)) else "FAILED"}: packets per track {res["counts"]}')
+        else: hz.log(f'[probe] FAILED: {res["why"]}')
+    except Exception as e:
+        import traceback; hz.log('[probe] FAILED: ' + traceback.format_exc().replace('\n', ' | '))
