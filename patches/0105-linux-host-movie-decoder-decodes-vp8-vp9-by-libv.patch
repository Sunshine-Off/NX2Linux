@@ -1,7 +1,12 @@
-"""The SDK's movie library on the Linux host (NX2Linux S7bis, milestone E). A game plays a movie by opening it with a movie::Extractor (SetDataSource: the SDK's own demuxer), then feeding the packets to a movie::Decoder, which on the
-Switch is NVIDIA's hardware decoder. The host has no decoder behind that interface yet (the Mach host's hle_movie.c decodes VP8 / VP9 with libvpx and Vorbis with stb_vorbis; it has not been ported), and a Decoder that answers 0
-to everything would let the player wait for pictures that never come. So the opening of a movie fails here, explicitly and with the code the SDK itself returns when it has no implementation object (0x1000): the game's own
-player reports that it could not open the movie, and goes on without it. Every refusal is counted and named, and the end of the run says how many movies the game asked for."""
+"""The SDK's movie library on the Linux host (NX2Linux S7bis, milestone E). A game plays a movie by opening it with a movie::Extractor (the SDK's own demuxer, which runs as lifted code on the RomFS), then feeding the packets to a
+movie::Decoder, which on the Switch is NVIDIA's hardware decoder. Here the Decoder is replaced (the protocol of the Mach host's hle_movie.c): VP8 / VP9 pictures are decoded by libvpx into NV12 and Vorbis packets by stb_vorbis into
+PCM 16-bit (linux/host/movie.c, loaded by movie_codec.py); the inputs, the output slots and the four events (input available, output ready, format changed, error) follow MediaCodec's behaviour, which movie::Decoder wraps.
+What is not decoded here (H.264, AAC, the native-texture output mode) leaves the decoder without an implementation: every method returns the SDK's failure code and the log says which decoder was asked for. When the
+decoders themselves are missing (libnx2linux_movie.so not built, no libvpx), the opening of a movie is refused with the SDK's own "no implementation" code (0x1000) instead, named and counted, so the game's player gives up on
+the movie and goes on. Decoding is synchronous on the calling guest thread; events are signalled by the SDK's own nn::os::SignalEvent, called on that thread."""
+import os, struct, threading, time
+
+import movie_codec
 from horizon_overrides import hle
 
 NO_IMPLEMENTATION = 0x1000   # what the SDK returns for a data source it has no implementation object for (engine/dm/host/hle_movie.c)
@@ -17,8 +22,18 @@ def refuse(hz, what):
     return NO_IMPLEMENTATION
 
 
+def sdk_owns(symbol):
+    """True for what the SDK's own code does when the decoders are there: the extractor (the demuxer) runs as lifted code on the RomFS, so the not-ported stubs of the Mach host's list leave it alone"""
+    return bool(movie_codec.library_path()) and symbol.startswith(('_ZN5movie9Extractor', '_ZN5movie11NnExtractor'))
+
+
 def report(hz):
     n = refused(hz)
+    if movie_codec.library_path():
+        decs, bad = getattr(hz, 'movie_decs', {}), getattr(hz, 'movie_unsupported', [])
+        made = getattr(hz, 'movie_ndec', 0)
+        if not made and not bad: return 'movie: the game opened no movie decoder'
+        return f'movie: {made} decoders made, {len(decs)} still open, {len(bad)} asked for a type that is not decoded here {bad[:3] or ""}'
     if not n: return 'movie: the game opened no movie'
     return f'movie: {len(n)} openings refused, no decoder on the Linux host (first: {n[0]})'
 
@@ -35,4 +50,429 @@ def _install():
         hle(sym, 'the host has no movie decoder: opening fails with the SDK\'s own "no implementation" code')(lambda hz, r, who=who: r.__setitem__(0, refuse(hz, f'{who} {hz.cstring(r[2], 0x200)!r}' if r[2] else who)))
 
 
-_install()
+# ======================================================================== the decoder ========================================================================
+M32, M64 = 0xFFFFFFFF, 0xFFFFFFFFFFFFFFFF
+MD_NIN, MD_INCAP = 4, 4 << 20          # input buffers, and the bytes of each (a 1080p VP9 packet is far smaller)
+MD_NO_INPUT, MD_NO_OUTPUT, MD_FAIL, MD_BAD_ARG = 0x1011, 0x100E, 0x1000, 0x100B   # the SDK's codes: no free input, no output ready, no implementation, a bad argument
+T_AVC, T_VP8, T_VP9, T_AAC, T_VORBIS = 1, 2, 3, 4, 5
+F_PCM16, F_ABGR, F_NV12 = 1, 3, 4      # the output formats as later SDKs number them (SDK 3 numbers ARGB 2 and NV12 3: its constructor converts)
+MODE_CPU, MODE_TEXTURE = 1, 2
+PCM_CAP = 8192 * 8 * 2                 # the bytes of one audio output: a Vorbis packet gives at most 4096 samples a channel, 8 channels
+SLOTS_VIDEO, SLOTS_AUDIO = 16, 64      # output slots (what the Mach host settled on for the players of many games)
+MOVIE_BASE = 0xA_0000_0000             # guest memory the host gives the movie library: key strings and scratch words, then the input buffers of each decoder
+KEYS_SIZE = 0x10000
+IN_BASE = MOVIE_BASE + KEYS_SIZE
+MAX_DECODERS = 16
+
+
+class Guest:
+    """The SDK's own movie::Buffer, movie::MediaData and nn::os functions, called on the calling guest thread, so the host needs no knowledge of their layouts"""
+    def __init__(self, hz):
+        self.hz, self.lock, self.keys, self.next_key = hz, threading.Lock(), {}, 0
+        if not hz.aot.try_map(MOVIE_BASE, KEYS_SIZE + MAX_DECODERS * MD_NIN * MD_INCAP): raise RuntimeError('no room for the movie memory')
+
+    def call(self, symbol, **regs): return self.hz.call_guest(symbol, {k: v & M64 for k, v in regs.items()})
+
+    def key(self, text):
+        """The guest address of a NUL-terminated copy of a key string (the SDK's functions take C strings)"""
+        with self.lock:
+            a = self.keys.get(text)
+            if a is None:
+                raw = text.encode() + b'\0'; a = MOVIE_BASE + 0x2000 + self.next_key; self.next_key += (len(raw) + 15) & ~15
+                if self.next_key > 0x8000: raise RuntimeError('too many movie keys')
+                self.hz.wr(a, raw); self.keys[text] = a
+            return a
+
+    def scratch(self):
+        """A word of guest memory of this thread's own (the SDK writes its out parameters there)"""
+        return MOVIE_BASE + 0xA000 + 16 * (threading.get_ident() % 1024)
+
+    def set_data(self, buf, ptr, cap): self.call('_ZN5movie6Buffer18SetDataAndCapacityEPvm', x0=buf, x1=ptr, x2=cap)
+    def set_range(self, buf, off, size): self.call('_ZN5movie6Buffer8SetRangeEii', x0=buf, x1=off, x2=size)
+    def data(self, buf): return self.call('_ZNK5movie6Buffer4DataEv', x0=buf)
+    def cap(self, buf): return self.call('_ZNK5movie6Buffer8CapacityEv', x0=buf)
+    def size(self, buf): return self.call('_ZNK5movie6Buffer4SizeEv', x0=buf)
+    def set_i32(self, md, key, v): self.call('_ZN5movie9MediaData8SetInt32EPKci', x0=md, x1=self.key(key), x2=v & M32)
+    def set_rect(self, md, key, l, t, r, b): self.call('_ZN5movie9MediaData7SetRectEPKciiii', x0=md, x1=self.key(key), x2=l & M32, x3=t & M32, x4=r & M32, x5=b & M32)
+
+    def find_i32(self, md, key):
+        out = self.scratch(); self.hz.wr32(out, 0)
+        ok = self.call('_ZNK5movie9MediaData9FindInt32EPKcPi', x0=md, x1=self.key(key), x2=out) & 1
+        v = self.hz.rd32(out)
+        return (v - (1 << 32) if v & (1 << 31) else v) if ok else None
+
+    def find_buf(self, md, key):
+        out = self.scratch(); self.hz.wr64(out, 0)
+        ok = self.call('_ZNK5movie9MediaData10FindBufferEPKcPPNS_6BufferE', x0=md, x1=self.key(key), x2=out) & 1
+        return self.hz.rd64(out) if ok else 0
+
+    def signal(self, event): self.call('_ZN2nn2os11SignalEventEPNS0_9EventTypeE', x0=event)
+
+
+def guest_of(hz):
+    if not hasattr(hz, 'movie_guest'): hz.movie_guest = Guest(hz)
+    return hz.movie_guest
+
+
+class Slot:
+    def __init__(self): self.used = self.pic = self.cli = False; self.pts = 0; self.flags = 0; self.data = b''
+
+
+class Dec:
+    """One movie::Decoder: its inputs, output slots and events, and the codec behind them"""
+    def __init__(self, hz, kind, fmt, mode, out_align):
+        self.hz, self.kind, self.fmt, self.mode, self.out_align = hz, kind, fmt, mode, out_align
+        self.audio = kind in (T_VORBIS, T_AAC)
+        self.lock, self.dlock = threading.RLock(), threading.RLock()
+        self.evc, self.ev = 0, [None] * 4
+        self.w = self.h = 0; self.fmt_sent = self.started = self.in_eos = False
+        self.infree, self.inown, self.pend = list(range(MD_NIN)), set(), []
+        self.nout = SLOTS_AUDIO if self.audio else SLOTS_VIDEO
+        self.out = [Slot() for _ in range(self.nout)]; self.outq = []
+        self.codec = None; self.vhdr = [b'', b'']; self.ch = self.rate = 0
+        self.slot = None; self.n_in = self.n_out = 0; self.errors = 0
+        self.in_base = IN_BASE + hz.movie_ndec * MD_NIN * MD_INCAP; hz.movie_ndec += 1
+
+    def event(self, i):
+        """The guest address of the client's event i: the entry of its DecoderEvents struct, read when it is signalled (the client may fill the struct after registering it), else the one it held at registration; 0 when none"""
+        p = 0
+        if self.evc:
+            try: p = self.hz.rd64(self.evc + 8 * i)
+            except AssertionError: p = 0
+        if p % 8 or p < 0x1_0000_0000 or not self.hz.aot.lib.aot_hash64(p, 8, 0): p = self.ev[i] or 0
+        return p
+
+    def fire(self, indices):
+        g = guest_of(self.hz)
+        for i in indices:
+            p = self.event(i)
+            if p: g.signal(p)
+            elif self.errors < 8: self.errors += 1; self.hz.log(f'[movie] [RED] decoder event {i} is not an event any more: not delivered')
+
+    def dims(self): return (self.w or 1920, self.h or 1080)
+
+    def close_codec(self):
+        if self.codec: self.codec.close(); self.codec = None
+
+    # ---- decoding one packet into a slot ----
+    def decode(self, packet):
+        """The slot data for a packet: NV12 bytes (video, None for no picture), PCM bytes (audio, b'' for none)"""
+        if self.kind in (T_VP8, T_VP9):
+            if self.codec is None:
+                w, h = self.dims(); self.codec = movie_codec.Video(self.kind == T_VP9, w, h, threads=max(2, (os.cpu_count() or 4) // 4))
+                self.hz.log(f'[movie] libvpx {self.codec.version}: {"VP9" if self.kind == T_VP9 else "VP8"} decoder, {w}x{h}')
+            nv, size = self.codec.decode(packet)
+            if nv is not None and size != self.dims() and not self.errors: self.errors += 1; self.hz.log(f'[movie] [RED] picture {size[0]}x{size[1]} does not match the output {self.dims()[0]}x{self.dims()[1]}: padded with black or cropped')
+            return nv
+        if self.kind == T_VORBIS:
+            if self.codec is None:
+                self.codec = movie_codec.Vorbis(self.vhdr[0], self.vhdr[1]); self.ch, self.rate = self.codec.channels, self.codec.rate
+                self.hz.log(f'[movie] Vorbis: {self.ch} channels {self.rate} Hz')
+            return self.codec.decode(packet, PCM_CAP)
+        raise movie_codec.CodecError('decoder type not decoded here')
+
+    def pump(self):
+        """While packets wait and an output slot is free: decode the head packet, give its input back, announce the output (and the input, unless the stream ended)"""
+        with self.dlock:
+            while True:
+                with self.lock:
+                    free = next((k for k, s in enumerate(self.out) if not s.used), None) if self.pend else None
+                    if free is None: return
+                    pk = self.pend.pop(0); self.out[free].used = True
+                eos = bool(pk['flags'] & 4)
+                data, got = b'', False
+                if pk['size'] > 0 and not (eos and (pk['pts'] < 0 or pk['size'] >= MD_INCAP)):
+                    try:
+                        raw = self.hz.rd(self.in_base + pk['in'] * MD_INCAP + pk['off'], pk['size'])
+                        r = self.decode(raw)
+                        if r: data, got = r, True
+                    except movie_codec.CodecError as e:
+                        if self.errors < 8: self.errors += 1; self.hz.log(f'[movie] [RED] decode error ({pk["size"]} bytes): {e}')
+                with self.lock:
+                    self.infree.append(pk['in'])
+                    ready = got or eos   # an end-of-stream packet without data still yields an output, to carry the flag back
+                    if ready:
+                        s = self.out[free]; s.pic, s.pts, s.flags, s.data = got, pk['pts'], pk['flags'], data; self.outq.append(free)
+                    else: self.out[free].used = False
+                    ineos = self.in_eos
+                self.fire(([] if ineos else [0]) + ([1] if ready else []))
+
+    def reset(self, close):
+        with self.dlock, self.lock:
+            if close: self.close_codec()
+            self.infree, self.inown = list(range(MD_NIN)), set()
+            self.outq, self.pend, self.in_eos = [], [], False
+            for s in self.out:
+                s.used = s.cli = False
+                if close: s.pic = False
+
+
+def dec_of(hz, self_ptr):
+    token = hz.rd64(self_ptr + 8)
+    return hz.__dict__.setdefault('movie_decs', {}).get(token)
+
+
+def vp9_size(p):
+    """(width, height) of a VP9 key frame from its uncompressed header (VP9 spec 6.2), or None"""
+    bit = [0]
+    def rb(k):
+        v = 0
+        for _ in range(k):
+            if bit[0] >> 3 >= len(p): raise IndexError
+            v = v << 1 | (p[bit[0] >> 3] >> (7 - (bit[0] & 7)) & 1); bit[0] += 1
+        return v
+    try:
+        if rb(2) != 2: return None
+        lo, hi = rb(1), rb(1); prof = hi << 1 | lo
+        if prof == 3: rb(1)
+        if rb(1): return None   # show_existing_frame
+        if rb(1) != 0: return None   # not a key frame
+        rb(2)
+        if rb(24) != 0x498342: return None
+        if prof >= 2: rb(1)
+        if rb(3) != 7:
+            rb(1)
+            if prof in (1, 3): rb(3)
+        elif prof in (1, 3): rb(1)
+        return rb(16) + 1, rb(16) + 1
+    except IndexError: return None
+
+
+def vp8_size(p):
+    if len(p) < 10 or p[0] & 1 or bytes(p[3:6]) != b'\x9d\x01\x2a': return None
+    x, y = (p[6] | p[7] << 8) & 0x3FFF, (p[8] | p[9] << 8) & 0x3FFF
+    return (x, y) if x and y else None
+
+
+def make_decoder(hz, self_ptr, kind, fmt, mode, out_align=0):
+    """The constructor: the object gets the Decoder vtable and a token naming the host side; a combination that is not decoded here keeps a null token and every method answers 0x1000"""
+    hz.__dict__.setdefault('movie_decs', {}); hz.__dict__.setdefault('movie_ndec', 0)
+    vt = hz.ms.symbol('_ZTVN5movie7DecoderE') + 0x10
+    hz.wr64(self_ptr, vt); hz.wr64(self_ptr + 8, 0)
+    audio = kind == T_VORBIS and fmt == F_PCM16
+    video = kind in (T_VP8, T_VP9) and fmt == F_NV12 and mode != MODE_TEXTURE
+    if not (audio or video) or hz.movie_ndec >= MAX_DECODERS:
+        hz.log(f'[movie] [RED] decoder type {kind} output {fmt} mode {mode} is not decoded on the Linux host (VP8 / VP9 as NV12 and Vorbis as PCM 16-bit are): every method returns failure')
+        hz.__dict__.setdefault('movie_unsupported', []).append((kind, fmt, mode)); return
+    guest_of(hz)
+    d = Dec(hz, kind, fmt, mode, out_align)
+    token = len(hz.movie_decs) + 1; hz.movie_decs[token] = d; hz.wr64(self_ptr + 8, token)
+    hz.log(f'[movie] decoder {self_ptr:#x}: type {kind} output {fmt} mode {mode}')
+
+
+def free_decoder(hz, self_ptr):
+    token = hz.rd64(self_ptr + 8); d = hz.__dict__.setdefault('movie_decs', {}).pop(token, None)
+    hz.wr64(self_ptr + 8, 0)
+    if d:
+        with d.dlock, d.lock: d.close_codec()
+        hz.log(f'[movie] decoder {self_ptr:#x} destroyed: {d.n_in} packets in, {d.n_out} outputs out')
+
+
+def rv(r, v): r[0] = v & M64
+
+
+def _decoder_handlers():
+    D = '_ZN5movie7Decoder'
+    reason = 'the host decodes (linux/host/movie.c): VP8 / VP9 by libvpx, Vorbis by stb_vorbis'
+    hle(D + 'C1ENS_11DecoderTypeENS_19DecoderOutputFormatENS_11DecoderModeEi', reason)(lambda hz, r: make_decoder(hz, r[0], r[1] & M32, r[2] & M32, r[3] & M32))
+    hle(D + 'C1ENS_11DecoderTypeENS_19DecoderOutputFormatENS_11DecoderModeE', reason)(lambda hz, r: make_decoder(hz, r[0], r[1] & M32, r[2] & M32, r[3] & M32))
+    def ctor3(hz, r):   # SDK 3 (Xenoblade 2): no mode or priority; its formats are numbered one lower (ARGB 2, NV12 3), its decoders are CPU ones, and GetOutputBufferSize puts an alignment (0x20) in its second output
+        fmt = r[2] & M32; make_decoder(hz, r[0], r[1] & M32, F_NV12 if fmt == 3 else F_ABGR if fmt == 2 else fmt, MODE_CPU, 0x20)
+        d = dec_of(hz, r[0])
+        if d: d.out_align = 0x20
+    for suffix in ('C1', 'C2'): hle(D + suffix + 'ENS_11DecoderTypeENS_19DecoderOutputFormatE', reason)(ctor3)
+    hle(D + 'D2Ev', reason)(lambda hz, r: free_decoder(hz, r[0]))
+    hle(D + 'D1Ev', reason)(lambda hz, r: free_decoder(hz, r[0]))
+    def delete_decoder(hz, r): free_decoder(hz, r[0]); guest_of(hz).call('_ZdlPv', x0=r[0])   # the deleting destructor: the object itself goes back through the game's operator delete
+    hle(D + 'D0Ev', reason)(delete_decoder)
+
+    def configure(hz, r):
+        d = dec_of(hz, r[0])
+        if d is None: return rv(r, MD_FAIL)
+        g, md = guest_of(hz), r[1]
+        if d.audio:   # codec-specific data as Android's MediaCodec takes it: Vorbis csd-0 = identification header, csd-1 = setup header
+            for k in range(2):
+                b = g.find_buf(md, f'csd-{k}') if md else 0
+                if b:
+                    n, ptr = g.size(b), g.data(b)
+                    if n and ptr: d.vhdr[k] = hz.rd(ptr, n)
+            ch, rate = (g.find_i32(md, 'channel-count'), g.find_i32(md, 'sample-rate')) if md else (None, None)
+            if ch and ch > 0: d.ch = ch
+            if rate and rate > 0: d.rate = rate
+            return rv(r, 0)
+        w, h = (g.find_i32(md, 'width'), g.find_i32(md, 'height')) if md else (None, None)
+        with d.lock:
+            if w and h and w > 0 and h > 0 and not d.fmt_sent: d.w, d.h = w, h
+        rv(r, 0)
+    hle(D + '9ConfigureEPNS_9MediaDataE', reason)(configure)
+
+    def register_events(hz, r):
+        d = dec_of(hz, r[0])
+        if d is None: return rv(r, MD_FAIL)
+        d.evc = r[1]
+        for i in range(4):
+            try: p = hz.rd64(r[1] + 8 * i) if r[1] else 0
+            except AssertionError: p = 0
+            d.ev[i] = p if p % 8 == 0 and p >= 0x1_0000_0000 else None
+        rv(r, 0)
+    hle(D + '20RegisterClientEventsEPNS_13DecoderEventsE', reason)(register_events)
+
+    def start(hz, r):
+        d = dec_of(hz, r[0])
+        if d is None: return rv(r, 0x2002)
+        with d.lock: d.started = True
+        d.fire([0]); rv(r, 0)   # the inputs are all free: input available
+    hle(D + '5StartEv', reason)(start)
+
+    def stop(hz, r):
+        d = dec_of(hz, r[0])
+        if d is None: return rv(r, 0x2003)
+        with d.lock: d.started = False
+        d.reset(True); rv(r, 0)
+    hle(D + '4StopEv', reason)(stop)
+
+    def reset(hz, r):
+        d = dec_of(hz, r[0])
+        if d is None: return rv(r, MD_FAIL)
+        d.reset(True); d.fmt_sent = False; rv(r, 0)
