+class Refusals(unittest.TestCase):
+    """The library is there but this run looks inside the Python handling of the calls: they stay in Python and the log says which tool asked"""
+    def test_the_svc_profile_the_ring_and_verbose_keep_python(self):
+        for attr, value, name in (('svc_prof', {}, 'NX2LINUX_SVC_PROFILE'), ('ring', [], 'NX2LINUX_SVC_RING'), ('verbose', True, '--verbose')):
+            hz, aot, out = horizon(); setattr(hz, attr, value)
+            self.assertIsNone(hs.install(hz, {'NX2LINUX_SVC_NATIVE': '1', 'NX2LINUX_SYNC_LIB': '/nonexistent'}))
+            self.assertIn(name, out.getvalue()); self.assertEqual(aot.registered, [])
+
+
+# ---- the four calls, on both implementations ----
+import struct, time
+LISTENERS = 0x40000000
+LOCK, UNLOCK, WAIT, SIGNAL = 0x1a, 0x1b, 0x1c, 0x1d
+FOREVER = (1 << 64) - 1
+
+
+class Mem:
+    """Guest memory of 64 words at 0x1000, shared by both implementations. A word that is not there fails like the runtime's peek does (AssertionError) and its compare-exchange answers a value that is not the expected one"""
+    BASE, N = 0x1000, 64
+    def __init__(self): self.words, self.lock = [0] * self.N, threading.Lock()
+    def idx(self, a): return (a - self.BASE) // 4 if a % 4 == 0 and self.BASE <= a < self.BASE + 4 * self.N else None
+    def w(self, i): return self.BASE + 4 * i
+    def peek(self, a, n):
+        i = self.idx(a); assert i is not None and n == 4, f'peek {a:#x}'
+        with self.lock: return struct.pack('<I', self.words[i])
+    def poke(self, a, data, n):
+        i = self.idx(a)
+        if i is None: return 1
+        with self.lock: self.words[i] = struct.unpack('<I', bytes(data[:4]))[0]
+        return 0
+    def cas(self, a, e, d):
+        i = self.idx(a)
+        if i is None: return (e ^ 1) & 0xFFFFFFFF
+        with self.lock:
+            old = self.words[i]
+            if old == e: self.words[i] = d & 0xFFFFFFFF
+            return old
+    def get(self, i):
+        with self.lock: return self.words[i]
+    def set(self, i, v):
+        with self.lock: self.words[i] = v
+
+
+class PyImpl:
+    """The Python path: Horizon.svc"""
+    name = 'python'
+    def __init__(self, mem):
+        self.mem = mem
+        class A(FakeAot):
+            def __init__(a):
+                super().__init__(); a.lib = types.SimpleNamespace(aot_cas32=mem.cas, aot_poke=mem.poke)
+            def peek(a, addr, n): return mem.peek(addr, n)
+        ms = types.SimpleNamespace(aot=A(), modules=[], TLS=0x1000, STOP=0xFFFF0000)
+        self.hz = hh.Horizon(ms, out=io.StringIO()); self.threads = {}
+    def enter(self, ident):
+        t = self.threads.get(ident) or self.threads.setdefault(ident, hh.KThread(self.hz, 0, 0, 0, 44, 0x5000 + 0x200 * ident))
+        self.hz.bind(t)
+    def leave(self): self.hz.bind(None)
+    def call(self, num, x0=0, x1=0, x2=0, x3=0):
+        r = [0] * 31; r[0], r[1], r[2], r[3] = x0, x1, x2, x3
+        self.hz.svc(num, r, 0x4000 + num)
+        return r[0]
+    def waiters(self, on_key, addr): return len((self.hz.key_waiters if on_key else self.hz.mutex_waiters).get(addr, []))
+    def close(self): pass
+
+
+class CImpl:
+    """The C library, with the same memory (through ctypes callbacks, as the runtime's functions are for it)"""
+    name = 'c'
+    def __init__(self, mem):
+        self.mem = mem
+        self.lib = C.CDLL(LIB)
+        self.peek = PEEK(lambda a, d, n: self._peek(a, d, n)); self.cas = CAS(mem.cas)
+        self.lib.nx2sync_init.argtypes = [C.c_void_p, C.c_void_p]
