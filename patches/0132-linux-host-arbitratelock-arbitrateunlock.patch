+        except BaseException as e: errors.append(e)
+    ths = [threading.Thread(target=worker, args=(i,)) for i in range(threads)]
+    for th in ths: th.start()
+    for th in ths: th.join(60)
+    assert not any(th.is_alive() for th in ths), 'the mutex workers did not finish'
+    assert not errors, errors
+    assert shared[0] == threads * rounds, f'{shared[0]} of {threads * rounds}: exclusion failed'
+    assert m.get(20) == 0 and impl.waiters(0, m.w(20)) == 0
