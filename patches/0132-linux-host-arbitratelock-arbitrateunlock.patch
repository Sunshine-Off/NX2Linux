+def contention(impl, threads=4, rounds=300):
+    """A mutex and a condition variable built from the calls, as libnx does: exclusion, and every item produced is consumed exactly once"""
+    m, shared, errors = impl.mem, [0], []
+    def lock(self):
+        while True:
+            cur = m.cas(m.w(20), 0, self)
+            if cur == 0: return
+            if not cur & LISTENERS:
+                if m.cas(m.w(20), cur, cur | LISTENERS) != cur: continue
+            impl.call(LOCK, cur & ~LISTENERS, m.w(20), self)
+            if m.get(20) & ~LISTENERS == self: return
+    def unlock(self):
+        if m.cas(m.w(20), self, 0) != self: impl.call(UNLOCK, m.w(20))
+    def worker(i):
+        impl.enter(100 + i); self = 0xD300 + i
+        try:
+            for r in range(rounds):
