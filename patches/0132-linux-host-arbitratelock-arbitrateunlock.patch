+"""The native synchronisation calls through the real AOT runtime (issue 19): recompiled guest functions that make the svc, the library answering them in C, several host threads. A thread that waits for a key is
+woken by another thread's signal and its mutex word comes back, the Python handler never sees these calls, and a thread that is blocked in C does not stop the others.
+Needs REMILL_BUILD, clang++ and unicorn (like test_aot_svc) and libnx2linux_sync.so (cmake -S linux/host -B ~/.cache/nx2linux/build-host, or NX2LINUX_SYNC_LIB); skipped otherwise."""
+import struct, sys, threading, time, types, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import aot_lift
+import arm64_fixture as fx
+import horizon_sync as hs
+from test_aot_t3 import READY, DATA, STACK, STACK_SIZE
+
+LIB = hs.library_path()
+WAITFN, SIGNALFN, LOCKFN, UNLOCKFN, OTHERFN = 0x100, 0x120, 0x140, 0x160, 0x180
+M = (1 << 64) - 1
+STACKS = [STACK + 0x4000 * i for i in range(1, 5)]
+
+
+def image():
+    img = bytearray(0x1000)
+    def put(at, words): img[at:at + 4 * len(words)] = struct.pack('<%dI' % len(words), *words)
+    put(WAITFN, [fx.SVC(0x1c), fx.RET])
+    put(SIGNALFN, [fx.SVC(0x1d), fx.RET])
+    put(LOCKFN, [fx.SVC(0x1a), fx.RET])
+    put(UNLOCKFN, [fx.SVC(0x1b), fx.RET])
+    put(OTHERFN, [fx.SVC(0x2A), fx.RET])
+    return bytes(img)
+
+
+@unittest.skipUnless(READY and LIB, 'needs REMILL_BUILD, clang++, unicorn and libnx2linux_sync.so')
+class NativeThroughTheRuntime(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        img = image()
+        cls.a = aot_lift.Aot([(f, img[f:f + 8]) for f in (WAITFN, SIGNALFN, LOCKFN, UNLOCKFN, OTHERFN)])
+        cls.a.map(0, len(img), img); cls.a.map(DATA, 0x2000, bytes(0x2000)); cls.a.map(STACK, STACK_SIZE, bytes(STACK_SIZE))
+        cls.python_calls = []
+        def python_handler(num, r, orig):
+            cls.python_calls.append(num)
+            if num == 0x2A: r[0] = 0x2A2A
+            else: r[0] = 0xF001
+        cls.a.set_svc_handler(python_handler)
+        cls.log = []
+        hz = types.SimpleNamespace(aot=cls.a, log=cls.log.append, svc_prof=None, ring=None, verbose=False, main_thread_obj=types.SimpleNamespace(tid=1, handle=0))
+        cls.native = hs.install(hz, {'NX2LINUX_SVC_NATIVE': '1', 'NX2LINUX_SYNC_LIB': LIB})
+
+    @classmethod
+    def tearDownClass(cls): cls.a.close()
+
+    def setUp(self): self.python_calls.clear()
+
+    def word(self, i): return struct.unpack('<I', self.a.peek(DATA + 4 * i, 4))[0]
+    def setword(self, i, v): self.assertEqual(self.a.lib.aot_poke(DATA + 4 * i, struct.pack('<I', v), 4), 0)
+    def addr(self, i): return DATA + 4 * i
+
+    def run_guest(self, fn, regs, stack, tid=None):
+        if tid is not None: self.native.lib.nx2sync_bind(tid, 0)
+        return self.a.run(fn, dict(regs, x30=0xFFFF0000), 0, stack)
+
+    def test_it_is_installed(self):
+        self.assertIsNotNone(self.native, self.log); self.assertEqual(self.native.calls, [0x1a, 0x1b, 0x1c, 0x1d])
+
+    def test_unlock_in_c_clears_the_word_and_python_never_sees_it(self):
+        self.setword(0, 0xD001)
+        r = self.run_guest(UNLOCKFN, {'x0': self.addr(0)}, STACKS[0])
+        self.assertEqual((r['x0'], self.word(0)), (0, 0)); self.assertEqual(self.python_calls, [])
+
+    def test_a_call_that_is_not_one_of_the_four_still_goes_to_python(self):
+        r = self.run_guest(OTHERFN, {'x0': 1}, STACKS[0])
+        self.assertEqual(r['x0'], 0x2A2A); self.assertEqual(self.python_calls, [0x2A])
+
+    def test_wait_times_out_with_the_mutex_taken_again(self):
+        self.setword(1, 0xD001)
+        r = self.run_guest(WAITFN, {'x0': self.addr(1), 'x1': self.addr(5), 'x2': 0xD001, 'x3': 10_000_000}, STACKS[0])
+        self.assertEqual((r['x0'], self.word(1)), (0xEA01, 0xD001)); self.assertEqual(self.python_calls, [])
+
+    def test_a_thread_blocked_in_c_is_woken_by_a_signal_from_another_thread(self):
+        self.setword(2, 0xD002)
+        res = {}
+        def waiter():
+            res['r'] = self.run_guest(WAITFN, {'x0': self.addr(2), 'x1': self.addr(6), 'x2': 0xD002, 'x3': 30_000_000_000}, STACKS[1], tid=41)
+        th = threading.Thread(target=waiter); th.start()
+        end = time.monotonic() + 10
+        while self.native.lib.nx2sync_waiters(1, self.addr(6)) != 1 and time.monotonic() < end: time.sleep(0.001)
+        self.assertEqual(self.native.lib.nx2sync_waiters(1, self.addr(6)), 1)
+        self.assertEqual(self.word(2), 0)                                       # the waiter released its mutex
+        sig = self.run_guest(SIGNALFN, {'x0': self.addr(6), 'x1': 1}, STACKS[2], tid=42)   # this thread is not blocked: the call went through while another waits
+        self.assertEqual(sig['x0'], 0)
+        th.join(10); self.assertFalse(th.is_alive())
+        self.assertEqual((res['r']['x0'], self.word(2)), (0, 0xD002)); self.assertEqual(self.python_calls, [])
+
+    def test_lock_waits_for_unlock_and_gets_the_word(self):
+        self.setword(3, 0xD001 | 0x40000000)                                    # held by 0xD001, listeners
+        res = {}
+        th = threading.Thread(target=lambda: res.update(r=self.run_guest(LOCKFN, {'x0': 0xD001, 'x1': self.addr(3), 'x2': 0xD003}, STACKS[3], tid=43)))
+        th.start()
+        end = time.monotonic() + 10
+        while self.native.lib.nx2sync_waiters(0, self.addr(3)) != 1 and time.monotonic() < end: time.sleep(0.001)
+        self.assertEqual(self.native.lib.nx2sync_waiters(0, self.addr(3)), 1)
+        self.run_guest(UNLOCKFN, {'x0': self.addr(3)}, STACKS[2], tid=44)
+        th.join(10); self.assertFalse(th.is_alive())
+        self.assertEqual((res['r']['x0'], self.word(3)), (0, 0xD003)); self.assertEqual(self.python_calls, [])
+
+
+if __name__ == '__main__': unittest.main()
