+                while len(q) == 3: assert impl.call(WAIT, m.w(20), m.w(32), self, FOREVER) == 0
+                q.append(k); impl.call(SIGNAL, m.w(31), 1); unlock(self)
+        except BaseException as e: errors.append(e)
+    def consumer(i):
+        impl.enter(300 + i); self = 0xD500 + i
+        try:
+            for _ in range(items):
+                lock(self)
+                while not q: assert impl.call(WAIT, m.w(20), m.w(31), self, FOREVER) == 0
+                v = q.pop(0); impl.call(SIGNAL, m.w(32), 1); unlock(self)
+                with m.lock: state['sum'] += v; state['n'] += 1
+        except BaseException as e: errors.append(e)
+    ths = [threading.Thread(target=producer, args=(i,)) for i in range(2)] + [threading.Thread(target=consumer, args=(i,)) for i in range(2)]
+    for th in ths: th.start()
+    for th in ths: th.join(60)
+    assert not any(th.is_alive() for th in ths), 'the queue workers did not finish: a lost wakeup or a deadlock'
+    assert not errors, errors
+    assert state['n'] == 2 * items and state['sum'] == 2 * items * (items + 1) // 2, state
+    assert not q and m.get(20) == 0
+    assert impl.waiters(1, m.w(31)) == impl.waiters(1, m.w(32)) == impl.waiters(0, m.w(20)) == 0
+
