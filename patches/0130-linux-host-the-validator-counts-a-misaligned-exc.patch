+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=11, **{'exclusive-misaligned': 4}), row('0x2', 'equal', equal=12)])
+            table, ok = vg.summarize(d, ['m'])
+        self.assertTrue(ok, table); self.assertIn('| misaligned exclusive |', table)
+        self.assertIn('| m | 2 | 2 | 0 | 0 | 0 | 0 | 23 | 0 | 0 | 0 | 4 | 0 | 0 |', table)
+        self.assertIn('4 cases where Unicorn stopped on an exclusive access at an address that is not aligned', table)
+        self.assertIn('2 functions identical to Unicorn over 23 cases', table, 'the excused cases are not counted as compared')
+
+    def test_a_table_without_any_misaligned_exclusive_has_no_note(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=12)])
+            table, ok = vg.summarize(d, ['m'])
+        self.assertTrue(ok); self.assertNotIn('not aligned', table)
+
     def test_a_table_of_nothing_compared_is_not_a_pass(self):
         with tempfile.TemporaryDirectory() as d:
