+    lifted: the answer of a lift already done into ll (True: the IR calls __remill_error), from _lift_batch"""
+    if lifted is None: lifted = _run_lift(code, address, ll, entry)
+    if not lifted: return
     scratch = ll + '.insn.ll'
     traps = 0
     for i, (w,) in enumerate(struct.iter_unpack('<I', code)):
