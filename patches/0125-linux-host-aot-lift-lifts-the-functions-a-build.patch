diff --git a/dm/tools/tests/test_aot_lift_batch.py b/dm/tools/tests/test_aot_lift_batch.py
new file mode 100644
index 00000000..98e94cab
--- /dev/null
+++ b/dm/tools/tests/test_aot_lift_batch.py
@@ -0,0 +1,135 @@
+"""Lifting many functions per remill-lift process (aot_lift.Aot, remill-lift --batch, Remill patch 0011).
+A run of remill-lift spends about 85 ms of a 90 ms lift loading the architecture semantics, so a build used to pay that once per function.
+  · a build of many functions starts a few lifter processes, not one per function;
+  · the objects are the same, byte for byte, with the batch and without it (AOT_LIFT_BATCH=0), so the cache keys and the cached objects stay valid;
+  · a lifter without --batch (a Remill built before patch 0011) is detected on first use and the build goes on one function per process;
+  · a function Remill cannot lift, a function with a trap and a function that is too long give the same answer in a batch as alone.
+Needs REMILL_BUILD, clang++ and unicorn; skipped otherwise. The tests that need --batch in the lifter are skipped with the reason when the Remill build lacks it."""
+import os, stat, struct, subprocess, sys, tempfile, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import aot_lift
+import arm64_ref as ref
+from test_aot_t3 import SP, READY
+
+MOVZ_X0, CLS_X0_X0 = 0xD2800000, 0xDAC01400   # mov x0, #imm16 (imm16 << 5) ; cls x0, x0 (Remill has no semantics for it)
+BASE = 0x10000
+
+
+def has_batch():
+    """True when the lifter in REMILL_BUILD knows --batch"""
+    if not READY: return False
+    r = subprocess.run([aot_lift.lifter(), '--arch', 'aarch64', '--batch', os.devnull], capture_output=True, text=True, errors='replace')
+    return 'unknown command line flag' not in r.stderr
+
+
+def functions(count):
+    """count distinct functions: function i returns i + 1 in x0"""
+    return [(BASE + 0x40 * i, struct.pack('<2I', MOVZ_X0 | ((i + 1) << 5), aot_lift.RET)) for i in range(count)]
+
+
+class Counting:
+    """Replaces aot_lift.lifter by a script that logs each start, then runs the real lifter (or, with refuse_batch, behaves like a lifter built before --batch)"""
+    def __init__(self, refuse_batch=False):
+        self.dir = tempfile.TemporaryDirectory()
+        self.log = Path(self.dir.name) / 'starts'
+        self.real = aot_lift.lifter()
+        self.script = Path(self.dir.name) / 'remill-lift-test'
+        refuse = ('case " $* " in *" --batch "*) echo "ERROR: unknown command line flag \'batch\'" >&2; exit 1;; esac\n' if refuse_batch else '')
+        self.script.write_text(f'#!/bin/sh\necho start >> "{self.log}"\n{refuse}exec "{self.real}" "$@"\n')
+        self.script.chmod(self.script.stat().st_mode | stat.S_IEXEC)
+
+    def __enter__(self):
+        self.saved = aot_lift.lifter
+        aot_lift.lifter = lambda: str(self.script)
+        aot_lift._batch_refused = False
+        return self
+
+    def __exit__(self, *a):
+        aot_lift.lifter = self.saved
+        aot_lift._batch_refused = False
+        self.dir.cleanup()
+
+    @property
+    def starts(self): return len(self.log.read_text().split()) if self.log.exists() else 0
+
+
+def objects(cache):
+    return {p.relative_to(cache).as_posix(): p.read_bytes() for p in sorted(Path(cache).rglob('*')) if p.is_file() and p.suffix in ('.o', '.syms', '.fail')}
+
+
+@unittest.skipUnless(READY, 'needs REMILL_BUILD (a Remill build folder), clang++ and unicorn')
+class Batch(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.root = Path(self.dir.name)
+        self.saved_env = os.environ.get('AOT_LIFT_BATCH')
+
+    def tearDown(self):
+        if self.saved_env is None: os.environ.pop('AOT_LIFT_BATCH', None)
+        else: os.environ['AOT_LIFT_BATCH'] = self.saved_env
+        self.dir.cleanup()
+
+    def build(self, fs, cache=None, **kw):
+        return aot_lift.Aot(fs, cache=str(self.root / cache) if cache else None, **kw)
+
+    @unittest.skipUnless(has_batch(), 'this Remill build has no remill-lift --batch (patch 0011)')
+    def test_many_functions_start_few_lifter_processes(self):
+        fs = functions(70)
+        with Counting() as c:
+            a = self.build(fs, 'c1', jobs=4)
+            try:
+                for i in (0, 37, 69): self.assertEqual(a.run(fs[i][0], {'x30': ref.STOP}, 0, SP)['x0'], i + 1)
+            finally: a.close()
+            self.assertLessEqual(c.starts, 5, f'{c.starts} lifter processes for 70 functions')
+
+    @unittest.skipUnless(has_batch(), 'this Remill build has no remill-lift --batch (patch 0011)')
+    def test_the_objects_are_the_same_with_and_without_the_batch(self):
+        fs = functions(40) + [(0x90000, struct.pack('<2I', CLS_X0_X0, aot_lift.RET))]
+        os.environ['AOT_LIFT_BATCH'] = '0'
+        with Counting() as alone:
+            self.build(fs, 'alone', stub_unliftable=True, jobs=4).close()
+            self.assertGreaterEqual(alone.starts, 40, 'AOT_LIFT_BATCH=0 must lift one function per process')
+        os.environ.pop('AOT_LIFT_BATCH')
+        with Counting(): self.build(fs, 'batch', stub_unliftable=True, jobs=4).close()
+        a, b = objects(self.root / 'alone'), objects(self.root / 'batch')
+        self.assertEqual(sorted(a), sorted(b))
+        self.assertEqual(len(a), 2 * 40 + 1, 'an .o and a .syms per function that lifts, a .fail for the one that does not')
+        self.assertEqual([k for k in a if a[k] != b[k]], [])
+
+    def test_a_lifter_without_batch_is_detected_and_the_build_goes_on(self):
+        fs = functions(20)
+        with Counting(refuse_batch=True) as c:
+            a = self.build(fs, 'old', jobs=2)
+            try: self.assertEqual(a.run(fs[11][0], {'x30': ref.STOP}, 0, SP)['x0'], 12)
+            finally: a.close()
+            first = c.starts
+            self.build(functions(30)[20:], 'old2', jobs=2).close()
+            self.assertGreaterEqual(first, 20, 'one process per function without --batch')
+            self.assertLessEqual(c.starts - first, 10 + 2, 'the refusal is remembered: no second attempt per chunk')
+
+    @unittest.skipUnless(has_batch(), 'this Remill build has no remill-lift --batch (patch 0011)')
+    def test_an_unliftable_function_in_a_batch_gives_the_reason_it_gives_alone(self):
+        g = (0x90000, struct.pack('<2I', CLS_X0_X0, aot_lift.RET))
+        fs = functions(10) + [g]
+        os.environ['AOT_LIFT_BATCH'] = '0'
+        alone = self.build(fs, stub_unliftable=True); why_alone = alone.unlifted[g[0]]; alone.close()
+        os.environ.pop('AOT_LIFT_BATCH')
+        batch = self.build(fs, stub_unliftable=True); why_batch = batch.unlifted[g[0]]; batch.close()
+        self.assertIn('cls', why_batch)
+        self.assertEqual(why_batch, why_alone)
+        with self.assertRaises(aot_lift.LiftError) as e: self.build(fs, stub_unliftable=False)
+        self.assertIn('cls', str(e.exception))
+
+    @unittest.skipUnless(has_batch(), 'this Remill build has no remill-lift --batch (patch 0011)')
+    def test_a_function_over_the_command_line_cap_is_still_refused_by_name(self):
+        big = (0x90000, struct.pack('<I', 0xD503201F) * (aot_lift.MAX_LIFT_BYTES // 4 + 1) + struct.pack('<I', aot_lift.RET))
+        with self.assertRaises(aot_lift.LiftError) as e: self.build(functions(3) + [big])
+        self.assertIn('0x90000', str(e.exception).replace('0x090000', '0x90000'))
+        self.assertIn(str(aot_lift.MAX_LIFT_BYTES), str(e.exception))
+
+
+if __name__ == '__main__':
+    unittest.main()
