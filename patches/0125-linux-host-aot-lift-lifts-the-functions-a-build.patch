     return '@__remill_error' in Path(ll).read_text()
 
 
+LIFT_BATCH = 32          # functions handed to one remill-lift process: its start-up (the architecture semantics, about 85 ms) is paid once for all of them
+_batch_refused = False   # set when the lifter does not know --batch (a Remill built before patch 0011): every function then goes through its own process
+
+
+def _lift_batch(requests):
+    """requests: [(code, address, ll, entry)]. Lifts them in one remill-lift process (--batch) -> a list as long as requests, each True (the IR calls __remill_error), False, or None when the request was not
+    done in the batch (too long for the command-line cap, refused by the lifter, or the lifter has no --batch): the caller then lifts it alone, which gives the error the single run gives.
+    The objects do not depend on this: a batch child lifts from the same untouched state as a run of its own (the IR is identical, byte for byte)"""
+    global _batch_refused
+    todo = [i for i, (code, address, ll, entry) in enumerate(requests) if len(code) <= MAX_LIFT_BYTES and not re.search(r'\s', ll)]
+    out = [None] * len(requests)
+    if len(todo) < 2 or _batch_refused or os.environ.get('AOT_LIFT_BATCH', '1') == '0': return out
+    fd, path = tempfile.mkstemp(suffix='.batch', dir=os.path.dirname(requests[todo[0]][2]))
+    try:
+        with os.fdopen(fd, 'w') as f:
+            for i in todo:
+                code, address, ll, entry = requests[i]
+                f.write(f"{address:x} {'-' if entry is None else format(entry, 'x')} {code.hex()} {ll}\n")
+        r = subprocess.run([lifter(), '--arch', 'aarch64', '--batch', path], capture_output=True, text=True, errors='replace')
+    finally: os.unlink(path)
+    if 'unknown command line flag' in r.stderr: _batch_refused = True; return out
+    for line in r.stdout.splitlines():
+        parts = line.split()
+        if len(parts) >= 2 and parts[0] == 'ok' and parts[1].isdigit() and 0 < int(parts[1]) <= len(todo):
+            ll = requests[todo[int(parts[1]) - 1]][2]
+            if os.path.exists(ll): out[todo[int(parts[1]) - 1]] = '@__remill_error' in Path(ll).read_text()
+    return out
+
+
 def lift(word, ll, address=0x1000):
     """Lift one instruction (+ ret) to the IR file ll; LiftError when Remill has no semantics for it"""
     if _run_lift(struct.pack('<2I', word, RET), address, ll):
         raise LiftError(f'{address:#x}: {word:#010x} ({_disasm(word, address)}): Remill has no semantics for this instruction (the lifted code calls __remill_error)')
 
 
