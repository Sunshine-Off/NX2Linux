+                    _atomic(base_path + '.syms', ' '.join(undefined_symbols(tmp_obj)).encode())
+                    _atomic(base_path + '.o', Path(tmp_obj).read_bytes())
+                    os.unlink(ll); os.unlink(tmp_obj)
