From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shikosu <teovidal01@gmail.com>
Date: Wed, 4 Nov 2026 22:30:07 +0100
Subject: [PATCH] module_validate: workers run with the venv interpreter
 (NX2_PYTHON, NX2_VENV or ~/.cache/nx2linux/venv)

The workers run with python3 -I, which ignores the user site, so capstone, unicorn
and lz4 installed there are invisible to them and test_module_validate failed with
No module named capstone. worker_python() picks the interpreter that
tools/setup_toolchain.sh sets up, and falls back to the current one.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Upstream-Status: pending
Reason: Workers need the venv interpreter: -I hides the user site
Issue: Sunshine-Off/NX2Linux#6

---
 dm/tools/module_validate.py            | 10 +++++++++-
 dm/tools/tests/test_module_validate.py |  2 +-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/dm/tools/module_validate.py b/dm/tools/module_validate.py
index c28722a..c6596b4 100644
--- a/dm/tools/module_validate.py
+++ b/dm/tools/module_validate.py
@@ -18,6 +18,14 @@ import elf_module as em
 
 SCRATCH, SCRATCH_SIZE, STACK, STACK_SIZE, STOP = 0x20000000, 0x10000, 0x30000000, 0x10000, 0xFFFF0000
 MASK = (1 << 64) - 1
+
+
+def worker_python():
+    """The interpreter the workers run with. They use `python3 -I`, which ignores the user site, so capstone, unicorn and lz4 must be in the interpreter's own packages:
+    NX2_PYTHON if set, else the venv tools/setup_toolchain.sh makes ($NX2_VENV or ~/.cache/nx2linux/venv), else this one."""
+    if os.environ.get('NX2_PYTHON'): return os.environ['NX2_PYTHON']
+    venv = Path(os.environ.get('NX2_VENV') or Path.home() / '.cache' / 'nx2linux' / 'venv') / 'bin' / 'python'
+    return str(venv) if venv.exists() else sys.executable
 REJECT = {'bl', 'blr', 'br', 'svc', 'mrs', 'msr', 'brk', 'hlt', 'hvc', 'smc', 'udf', 'eret'}   # a leaf function: nothing that leaves it or reads the machine
 
 
@@ -230,7 +238,7 @@ def worker(a):
 
 
 def run_batch(a, starts):
-    cmd = [sys.executable, '-I', str(HERE / 'module_validate.py'), '_worker', a.exefs, a.work, a.module, '--starts', ','.join(f'{s:x}' for s in starts), '--cases', str(a.cases), '--seed', str(a.seed)] + (['--jit'] if a.jit else []) + (['--only-unliftable'] if a.only_unliftable else []) + (['--switches'] if a.switches else [])
+    cmd = [worker_python(), '-I', str(HERE / 'module_validate.py'), '_worker', a.exefs, a.work, a.module, '--starts', ','.join(f'{s:x}' for s in starts), '--cases', str(a.cases), '--seed', str(a.seed)] + (['--jit'] if a.jit else []) + (['--only-unliftable'] if a.only_unliftable else []) + (['--switches'] if a.switches else [])
     try: p = subprocess.run(cmd, capture_output=True, text=True, timeout=a.timeout, env=dict(os.environ, PYTHONPATH=f'{HERE}:{HERE / "tests"}'))
     except subprocess.TimeoutExpired: return [dict(function=hex(s), status='timeout') for s in starts]
     rows = [json.loads(l) for l in p.stdout.splitlines() if l.startswith('{')]
diff --git a/dm/tools/tests/test_module_validate.py b/dm/tools/tests/test_module_validate.py
index 8a88b2d..c5906eb 100644
--- a/dm/tools/tests/test_module_validate.py
+++ b/dm/tools/tests/test_module_validate.py
@@ -25,7 +25,7 @@ class Validate(unittest.TestCase):
     def tearDownClass(cls): cls.dir.cleanup()
 
     def run_tool(self, *args):
-        return subprocess.run([sys.executable, '-I', str(TOOL), args[0], str(self.exefs), str(self.work), 'a', *args[1:]], capture_output=True, text=True,
+        return subprocess.run([mv.worker_python(), '-I', str(TOOL), args[0], str(self.exefs), str(self.work), 'a', *args[1:]], capture_output=True, text=True,
                               env=dict(os.environ, PYTHONPATH=f'{TOOL.parent}:{HERE}'), timeout=300)
 
     def test_coverage_counts_what_lifts(self):
