From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shikosu <teovidal01@gmail.com>
Date: Mon, 2 Nov 2026 16:05:44 +0100
Subject: [PATCH] jump tables through x16/x17, thread pointers of a run
 changeable from a service handler

LLVM jumps through x16 for a switch (Xenoblade 2's csvb::CCsvbUtility): find_jump_tables no longer skips br x16/x17 (a PLT stub is still not a table). aot_set_tls/aot_get_tls change the thread pointers of the run a host thread executes, so a fiber resumed by another guest thread sees that thread's GetCurrentThread.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Upstream-Status: pending
Reason: S7bis Linux Horizon layer (fibers, hid, runner, stubs) and AOT/jump-table fixes found booting Xenoblade Chronicles 2; tests use synthetic code and fake guest memory, no game data
Issue: none yet (NX2Linux, branch swann/jalon-s7bis-xc2)

---
 dm/tools/aot_lift.py               | 10 ++++++++++
 dm/tools/aot_runtime.cpp           |  6 +++++-
 dm/tools/aot_runtime.h             |  2 ++
 dm/tools/jump_tables.py            |  2 +-
 dm/tools/tests/test_jump_tables.py | 13 +++++++++++++
 5 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/dm/tools/aot_lift.py b/dm/tools/aot_lift.py
index 432a73d..c285814 100644
--- a/dm/tools/aot_lift.py
+++ b/dm/tools/aot_lift.py
@@ -372,6 +372,16 @@ class Aot:
         if snapshot: out['mem'] = {b: self.peek(b, n) for b, n, _ in self.regions}   # a game's heap is gigabytes: its threads run with snapshot=False
         return out
 
+    def get_tls(self, which):
+        """The thread pointer of the run the calling thread executes: 0 tpidr_el0, 1 tpidrro_el0"""
+        self.lib.aot_get_tls.restype = ctypes.c_uint64; self.lib.aot_get_tls.argtypes = [ctypes.c_int]
+        return self.lib.aot_get_tls(which)
+
+    def set_tls(self, tpidr_el0, tpidrro_el0):
+        """Change the thread pointers of the run the calling thread executes (a fiber resumed by another guest thread)"""
+        self.lib.aot_set_tls.argtypes = [ctypes.c_uint64, ctypes.c_uint64]
+        self.lib.aot_set_tls(tpidr_el0, tpidrro_el0)
+
     def close(self):
         self.lib.aot_unmap_all()
         if self.dir: self.dir.cleanup()
diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index 18e6d2b..0327f49 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -39,6 +39,7 @@ std::atomic<unsigned> g_nregions;
 std::mutex g_regions_mu;
 thread_local jmp_buf *g_jb;
 thread_local char g_err[300];
+thread_local State *g_state;   // the State of the run this host thread is executing: a service handler (a fiber switch) changes the thread pointers in it
 thread_local bool g_exit_requested;   // a service handler asked this guest thread to end (svcExitThread): checked when the handler returns, so the unwinding stays in C
 uint64_t g_stats[AOT_S_N];
 enum { S_CALLS = AOT_S_CALLS, S_JUMPS = AOT_S_JUMPS, S_FALLBACK = AOT_S_FALLBACK, S_READS = AOT_S_READS, S_WRITES = AOT_S_WRITES, S_REGIONS = AOT_S_REGIONS };
@@ -113,6 +114,8 @@ void aot_fail(const char *fmt, ...) {
 }
 void aot_count(int stat) { count(stat); }
 void aot_request_exit(void) { g_exit_requested = true; }
+void aot_set_tls(uint64_t tpidr_el0, uint64_t tpidrro_el0) { if (g_state) { g_state->sr.tpidr_el0.qword = tpidr_el0; g_state->sr.tpidrro_el0.qword = tpidrro_el0; } }
+uint64_t aot_get_tls(int which) { return !g_state ? 0 : which ? g_state->sr.tpidrro_el0.qword : g_state->sr.tpidr_el0.qword; }
 int aot_try_call(AotFn f, State *st, uint64_t pc, Memory *m, char *err, uint64_t errn) {
     jmp_buf jb, *outer = g_jb; g_jb = &jb;
     if (setjmp(jb)) { g_jb = outer; snprintf(err, errn, "%s", g_err); return 1; }
@@ -283,6 +286,7 @@ int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
     st.fpcr.flat = (uint32_t)g->fpcr; aot_fpsr_set(st, (uint32_t)g->fpsr);
     st.sr.n = g->nzcv >> 3 & 1; st.sr.z = g->nzcv >> 2 & 1; st.sr.c = g->nzcv >> 1 & 1; st.sr.v = g->nzcv & 1;
     jmp_buf jb; int rc = 0;
+    State *outer_state = g_state; g_state = &st;
     if (setjmp(jb)) rc = 1;
     else {
         g_jb = &jb;
@@ -292,7 +296,7 @@ int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
         else if (aot_fallback) { count(S_FALLBACK); aot_fallback(&st, pc, token, 0); }   // an entry the translator did not lift (a stub, a module's init function) runs in the JIT
         else fail("no AOT function at %#llx", (unsigned long long)pc);
     }
-    g_jb = nullptr;
+    g_jb = nullptr; g_state = outer_state;
 #define X(i) g->x[i] = st.gpr.x##i.qword;
     X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
 #undef X
diff --git a/dm/tools/aot_runtime.h b/dm/tools/aot_runtime.h
index 608511a..1f7c670 100644
--- a/dm/tools/aot_runtime.h
+++ b/dm/tools/aot_runtime.h
@@ -20,6 +20,8 @@ AotFn aot_find(uint64_t pc);                                  // the AOT functio
 uint8_t *aot_guest_ptr(uint64_t a, uint64_t n);               // host pointer to n guest bytes at a, or null when they are not all inside one mapped region
 [[noreturn]] void aot_fail(const char *fmt, ...) __attribute__((format(printf, 1, 2)));   // leave the lifted code with an error (aot_run reports it)
 void aot_count(int stat);
+void aot_set_tls(uint64_t tpidr_el0, uint64_t tpidrro_el0);   // change the thread pointers of the run this thread executes (a fiber resumed by another guest thread)
+uint64_t aot_get_tls(int which);   // 0: tpidr_el0, 1: tpidrro_el0
 void aot_request_exit(void);   // the current guest thread ends when its service handler returns (svcExitThread)
 uint64_t aot_stat(int stat);
 // Run an AOT function and catch its error: 0 when it returned, else 1 with the reason in err (the caller then cleans up and fails in its turn)
diff --git a/dm/tools/jump_tables.py b/dm/tools/jump_tables.py
index f16d9b4..0124410 100644
--- a/dm/tools/jump_tables.py
+++ b/dm/tools/jump_tables.py
@@ -50,7 +50,7 @@ def find_jump_tables(img, start, end):
     ins = list(_md().disasm(bytes(img[start:end]), start))
     out = []
     for i, x in enumerate(ins):
-        if x.mnemonic != 'br' or x.op_str in ('x16', 'x17'): continue
+        if x.mnemonic != 'br': continue   # x16 and x17 too: LLVM jumps through x16 (a PLT stub's br x17 is not a table: it jumps on a pointer loaded from memory, which _resolve does not accept)
         t = _resolve(img, ins, i, start, end)
         if t: out.append(t)
     return out
diff --git a/dm/tools/tests/test_jump_tables.py b/dm/tools/tests/test_jump_tables.py
index 225e63a..aae893b 100644
--- a/dm/tools/tests/test_jump_tables.py
+++ b/dm/tools/tests/test_jump_tables.py
@@ -88,4 +88,17 @@ class Tables(unittest.TestCase):
         words[5:5] = [0xD28000A9]   # mov x9, #5 between the adrp/add and the ldrb: the load no longer reads a known table
         self.assertEqual(self.find(words, bytes([0, 2, 4, 6])), [])
 
+    def test_llvm_jumps_through_x16_with_a_word_table_relative_to_itself(self):
+        # Xenoblade 2's csvb::CCsvbUtility: ldrsw x16, [x15, x17, lsl #2] ; add x16, x16, x15 ; br x16 (the table base kept in x15 since the prologue)
+        words = [CMP(0, 1), BHI(F + 4, F + 44), ADRP(15, F + 8, TABLE), ADDI(15, 15, TABLE & 0xFFF), LDRSW(16, 15, 0), ADD(16, 16, 15), BR(16)]
+        words += [NOP, RET, NOP, RET, NOP, RET]
+        a, b = F + 4 * 7, F + 4 * 9
+        (t,) = self.find(words, struct.pack('<2i', a - TABLE, b - TABLE))
+        self.assertEqual(t.targets, (a, b))
+
+    def test_a_plt_stub_through_x17_is_still_not_a_table(self):
+        words = [ADRP(16, F, TABLE), 0xF9400211, ADDI(16, 16, 0), BR(17)]   # adrp x16 ; ldr x17, [x16] ; add x16, x16, #0 ; br x17
+        self.assertEqual(self.find(words, bytes(16)), [])
+
+
 if __name__ == '__main__': unittest.main()
