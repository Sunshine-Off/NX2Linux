 Needs a Remill with the ADC/ADCS and exclusive-store patches (fork en cours/remill-patches), REMILL_BUILD, clang++ and unicorn; skipped otherwise."""
-import re, struct, sys, tempfile, threading, unittest, os
+import re, shutil, struct, sys, tempfile, threading, unittest, os
 from pathlib import Path
 
 HERE = Path(__file__).resolve().parent
@@ -143,5 +143,50 @@ class Atomics(unittest.TestCase):
         self.skipTest('no lost update seen in 5 tries: this host did not interleave the threads')
 
 
+@unittest.skipUnless(READY and shutil.which('aarch64-linux-gnu-as') and shutil.which('aarch64-linux-gnu-objcopy'), 'needs REMILL_BUILD, clang++, unicorn and aarch64-linux-gnu-as')
+class PairExclusives(unittest.TestCase):
+    """ldaxp/stlxp of two X registers is a 16-byte compare-and-swap (lock cmpxchg16b): threads adding to both words of a pair lose no update, and the two words always agree (issue #16)"""
+    LOOP = '1: ldaxp x2, x3, [x0]; add x2, x2, #1; add x3, x3, #1; stlxp w4, x2, x3, [x0]; cbnz w4, 1b; subs x1, x1, #1; b.ne 1b'
+    PLAIN = '1: ldp x2, x3, [x0]; add x2, x2, #1; add x3, x3, #1; stp x2, x3, [x0]; subs x1, x1, #1; b.ne 1b'
+
+    def counts(self, line, nthreads=4, n=20000):
+        import test_aot_simd as ts
+        with tempfile.TemporaryDirectory() as tmp: (w,) = ts.assemble([line], tmp)
+        aot = mapped(struct.pack('<%dI' % len(w), *w))
+        try:
+            errs = []
+            def work():
+                r = aot.run(ADDR, {'x0': DATA + 0x80, 'x1': n, 'x30': ref.STOP}, 0, SP)
+                if 'fault' in r: errs.append(r['fault'])
+            threads = [threading.Thread(target=work) for _ in range(nthreads)]
+            for t in threads: t.start()
+            for t in threads: t.join()
+            self.assertEqual(errs, [])
+            lo, hi = struct.unpack_from('<QQ', aot.peek(DATA, DATA_SIZE), 0x80)
+            start = struct.unpack_from('<QQ', MEM[DATA], 0x80)
+            return (lo - start[0], hi - start[1]), nthreads * n
+        finally: aot.close()
+
+    def test_threads_adding_to_a_pair_lose_no_update(self):
+        for _ in range(3):
+            (lo, hi), want = self.counts(self.LOOP)
+            self.assertEqual((lo, hi), (want, want), 'a pair store succeeded although another thread had written the pair')
+
+    def test_the_race_is_real_without_pair_exclusives(self):
+        for _ in range(5):
+            (lo, hi), want = self.counts(self.PLAIN)
+            if lo < want or hi < want: return
+        self.skipTest('no lost update seen in 5 tries: this host did not interleave the threads')
+
+    def test_an_unaligned_pair_is_an_explicit_error_not_a_host_fault(self):
+        import test_aot_simd as ts
+        with tempfile.TemporaryDirectory() as tmp: (w,) = ts.assemble(['ldxp x4, x5, [x0]; stxp w2, x4, x5, [x0]'], tmp)
+        aot = mapped(struct.pack('<%dI' % len(w), *w))
+        try:
+            got = aot.run(ADDR, {'x0': DATA + 0x88, 'x30': ref.STOP}, 0, SP)   # 8-byte aligned, not 16
+            self.assertIn('not naturally aligned', got.get('fault', 'no fault: the store went through'))
+        finally: aot.close()
+
+
 if __name__ == '__main__':
     unittest.main()
