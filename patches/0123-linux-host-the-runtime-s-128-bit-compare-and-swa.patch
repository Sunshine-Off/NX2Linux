@@ -0,0 +1,46 @@
+"""lift_coverage.py (NX2Linux Phase 2, #16): the table of instruction families is well formed, every form assembles, and the table prints. The lifting itself is measured by the tool and checked by test_aot_simd.py.
+Needs aarch64-linux-gnu-as; skipped otherwise."""
+import shutil, sys, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import lift_coverage as lc
+
+AS = shutil.which('aarch64-linux-gnu-as')
+# forms the assembler (binutils) does not know with the options the tool uses: none today
+KNOWN_REFUSED = set()
+
+
+class Table(unittest.TestCase):
+    def test_families_are_named_described_and_free_of_duplicates(self):
+        seen = set()
+        for name, (what, lines) in lc.FAMILIES.items():
+            self.assertTrue(what and lines, name)
+            for l in lines:
+                self.assertNotIn(l, seen, f'{l} is listed twice'); seen.add(l)
+                self.assertNotIn(';', l, 'one instruction per line: the tool lifts each line as one function')
+
+    def test_the_families_of_the_issue_are_there(self):
+        for want in ('pair-exclusives', 'lse-atomics', 'saturating-narrow', 'reciprocal-estimate', 'half-conversion', 'half-arithmetic', 'ccmn'):
+            self.assertIn(want, lc.FAMILIES)
+
+    def test_the_table_counts_each_result(self):
+        res = {'a': [('x', 'lifted', ''), ('y', 'jit', 'why'), ('z', 'refused', '')]}
+        with unittest.mock.patch.dict(lc.FAMILIES, {'a': ('what', ['x', 'y', 'z'])}):
+            out = lc.table(res)
+        self.assertRegex(out, r'a\s+3\s+1\s+1\s+1\s+what'); self.assertRegex(out, r'total\s+3\s+1\s+1\s+1')
+
+    @unittest.skipUnless(AS, 'needs aarch64-linux-gnu-as')
+    def test_every_form_assembles(self):
+        bad = [(l, why) for _, (_, lines) in lc.FAMILIES.items() for l in lines for ok, why in [lc.assembles(l)] if not ok and l not in KNOWN_REFUSED]
+        self.assertEqual(bad, [])
+
+    @unittest.skipUnless(AS, 'needs aarch64-linux-gnu-as')
+    def test_the_assembler_refusing_a_form_is_reported_as_refused_not_as_a_lifting_gap(self):
+        self.assertFalse(lc.assembles('notaninstruction x0')[0]); self.assertTrue(lc.assembles('nop')[0])
+
+
+import unittest.mock  # noqa: E402  (used by the test above)
+
+if __name__ == '__main__': unittest.main()
