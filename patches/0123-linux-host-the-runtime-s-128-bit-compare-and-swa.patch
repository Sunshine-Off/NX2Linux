diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index 4a70773a..afe8a3aa 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -224,6 +224,18 @@ ACCESS(f32, float) ACCESS(f64, double)   // scalar floating-point loads and stor
         __atomic_compare_exchange_n((T *)guest(a, sizeof(T), "atomic access"), &expected, desired, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); \
         count_write(); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
 CAS(8, uint8_t) CAS(16, uint16_t) CAS(32, uint32_t) CAS(64, uint64_t)
+// The pair exclusives (ldxp/stxp of two X registers, Remill patch 0010) store 16 bytes with one compare-and-swap: lock cmpxchg16b, which faults (#GP) on a location that is not 16-byte aligned, so the alignment is
+// checked first (the hardware requires it too). The mapping is page aligned and a region lives at nx2_gbase + address, so a guest address aligned to 16 is a host address aligned to 16. expected gets the value the
+// location held, as for the narrower ones
+Memory *__remill_compare_exchange_memory_128(Memory *m, uint64_t a, unsigned __int128 &expected, unsigned __int128 &desired) {
+    if (a % 16) fail("atomic access of 16 bytes at %#llx is not naturally aligned", (unsigned long long)a);
+    unsigned __int128 *p = (unsigned __int128 *)guest(a, 16, "atomic access");
+    uint64_t lo = (uint64_t)expected, hi = (uint64_t)(expected >> 64);
+    const uint64_t dlo = (uint64_t)desired, dhi = (uint64_t)(desired >> 64);
+    __asm__ __volatile__("lock cmpxchg16b %0" : "+m"(*p), "+a"(lo), "+d"(hi) : "b"(dlo), "c"(dhi) : "memory", "cc");
+    expected = ((unsigned __int128)hi << 64) | lo;
+    count_write(); if (aot_write_hook) aot_write_hook(a, 16); return m;
+}
 Memory *__remill_atomic_begin(Memory *m) { return m; }   // the CAS above is the atomic operation; these only bracket the instruction
 Memory *__remill_atomic_end(Memory *m) { return m; }
 
diff --git a/dm/tools/tests/lift_coverage.py b/dm/tools/tests/lift_coverage.py
new file mode 100644
index 00000000..721279e1
--- /dev/null
+++ b/dm/tools/tests/lift_coverage.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Which AArch64 instructions Remill lifts, by family, with no game data (NX2Linux Phase 2, #16).
+Every line of FAMILIES is assembled with aarch64-linux-gnu-as, lifted alone by remill-lift (aot_lift.Aot with stub_unliftable) and classified: `lifted` (native recompiled code), `jit` (Remill cannot lift it:
+it runs in the dynarmic fallback, with the reason Remill gave) or `refused` (the assembler does not know the form: it is not a lifting gap). The table is what the issue asked for before and after a Remill patch.
+Counts per game are not here: they come from `module_validate.py census` on the game's own modules (Balatro 1,720 instructions in 153 classes, from blocages-connus.md, XC2 not measured).
+Needs aarch64-linux-gnu-as, REMILL_BUILD and clang++.
+Usage: lift_coverage.py [--json OUT] [--family NAME ...]"""
+import argparse, collections, json, os, shutil, struct, subprocess, sys, tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+
+AS = shutil.which('aarch64-linux-gnu-as')
+MARCH = '-march=armv8.2-a+fp16+crypto'
+
+SIZES = ('', 'b', 'h')
+LSE_ORDER = ('', 'a', 'l', 'al')
+
+
+def lse():
+    out = []
+    for o in LSE_ORDER:
+        out += [f'cas{o} x0, x1, [x2]', f'cas{o} w0, w1, [x2]', f'cas{o}b w0, w1, [x2]', f'cas{o}h w0, w1, [x2]', f'casp{o} x0, x1, x2, x3, [x4]',
+                f'swp{o} x0, x1, [x2]', f'swp{o} w0, w1, [x2]', f'swp{o}b w0, w1, [x2]', f'swp{o}h w0, w1, [x2]']
+        for op in ('add', 'clr', 'eor', 'set', 'smax', 'smin', 'umax', 'umin'):
+            out += [f'ld{op}{o} x0, x1, [x2]', f'ld{op}{o} w0, w1, [x2]', f'ld{op}{o}b w0, w1, [x2]', f'ld{op}{o}h w0, w1, [x2]']
+    out += [f'st{op} x0, [x1]' for op in ('add', 'clr', 'eor', 'set', 'smax', 'smin', 'umax', 'umin')]
+    return out
+
+
+def narrow(op):
+    return [f'{op} v0.8b, v1.8h', f'{op}2 v0.16b, v1.8h', f'{op} v0.4h, v1.4s', f'{op}2 v0.8h, v1.4s', f'{op} v0.2s, v1.2d', f'{op}2 v0.4s, v1.2d',
+            f'{op} b0, h1', f'{op} h0, s1', f'{op} s0, d1']
+
+
+# family -> (what it is, [assembly lines]). The family names are the ones of the issue
+FAMILIES = {
+    'pair-exclusives': ('ldxp, ldaxp, stxp, stlxp (128-bit and 64-bit pairs)',
+                        ['ldxp x0, x1, [x2]', 'ldaxp x0, x1, [x2]', 'stxp w3, x0, x1, [x2]', 'stlxp w3, x0, x1, [x2]',
+                         'ldxp w0, w1, [x2]', 'ldaxp w0, w1, [x2]', 'stxp w3, w0, w1, [x2]', 'stlxp w3, w0, w1, [x2]']),
+    'single-exclusives': ('control: ldxr, stxr and byte, half forms (already lifted by patches 0002 and the blocks 3 and 4 work)',
+                          ['ldxr x0, [x2]', 'ldaxr w0, [x2]', 'stxr w3, x0, [x2]', 'stlxr w3, w0, [x2]', 'ldxrb w0, [x2]', 'stxrh w3, w0, [x2]', 'ldar x0, [x2]', 'stlr x0, [x2]']),
+    'lse-atomics': ('ARMv8.1 LSE: cas*, casp*, swp*, ld<op>*, st<op> (not in the Switch CPU, present in outline-atomics code)', lse()),
+    'saturating-narrow': ('sqxtn, uqxtn, sqxtun (vector and scalar)', narrow('sqxtn') + narrow('uqxtn') + narrow('sqxtun')),
+    'reciprocal-estimate': ('frecpe, frecpx (single, double, scalar, vector)',
+                            ['frecpe v0.4s, v1.4s', 'frecpe v0.2s, v1.2s', 'frecpe v0.2d, v1.2d', 'frecpe s0, s1', 'frecpe d0, d1', 'frecpx s0, s1', 'frecpx d0, d1']),
+    'reciprocal-controls': ('control: frecps, frsqrte, frsqrts (patch 0009)', ['frecps s0, s1, s2', 'frecps v0.4s, v1.4s, v2.4s', 'frsqrte s0, s1', 'frsqrte v0.2d, v1.2d', 'frsqrts d0, d1, d2']),
+    'half-conversion': ('fcvt between half and single or double, fcvtn and fcvtl with 4h (the Cortex-A57 has these)',
+                        ['fcvt s0, h1', 'fcvt h0, s1', 'fcvt d0, h1', 'fcvt h0, d1', 'fcvtn v0.4h, v1.4s', 'fcvtn2 v0.8h, v1.4s', 'fcvtl v0.4s, v1.4h', 'fcvtl2 v0.4s, v1.8h']),
+    'half-arithmetic': ('FP16 arithmetic and loads (ARMv8.2, not in the Switch CPU)',
+                        ['fadd h0, h1, h2', 'fsub h0, h1, h2', 'fmul h0, h1, h2', 'fdiv h0, h1, h2', 'fsqrt h0, h1', 'fabs h0, h1', 'fneg h0, h1', 'fmadd h0, h1, h2, h3', 'fcmp h0, h1',
+                         'fcvtzs w0, h1', 'scvtf h0, w1', 'fadd v0.4h, v1.4h, v2.4h', 'fmul v0.8h, v1.8h, v2.8h', 'fmla v0.8h, v1.8h, v2.8h', 'ldr h0, [x1]', 'str h0, [x1]']),
+    'ccmn': ('conditional compare negative: register form (the issue) and immediate form (control)',
+             ['ccmn x0, x1, #0, eq', 'ccmn w0, w1, #4, ne', 'ccmn x0, x1, #15, lt', 'ccmn x0, #5, #0, eq', 'ccmn w0, #31, #2, hi']),
+    'system': ('mrs ctr_el0, udf and the barriers (patch 0007 and __remill_error)', ['mrs x0, ctr_el0', 'mrs x0, dczid_el0', 'mrs x0, cntfrq_el0', 'udf #0', 'dmb ish', 'dsb sy', 'isb', 'clrex']),
+    'found-unlifted': ('not in the issue, found while measuring: cls, mrs and msr of NZCV, scalar faddp, fmaxnmv, sqrdmlah (ARMv8.1, not in the Switch CPU)',
+                       ['cls x0, x1', 'cls w0, w1', 'mrs x0, nzcv', 'msr nzcv, x0', 'faddp s0, v1.2s', 'faddp d0, v1.2d', 'fmaxnmv s0, v1.4s', 'sqrdmlah v0.4s, v1.4s, v2.4s']),
+    'crypto-controls': ('control: AES, SHA, PMULL, CRC32 (patches 0005 and 0009)', ['aese v0.16b, v1.16b', 'aesmc v0.16b, v1.16b', 'sha256h q0, q1, v2.4s', 'pmull v0.1q, v1.1d, v2.1d', 'crc32w w0, w1, w2', 'crc32cx w0, w1, x2']),
+}
+
+
+def assembles(line):
+    """True when the assembler knows this form (and the reason when not)"""
+    with tempfile.TemporaryDirectory() as d:
+        src = Path(d) / 'i.s'; src.write_text('.text\n' + line + '\n')
+        r = subprocess.run([AS, MARCH, str(src), '-o', str(Path(d) / 'i.o')], capture_output=True, text=True, errors='replace')
+    return (True, '') if r.returncode == 0 else (False, (r.stderr.strip().splitlines() or ['refused'])[-1][:120])
+
+
+def measure(families):
+    """{family: [(line, 'lifted' | 'jit' | 'refused', reason)]}"""
+    import test_aot_simd as ts
+    out = {}
+    for name in families:
+        lines = FAMILIES[name][1]
+        ok, rows = [], {}
+        for l in lines:
+            good, why = assembles(l)
+            if good: ok.append(l)
+            else: rows[l] = ('refused', why)
+        if ok:
+            with tempfile.TemporaryDirectory() as tmp:
+                h = ts.Harness(ok, tmp)
+                try:
+                    for l in ok: rows[l] = ('jit', h.unlifted[l]) if l in h.unlifted else ('lifted', '')
+                finally: h.close()
+        out[name] = [(l, *rows[l]) for l in lines]
+    return out
+
+
+def table(result):
+    lines = [f'{"family":<20} {"forms":>5} {"lifted":>6} {"jit":>4} {"refused":>7}  what']
+    tot = collections.Counter()
+    for name, rows in result.items():
+        c = collections.Counter(r[1] for r in rows); tot.update(c)
+        lines.append(f'{name:<20} {len(rows):>5} {c["lifted"]:>6} {c["jit"]:>4} {c["refused"]:>7}  {FAMILIES[name][0]}')
+    lines.append(f'{"total":<20} {sum(tot.values()):>5} {tot["lifted"]:>6} {tot["jit"]:>4} {tot["refused"]:>7}')
+    return '\n'.join(lines)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--json', help='write every form and its result here'); ap.add_argument('--family', nargs='+', choices=list(FAMILIES))
+    ap.add_argument('--detail', action='store_true', help='also list every form that is not lifted, with Remill\'s reason')
+    a = ap.parse_args(argv)
+    if not AS or not os.environ.get('REMILL_BUILD'): sys.exit('[RED] lift_coverage: needs aarch64-linux-gnu-as and REMILL_BUILD')
+    res = measure(a.family or list(FAMILIES))
+    print(table(res))
+    if a.detail:
+        for name, rows in res.items():
+            for l, st, why in rows:
+                if st != 'lifted': print(f'  {name}: {l:<34} {st:<8} {why}')
+    if a.json: Path(a.json).write_text(json.dumps({n: [dict(asm=l, result=s, reason=w) for l, s, w in r] for n, r in res.items()}, indent=1) + '\n')
+    return 0
+
+
+if __name__ == '__main__': sys.exit(main())
