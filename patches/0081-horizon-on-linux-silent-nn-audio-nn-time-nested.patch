+        t0 = rel[-1][0]
+        return f'thread {tid} waits on mutex {mutex:#x} key {key:#x}; last svcs on them:\n' + '\n'.join(f'    {e[0] - t0:+8.3f} s thread {e[1]} {e[2]}({e[3]:#x}, {e[4]:#x}, {e[5]:#x}, {e[6]:#x})' for e in rel[-last:])
+
     def note(self, msg):
