-import os, time
+"""Input for the Linux host (NX2Linux S7bis, issue 21): the keyboard, gamepad and mouse events of the window become what the game reads from nn::hid (horizon_hid.py): buttons, sticks and one touch.
+Keys: X A, Z B, C X, V Y, arrows and Return (Plus), Backspace (Minus), A / S the shoulders, Q / W the triggers. NX2LINUX_KEYS_STICKS=1 makes the arrows the left stick and I J K L the right stick instead of the D-pad.
+A gamepad uses the physical layout (SDL's east button is Switch A). Its sticks and triggers are read: the sticks with a radial dead zone (NX2LINUX_DEADZONE in percent, 15 by default), the triggers are ZL and ZR above half way. The events carry no gamepad number, so with two gamepads their presses and axes are mixed (the log names the first one seen).
+The left mouse button is a finger on the touch screen, the window is mapped to 1280 by 720.
+A press shorter than the time between two reads of the game used to be lost. Now a button that is released before the game has read it stays visible until it has been read once and for at least NX2LINUX_MIN_HOLD milliseconds (50 by default, 0 gives the old behaviour), and never longer than NX2LINUX_MAX_HOLD milliseconds (500) in case the game does not read.
+NX2LINUX_PRESS=A@45:0.3,Plus@60 presses a button at a time in seconds (for how long, 0.2 s by default) without a person: how a title screen is passed in a test run."""
+import math, os, threading, time
 
 import horizon_hid
 
@@ -9,6 +12,12 @@ BUTTONS = {n: 1 << i for i, n in enumerate(('A', 'B', 'X', 'Y', 'StickL', 'Stick
 KEYS = {ord('x'): 'A', ord('z'): 'B', ord('c'): 'X', ord('v'): 'Y', ord('a'): 'L', ord('s'): 'R', ord('q'): 'ZL', ord('w'): 'ZR', 0x0D: 'Plus', 0x08: 'Minus', 0x20: 'A', 0x1B: 'B',
         0x4000004F: 'Right', 0x40000050: 'Left', 0x40000051: 'Down', 0x40000052: 'Up'}
 GAMEPAD = {0: 'B', 1: 'A', 2: 'Y', 3: 'X', 4: 'Minus', 6: 'Plus', 7: 'StickL', 8: 'StickR', 9: 'L', 10: 'R', 11: 'Up', 12: 'Down', 13: 'Left', 14: 'Right'}   # SDL_GamepadButton
+ARROWS = {0x4000004F: (1, 0), 0x40000050: (-1, 0), 0x40000051: (0, -1), 0x40000052: (0, 1)}   # SDL keys right, left, down, up -> left stick (x, y with y up)
+IJKL = {ord('l'): (1, 0), ord('j'): (-1, 0), ord('k'): (0, -1), ord('i'): (0, 1)}
+AXIS_LX, AXIS_LY, AXIS_RX, AXIS_RY, AXIS_ZL, AXIS_ZR = range(6)   # SDL_GamepadAxis
+STICK_MAX = 32767
+TRIGGER_ON, TRIGGER_OFF = 16384, 8192   # a trigger counts as pressed above half way and as released under a quarter
+SCREEN = (1280, 720)   # the Switch screen, what touch positions are in
 
 
 def script():
@@ -21,26 +30,188 @@ def script():
     return out
 
 
+def number(environ, name, default):
+    try: return float(environ[name])
+    except (KeyError, ValueError): return default
+
+
+def radial(x, y, dead):
+    """A stick position (raw SDL axes, y down) as the Switch reads it: dead zone cut, the rest rescaled to the full range, y up"""
+    m = math.hypot(x, y) / STICK_MAX
+    if m <= dead: return 0, 0
+    k = min(1.0, (m - dead) / (1.0 - dead)) / m
+    return max(-STICK_MAX, min(STICK_MAX, round(x * k))), max(-STICK_MAX, min(STICK_MAX, round(-y * k)))
+
+
+class Touch:
+    """One finger. A sample says Start once, then the position while it is down, then End once, then nothing, so a tap shorter than the time between two reads still gives Start and End"""
+    START, END = 1, 2
+
+    def __init__(self, now, max_hold):
+        self.now, self.max_hold = now, max_hold
+        self.down, self.x, self.y, self.fid, self.start_pending, self.end_pending, self.t = False, 0, 0, 0, False, False, 0.0
+        self.taps, self.lost = 0, 0
+
+    def press(self, x, y):
+        self.down, self.x, self.y, self.fid, self.start_pending, self.end_pending, self.t = True, x, y, self.fid + 1, True, False, self.now(); self.taps += 1
+
+    def move(self, x, y):
+        if self.down: self.x, self.y = x, y
+
+    def release(self):
+        if self.down: self.down, self.end_pending, self.t = False, True, self.now()
+
+    def sample(self):
+        """[(finger id, x, y, attributes)]"""
+        if not self.down and (self.start_pending or self.end_pending) and self.now() - self.t > self.max_hold:   # nobody read it: drop it, it would be old news
+            self.start_pending = self.end_pending = False; self.lost += 1
+        if self.down:
+            attrs, self.start_pending = (self.START if self.start_pending else 0), False
+            return [(self.fid, self.x, self.y, attrs)]
+        if self.end_pending:
+            if self.start_pending: self.start_pending = False; return [(self.fid, self.x, self.y, self.START)]   # a tap nobody has seen yet: Start now, End on the next read
+            self.end_pending = False; return [(self.fid, self.x, self.y, self.END)]
+        return []
+
+
 class Input:
-    def __init__(self, hz, now=time.monotonic):
-        self.hz, self.now, self.t0, self.held, self.script = hz, now, now(), 0, script()
+    def __init__(self, hz, now=time.monotonic, environ=None):
+        env = os.environ if environ is None else environ
+        self.hz, self.now, self.t0, self.script = hz, now, now(), script()
+        self.min_hold, self.max_hold = max(0.0, number(env, 'NX2LINUX_MIN_HOLD', 50.0)) / 1000, max(0.0, number(env, 'NX2LINUX_MAX_HOLD', 500.0)) / 1000
+        self.dead = min(0.9, max(0.0, number(env, 'NX2LINUX_DEADZONE', 15.0) / 100))
+        self.keys_sticks = env.get('NX2LINUX_KEYS_STICKS', '') not in ('', '0')
+        self.lock = threading.RLock()
+        self.down = {}        # bit -> the sources holding it (keys, buttons)
+        self.entries = {}     # bit -> [pressed at, read by the game since, released at or None]: what the game sees
+        self.axes, self.key_stick, self.pad = [0] * 6, {}, None
+        self.win = SCREEN     # window size in window units, from the resize events
+        self.touch = Touch(now, self.max_hold)
+        self.stats = {'reads': 0, 'presses': 0, 'kept': 0, 'merged': 0, 'never_read': 0, 'key': 0, 'pad': 0, 'axis': 0, 'mouse': 0}
+        horizon_hid.state(hz).source = self
+
+    # ---- what the game reads ----
+    def sample(self):
+        """(buttons, sticks) for one read of the game. A button released before any read is shown now and not again"""
+        with self.lock:
+            self.stats['reads'] += 1
+            return self.view(True), self.sticks()
+
+    def touches(self):
+        with self.lock: return self.touch.sample()
+
+    def view(self, read):
+        now = self.now(); mask = 0
+        for bit in list(self.entries):
+            e = self.entries[bit]
+            if e[2] is not None:
+                age = now - e[0]
+                if (e[1] and age >= self.min_hold) or age >= self.max_hold:
+                    if not e[1]: self.stats['never_read'] += 1
+                    del self.entries[bit]; continue
+            mask |= bit
+            if read: e[1] = True
+        t = now - self.t0
+        for bit, a, b in self.script:
+            if a <= t < b: mask |= bit
+        return mask
+
+    def sticks(self):
+        lx, ly = radial(self.axes[AXIS_LX], self.axes[AXIS_LY], self.dead); rx, ry = radial(self.axes[AXIS_RX], self.axes[AXIS_RY], self.dead)
+        if not (lx or ly or rx or ry) and self.key_stick:   # the keyboard stands in only when the gamepad's sticks are at rest
+            lx, ly, rx, ry = self.key_sticks()
+        return lx, ly, rx, ry
+
+    def key_sticks(self):
+        def axis(table):
+            x = sum(v[0] for k, v in table.items() if self.key_stick.get(k)); y = sum(v[1] for k, v in table.items() if self.key_stick.get(k))
+            x, y = max(-1, min(1, x)), max(-1, min(1, y)); s = 0.7071 if x and y else 1.0
+            return round(x * s * STICK_MAX), round(y * s * STICK_MAX)
+        return (*axis(ARROWS), *axis(IJKL))
+
+    # ---- what the window says ----
+    def press(self, bit, src):
+        holders = self.down.setdefault(bit, set())
+        if src in holders: return   # a key repeating
+        holders.add(src)
+        e = self.entries.get(bit)
+        if e is not None and e[2] is None: return   # already down through another source
+        if e is not None and not e[1]: self.stats['merged'] += 1   # a second press before the game read the first: one for the game
+        self.entries[bit] = [self.now(), False, None]; self.stats['presses'] += 1
+
+    def release(self, bit, src):
+        holders = self.down.get(bit, set()); holders.discard(src)
+        e = self.entries.get(bit)
+        if holders or e is None or e[2] is not None: return   # another source still holds it
+        now = self.now()
+        if self.min_hold <= 0 or (e[1] and now - e[0] >= self.min_hold): del self.entries[bit]
+        else: e[2] = now; self.stats['kept'] += 1   # released before the game read it, or too fast: it stays until it has been read
 
     def event(self, ev):
         """One window event: (name, key, ...)"""
         name, key = ev[0], ev[1]
-        bit = BUTTONS.get(KEYS.get(key)) if name.startswith('key') else BUTTONS.get(GAMEPAD.get(key)) if name.startswith('pad') and name not in ('pad_added', 'pad_removed', 'pad_axis') else None
-        if not bit: return
+        with self.lock:
+            if name.startswith('key'): self.stats['key'] += 1; self.key_event(name, key)
+            elif name in ('pad_down', 'pad_up'): self.stats['pad'] += 1; self.pad_button(name.endswith('down'), key)
+            elif name == 'pad_axis': self.stats['axis'] += 1; self.pad_axis(key, ev[2])
+            elif name == 'pad_added': self.pad_added(key)
+            elif name == 'pad_removed': self.pad_removed(key)
+            elif name == 'resize' and ev[2] > 0 and ev[3] > 0: self.win = (ev[2], ev[3])
+            elif name.startswith('mouse'): self.stats['mouse'] += 1; self.mouse(name, key, ev[2], ev[3])
+            self.apply()
+
+    def key_event(self, name, key):
         down = name.endswith('down')
-        self.held = self.held | bit if down else self.held & ~bit
-        self.apply()
+        if self.keys_sticks and (key in ARROWS or key in IJKL): self.key_stick[key] = down; return
+        bit = BUTTONS.get(KEYS.get(key))
+        if bit: (self.press if down else self.release)(bit, ('key', key))
+
+    def pad_button(self, down, button):
+        bit = BUTTONS.get(GAMEPAD.get(button))
+        if bit: (self.press if down else self.release)(bit, ('pad', button))
+
+    def pad_axis(self, axis, value):
+        if axis < AXIS_ZL:
+            self.axes[axis] = value
+            return
+        if axis != AXIS_ZL and axis != AXIS_ZR: return
+        bit = BUTTONS['ZL' if axis == AXIS_ZL else 'ZR']; held = ('pad', 'axis', axis) in self.down.get(bit, set())
+        if value >= TRIGGER_ON and not held: self.press(bit, ('pad', 'axis', axis))
+        elif value < TRIGGER_OFF and held: self.release(bit, ('pad', 'axis', axis))
+
+    def pad_added(self, pad_id):
+        if self.pad is None:
+            self.pad = pad_id; self.say(f'[input] gamepad {pad_id} connected')
+        else: self.say(f'[input] gamepad {pad_id} connected as well as {self.pad}: their events are mixed')
+
+    def pad_removed(self, pad_id):
+        if pad_id != self.pad: return
+        self.pad, self.axes = None, [0] * 6
+        for bit, holders in list(self.down.items()):
+            for src in [s for s in holders if s[0] == 'pad']: self.release(bit, src)
+        self.say(f'[input] gamepad {pad_id} removed')
+
+    def mouse(self, name, x, y, button):
+        tx, ty = x * SCREEN[0] // max(1, self.win[0]), y * SCREEN[1] // max(1, self.win[1])
+        tx, ty = max(0, min(SCREEN[0] - 1, tx)), max(0, min(SCREEN[1] - 1, ty))
+        if name == 'mouse_down' and button == 1: self.touch.press(tx, ty)
+        elif name == 'mouse_up' and button == 1: self.touch.release()
+        elif name == 'mouse_move': self.touch.move(tx, ty)
+
+    def say(self, msg):
+        log = getattr(self.hz, 'log', None)
+        if log: log(msg)
 
     def poll(self):
         """Applies the scripted presses that are on now"""
         if self.script: self.apply()
 
     def apply(self):
-        t = self.now() - self.t0
-        scripted = 0
-        for bit, a, b in self.script:
-            if a <= t < b: scripted |= bit
-        horizon_hid.state(self.hz).buttons = self.held | scripted
+        """Keeps the buttons and sticks of HidState up to date for whoever looks at them. The game's own reads go through sample()"""
+        s = horizon_hid.state(self.hz)
+        s.buttons, s.sticks = self.view(False), self.sticks()
+
+    def report(self):
+        s = self.stats
+        return (f"input: {s['reads']} reads by the game, {s['presses']} presses, {s['kept']} kept until read, {s['merged']} merged, {s['never_read']} never read, {self.touch.taps} touches ({self.touch.lost} never read) | "
+                f"events: {s['key']} key, {s['pad']} gamepad button, {s['axis']} gamepad axis, {s['mouse']} mouse | gamepad {self.pad if self.pad is not None else 'none seen'}")
