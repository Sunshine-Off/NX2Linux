+"""validate_game.py (NX2Linux Phase 2, #15): the table and the verdict from the files module_validate.py leaves, the steps it would run, what it refuses, and on a synthetic module the whole run next to Unicorn and
+the resume. No game data. The table and the plan need nothing: the whole run needs REMILL_BUILD, clang++, unicorn and capstone, and is skipped otherwise."""
+import contextlib, io, json, os, subprocess, sys, tempfile, unittest
+from pathlib import Path
+from unittest import mock
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import validate_game as vg
+
+TOOL = HERE.parent / 'validate_game.py'
+try:
+    import capstone  # noqa: F401
+    from test_aot_t3 import READY
+except ImportError: capstone, READY = None, False
+READY = bool(READY and capstone)
+
+
+def row(fn, status, **counts): return dict(function=fn, status=status, cases=sum(counts.values()), detail='', counts=counts)
+
+
+def write(work, sub, module, rows):
+    d = Path(work) / sub; d.mkdir(parents=True, exist_ok=True); (d / f'{module}.diff.json').write_text(json.dumps(rows))
+
+
+def args(**kw):
+    import argparse
+    return argparse.Namespace(**dict(dict(exefs='/x/ExeFS', functions=200, cases=12, seeds=[1], coverage_sample=3000, jit=False), **kw))
+
+
+class Table(unittest.TestCase):
+    def test_equal_functions_with_cases_behind_them_are_a_pass(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'main', [row('0x1', 'equal', equal=10, **{'both-fault': 2}), row('0x2', 'equal', equal=12), row('0x3', 'inconclusive', **{'both-fault': 12})])
+            write(d, 'switches.seed1', 'main', [row('0x4', 'equal', equal=12, **{'table-jumps': 30})])
+            table, ok = vg.summarize(d, ['main'])
+        self.assertTrue(ok); self.assertIn('| main | 4 | 3 | 0 | 1 |', table); self.assertIn('3 functions identical to Unicorn over 34 cases, 0 cases that differ', table)
+
+    def test_every_way_to_not_pass_is_not_a_pass_and_is_listed(self):
+        for status, extra in (('mismatch', dict(equal=3)), ('timeout', {}), ('worker-died', {})):
+            with self.subTest(status), tempfile.TemporaryDirectory() as d:
+                bad = row('0xdead', status, **extra); bad['detail'] = 'inputs {x0: 5}: differs in [x1]'
+                write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=12), bad])
+                table, ok = vg.summarize(d, ['m'])
+                self.assertFalse(ok); self.assertIn('Not a pass', table); self.assertIn(f'm plain.seed1 0xdead: {status}', table)
+
+    def test_cases_that_differ_fail_even_when_the_function_status_says_equal(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=11, **{'fault-differs': 1})])
+            self.assertFalse(vg.summarize(d, ['m'])[1])
+
+    def test_a_table_of_nothing_compared_is_not_a_pass(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'inconclusive', **{'both-fault': 12}), row('0x2', 'unliftable')])
+            table, ok = vg.summarize(d, ['m'])
+        self.assertFalse(ok); self.assertIn('no case was compared', table)
+
+    def test_a_module_with_no_result_and_an_unreadable_file_fail(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'a', [row('0x1', 'equal', equal=5)])
+            self.assertFalse(vg.summarize(d, ['a', 'b'])[1]); self.assertIn('no diff result', vg.summarize(d, ['a', 'b'])[0])
+            (Path(d) / 'plain.seed1' / 'a.diff.json').write_text('{nope')
+            self.assertFalse(vg.summarize(d, ['a'])[1])
+
+    def test_coverage_and_census_are_added_when_the_files_are_there(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=5)])
+            (Path(d) / 'm.coverage.json').write_text(json.dumps(dict(functions=200, lift=190, unliftable={'0x1': 'x'} | {hex(i): 'y' for i in range(2, 11)})))
+            (Path(d) / 'm.census.json').write_text(json.dumps({'ldxp': dict(count=18, classes=2, example='ldxp x0, x1, [x2]'), 'cls': dict(count=40, classes=1, example='cls x0, x1')}))
+            table, _ = vg.summarize(d, ['m'])
+        self.assertIn('m: 190 of 200 functions lift (95.0%), 10 do not', table); self.assertIn('cls 40, ldxp 18', table)
+
+
+class Plan(unittest.TestCase):
+    def run_main(self, *argv):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out): code = vg.main(list(argv))
+        return code, out.getvalue()
+
+    def test_the_steps_are_in_the_order_of_the_docstring_for_every_module_and_seed(self):
+        labels = [s[0] for s in vg.steps(['main', 'sdk'], args(seeds=[1, 2], jit=True))]
+        self.assertEqual(labels[0], 'main: coverage')
+        self.assertEqual(labels[1:4], ['main: diff plain, seed 1', 'main: diff switches, seed 1', 'main: diff of the functions run by the JIT, seed 1'])
+        self.assertEqual(len([l for l in labels if 'diff' in l]), 2 * 2 * 3); self.assertTrue(labels[-1].startswith('census of main,sdk'))
+        self.assertFalse(any('JIT' in s[0] for s in vg.steps(['main'], args(jit=False))))
+
+    def test_the_jit_step_asks_for_the_unliftable_functions_and_the_fallback(self):
+        (step,) = [s for s in vg.steps(['main'], args(jit=True)) if 'JIT' in s[0]]
+        self.assertIn('--only-unliftable', step[2]); self.assertIn('--jit', step[2])
+
+    def test_a_dry_run_prints_what_it_would_do_and_needs_neither_the_game_nor_remill(self):
+        with tempfile.TemporaryDirectory() as d, mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop('REMILL_BUILD', None)
+            code, out = self.run_main('/nonexistent/ExeFS', d, 'main,sdk,subsdk0', '--seeds', '1,2', '--dry-run')
+        self.assertEqual(code, 0); self.assertEqual(out.count('would run:'), 3 * (1 + 2 * 2) + 1); self.assertIn('--switches', out)
+
+    def test_it_refuses_a_work_folder_inside_a_repository_a_missing_exefs_and_a_missing_toolchain(self):
+        with tempfile.TemporaryDirectory() as d:
+            (Path(d) / 'repo' / '.git').mkdir(parents=True)
+            for argv, why in ((['/x', str(Path(d) / 'repo' / 'work'), 'm'], 'inside a git repository'), (['/nonexistent', str(Path(d) / 'w'), 'm'], 'not a folder')):
+                with self.subTest(why), self.assertRaises(SystemExit) as cm: self.run_main(*argv)
+                self.assertIn(why, str(cm.exception))
+            ex = Path(d) / 'ExeFS'; ex.mkdir()
+            with self.assertRaises(SystemExit) as cm: self.run_main(str(ex), str(Path(d) / 'w'), 'main')
+            self.assertIn('no module file main', str(cm.exception))
+            (ex / 'main').write_bytes(b'')
+            with mock.patch.dict(os.environ, {}, clear=False):
+                os.environ.pop('REMILL_BUILD', None)
+                with self.assertRaises(SystemExit) as cm: self.run_main(str(ex), str(Path(d) / 'w'), 'main')
+                self.assertIn('REMILL_BUILD', str(cm.exception))
+                os.environ['REMILL_BUILD'] = d; os.environ.pop('DYNARMIC_DIR', None)
+                with self.assertRaises(SystemExit) as cm: self.run_main(str(ex), str(Path(d) / 'w'), 'main', '--jit')
+                self.assertIn('DYNARMIC_DIR', str(cm.exception))
+
+    def test_bad_seeds_are_an_argument_error(self):
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit): self.run_main('/x', '/tmp/w', 'm', '--seeds', 'a,b', '--dry-run')
+
+    def test_the_summary_mode_reads_a_work_folder_and_writes_the_markdown(self):
+        with tempfile.TemporaryDirectory() as d:
+            write(d, 'plain.seed1', 'm', [row('0x1', 'equal', equal=5)])
+            code, out = self.run_main('--summary', d, 'm', '--md', str(Path(d) / 't.md'))
+            self.assertEqual(code, 0); self.assertEqual((Path(d) / 't.md').read_text(), out.rstrip('\n') + '\n'); self.assertIn('| m | 1 | 1 |', out)
+
+
+@unittest.skipUnless(READY, 'needs REMILL_BUILD, clang++, unicorn and capstone')
+class WholeRun(unittest.TestCase):
+    def test_a_synthetic_module_goes_through_every_step_then_resumes(self):
+        import module_fixture as mf
+        with tempfile.TemporaryDirectory() as d:
+            ex, work = Path(d) / 'ExeFS', Path(d) / 'work'; ex.mkdir()
+            (ex / 'a').write_bytes(mf.build(mf.module_a())[0])
+            cmd = [sys.executable, '-I', str(TOOL), str(ex), str(work), 'a', '--functions', '10', '--cases', '6', '--seeds', '1,2', '--coverage-sample', '0', '--jobs', '2', '--md', str(Path(d) / 't.md')]
+            env = dict(os.environ)
+            p = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=900)
+            self.assertEqual(p.returncode, 0, p.stdout[-1500:] + p.stderr[-800:])
+            self.assertIn('a: 10 of 10 functions lift (100.0%), 0 do not', p.stdout)
+            self.assertRegex(p.stdout, r'\| a \| \d+ \| \d+ \| 0 \| \d+ \| 0 \| 0 \| [1-9]\d* \|')   # no mismatch, no timeout, and cases behind the "equal"
+            for sub in ('plain.seed1', 'plain.seed2', 'switches.seed1', 'switches.seed2'): self.assertTrue((work / sub / 'a.diff.json').is_file(), sub)
+            self.assertTrue((work / 'a.census.json').is_file()); self.assertTrue((Path(d) / 't.md').read_text().startswith('| module |'))
+            again = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=900)
+            self.assertEqual(again.returncode, 0); self.assertGreaterEqual(again.stdout.count('[skip]'), 6); self.assertEqual(again.stdout.count('[run]'), 0)
+
+
+if __name__ == '__main__': unittest.main()
