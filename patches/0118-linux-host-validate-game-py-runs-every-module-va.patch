+#!/usr/bin/env python3
+"""Runs the whole of module_validate.py on a game's modules and puts the result in one table (NX2Linux Phase 2, #15: the Xenoblade 2 modules against Unicorn, as Balatro's were). Nothing of the game is stored
+or printed beyond addresses, counts and mnemonics, and the work folder holds code derived from the game, so it stays outside the repository (the tool refuses a folder inside one).
+For each module, in this order (a step whose result file is already in the work folder is not run again, unless --force):
+  coverage          how much of the module Remill lifts (a sample of the functions with --coverage-sample, all of them with 0)
+  census            every instruction class Remill does not lift, with its count (all modules together, once)
+  diff              leaf functions next to the Unicorn ARM64 core: registers, NZCV and memory must be identical
+  diff --switches   functions with a jump table, the same comparison (the `br` of the table is allowed)
+  diff --only-unliftable --jit   with --jit: the functions Remill cannot lift, run in the dynarmic fallback next to Unicorn (needs the coverage of the module and DYNARMIC_DIR)
+Each diff step runs once per seed: --seeds 1,2,3 tests different functions and different inputs, and the table adds them up.
+Usage: validate_game.py <ExeFS dir> <work dir> <module>[,<module>...] [--functions N] [--cases K] [--seeds 1,2] [--coverage-sample N] [--jobs J] [--jit] [--force] [--dry-run] [--md FILE]
+       validate_game.py --summary <work dir> <module>[,<module>...] [--md FILE]      only the table, from what the work folder holds
+Exit status: 0 when no function differs from Unicorn and nothing timed out or died, else 1. A table of "equal" with no case behind it is not a pass: the cases are counted."""
+import argparse, collections, json, os, subprocess, sys, time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+BAD = ('mismatch', 'timeout', 'worker-died')
+
+
+def steps(modules, a):
+    """[(label, file that proves it was done, argv of module_validate.py, folder it works in)]"""
+    out = []
+    for m in modules:
+        out.append((f'{m}: coverage', f'{m}.coverage.json', ['coverage', str(a.exefs), None, m] + (['--sample', str(a.coverage_sample)] if a.coverage_sample else []), '.'))
+        for seed in a.seeds:
+            for kind, extra in (('plain', []), ('switches', ['--switches'])):
+                out.append((f'{m}: diff {kind}, seed {seed}', f'{kind}.seed{seed}/{m}.diff.json', ['diff', str(a.exefs), None, m, '--functions', str(a.functions), '--cases', str(a.cases), '--seed', str(seed)] + extra, f'{kind}.seed{seed}'))
+            if a.jit: out.append((f'{m}: diff of the functions run by the JIT, seed {seed}', f'jit.seed{seed}/{m}.diff.json', ['diff', str(a.exefs), None, m, '--functions', str(a.functions), '--cases', str(a.cases),
+                                  '--seed', str(seed), '--only-unliftable', '--jit'], f'jit.seed{seed}'))
+    out.append((f'census of {",".join(modules)}', f'{"+".join(modules)}.census.json', ['census', str(a.exefs), None, ','.join(modules)], '.'))
+    return out
+
+
+def run_step(argv, work, sub, a):
+    import module_validate as mv
+    folder = Path(work) / sub
+    folder.mkdir(parents=True, exist_ok=True)
+    if argv[0] == 'diff' and sub != '.':   # a diff pass keeps the module's coverage (for --only-unliftable) and its converted module one folder up
+        for name in Path(work).glob('*.manifest.json'): _link(name, folder / name.name)
+        for name in Path(work).glob('*.elf'): _link(name, folder / name.name)
+        for name in Path(work).glob('*.coverage.json'): _link(name, folder / name.name)
+    cmd = [mv.worker_python(), '-I', str(HERE / 'module_validate.py')] + [str(folder) if x is None else x for x in argv] + ['--jobs', str(a.jobs)]
+    return subprocess.run(cmd, capture_output=True, text=True, env=dict(os.environ, PYTHONPATH=f'{HERE}:{HERE / "tests"}'))
+
+
+def _link(src, dst):
+    if not dst.exists(): dst.symlink_to(src.resolve())
+
+
+def summarize(work, modules):
+    """(markdown, ok): the table of everything the work folder holds"""
+    work = Path(work)
+    lines, ok, grand = [], True, collections.Counter()
+    lines.append('| module | functions tested | equal | mismatch | inconclusive | unliftable | timeout, died | cases equal | both fault | budget | fault differs | MISMATCH cases | jump-table jumps |')
+    lines.append('|---|---|---|---|---|---|---|---|---|---|---|---|---|')
+    details = []
+    for m in modules:
+        files = sorted(work.glob(f'*/{m}.diff.json')) + sorted(work.glob(f'{m}.diff.json'))
+        st, cases = collections.Counter(), collections.Counter()
+        for f in files:
+            try: rows = json.loads(f.read_text())
+            except (OSError, ValueError): st['unreadable file'] += 1; continue
+            for r in rows:
+                st[r.get('status', '?')] += 1
+                for k, v in r.get('counts', {}).items(): cases[k] += v
+                if r.get('status') in BAD: details.append(f'{m} {f.parent.name} {r.get("function")}: {r.get("status")} {r.get("detail", "")[:300]}')
+        if not files: lines.append(f'| {m} | no diff result in the work folder | | | | | | | | | | | |'); ok = False; continue
+        bad = sum(st[k] for k in BAD) + st['unreadable file']
+        ok = ok and not bad and not cases['MISMATCH'] and not cases['fault-differs']
+        lines.append(f"| {m} | {sum(st.values())} | {st['equal']} | {st['mismatch']} | {st['inconclusive']} | {st['unliftable']} | {st['timeout'] + st['worker-died']} | {cases['equal']} | {cases['both-fault']} | "
+                     f"{cases['budget']} | {cases['fault-differs']} | {cases['MISMATCH']} | {cases['table-jumps']} |")
+        grand.update({'functions': sum(st.values()), 'equal': st['equal'], 'cases': cases['equal'], 'mismatch': cases['MISMATCH'] + cases['fault-differs']})
+    lines.append('')
+    if ok and not grand['cases']: ok = False; why = 'no case was compared.'
+    else: why = 'a difference, a timeout, a dead worker or a missing result is listed above or below.'
+    lines.append(f"**{grand['equal']} functions identical to Unicorn over {grand['cases']} cases, {grand['mismatch']} cases that differ.**" if ok else '**Not a pass:** ' + why)
+    for d in details: lines.append(f'- {d}')
+    cov = []
+    for m in modules:
+        f = work / f'{m}.coverage.json'
+        if f.exists():
+            try: c = json.loads(f.read_text()); cov.append(f"{m}: {c['lift']} of {c['functions']} functions lift ({100 * c['lift'] / max(1, c['functions']):.1f}%), {len(c['unliftable'])} do not")
+            except (ValueError, KeyError): pass
+    if cov: lines += ['', 'Coverage: ' + '; '.join(cov)]
+    cen = work / f'{"+".join(modules)}.census.json'
+    if cen.exists():
+        try:
+            c = json.loads(cen.read_text())
+            lines += ['', 'Instruction classes Remill does not lift (all modules, by instructions): ' + ', '.join(f"{k} {v['count']}" for k, v in sorted(c.items(), key=lambda kv: -kv[1]['count'])[:15])]
+        except (ValueError, KeyError): pass
+    return '\n'.join(lines) + '\n', ok
+
+
+def inside_repository(path):
+    p = Path(path).resolve()
+    return any((q / '.git').exists() for q in [p, *p.parents])
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0], formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--summary', action='store_true'); ap.add_argument('paths', nargs='+')
+    ap.add_argument('--functions', type=int, default=200); ap.add_argument('--cases', type=int, default=12); ap.add_argument('--seeds', default='1')
+    ap.add_argument('--coverage-sample', type=int, default=3000, help='functions per module for the coverage step (0: all of them, slow on a big module)')
+    ap.add_argument('--jobs', type=int, default=max(1, (os.cpu_count() or 2) - 2)); ap.add_argument('--jit', action='store_true')
+    ap.add_argument('--force', action='store_true'); ap.add_argument('--dry-run', action='store_true'); ap.add_argument('--md', help='also write the table here')
+    a = ap.parse_args(argv)
+    if a.summary:
+        if len(a.paths) != 2: ap.error('--summary takes <work dir> <modules>')
+        work, mods = a.paths[0], a.paths[1].split(',')
+    else:
+        if len(a.paths) != 3: ap.error('give <ExeFS dir> <work dir> <modules>')
+        a.exefs, work, mods = a.paths[0], a.paths[1], a.paths[2].split(',')
+    try: a.seeds = [int(s) for s in str(a.seeds).split(',')]
+    except ValueError: ap.error('--seeds is a list of integers, for example 1,2,3')
+    if not a.summary:
+        if inside_repository(work): sys.exit(f'[RED] {work} is inside a git repository: the work folder holds code derived from the game, give a folder outside it')
+        if not a.dry_run and not Path(a.exefs).is_dir(): sys.exit(f'[RED] {a.exefs} is not a folder (the ExeFS that `nx2linux extract` writes)')
+        missing = [m for m in mods if not (Path(a.exefs) / m).is_file()]
+        if missing and not a.dry_run: sys.exit(f'[RED] no module file {", ".join(missing)} in {a.exefs}')
+        if a.jit and not a.dry_run and not os.environ.get('DYNARMIC_DIR'): sys.exit('[RED] --jit needs DYNARMIC_DIR (source <toolchain>/env.sh)')
+        if not a.dry_run and not os.environ.get('REMILL_BUILD'): sys.exit('[RED] needs REMILL_BUILD (source <toolchain>/env.sh)')
+        for label, proof, argv_, sub in steps(mods, a):
+            if a.dry_run: print(f'would run: {label}:  module_validate.py ' + ' '.join('<work>' if x is None else x for x in argv_)); continue
+            if (Path(work) / proof).exists() and not a.force: print(f'[skip] {label}: {proof} is there', flush=True); continue
+            t = time.time(); print(f'[run] {label} ...', flush=True)
+            r = run_step(argv_, work, sub, a)
+            (Path(work) / 'validate.log').open('a').write(f'== {label}\n{r.stdout[-4000:]}\n{r.stderr[-1500:]}\n')
+            print(f'[done] {label}: exit {r.returncode}, {time.time() - t:.0f} s', flush=True)
+        if a.dry_run: return 0
+    table, ok = summarize(work, mods)
+    print(table)
+    if a.md: Path(a.md).write_text(table)
+    return 0 if ok else 1
+
+
+if __name__ == '__main__': sys.exit(main())
