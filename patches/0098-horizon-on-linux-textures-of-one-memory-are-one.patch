+def _half(h):
+    e, m = h >> 10 & 31, h & 1023
+    v = (m / 1024 if e == 0 else (1 + m / 1024) * 2.0 ** (e - 15)) * (1 if h < 32768 else -1)
+    return 65504.0 if e == 31 else v
+
+
+def _ufloat(v, mant_bits):
+    e, m = v >> mant_bits, v & ((1 << mant_bits) - 1)
+    return m / (1 << mant_bits) * 2.0 ** -14 if e == 0 else (1 + m / (1 << mant_bits)) * 2.0 ** (e - 15) if e < 31 else 65504.0
+
+
+def png_pixels(fmt, px, w, h):
+    """The RGBA8 bytes of a render target of NVN format fmt for a PNG (what a person can look at: floating-point values are clamped to 0..1), or None for a format not shown"""
+    import struct
+    c8 = lambda x: int(max(0.0, min(1.0, x)) * 255 + 0.5)
+    n = w * h
+    if fmt in (0x25, 0x37, 0x6D): return bytes(px[:4 * n])
+    if fmt == 0x3F:
+        out = bytearray()
+        for (v,) in struct.iter_unpack('<I', px[:4 * n]): out += bytes((c8(_ufloat(v & 0x7FF, 6)), c8(_ufloat(v >> 11 & 0x7FF, 6)), c8(_ufloat(v >> 22, 5)), 255))
+        return bytes(out)
+    if fmt == 0x3D:
+        out = bytearray()
+        for (v,) in struct.iter_unpack('<I', px[:4 * n]): out += bytes(((v & 1023) * 255 // 1023, (v >> 10 & 1023) * 255 // 1023, (v >> 20 & 1023) * 255 // 1023, 255))
+        return bytes(out)
+    if fmt == 0x29:
+        out = bytearray()
+        for r, g, b, a in struct.iter_unpack('<4H', px[:8 * n]): out += bytes((c8(_half(r)), c8(_half(g)), c8(_half(b)), 255))
+        return bytes(out)
+    if fmt == 0x0A:
+        out = bytearray()
+        for (v,) in struct.iter_unpack('<f', px[:4 * n]): g = c8(v if v == v else 0.0); out += bytes((g, g, g, 255))
+        return bytes(out)
+    return None
+
