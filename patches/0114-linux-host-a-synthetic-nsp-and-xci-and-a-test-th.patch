+    def test_a_damaged_byte_fails_the_hash_check_unless_allowed(self):
+        pkg = self.pkg['nsp']; blob = bytearray(pkg.path.read_bytes())
+        at = blob.find(pkg.romfs['Data/table.bin'][:64]); self.assertGreater(at, 0)
+        # a byte deep in the file, in a RomFS block after the one that holds the tables: the tables stay readable, the file does not
+        blob[at + 0x8800] ^= 0xff
+        bad = self.out('damaged.nsp'); bad.write_bytes(bytes(blob))
+        r = nx(pkg.keys, bad, '-', self.out('damaged'))
+        self.assertNotEqual(r.returncode, 0, r.stdout + r.stderr)
+        r = nx(pkg.keys, bad, '-', self.out('damaged-allowed'), '--allow-damaged')
+        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+        self.assertIn('the NSP is damaged', r.stdout)
+        self.assertEqual((self.out('damaged-allowed') / 'RomFS' / 'Data' / 'table.bin').read_bytes()[0x8800], pkg.romfs['Data/table.bin'][0x8800] ^ 0xff)
