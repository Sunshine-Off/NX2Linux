+        rows = [l.split('\t') for l in (out / 'romfs_manifest.tsv').read_text().splitlines() if l and not l.startswith('#')]
+        self.assertEqual({r[0].lstrip('/'): int(r[1]) for r in rows}, {k: len(v) for k, v in pkg.romfs.items()})
