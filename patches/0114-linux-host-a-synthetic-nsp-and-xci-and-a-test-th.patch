+    def test_image_extraction_gives_the_same_files(self):
+        for kind, pkg in self.pkg.items():
+            with self.subTest(kind):
+                out = self.out(f'image-{kind}')
+                nx(pkg.keys, pkg.path, '-', out, '--romfs-image', check=True)
+                self.assertFalse((out / 'RomFS').exists())   # the image replaces the folder
+                img = out / 'RomFS.img'
+                index = romfs_image.read_index(img)
+                blob = img.read_bytes()
+                files = {p: blob[off:off + size] for p, (is_dir, off, size) in index.items() if not is_dir}
+                self.assertEqual(files, pkg.romfs)
+                self.assertEqual({p for p, (d, _, _) in index.items() if d}, {'Data', 'Data/deep', 'Movie'})
