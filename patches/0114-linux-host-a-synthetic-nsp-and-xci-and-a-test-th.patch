+++ b/dm/tools/tests/test_nx_extract.py
@@ -0,0 +1,144 @@
+"""nx_extract on a synthetic package: an NSP and an XCI made by nsp_fixture.py (random bytes, fake keys, written to a temporary folder) are opened by LibHac like real ones. The title ID, the control data,
+ExeFS, RomFS (as a folder and as a DMROMFS1 image) come back byte for byte, the hash trees catch a damaged byte, and a wrong key, a cut-off file or a package with no meta NCA stops with a non-zero exit.
+The extracted `main` is then turned into an ELF module and manifest, the first step of the Linux chain. No game file and no real key is used or read.
+Needs dotnet and the restored LibHac package (nx_extract builds offline once it is in the NuGet cache); skipped with the reason otherwise."""
+import hashlib
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+TOOLS = HERE.parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(TOOLS))
+import nsp_fixture as fx
+import romfs_image
+
+PROJECT = TOOLS / 'nx_extract'
+SKIP = None
+if not shutil.which('dotnet'): SKIP = 'dotnet is not installed (dotnet-sdk-10.0)'
+elif not (PROJECT / 'nx_extract.csproj').is_file(): SKIP = 'nx_extract is not in the engine tree'
+
+
+def nx(*args, check=False):
+    r = subprocess.run(['dotnet', 'run', '-c', 'Release', '--no-build', '--project', str(PROJECT), '--', *map(str, args)], capture_output=True, text=True, timeout=300)
+    if check: assert r.returncode == 0, r.stdout + r.stderr
+    return r
+
+
+class Aes(unittest.TestCase):
+    """The fixture's encryptor against the published vectors, so a wrong package is never blamed on a wrong cipher"""
+    def test_fips_197(self):
+        key, plain = bytes.fromhex('000102030405060708090a0b0c0d0e0f'), bytes.fromhex('00112233445566778899aabbccddeeff')
+        self.assertEqual(fx.aes_ecb_encrypt(key, plain).hex(), '69c4e0d86a7b0430d8cdb78070b4c55a')
+
+    def test_xts_ieee_1619_vector_1(self):   # all-zero keys, sector 0, 32 zero bytes (the tweak is the sector number, big-endian: 0 for sector 0 as well)
+        self.assertEqual(fx.xts_encrypt(bytes(32), bytes(32), sector_size=32).hex(), '917cf69ebd68b2ec9b9fe9a3eadda692cd43d2f59598ed858c02c2652fbf922e')
+
+
+@unittest.skipIf(SKIP, SKIP)
+class Extraction(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        built = subprocess.run(['dotnet', 'build', '-c', 'Release', '-v', 'q', str(PROJECT)], capture_output=True, text=True, timeout=600)
+        if built.returncode != 0: raise unittest.SkipTest('nx_extract does not build here (LibHac not restored and no network?): ' + (built.stdout + built.stderr).strip().splitlines()[-1][:300])
+        cls.tmp = Path(tempfile.mkdtemp(prefix='nx2linux-fixture-')); cls.addClassCleanup(shutil.rmtree, cls.tmp, True)
+        cls.pkg = {k: fx.make(cls.tmp / k, k) for k in ('nsp', 'xci')}
+
+    def out(self, name): return self.tmp / name
+
+    def test_title_id(self):
+        for kind, pkg in self.pkg.items():
+            with self.subTest(kind):
+                r = nx(pkg.keys, '--title', pkg.path, check=True)
+                self.assertEqual(r.stdout.strip(), f'title {fx.TITLE_ID:016x}')
+
+    def test_folder_extraction_gives_the_files_back(self):
+        for kind, pkg in self.pkg.items():
+            with self.subTest(kind):
+                out = self.out(f'folder-{kind}')
+                r = nx(pkg.keys, pkg.path, '-', out, check=True)
+                self.assertIn(f'title {fx.TITLE_ID:016x}', r.stdout)
+                self.assertIn(f'display version {fx.DISPLAY_VERSION}', r.stdout)
+                self.assertIn(f'name {fx.GAME_NAME}', r.stdout)
+                self.assertEqual(sorted(p.name for p in (out / 'ExeFS').iterdir()), sorted(pkg.exefs))
+                for name, data in pkg.exefs.items(): self.assertEqual((out / 'ExeFS' / name).read_bytes(), data, name)
+                got = {str(p.relative_to(out / 'RomFS')): p.read_bytes() for p in (out / 'RomFS').rglob('*') if p.is_file()}
+                self.assertEqual(got, pkg.romfs)
+                self.assertEqual((out / 'icon.jpg').read_bytes(), pkg.icon)
+                self.assertEqual(len((out / 'control.nacp').read_bytes()), 0x4000)
+                self.assertIn(f'main build id {pkg.exefs["main"][0x40:0x50].hex()}', r.stdout)   # the NSO's build ID is the first 16 bytes of its module ID
