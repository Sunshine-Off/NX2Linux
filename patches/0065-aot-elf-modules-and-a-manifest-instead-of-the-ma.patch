+// Imports: an open-addressing table on the address, filled under a mutex and read without one (the address is published last)
+struct ImportEnt { std::atomic<uint64_t> addr; AotImportFn fn; void *ctx; char name[64]; };
+enum { IMPORT_CAP = 8192 };
+ImportEnt g_imports[IMPORT_CAP];
+std::mutex g_imports_mu;
+unsigned g_nimports;
+inline unsigned import_slot(uint64_t a) { return (unsigned)(((a >> 2) * 0x9E3779B97F4A7C15ull) >> (64 - 13)); }
+ImportEnt *import_find(uint64_t a) {
