     count(AOT_S_UNLIFTED); count(S_FALLBACK);
@@ -180,7 +227,9 @@ int aot_unmap(uint64_t base) {
     for (unsigned i = 0, n = g_nregions.load(); i < n; i++) if (g_regions[i].size && g_regions[i].base == base) { g_regions[i].size = 0; return 0; }
     return 1;
 }
+void aot_unregister_imports();
 void aot_unmap_all() {
