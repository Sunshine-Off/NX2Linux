+    g_nimports = 0;
 }
 uint8_t *aot_guest_ptr(uint64_t a, uint64_t n) {
     for (unsigned i = 0, e = g_nregions.load(std::memory_order_acquire); i < e; i++) {
@@ -149,6 +179,23 @@ Memory *__remill_async_hyper_call(State &st, uint64_t pc, Memory *m) {
 }
 Memory *__remill_missing_block(State &, uint64_t pc, Memory *) { fail("control reached %#llx, which was not lifted as code (a call returned to an unexpected address)", (unsigned long long)pc); }
 
+// A call of an import: pc is the address the guest branched to, which names the import
+Memory *import_call(State *st, uint64_t pc, Memory *m) {
+    ImportEnt *e = import_find(pc);
+    if (!e) fail("import at %#llx vanished", (unsigned long long)pc);
+    count(AOT_S_IMPORTS);
+    if (!e->fn) fail("call to the unresolved import %s (%#llx): no host function implements it", e->name, (unsigned long long)pc);
+    uint64_t regs[31];
+#define X(i) regs[i] = st->gpr.x##i.qword;
+    XREGS(X)
+#undef X
+    e->fn(regs, e->ctx);
+#define X(i) st->gpr.x##i.qword = regs[i];
+    XREGS(X)
+#undef X
+    return m;
+}
+
 // The stub of a function the translator could not lift (generated by aot_lift.py): a direct `bl` to it still links, and runs the function through the JIT, or stops with the reason
