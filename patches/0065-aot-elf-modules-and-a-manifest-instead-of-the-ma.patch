+    if (!addr || g_nimports >= IMPORT_CAP / 2 || import_find(addr)) return 1;
+    unsigned i = import_slot(addr);
+    while (g_imports[i].addr.load()) i = (i + 1) & (IMPORT_CAP - 1);
+    g_imports[i].fn = fn; g_imports[i].ctx = ctx; snprintf(g_imports[i].name, sizeof g_imports[i].name, "%s", name ? name : "?");
+    g_imports[i].addr.store(addr, std::memory_order_release); g_nimports++;
