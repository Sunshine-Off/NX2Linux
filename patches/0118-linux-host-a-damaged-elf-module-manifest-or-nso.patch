+    except SystemExit as e: raise ModuleError(str(e.code).removeprefix('[RED] ')) from None
+    m = describe(elf.read_bytes(), name, elf.name, build_id)
     man.write_text(json.dumps(m, indent=1, sort_keys=True) + '\n')
