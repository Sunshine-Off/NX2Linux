@@ -193,7 +206,12 @@ def load_manifest(path):
     path = Path(path)
     try: m = json.loads(path.read_text())
     except (OSError, ValueError) as e: raise ModuleError(f'{path}: {e}') from None
+    if not isinstance(m, dict): raise ModuleError(f'{path}: not a JSON object')
     if m.get('format') != FORMAT: raise ModuleError(f'{path}: format {m.get("format")!r}, not {FORMAT!r}')
+    for k in ('name', 'elf', 'sha256', 'build_id'):
+        if k not in m: raise ModuleError(f'{path}: lacks "{k}"')
