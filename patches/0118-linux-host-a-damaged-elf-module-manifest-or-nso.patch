+        out.append((bytes(img[st + name:end]).decode(errors='backslashreplace'), info >> 4, info & 15, shndx != 0, value, size))   # a name that is not UTF-8 keeps its bytes as \xNN: it still loads, and the same way every time
     return out
 
 
@@ -89,6 +98,7 @@ def read_relocs(img, dynamic):
     out = []
