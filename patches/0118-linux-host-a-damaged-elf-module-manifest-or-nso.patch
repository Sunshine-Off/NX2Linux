@@ -25,6 +25,8 @@ DT = {2: 'PLTRELSZ', 5: 'STRTAB', 6: 'SYMTAB', 7: 'RELA', 8: 'RELASZ', 9: 'RELAE
 R_ABS64, R_GLOB_DAT, R_JUMP_SLOT, R_RELATIVE = 257, 1025, 1026, 1027
 RNAME = {R_ABS64: 'ABS64', R_GLOB_DAT: 'GLOB_DAT', R_JUMP_SLOT: 'JUMP_SLOT', R_RELATIVE: 'RELATIVE'}
 STOP = 0xFFFF0000   # the x30 the harness gives a function it calls: never executed
+MAX_IMAGE = 1 << 30   # the largest module image (code, data and bss) the loader maps: a Switch module is a few hundred megabytes at most, so a bigger size field is damage, and is refused before it is allocated
+PHSIZE = 56   # the size of an ELF64 program header
 
 
