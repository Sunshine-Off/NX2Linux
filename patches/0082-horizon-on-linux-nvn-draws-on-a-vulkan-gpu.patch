+        elif op == 'samppool': state['samppool'] = c[1]
+        elif op == 'viewports':
+            tab = state.setdefault('viewport', {})
+            for k, v in c[1].items(): tab[k] = v
+        elif op == 'scissors':
+            tab = state.setdefault('scissor', {})
+            for k, v in c[1].items(): tab[k] = v
+        elif op == 'misc': state.setdefault('misc', {}).update(c[1])
+
+    def draw(self, state, call):
