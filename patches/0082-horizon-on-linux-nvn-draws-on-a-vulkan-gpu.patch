+SHADER_CONTROL_SIZE = 0x880
+SHADER_CODE_SIZE_AT, SHADER_OWN_LENGTH_AT = 0x704, 0x20   # offsets in the control section, as engine/dm/gfx/nvn/hle_nvn.c keys_hash reads them
