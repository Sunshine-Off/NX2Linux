+
+    # ---- images ----
+    def vk_format(self, fmt, what='texture'):
+        f = NVN_TO_VK.get(fmt)
+        if f is None: raise Skip(f'{what} format {fmt:#x}')
+        return f
+
+    def image_of(self, ptr, target=False):
+        """The GPU image of an NVN texture (created on first use; sampled textures are read from the game's memory then)"""
+        n = self.nvn
+        t = n.o.get(ptr)
+        if not t or 'd' not in t: raise Skip('unknown texture')
+        d = t['d']
+        im = self.images.get(ptr)
+        if im is None:
