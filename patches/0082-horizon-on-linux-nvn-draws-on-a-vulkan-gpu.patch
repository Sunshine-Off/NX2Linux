+            if d.flags & 0x50:   # linear
+                stride = d.stride or (row_bytes + 31 & ~31)
+                raw = self.nvn.hz.rd(addr, stride * rows)
+                data = b''.join(raw[y * stride:y * stride + row_bytes] for y in range(rows))
+            else:
