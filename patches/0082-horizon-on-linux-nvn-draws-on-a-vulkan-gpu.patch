diff --git a/dm/tools/horizon_gpu.py b/dm/tools/horizon_gpu.py
new file mode 100644
index 0000000..cd3fa9c
--- /dev/null
+++ b/dm/tools/horizon_gpu.py
@@ -0,0 +1,111 @@
+"""The GPU the NVN layer draws with (NX2Linux S7bis): ctypes over linux/host's libnx2linux_gpu.so, a headless Vulkan 1.3 device (the RTX or lavapipe) that renders draws into images.
+The library is found through NX2LINUX_GPU_LIB, else ~/.cache/nx2linux/build-host (where `cmake -B` of linux/host puts it). The structures below mirror Nx2Draw in linux/host/gpu.c field by field."""
+import ctypes as C
+import os
+from pathlib import Path
+
+MAX_TARGETS = 8
+
+
+class GpuError(Exception): pass
+
+
+class Stream(C.Structure):
+    _fields_ = [('binding', C.c_uint32), ('stride', C.c_uint32), ('divisor', C.c_uint32), ('pad', C.c_uint32), ('data', C.c_void_p), ('size', C.c_uint64)]
+
+
+class Attr(C.Structure):
+    _fields_ = [('location', C.c_uint32), ('binding', C.c_uint32), ('format', C.c_uint32), ('offset', C.c_uint32)]
+
+
+class Blend(C.Structure):
+    _fields_ = [(n, C.c_uint32) for n in ('enable', 'src_rgb', 'dst_rgb', 'op_rgb', 'src_a', 'dst_a', 'op_a', 'mask')]
+
+
+class Buf(C.Structure):
+    _fields_ = [('binding', C.c_uint32), ('kind', C.c_uint32), ('pad0', C.c_uint32), ('pad1', C.c_uint32), ('data', C.c_void_p), ('size', C.c_uint64)]
+
+
+class Tex(C.Structure):
+    _fields_ = [(n, C.c_uint32) for n in ('binding', 'image', 'min_filter', 'mag_filter', 'mip_mode', 'wrap_s', 'wrap_t', 'wrap_r', 'compare_enable', 'compare_op')] + \
+               [(n, C.c_float) for n in ('lod_min', 'lod_max', 'lod_bias', 'aniso')]
+
+
+class Draw(C.Structure):
+    _fields_ = [('vs', C.c_uint32), ('ps', C.c_uint32), ('ntargets', C.c_uint32), ('targets', C.c_uint32 * MAX_TARGETS), ('depth_image', C.c_uint32),
+                ('nattrs', C.c_uint32), ('attrs', Attr * 16), ('nstreams', C.c_uint32), ('streams', Stream * 16),
+                ('topology', C.c_uint32), ('index_type', C.c_uint32), ('pad0', C.c_uint32), ('pad1', C.c_uint32), ('index_data', C.c_void_p), ('index_size', C.c_uint64),
+                ('first', C.c_int32), ('count', C.c_int32), ('base_vertex', C.c_int32), ('base_instance', C.c_int32), ('instances', C.c_uint32), ('pad2', C.c_uint32),
+                ('blend', Blend * MAX_TARGETS),
+                ('cull', C.c_uint32), ('front_face', C.c_uint32), ('polygon_mode', C.c_uint32), ('depth_test', C.c_uint32), ('depth_write', C.c_uint32), ('depth_func', C.c_uint32),
+                ('depth_clamp', C.c_uint32), ('pad3', C.c_uint32),
+                ('viewport', C.c_float * 4), ('depth_range', C.c_float * 2), ('scissor', C.c_int32 * 4),
+                ('nbufs', C.c_uint32), ('bufs', Buf * 32), ('ntex', C.c_uint32), ('tex', Tex * 32)]
+
+
+def library_path():
+    p = os.environ.get('NX2LINUX_GPU_LIB') or str(Path.home() / '.cache/nx2linux/build-host/libnx2linux_gpu.so')
+    return p if os.path.exists(p) else None
+
+
+class Gpu:
+    def __init__(self, software=False):
+        path = library_path()
+        if path is None: raise GpuError('libnx2linux_gpu.so not found: build linux/host (cmake -S linux/host -B ~/.cache/nx2linux/build-host && cmake --build ~/.cache/nx2linux/build-host) or set NX2LINUX_GPU_LIB')
+        L = self.lib = C.CDLL(path)
+        L.nx2gpu_error.restype = C.c_char_p; L.nx2gpu_name.restype = C.c_char_p
+        L.nx2gpu_open.argtypes = [C.c_int]
+        L.nx2gpu_shader.argtypes = [C.c_char_p, C.c_uint32]; L.nx2gpu_shader.restype = C.c_uint32
+        L.nx2gpu_image.argtypes = [C.c_uint32, C.c_uint32, C.c_uint32, C.c_int]; L.nx2gpu_image.restype = C.c_uint32
+        L.nx2gpu_image_free.argtypes = [C.c_uint32]
+        L.nx2gpu_upload.argtypes = [C.c_uint32, C.c_char_p, C.c_uint64]
+        L.nx2gpu_read.argtypes = [C.c_uint32, C.c_void_p, C.c_uint64]
+        L.nx2gpu_deswizzle.argtypes = [C.c_char_p, C.c_void_p, C.c_uint32, C.c_uint32, C.c_uint32]
+        L.nx2gpu_clear_color.argtypes = [C.c_uint32, C.POINTER(C.c_float)]
+        L.nx2gpu_clear_depth.argtypes = [C.c_uint32, C.c_float, C.c_uint32]
+        L.nx2gpu_draw.argtypes = [C.POINTER(Draw)]
+        L.nx2gpu_stats.argtypes = [C.POINTER(C.c_uint64)]
+        if L.nx2gpu_open(int(software)): raise GpuError(L.nx2gpu_error().decode())
+
+    @property
+    def name(self): return self.lib.nx2gpu_name().decode()
+
+    def _check(self, r, what):
+        if r: raise GpuError(f'{what}: {self.lib.nx2gpu_error().decode()}')
+
+    def shader(self, spirv):
+        i = self.lib.nx2gpu_shader(bytes(spirv), len(spirv))
+        if not i: raise GpuError(f'shader: {self.lib.nx2gpu_error().decode()}')
+        return i
+
+    def image(self, w, h, vk_format, depth=False):
+        i = self.lib.nx2gpu_image(w, h, vk_format, int(depth))
+        if not i: raise GpuError(f'image {w}x{h} format {vk_format}: {self.lib.nx2gpu_error().decode()}')
+        return i
+
+    def image_free(self, i): self.lib.nx2gpu_image_free(i)
+    def upload(self, i, pixels): self._check(self.lib.nx2gpu_upload(i, bytes(pixels), len(pixels)), 'upload')
+
+    def deswizzle(self, raw, row_bytes, rows, tile_h):
+        out = C.create_string_buffer(row_bytes * rows)
+        self._check(self.lib.nx2gpu_deswizzle(bytes(raw), out, row_bytes, rows, tile_h), 'deswizzle')
+        return out.raw
+
+    def read(self, i, nbytes):
+        out = C.create_string_buffer(nbytes)
+        self._check(self.lib.nx2gpu_read(i, out, nbytes), 'read')
+        return out.raw
+
+    def clear_color(self, i, rgba): self._check(self.lib.nx2gpu_clear_color(i, (C.c_float * 4)(*rgba)), 'clear')
+    def clear_depth(self, i, depth, stencil=0): self._check(self.lib.nx2gpu_clear_depth(i, depth, stencil), 'clear depth')
+    def flush(self): self._check(self.lib.nx2gpu_flush(), 'flush')
+
+    def draw(self, d):
+        """0: recorded, 1: skipped (a resource the draw names is not there)"""
+        r = self.lib.nx2gpu_draw(C.byref(d))
+        if r < 0: raise GpuError(f'draw: {self.lib.nx2gpu_error().decode()}')
+        return r
+
+    def stats(self):
+        a = (C.c_uint64 * 6)(); self.lib.nx2gpu_stats(a)
+        return dict(zip(('draws', 'flushes', 'skipped', 'images', 'shaders', 'pipelines'), a))
