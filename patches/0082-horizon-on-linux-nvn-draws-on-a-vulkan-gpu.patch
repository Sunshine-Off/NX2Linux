+        return im
+
+    def upload(self, ptr, t, d, im):
+        im['uploaded'] = True
+        if im['depth']: self.count('upload: depth'); return
+        lay = nvn_layout.layout(d)
+        bpb, bw, bh = nvn_layout.fmt_of(d.format)
+        if not bpb: self.count('upload: format without a size'); return
+        row_bytes, rows = nvn_layout.blk(d.width, bw) * bpb, nvn_layout.blk(d.height, bh)
+        addr = self.nvn.pool_addr(t.get('pool', 0), t.get('off', 0))
+        if not addr: self.count('upload: texture without storage'); return
