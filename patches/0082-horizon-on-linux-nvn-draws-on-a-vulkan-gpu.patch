+"""NVN state objects for the Linux host (NX2Linux S7bis): the blend, color, polygon, depth-stencil, multisample and vertex states the game builds in its own memory, packed as the fixed-size
+structs it hands to nvnCommandBufferBind*State. Same fields and defaults as engine/dm/gfx/nvn/nvn_obj.h (the Mach host), kept in the game's memory so a state the game copies by value stays
+valid. The layouts are ours (the game never reads the bytes), they only have to fit the NVN struct sizes."""
+
+# NVN enum values the defaults need (nvn.h)
+BLEND_FUNC_ZERO, BLEND_FUNC_ONE, BLEND_EQUATION_ADD = 1, 2, 1
+LOGIC_OP_COPY, ALPHA_FUNC_ALWAYS = 3, 8
+FACE_NONE, FACE_FRONT, FACE_BACK, FRONT_FACE_CCW, POLYGON_MODE_FILL = 0, 1, 2, 1, 2
+DEPTH_FUNC_LESS, STENCIL_FUNC_ALWAYS, STENCIL_OP_KEEP = 2, 8, 1
+
+
+class Spec:
+    """A little-endian bit-packed struct: fields are (name, width) in order from bit 0"""
+    def __init__(self, name, size, fields, defaults):
+        self.name, self.size, self.fields, self.defaults = name, size, fields, defaults
+        assert sum(w for _, w in fields) <= size * 8, name
+
+    def unpack(self, raw):
+        v, out, shift = int.from_bytes(raw[:self.size], 'little'), {}, 0
+        for f, w in self.fields:
+            out[f] = v >> shift & (1 << w) - 1; shift += w
+        return out
+
+    def pack(self, d):
+        v, shift = 0, 0
+        for f, w in self.fields:
+            v |= (d[f] & (1 << w) - 1) << shift; shift += w
+        return v.to_bytes(self.size, 'little')
+
+    def default(self): return dict(self.defaults)
+
+
+BLEND = Spec('blend', 8, [('target', 3), ('src_rgb', 7), ('dst_rgb', 7), ('src_a', 7), ('dst_a', 7), ('eq_rgb', 3), ('eq_a', 3), ('adv', 6), ('adv_npm', 1), ('adv_ovl', 2)],
+             dict(target=0, src_rgb=BLEND_FUNC_ONE, dst_rgb=BLEND_FUNC_ZERO, src_a=BLEND_FUNC_ONE, dst_a=BLEND_FUNC_ZERO, eq_rgb=BLEND_EQUATION_ADD, eq_a=BLEND_EQUATION_ADD, adv=0, adv_npm=0, adv_ovl=0))
+COLOR = Spec('color', 4, [('blend_en', 8), ('logic_op', 4), ('alpha_func', 4)], dict(blend_en=0, logic_op=LOGIC_OP_COPY, alpha_func=ALPHA_FUNC_ALWAYS))
+CHMASK = Spec('chmask', 4, [('mask', 32)], dict(mask=0xFFFFFFFF))   # 4 bits per target: r=1 g=2 b=4 a=8, bit set = write
+MS_FIELDS = ('enable', 'samples', 'a2c', 'a2c_dither', 'raster_samples', 'cov_mod', 'cov2color_en', 'cov2color_out', 'sl_en', 'sl_grid')
+MULTISAMPLE = Spec('multisample', 10, [(f, 8) for f in MS_FIELDS], dict({f: 0 for f in MS_FIELDS}, enable=1))
+POLYGON = Spec('polygon', 4, [('cull', 2), ('front', 1), ('mode', 2), ('offset_en', 3)], dict(cull=FACE_NONE, front=FRONT_FACE_CCW, mode=POLYGON_MODE_FILL, offset_en=0))
+DEPTH_STENCIL = Spec('depth_stencil', 8, [('dt', 1), ('dw', 1), ('df', 4), ('st', 1), ('sf_f', 4), ('sf_b', 4), ('fail_f', 4), ('zfail_f', 4), ('zpass_f', 4), ('fail_b', 4), ('zfail_b', 4), ('zpass_b', 4)],
+                     dict(dt=0, dw=1, df=DEPTH_FUNC_LESS, st=0, sf_f=STENCIL_FUNC_ALWAYS, sf_b=STENCIL_FUNC_ALWAYS, fail_f=STENCIL_OP_KEEP, zfail_f=STENCIL_OP_KEEP, zpass_f=STENCIL_OP_KEEP,
+                          fail_b=STENCIL_OP_KEEP, zfail_b=STENCIL_OP_KEEP, zpass_b=STENCIL_OP_KEEP))
+VERTEX_ATTRIB = Spec('vertex_attrib', 4, [('fmt', 8), ('offset', 19), ('stream', 5)], dict(fmt=0, offset=0, stream=0))
+VERTEX_STREAM = Spec('vertex_stream', 8, [('stride', 32), ('divisor', 32)], dict(stride=0, divisor=0))
+
+M32 = 0xFFFFFFFF
+
+
+def _faces(d, face, fields, values):
+    if face & FACE_FRONT: d.update(zip(fields[0], values))
+    if face & FACE_BACK: d.update(zip(fields[1], values))
+
+
+def _blend_func(d, a): d.update(src_rgb=a[0], dst_rgb=a[1], src_a=a[2], dst_a=a[3])
+def _blend_enable(d, a):
+    i = a[0] & M32
+    if i < 8: d['blend_en'] = d['blend_en'] | 1 << i if a[1] & 0xFF else d['blend_en'] & ~(1 << i)
+def _chmask(d, a):
+    i = a[0] & M32
+    if i < 8: d['mask'] = d['mask'] & ~(0xF << 4 * i) | ((a[1] & 1) | (a[2] & 1) << 1 | (a[3] & 1) << 2 | (a[4] & 1) << 3) << 4 * i
+def _stencil_func(d, a): _faces(d, a[0] & M32, (('sf_f',), ('sf_b',)), (a[1] & M32,))
+def _stencil_op(d, a): _faces(d, a[0] & M32, (('fail_f', 'zfail_f', 'zpass_f'), ('fail_b', 'zfail_b', 'zpass_b')), (a[1] & M32, a[2] & M32, a[3] & M32))
+
+
+# kind name -> (spec, {setter name: fn(fields, args)}); args are x1.. of the call (x0 is the struct). Integer and pointer arguments only: the host functions get x0..x30, not the float registers
+OBJECTS = {
+    'BlendState': (BLEND, {'SetBlendTarget': lambda d, a: d.update(target=a[0]), 'SetBlendFunc': _blend_func, 'SetBlendEquation': lambda d, a: d.update(eq_rgb=a[0], eq_a=a[1]),
+                           'SetAdvancedMode': lambda d, a: d.update(adv=a[0] if a[0] <= 0x1F else 0), 'SetAdvancedPremultipliedSrc': lambda d, a: d.update(adv_npm=int(not a[0] & 0xFF)),
+                           'SetAdvancedOverlap': lambda d, a: d.update(adv_ovl=a[0] & 3)}),
+    'ColorState': (COLOR, {'SetBlendEnable': _blend_enable, 'SetAlphaTest': lambda d, a: d.update(alpha_func=a[0]), 'SetLogicOp': lambda d, a: d.update(logic_op=a[0])}),
+    'ChannelMaskState': (CHMASK, {'SetChannelMask': _chmask}),
+    'MultisampleState': (MULTISAMPLE, {'SetMultisampleEnable': lambda d, a: d.update(enable=int(bool(a[0] & 0xFF))), 'SetSamples': lambda d, a: d.update(samples=a[0]),
+                                       'SetAlphaToCoverageEnable': lambda d, a: d.update(a2c=int(bool(a[0] & 0xFF))), 'SetAlphaToCoverageDither': lambda d, a: d.update(a2c_dither=int(bool(a[0] & 0xFF))),
+                                       'SetRasterSamples': lambda d, a: d.update(raster_samples=a[0]), 'SetCoverageModulationMode': lambda d, a: d.update(cov_mod=a[0]),
+                                       'SetCoverageToColorEnable': lambda d, a: d.update(cov2color_en=int(bool(a[0] & 0xFF))), 'SetCoverageToColorOutput': lambda d, a: d.update(cov2color_out=a[0]),
+                                       'SetSampleLocationsEnable': lambda d, a: d.update(sl_en=int(bool(a[0] & 0xFF))), 'SetSampleLocationsGridEnable': lambda d, a: d.update(sl_grid=int(bool(a[0] & 0xFF)))}),
+    'PolygonState': (POLYGON, {'SetCullFace': lambda d, a: d.update(cull=a[0]), 'SetFrontFace': lambda d, a: d.update(front=a[0]), 'SetPolygonMode': lambda d, a: d.update(mode=a[0]),
+                               'SetPolygonOffsetEnables': lambda d, a: d.update(offset_en=a[0])}),
+    'DepthStencilState': (DEPTH_STENCIL, {'SetDepthTestEnable': lambda d, a: d.update(dt=int(bool(a[0] & 0xFF))), 'SetDepthWriteEnable': lambda d, a: d.update(dw=int(bool(a[0] & 0xFF))),
+                                          'SetDepthFunc': lambda d, a: d.update(df=a[0]), 'SetStencilTestEnable': lambda d, a: d.update(st=int(bool(a[0] & 0xFF))),
+                                          'SetStencilFunc': _stencil_func, 'SetStencilOp': _stencil_op}),
+    'VertexAttribState': (VERTEX_ATTRIB, {'SetFormat': lambda d, a: d.update(fmt=a[0], offset=a[1]), 'SetStreamIndex': lambda d, a: d.update(stream=a[0])}),
+    'VertexStreamState': (VERTEX_STREAM, {'SetStride': lambda d, a: d.update(stride=a[0]), 'SetDivisor': lambda d, a: d.update(divisor=a[0])}),
+}
