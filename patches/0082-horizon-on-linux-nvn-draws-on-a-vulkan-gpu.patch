+            data = self._buffer(addr, min(size, need) if need else size)
+            keep.append(ctypes.create_string_buffer(data, max(1, len(data))))
+            d.streams[d.nstreams] = hg.Stream(s, stride, div, 0, ctypes.addressof(keep[-1]), len(data)); d.nstreams += 1
