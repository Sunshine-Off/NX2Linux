+        d.topology = QUADS if prim == 7 else prim
+        d.first, d.count, d.base_vertex, d.base_instance, d.instances = call.get('first', 0), call['count'], call.get('base_vertex', 0), call.get('base_instance', 0), call.get('instances', 1)
+        if indices:
+            keep.append(ctypes.create_string_buffer(indices[0], max(1, len(indices[0]))))
+            d.index_type, d.index_data, d.index_size = indices[1], ctypes.addressof(keep[-1]), len(indices[0])
+
+        # resources
+        self.bind_resources(state, d, keep, [(STAGE_VS, vs_res), (STAGE_FS, ps_res)])
+        self.gpu.draw(d)
+        self.stats['draws'] += 1
+        for p in rts: self.target_draws[p] = self.target_draws.get(p, 0) + 1
+
+    def bind_resources(self, state, d, keep, stages):
+        n = self.nvn
+        def add_buf(binding, kind, data):
+            keep.append(ctypes.create_string_buffer(data, max(1, len(data))))
+            d.bufs[d.nbufs] = hg.Buf(binding, kind, 0, 0, ctypes.addressof(keep[-1]), len(data)); d.nbufs += 1
+        add_buf(0, 0, SUPPORT)
+        seen = set()
+        for stage, res in stages:
+            if not res: continue
+            for cb in res['cbufs']:
+                if cb['binding'] in seen: continue
+                seen.add(cb['binding'])
+                if cb['slot'] >= 3 and (stage, cb['slot'] - 3) in state.get('ubo', {}):
+                    addr, size = state['ubo'][(stage, cb['slot'] - 3)]
+                    add_buf(cb['binding'], 0, self._buffer(addr, size, 1 << 16).ljust(16, b'\0'))
+                else: add_buf(cb['binding'], 0, bytes(DRIVER_SEGMENT_BYTES))
+            for sb in res['sbufs']:
+                if sb['binding'] in seen: continue
+                seen.add(sb['binding'])
+                addr, size = state.get('ssbo', {}).get((stage, sb['slot']), (0, 0))
+                add_buf(sb['binding'], 1, self._buffer(addr, size, 1 << 24).ljust(16, b'\0'))
+            for im in res['images']:
+                raise Skip('storage images')
+            for tx in res['textures']:
+                if tx['binding'] in seen: continue
+                seen.add(tx['binding'])
+                kind = tx['type'] & 0xFF
+                if kind != 3 or tx['type'] & 0x300: raise Skip(f'texture type {tx["type"]:#x}')
+                handle = self.handle_of(state, stage, tx)
+                tex_id, samp_id = handle & 0xFFFFF, handle >> 20 & 0xFFF
+                tp = n.o.get(state.get('texpool', 0), {})
+                ptr = tp.get('tex', {}).get(tex_id)
+                try: image = self.image_of(ptr)['id'] if ptr else self.dummy_image()
+                except Skip as e: image = self.dummy_image(); self.count('dummy: ' + str(e))
+                if not ptr: self.count('dummy: texture id not in the pool')
+                sp = n.o.get(state.get('samppool', 0), {}).get('samplers', {}).get(samp_id, {})
+                t = hg.Tex(); t.binding, t.image = tx['binding'], image
+                t.min_filter, t.mag_filter = int(sp.get('min_filter', 0) & 1), int(sp.get('mag_filter', 0) & 1)
+                t.wrap_s, t.wrap_t, t.wrap_r = (WRAP.get(sp.get(k, 1), 0) for k in ('wrap_s', 'wrap_t', 'wrap_r'))
+                t.lod_max = 0.25; t.aniso = 1.0
+                if tx['type'] & 0x400: t.compare_enable, t.compare_op = 1, max(0, sp.get('cmp_func', 2) - 1)
+                d.tex[d.ntex] = t; d.ntex += 1
+
+    def handle_of(self, state, stage, tx):
+        """The texture handle a shader texture slot reads: from the bound handle table (slot r of combined textures sits at c2 word 8 + 2 r, separate textures from word 90), or, for a bindless
+        read, from the word of the uniform buffer the shader names"""
+        if tx['cbuf_slot'] >= 3:
+            addr, size = state.get('ubo', {}).get((stage, tx['cbuf_slot'] - 3), (0, 0))
+            off = tx['handle'] * 4
+            if not addr or off + 4 > size: return 0
+            return struct.unpack('<I', self.nvn.hz.rd(addr + off, 4))[0]
+        w = tx['handle']
+        slot = (w - 8) // 2 if w < 90 else 128 + (w - 90) // 2
+        h = state.get('tex', {}).get((stage, slot), 0)
+        if slot >= 128: h = h | (state.get('samp', {}).get((stage, (w - 90) // 2), 0) << 0)
+        return h
+
+
+BLEND_FACTOR = {0x1: 0, 0x2: 1, 0x3: 2, 0x4: 3, 0x5: 6, 0x6: 7, 0x7: 8, 0x8: 9, 0x9: 4, 0xA: 5, 0xB: 14, 0x10: 15, 0x11: 16, 0x12: 17, 0x13: 18, 0x61: 10, 0x62: 11, 0x63: 12, 0x64: 13}
+
+
+def dump_targets(backend, directory):
+    """Every render target drawn into, as PNG (NX2LINUX_GPU_DUMP=<dir> at each 120th present): which pass makes the picture"""
+    import os
+    from horizon_nvn import write_png
+    os.makedirs(directory, exist_ok=True)
+    for ptr, count in sorted(backend.target_draws.items(), key=lambda kv: -kv[1])[:24]:
+        im = backend.images.get(ptr)
+        if not im or im['depth'] or im['fmt'] not in (VK['RGBA8_UNORM'], VK['RGBA8_SRGB']): continue
+        px = backend.gpu.read(im['id'], im['w'] * im['h'] * 4)
+        lit = sum(1 for i in range(0, len(px), 4 * 97) if px[i] or px[i + 1] or px[i + 2])
+        backend.nvn.hz.log(f'[nvn] target {ptr:#x} {im["w"]}x{im["h"]} draws={count} non-black samples={lit}')
+        write_png(os.path.join(directory, f'{backend.nvn.stats["presents"]:05d}_{ptr:x}.png'), im['w'], im['h'], px)
