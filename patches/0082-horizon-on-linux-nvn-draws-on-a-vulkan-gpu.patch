+
+    @staticmethod
+    def apply_state(state, c):
+        """A recorded state or binding command: the state a draw reads when it runs"""
+        op = c[0]
+        if op == 'program': state['program'] = (c[1], c[2])
+        elif op == 'bind_state':
+            state.setdefault('states', {})[c[1]] = c[2]
+            if c[1] == 'blend': state.setdefault('blends', {})[c[2]['target']] = c[2]
+        elif op == 'vattr': state['vattr'] = c[1]
