+        d.viewport[:] = (vp[0], vp[1] + vp[3], vp[2], -vp[3])   # y up in clip space: the negative height flips it to the window (upper-left origin)
+        d.depth_range[:] = state.get('misc', {}).get('depth_range', (0.0, 1.0))
+        sc = state.get('scissor', {}).get(0, (0, 0, tw, th))
+        d.scissor[:] = (max(0, sc[0]), max(0, sc[1]), max(0, sc[2]), max(0, sc[3]))
+
+        # vertex input
+        vattr, vstream, vbuf = state.get('vattr', []), state.get('vstream', []), state.get('vbuf', {})
+        kind = call['kind']
+        indices = None
+        if kind == 'elements':
+            isz = (1, 2, 4)[call['index_type']] if call['index_type'] < 3 else 4
