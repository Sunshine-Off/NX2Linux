+"""Maxwell shaders to SPIR-V on the Linux host (NX2Linux S7bis): the game's NVN shaders (a code area with its 0x30 header and a control section, as nvnProgramSetShaders gets them) go through
+the translator the Mach host uses for Metal (engine/dm/gfx/tools/dmsh_xlate, Ryujinx.Graphics.Shader, run by dotnet), which emits SPIR-V for Vulkan: here that SPIR-V is used as it is, where
+the Mach chain converts it to MSL. The job is built as dmsh_build.py job_for builds it (vertex shaders in two parts merged, the 0x30 header stripped, c1 passed for jump tables, early fragment
+tests). Without a game profile's answer table (shader_facts.tsv) the translator's queries (texture types, attribute types, fragment output types) use its defaults.
+Results are cached by shader key under NX2LINUX_SPIRV_CACHE (default ~/.cache/nx2linux/spirv)."""
+import json, os, shutil, struct, subprocess, tempfile
+from pathlib import Path
+
+XLATE_SRC = Path(__file__).resolve().parent.parent / 'gfx/tools/dmsh_xlate'
+XLATE_DIR = Path(os.environ.get('NX2LINUX_XLATE_DIR', Path.home() / '.cache/nx2linux/xlate'))   # the translator built for this machine (the dmsh_xlate_bin in the tree is built for macOS)
+XLATE_DLL = XLATE_DIR / 'dmsh_xlate.dll'
+CACHE = Path(os.environ.get('NX2LINUX_SPIRV_CACHE', Path.home() / '.cache/nx2linux/spirv'))
+SPH_MAGIC = bytes.fromhex('78563412')
+SHADER_TYPES = {0: 'vs', 1: 'vs', 2: 'tcs', 3: 'tes', 4: 'gs', 5: 'ps'}   # SPH shader type (word 0, bits 10..13); type 0 is a vertex shader, in two parts when the control section says so
+
+
+class TranslateError(Exception):
+    pass
+
+
+def stage_of(code):
+    """vs / ps / gs ... of a graphics code area (its 0x30 header, then the SPH), or None when it is not one"""
+    if len(code) < 0x80 or code[:4] not in (SPH_MAGIC, bytes.fromhex('79563412')): return None
+    return SHADER_TYPES.get(struct.unpack_from('<I', code, 0x30)[0] >> 10 & 0xF)
+
+
+def vertex_ab(code, ctl):
+    """A vertex shader in two parts (VertexA + VertexB, which Catherine: Full Body's GLSLC writes for every vertex shader) as one program: (code area with its 0x30 header, c1), or None for
+    any other vertex shader. The same merge as engine/dm/gfx/tools/dmsh_build.py vertex_ab, which documents the SPH and EXIT rewrite"""
+    if len(code) < 0x80 or len(ctl) < 0x760 or code[:4] != SPH_MAGIC: return None
+    w0 = struct.unpack_from('<I', code, 0x30)[0]
+    if w0 & 0x1f != 1 or (w0 >> 10) & 0xf != 0: return None
+    a_sph, a_len, _, b_sph, b_len, _ = struct.unpack_from('<6I', ctl, 0x748)
+    if not any((a_sph, a_len, b_sph, b_len)): return None
+    bw0 = struct.unpack_from('<I', code, b_sph)[0] if 0x80 <= b_sph <= len(code) - 0x50 else 0
+    if a_sph != 0x30 or b_sph != struct.unpack_from('<I', ctl, 0x700)[0] + 0x30 or bw0 & 0x1f != 1 or (bw0 >> 10) & 0xf != 1 or (a_len - 0x50) % 32 or (b_len - 0x50) % 32 or b_sph + b_len > len(code):
+        raise TranslateError(f'vertex shader of shader type 0 without a VertexB part in the expected place (control +0x748 {a_sph:#x} {a_len:#x} {b_sph:#x} {b_len:#x})')
+    sa, sb = list(struct.unpack_from('<20I', code, a_sph)), list(struct.unpack_from('<20I', code, b_sph))
+    sph = [sb[0] | sa[0] & ~(0xf << 10)] + [max(sa[i] & 0xffffff, sb[i] & 0xffffff) | sb[i] & ~0xffffff for i in (1, 2, 3)] + [sb[4]] + [sa[i] | sb[i] for i in range(5, 20)]
+    a = bytearray(code[a_sph + 0x50:a_sph + a_len]); b = code[b_sph + 0x50:b_sph + b_len]
+    for o in range(0, len(a), 8):
+        if o % 32 == 0: continue
+        ins = struct.unpack_from('<Q', a, o)[0]
+        if ins >> 52 == 0xe30 and ins & 0x1f == 0xf:
+            struct.pack_into('<Q', a, o, 0xe24 << 52 | ((len(a) - (o + 8)) & 0xffffff) << 20 | ins & 0xfffff)
+    return code[:0x30] + struct.pack('<20I', *sph) + bytes(a) + b, code[b_sph + b_len:]
+
+
+def early_fragment_tests(ctl, code):
+    return len(ctl) > 0x718 and ctl[0x718] != 0 and len(code) >= 0x50 and not struct.unpack_from('<I', code, 19 * 4)[0] & 2
+
+
+def make_job(key, stage, ctl, code, workdir):
+    """The translator's job for one shader: the file of instructions written under workdir, the rest as data"""
+    c1o, c1t = struct.unpack_from('<2I', ctl, 0x700)
+    c1 = code[c1o:c1t] if 0 <= c1o <= c1t <= len(code) else b''
+    if stage == 'vs':
+        ab = vertex_ab(code, ctl)
+        if ab: code, c1 = ab
+    if stage != 'cs': code = code[0x30:]   # the header; the translator reads the 0x50-byte SPH after it itself
+    path = os.path.join(workdir, key + '.bin'); open(path, 'wb').write(code)
+    job = {'key': key, 'stage': stage, 'code': path, 'tex': {}, 'img': {}, 'attr': {}, 'fout': {}, 'c1': c1.hex(), 'no_facts': True, 'debug': False, 'reduced': True}
+    if stage == 'ps' and early_fragment_tests(ctl, code): job['early_fragment_tests'] = True
+    return job
+
+
+def ensure_translator():
+    """Builds the translator with dotnet into XLATE_DIR when it is not there yet (about 10 s)"""
+    if XLATE_DLL.exists(): return
+    XLATE_DIR.mkdir(parents=True, exist_ok=True)
+    p = subprocess.run(['dotnet', 'build', '-c', 'Release', '-o', str(XLATE_DIR), f'-p:BaseIntermediateOutputPath={XLATE_DIR}/obj/'], cwd=XLATE_SRC, capture_output=True, text=True)
+    if p.returncode or not XLATE_DLL.exists(): raise TranslateError('cannot build the translator with dotnet:\n' + p.stdout[-800:])
+
+
+def translate(shaders):
+    """shaders: [(key, ctl, code)] → {key: (spirv bytes, resources dict)} for the ones that translate (the others are missing, their reason in the error list of the second result).
+    Already translated keys come from the cache; the rest go through one dotnet process"""
+    CACHE.mkdir(parents=True, exist_ok=True)
+    out, errors, jobs = {}, {}, []
+    work = tempfile.mkdtemp(prefix='nvn_spirv_')
+    try:
+        for key, ctl, code in shaders:
+            spv, res = CACHE / f'{key}.spv', CACHE / f'{key}.res.json'
+            if spv.exists() and res.exists(): out[key] = (spv.read_bytes(), json.loads(res.read_text())); continue
+            stage = stage_of(code)
+            if stage not in ('vs', 'ps'): errors[key] = f'stage {stage!r} is not translated yet'; continue
+            try: jobs.append(make_job(key, stage, ctl, code, work))
+            except TranslateError as e: errors[key] = str(e)
+        if jobs:
+            ensure_translator()
+            jf = os.path.join(work, 'jobs.json'); json.dump(jobs, open(jf, 'w'))
+            p = subprocess.run(['dotnet', str(XLATE_DLL), jf, work], capture_output=True, text=True)
+            for line in p.stderr.splitlines():
+                if line.startswith('[RED] '):
+                    key, _, why = line[6:].partition(': ')
+                    errors[key] = why
+            for j in jobs:
+                k = j['key']; spv, res = Path(work) / f'{k}.spv', Path(work) / f'{k}.res.json'
+                if spv.exists() and res.exists():
+                    shutil.copy(spv, CACHE / f'{k}.spv'); shutil.copy(res, CACHE / f'{k}.res.json')
+                    out[k] = (spv.read_bytes(), json.loads(res.read_text()))
+                else: errors.setdefault(k, f'no output (dotnet exit {p.returncode})')
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+    return out, errors
+
+
+def rebind(spirv, base):
+    """The SPIR-V with every resource Binding above 0 moved up by base. Each stage's resources are numbered from 1 by the translator (binding 0 is the support buffer every stage shares),
+    and a Vulkan pipeline has one descriptor set for all its stages: the pixel shader's go above the vertex shader's"""
+    w = list(struct.unpack(f'<{len(spirv) // 4}I', spirv))
+    i = 5
+    while i < len(w):
+        n, op = w[i] >> 16, w[i] & 0xFFFF
+        if op == 71 and n >= 4 and w[i + 2] == 33 and w[i + 3] > 0: w[i + 3] += base   # OpDecorate <id> Binding <n>
+        i += n or 1
+    return struct.pack(f'<{len(w)}I', *w)
