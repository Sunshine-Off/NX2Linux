+class Skip(Exception):
+    """A draw this backend cannot make yet: the reason is counted"""
+
+
+class GpuBackend:
+    def __init__(self, nvn, gpu=None, software=False):
+        self.nvn, self.gpu = nvn, gpu or hg.Gpu(software=software)
+        self.shaders = {}    # shader key -> (id, stage, resources) once translated
+        self.failed = {}     # shader key -> why it did not translate
+        self.images = {}     # texture pointer -> dict(id, w, h, fmt, uploaded, target)
+        self.dummy = None
+        self.target_draws = {}   # texture pointer -> draws made into it (diagnostics)
+        self.stats = {'draws': 0, 'skipped': {}, 'uploads': 0, 'translated': 0}
+
+    # ---- shaders ----
+    def translate_pending(self, want):
+        """Translates the shader keys in want together with a batch of the others the game has given programs so far"""
+        todo = [k for k in want if k not in self.shaders and k not in self.failed]
+        if not todo: return
+        extra = [k for k in self.nvn.shader_bytes if k not in self.shaders and k not in self.failed and k not in todo][:48]
