+def shader_stage(n, index, data, control):
+    st = {'index': index, 'data': data, 'control': control}
+    if not control: return st
+    try:
+        ctl = n.hz.rd(control, SHADER_CONTROL_SIZE)
+        ncode = struct.unpack_from('<I', ctl, SHADER_CODE_SIZE_AT)[0]
+        own = struct.unpack_from('<I', ctl, SHADER_OWN_LENGTH_AT)[0]
+        nctl = own if 0x760 <= own < SHADER_CONTROL_SIZE else SHADER_CONTROL_SIZE
+        code = n.hz.rd(data, ncode) if data and 0 < ncode < 1 << 24 else b''
+    except Exception as e:
+        st['error'] = str(e); return st
+    st.update(key=hashlib.sha256(ctl[:nctl] + code).digest()[:8].hex(), code_size=len(code), control_size=nctl)
+    n.shader_bytes.setdefault(st['key'], (ctl[:nctl], code))   # what the translator reads (nvn_spirv.py)
+    if n.shader_dump and code:
