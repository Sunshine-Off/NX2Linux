+            if len(raw) < call['count'] * isz: raise Skip('index buffer')
+            if isz == 1: raw = array('H', array('B', raw)).tobytes(); isz = 2
+            idx = array('H' if isz == 2 else 'I'); idx.frombytes(raw)
+            indices = (raw, 1 if isz == 2 else 2, max(idx) if len(idx) else 0)
+        used = {}
+        for loc, a in enumerate(vattr):
+            if not a['fmt']: continue
+            vkf = NVN_TO_VK.get(a['fmt'])
+            if vkf is None: raise Skip(f'vertex format {a["fmt"]:#x}')
+            if a['stream'] >= len(vstream) or a['stream'] not in vbuf: raise Skip('vertex stream not bound')
