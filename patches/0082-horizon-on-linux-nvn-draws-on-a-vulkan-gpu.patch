+            bl.mask = m
+            if en and b: bl.enable, bl.src_rgb, bl.dst_rgb, bl.op_rgb, bl.src_a, bl.dst_a, bl.op_a = 1, BLEND_FACTOR.get(b['src_rgb'], 1), BLEND_FACTOR.get(b['dst_rgb'], 0), b['eq_rgb'] - 1, BLEND_FACTOR.get(b['src_a'], 1), BLEND_FACTOR.get(b['dst_a'], 0), b['eq_a'] - 1
