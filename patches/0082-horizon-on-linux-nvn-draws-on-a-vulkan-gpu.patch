@@ -0,0 +1,72 @@
+"""horizon_gpu.py: a draw recorded through libnx2linux_gpu.so (headless Vulkan) reaches the image, and block-linear data comes out linear. Skipped without the library, glslc or a Vulkan 1.3 device."""
+import ctypes, os, shutil, struct, subprocess, sys, tempfile, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_gpu as hg
+
+VERT = """#version 450
+layout(location=0) in vec2 pos;
+layout(location=1) in vec4 col;
+layout(location=0) out vec4 v;
+void main() { gl_Position = vec4(pos, 0.0, 1.0); v = col; }
+"""
+FRAG = """#version 450
+layout(location=0) in vec4 v;
+layout(location=0) out vec4 o;
+layout(binding=1) uniform U { vec4 tint; } u;
+void main() { o = v * u.tint; }
+"""
+R8G8B8A8_UNORM, TRIANGLE_LIST = 37, 3
+
+
+def spirv(src, stage):
+    d = tempfile.mkdtemp()
+    try:
+        f = os.path.join(d, 's.' + stage)
+        with open(f, 'w') as fh: fh.write(src)
+        subprocess.run(['glslc', f, '-o', f + '.spv'], check=True, capture_output=True)
+        with open(f + '.spv', 'rb') as fh: return fh.read()
+    finally: shutil.rmtree(d)
+
+
+@unittest.skipUnless(hg.library_path() and shutil.which('glslc'), 'libnx2linux_gpu.so or glslc missing')
+class Gpu(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        try: cls.gpu = hg.Gpu()
+        except hg.GpuError as e: raise unittest.SkipTest(str(e))
+
+    def test_a_triangle_is_drawn_with_a_uniform_and_read_back(self):
+        g = self.gpu
+        vs, ps = g.shader(spirv(VERT, 'vert')), g.shader(spirv(FRAG, 'frag'))
+        img = g.image(64, 64, R8G8B8A8_UNORM)
+        g.clear_color(img, (0, 0, 0, 1))
+        verts = struct.pack('<18f', -1, -1, 1, 0, 0, 1, 3, -1, 1, 0, 0, 1, -1, 3, 1, 0, 0, 1)   # covers the whole target, red
+        keep = ctypes.create_string_buffer(verts); tint = ctypes.create_string_buffer(struct.pack('<4f', 1, 0.5, 1, 1))
+        d = hg.Draw(); d.vs, d.ps, d.ntargets = vs, ps, 1; d.targets[0] = img
+        d.nattrs = 2; d.attrs[0] = hg.Attr(0, 0, 103, 0); d.attrs[1] = hg.Attr(1, 0, 109, 8)   # R32G32_SFLOAT, R32G32B32A32_SFLOAT
+        d.nstreams = 1; d.streams[0] = hg.Stream(0, 24, 0, 0, ctypes.addressof(keep), len(verts))
+        d.topology, d.count, d.instances = 4, 3, 1
+        d.blend[0].mask = 0xF
+        d.cull, d.front_face, d.polygon_mode = 0, 0, 0
+        d.depth_func = 1
+        d.viewport[:] = (0, 0, 64, 64); d.depth_range[:] = (0, 1); d.scissor[:] = (0, 0, 64, 64)
+        d.nbufs = 1; d.bufs[0] = hg.Buf(1, 0, 0, 0, ctypes.addressof(tint), 16)
+        self.assertEqual(g.draw(d), 0)
+        px = g.read(img, 64 * 64 * 4)
+        c = (32 * 64 + 32) * 4
+        self.assertEqual(tuple(px[c:c + 4]), (255, 0, 0, 255))   # red * (1, .5, 1, 1)
+
+    def test_a_block_linear_image_comes_out_linear(self):
+        row_bytes, rows = 64, 8   # one GOB
+        lin = bytes((y * 7 + x) & 255 for y in range(rows) for x in range(row_bytes))
+        gob = bytearray(512)
+        for y in range(rows):
+            for x in range(row_bytes):
+                gob[(x % 64 // 32) * 256 + (y % 8 // 2) * 64 + (x % 32 // 16) * 32 + (y % 2) * 16 + x % 16] = lin[y * row_bytes + x]
+        self.assertEqual(self.gpu.deswizzle(bytes(gob), row_bytes, rows, 0), lin)
+
+
+if __name__ == '__main__':
+    unittest.main()
