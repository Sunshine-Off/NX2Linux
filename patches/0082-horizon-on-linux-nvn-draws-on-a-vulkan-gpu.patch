+++ b/dm/tools/tests/test_horizon_nvn.py
@@ -0,0 +1,114 @@
+"""horizon_nvn.py: the state, bindings and parameters of every draw are recorded and reach the draw sink at submit, with a fake guest memory (no game, no GPU)"""
+import hashlib, struct, sys, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_nvn as hn
+import nvn_state
+
+CB, PROG, CTL, CODE, QUEUE = 0x10000, 0x11000, 0x20000, 0x30000, 0x12000
+
+
+class FakeHz:
+    def __init__(self): self.mem, self.logs = bytearray(0x100000), []
+    def rd(self, a, n): return bytes(self.mem[a:a + n])
+    def wr(self, a, d): self.mem[a:a + len(d)] = d
+    def rd32(self, a): return struct.unpack('<I', self.rd(a, 4))[0]
+    def wr32(self, a, v): self.wr(a, struct.pack('<I', v & 0xFFFFFFFF))
+    def log(self, m): self.logs.append(m)
+    verbose_nvn = False
+
+
+def call(n, name, *args):
+    r = [0] * 39
+    r[:len(args)] = args
+    hn.IMPL[name](n, r)
+    return r[0]
+
+
+class Recording(unittest.TestCase):
+    def setUp(self):
+        self.hz = FakeHz(); self.n = hn.Nvn(self.hz); self.draws = []; self.n.draw_sink = self.draws.append
+        call(self.n, 'nvnCommandBufferInitialize', CB); call(self.n, 'nvnCommandBufferBeginRecording', CB)
+
+    def submit(self):
+        h = call(self.n, 'nvnCommandBufferEndRecording', CB)
+        self.hz.wr(0x13000, struct.pack('<Q', h))
+        call(self.n, 'nvnQueueSubmitCommands', QUEUE, 1, 0x13000)
+
+    def test_state_objects_round_trip_in_guest_memory(self):
+        call(self.n, 'nvnBlendStateSetDefaults', 0x14000)
+        call(self.n, 'nvnBlendStateSetBlendFunc', 0x14000, 6, 7, 2, 1)
+        d = nvn_state.BLEND.unpack(self.hz.rd(0x14000, 8))
+        self.assertEqual((d['src_rgb'], d['dst_rgb'], d['src_a'], d['dst_a'], d['eq_rgb']), (6, 7, 2, 1, nvn_state.BLEND_EQUATION_ADD))
+        call(self.n, 'nvnChannelMaskStateSetDefaults', 0x14100)
+        call(self.n, 'nvnChannelMaskStateSetChannelMask', 0x14100, 1, 1, 0, 1, 0)
+        self.assertEqual(nvn_state.CHMASK.unpack(self.hz.rd(0x14100, 4))['mask'], 0xFFFFFFFF & ~(0xF << 4) | 0b0101 << 4)
+        call(self.n, 'nvnDepthStencilStateSetDefaults', 0x14200)
+        call(self.n, 'nvnDepthStencilStateSetStencilOp', 0x14200, 3, 4, 5, 6)
+        ds = nvn_state.DEPTH_STENCIL.unpack(self.hz.rd(0x14200, 8))
+        self.assertEqual([ds[k] for k in ('fail_f', 'zfail_f', 'zpass_f', 'fail_b', 'zfail_b', 'zpass_b')], [4, 5, 6, 4, 5, 6])
+
