+                data = self.gpu.deswizzle(raw, row_bytes, rows, th)
+            self.gpu.upload(im['id'], data)
+            self.stats['uploads'] += 1
+        except (AssertionError, hg.GpuError) as e: self.count(f'upload: {type(e).__name__} {str(e)[:40]}')
+
+    def dummy_image(self):
+        if self.dummy is None:
+            self.dummy = self.gpu.image(1, 1, VK['RGBA8_UNORM']); self.gpu.upload(self.dummy, bytes(4))
+        return self.dummy
+
+    # ---- clears and presents ----
+    def clear(self, ptr, color):
+        try: self.gpu.clear_color(self.image_of(ptr, target=True)['id'], color)
+        except Skip: pass
+
+    def read_bitmap(self, ptr):
+        """The RGBA8 pixels of a render target, for the window"""
+        im = self.images.get(ptr)
+        if not im or im['depth'] or im['fmt'] not in (VK['RGBA8_UNORM'], VK['RGBA8_SRGB']): return None
+        return self.gpu.read(im['id'], im['w'] * im['h'] * 4)
+
+    # ---- draws ----
+    def count(self, why): self.stats['skipped'][why] = self.stats['skipped'].get(why, 0) + 1
+
+    def skip(self, why):
+        self.stats['skipped'][why] = self.stats['skipped'].get(why, 0) + 1
+
+    def draw(self, state, call):
+        try: self._draw(state, call)
+        except Skip as e: self.skip(str(e))
+
+    def _buffer(self, addr, size, limit=MAX_VERTEX_BYTES):
+        if not addr or size <= 0: return b''
+        try: return self.nvn.hz.rd(addr, min(size, limit))
+        except AssertionError: raise Skip('unreadable buffer')
+
+    def _draw(self, state, call):
+        n, gpu = self.nvn, self.gpu
+        if call['kind'] in ('arrays_indirect', 'elements_indirect', 'texture'): raise Skip(call['kind'])
