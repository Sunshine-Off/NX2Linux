diff --git a/dm/tools/aot_lift.py b/dm/tools/aot_lift.py
index 371ac8d..6cdb5e4 100644
--- a/dm/tools/aot_lift.py
+++ b/dm/tools/aot_lift.py
@@ -78,6 +78,12 @@ def _disasm(word, address):
 MAX_LIFT_BYTES = 60000   # remill-lift takes the code as one hex argument, and Linux caps an argument at 128 KiB: a longer function cannot be handed over
 
 
+def _is_trap(word, address):
+    """An instruction no decoder knows, or UDF: code that is meant to fault if it ever runs (the compiler's unreachable/assert trap, e.g. 0xe7ffdefe)"""
+    d = _disasm(word, address)
+    return d == '?' or d.startswith('udf')
+
+
 def _run_lift(code, address, ll, entry=None):
     if len(code) > MAX_LIFT_BYTES:
         raise LiftError(f'function {address:#x}: {len(code)} bytes are more than the {MAX_LIFT_BYTES} remill-lift accepts on its command line (one hex argument, 128 KiB at most)')
@@ -96,9 +102,13 @@ def lift_function(code, address, ll, entry=None):
     entry: lift from this address inside the bytes instead of from their start (a case of a switch, reached by the jump table), the whole function being there for the branches that go back before it"""
     if not _run_lift(code, address, ll, entry): return
     scratch = ll + '.insn.ll'
+    traps = 0
     for i, (w,) in enumerate(struct.iter_unpack('<I', code)):
         try: lift(w, scratch, address + 4 * i)
-        except LiftError as e: raise LiftError(f'function {address:#x}: {e}') from None
+        except LiftError as e:
+            if _is_trap(w, address + 4 * i): traps += 1; continue   # an undefined encoding on purpose: __remill_error in the IR stops the run at it (aot_runtime.cpp)
+            raise LiftError(f'function {address:#x}: {e}') from None
+    if traps: return
     raise LiftError(f'function {address:#x}: Remill could not lift it (its IR calls __remill_error), though each instruction lifts alone: a control flow it does not follow')
 
 
diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index 5586a1c..405942c 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -202,6 +202,11 @@ Memory *__remill_missing_block(State &st, uint64_t pc, Memory *m) {
     fail("control reached %#llx, which was not lifted as code (a call returned to an unexpected address)", (unsigned long long)pc);
 }
 
+// An encoding nothing decodes, or UDF: the guest faulted (aot_lift.py lets a function contain one on purpose, as the compilers' unreachable/assert trap)
+Memory *__remill_error(State &st, uint64_t pc, Memory *m) {
+    fail("undefined instruction executed at %#llx", (unsigned long long)pc);
+}
+
 // A call of an import: pc is the address the guest branched to, which names the import
 Memory *import_call(State *st, uint64_t pc, Memory *m) {
     ImportEnt *e = import_find(pc);
@@ -257,8 +262,8 @@ void aot_unmap_all() {
     for (unsigned i = 0, n = g_nregions.load(); i < n; i++) { free(g_regions[i].host); g_regions[i].size = 0; g_regions[i].host = nullptr; }
     g_nregions.store(0);
 }
-int aot_poke(uint64_t a, const uint8_t *src, uint64_t n) { jmp_buf jb; if (setjmp(jb)) return 1; g_jb = &jb; memcpy(guest(a, n, "poke"), src, n); g_jb = nullptr; if (aot_write_hook) aot_write_hook(a, n); return 0; }
-int aot_peek(uint64_t a, uint8_t *dst, uint64_t n) { jmp_buf jb; if (setjmp(jb)) return 1; g_jb = &jb; memcpy(dst, guest(a, n, "peek"), n); g_jb = nullptr; return 0; }
+int aot_poke(uint64_t a, const uint8_t *src, uint64_t n) { jmp_buf jb, *outer = g_jb; g_jb = &jb; if (setjmp(jb)) { g_jb = outer; return 1; } memcpy(guest(a, n, "poke"), src, n); g_jb = outer; if (aot_write_hook) aot_write_hook(a, n); return 0; }
+int aot_peek(uint64_t a, uint8_t *dst, uint64_t n) { jmp_buf jb, *outer = g_jb; g_jb = &jb; if (setjmp(jb)) { g_jb = outer; return 1; } memcpy(dst, guest(a, n, "peek"), n); g_jb = outer; return 0; }
 uint64_t aot_stat(int i) { return g_stats[i]; }
 void aot_stats_reset() { memset(g_stats, 0, sizeof g_stats); }
 
diff --git a/dm/tools/elf_module.py b/dm/tools/elf_module.py
index c7d20dc..0c7c48f 100644
--- a/dm/tools/elf_module.py
+++ b/dm/tools/elf_module.py
@@ -115,8 +115,8 @@ def find_functions(img, text_end, symbols, relocs):
         end = order[i] if i < len(order) else text_end
         if i and a < funcs[order[i - 1]][0]:
             # Inside a known function. A direct call or branch from another function lands there only on an entry: the PLT is the usual case (one FDE for the whole table, each stub called on its own).
-            # The function is split at the target; anything else that merely points inside is not an entry
-            if how != 'call' or a == order[i - 1]: return False
