diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index 0327f49..ace4b8c 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -44,6 +44,17 @@ thread_local bool g_exit_requested;   // a service handler asked this guest thre
 uint64_t g_stats[AOT_S_N];
 enum { S_CALLS = AOT_S_CALLS, S_JUMPS = AOT_S_JUMPS, S_FALLBACK = AOT_S_FALLBACK, S_READS = AOT_S_READS, S_WRITES = AOT_S_WRITES, S_REGIONS = AOT_S_REGIONS };
 inline void count(int i) { __atomic_fetch_add(&g_stats[i], 1, __ATOMIC_RELAXED); }   // guest threads run the lifted code at once
+// The memory counters are bumped on every guest load and store by every thread: one shared atomic made them a cache-line fight (a game with 36 threads ran at a frame a second). Each thread counts in its own
+// slot, aot_stat sums the slots. A slot is never freed (a thread that ended keeps its counts)
+struct MemCounts { uint64_t reads, writes; };
+std::mutex g_counts_mu; std::vector<MemCounts *> g_counts;
+inline MemCounts &mem_counts() {
+    static thread_local MemCounts *mine = nullptr;
+    if (!mine) { mine = new MemCounts{0, 0}; std::lock_guard<std::mutex> g(g_counts_mu); g_counts.push_back(mine); }
+    return *mine;
+}
+inline void count_read() { mem_counts().reads++; }
+inline void count_write() { mem_counts().writes++; }
 
 [[noreturn]] void fail(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
 [[noreturn]] void fail(const char *fmt, ...) {
@@ -53,9 +64,11 @@ inline void count(int i) { __atomic_fetch_add(&g_stats[i], 1, __ATOMIC_RELAXED);
 }
 
 uint8_t *guest(uint64_t a, uint64_t n, const char *what) {
+    static thread_local unsigned last = 0;   // most accesses hit the region the previous one did (the stack, the heap): look there first
+    if (last < MAX_REGIONS) { const Region &r = g_regions[last]; const uint64_t base = r.base, size = r.size; if (a >= base && n <= size && a - base <= size - n && size) return r.host + (a - base); }
     for (unsigned i = 0, e = g_nregions.load(std::memory_order_acquire); i < e; i++) {
         const Region &r = g_regions[i]; const uint64_t base = r.base, size = r.size;
-        if (a >= base && n <= size && a - base <= size - n) return r.host + (a - base);
+        if (a >= base && n <= size && a - base <= size - n) { last = i; return r.host + (a - base); }
     }
     fail("guest %s of %llu bytes at %#llx is outside every mapped region", what, (unsigned long long)n, (unsigned long long)a);
 }
@@ -132,8 +145,8 @@ bool __remill_flag_computation_overflow(bool r, ...) { return r; }
 COMPARE(eq) COMPARE(neq) COMPARE(slt) COMPARE(sle) COMPARE(sgt) COMPARE(sge) COMPARE(ult) COMPARE(ule) COMPARE(ugt) COMPARE(uge)
 
 #define ACCESS(N, T) \
-    T __remill_read_memory_##N(Memory *, uint64_t a) { T v; memcpy(&v, guest(a, sizeof(T), "read"), sizeof v); count(S_READS); return v; } \
-    Memory *__remill_write_memory_##N(Memory *m, uint64_t a, T v) { memcpy(guest(a, sizeof(T), "write"), &v, sizeof v); count(S_WRITES); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
+    T __remill_read_memory_##N(Memory *, uint64_t a) { T v; memcpy(&v, guest(a, sizeof(T), "read"), sizeof v); count_read(); return v; } \
+    Memory *__remill_write_memory_##N(Memory *m, uint64_t a, T v) { memcpy(guest(a, sizeof(T), "write"), &v, sizeof v); count_write(); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
 ACCESS(8, uint8_t) ACCESS(16, uint16_t) ACCESS(32, uint32_t) ACCESS(64, uint64_t)
 ACCESS(f32, float) ACCESS(f64, double)   // scalar floating-point loads and stores (ldr s0, str d0...)
 
@@ -143,7 +156,7 @@ ACCESS(f32, float) ACCESS(f64, double)   // scalar floating-point loads and stor
     Memory *__remill_compare_exchange_memory_##N(Memory *m, uint64_t a, T &expected, T desired) { \
         if (a % sizeof(T)) fail("atomic access of %u bytes at %#llx is not naturally aligned", (unsigned)sizeof(T), (unsigned long long)a); \
         __atomic_compare_exchange_n((T *)guest(a, sizeof(T), "atomic access"), &expected, desired, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); \
-        count(S_WRITES); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
+        count_write(); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
 CAS(8, uint8_t) CAS(16, uint16_t) CAS(32, uint32_t) CAS(64, uint64_t)
 Memory *__remill_atomic_begin(Memory *m) { return m; }   // the CAS above is the atomic operation; these only bracket the instruction
 Memory *__remill_atomic_end(Memory *m) { return m; }
@@ -195,6 +208,7 @@ Memory *__remill_async_hyper_call(State &st, uint64_t pc, Memory *m) {
 #define X(i) regs[i] = st.gpr.x##i.qword;
     XREGS(X)
 #undef X
+    st.hyper_call = AsyncHyperCall::kInvalid;   // consumed: the next asynchronous hyper call that sets none (SYS: dc, ic) must not look like this svc again
     aot_svc_handler(num, regs, at);
     if (g_exit_requested) { g_exit_requested = false; fail("thread exited"); }
 #define X(i) st.gpr.x##i.qword = regs[i];
@@ -272,8 +286,13 @@ void aot_unmap_all() {
 }
 int aot_poke(uint64_t a, const uint8_t *src, uint64_t n) { jmp_buf jb, *outer = g_jb; g_jb = &jb; if (setjmp(jb)) { g_jb = outer; return 1; } memcpy(guest(a, n, "poke"), src, n); g_jb = outer; if (aot_write_hook) aot_write_hook(a, n); return 0; }
 int aot_peek(uint64_t a, uint8_t *dst, uint64_t n) { jmp_buf jb, *outer = g_jb; g_jb = &jb; if (setjmp(jb)) { g_jb = outer; return 1; } memcpy(dst, guest(a, n, "peek"), n); g_jb = outer; return 0; }
-uint64_t aot_stat(int i) { return g_stats[i]; }
-void aot_stats_reset() { memset(g_stats, 0, sizeof g_stats); }
+uint64_t aot_stat(int i) {
+    if (i != S_READS && i != S_WRITES) return g_stats[i];
+    std::lock_guard<std::mutex> g(g_counts_mu); uint64_t n = 0;
+    for (const MemCounts *c : g_counts) n += i == S_READS ? c->reads : c->writes;
+    return n;
+}
+void aot_stats_reset() { memset(g_stats, 0, sizeof g_stats); std::lock_guard<std::mutex> g(g_counts_mu); for (MemCounts *c : g_counts) *c = {0, 0}; }
 
 // Run the AOT function at pc on the registers of g; 0 when it returned, else 1 with the reason in err
 int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
@@ -286,7 +305,7 @@ int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
     st.fpcr.flat = (uint32_t)g->fpcr; aot_fpsr_set(st, (uint32_t)g->fpsr);
     st.sr.n = g->nzcv >> 3 & 1; st.sr.z = g->nzcv >> 2 & 1; st.sr.c = g->nzcv >> 1 & 1; st.sr.v = g->nzcv & 1;
     jmp_buf jb; int rc = 0;
-    State *outer_state = g_state; g_state = &st;
+    State *outer_state = g_state; jmp_buf *outer_jb = g_jb; g_state = &st;
     if (setjmp(jb)) rc = 1;
     else {
         g_jb = &jb;
@@ -296,7 +315,7 @@ int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
         else if (aot_fallback) { count(S_FALLBACK); aot_fallback(&st, pc, token, 0); }   // an entry the translator did not lift (a stub, a module's init function) runs in the JIT
         else fail("no AOT function at %#llx", (unsigned long long)pc);
     }
-    g_jb = nullptr; g_state = outer_state;
+    g_jb = outer_jb; g_state = outer_state;   // a run started from a service handler (a nested call into the guest) hands the outer run its jump buffer back
 #define X(i) g->x[i] = st.gpr.x##i.qword;
     X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
 #undef X
diff --git a/dm/tools/jump_tables.py b/dm/tools/jump_tables.py
index 0124410..770b08f 100644
--- a/dm/tools/jump_tables.py
+++ b/dm/tools/jump_tables.py
@@ -7,7 +7,7 @@ every dispatch left the recompiled code for the JIT. The compilers' shapes handl
     add  x10, x10, x11, lsl #2              target = BASE + (entry << 2)   (or an extended register: `add x3, x3, w1, sxtb #2`)
     br   x10
 How it is done: a small symbolic run over the straight line before each `br` tracks which registers hold a known address and which hold a table entry; the `br` register must end as BASE + extend(entry) << shift.
-The number of entries comes from the guard (`cmp wN, #k` before the `br`, plus a slack of one), else the table is read while its targets fall inside the function. Every target outside the function is
+The number of entries comes from the guard (`cmp wN, #k` before the `br`, plus a slack of one; with a `ccmp` next to it, the larger of the two), else the table is read while its targets fall inside the function. Every target outside the function is
 dropped. An entry that is not really in the table only costs a lifted block nobody jumps to. A `br` this does not recognise is an ordinary indirect jump and stays one (a function pointer in a register, a tail call).
 find_jump_tables(img, start, end) -> [JumpTable]"""
 import re, struct
@@ -91,8 +91,16 @@ def _resolve(img, ins, i, start, end):
     _, base, (_, taddr, width, signed, ishift), kind, shift = j
     # the entry count: the nearest `cmp reg, #k` before the br (the guard of the switch), one more for slack; else scan while the targets are inside the function
     n = None
-    for x in reversed(ins[max(0, i - 120):i]):
-        if x.mnemonic == 'cmp' and re.fullmatch(r'[xw]\d+, #\w+', x.op_str): n = min(_imm(x.op_str.split(', ')[1]) + 2, CAP); break
+    for k in range(i - 1, max(0, i - 120) - 1, -1):
+        x = ins[k]
+        if x.mnemonic == 'cmp' and re.fullmatch(r'[xw]\d+, #\w+', x.op_str):
+            n = _imm(x.op_str.split(', ')[1])
+            # a compound guard (`cmp w4, #0 ; ccmp w8, #3, #2, ne ; b.hi default`, LLVM's `a != 0 && b <= 3`): the bound is the largest immediate of the compares right around it
+            for y in ins[max(0, k - 3):k + 4]:
+                if y.mnemonic == 'ccmp':
+                    mm = re.fullmatch(r'[xw]\d+, #(\w+), #\w+, \w+', y.op_str)
+                    if mm: n = max(n, _imm(mm.group(1)))
+            n = min(n + 2, CAP); break
     targets, k = set(), 0
     while k < (n or CAP):
         at = taddr + k * width
