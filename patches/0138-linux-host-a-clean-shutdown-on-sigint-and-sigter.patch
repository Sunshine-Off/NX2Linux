+CHILD = textwrap.dedent('''
+    import sys, time, threading
+    sys.path.insert(0, %(tools)r)
+    import horizon_shutdown as hs
+    sd = hs.Shutdown()
+    sd.add('report', lambda: print('report printed', flush=True), 5)
+    if %(slow)r: sd.add('slow', lambda: time.sleep(60), 60)
+    hs.Signals(sd).install()
+    print('ready', flush=True)
+    time.sleep(60)   # the main thread is not available to a handler for long: the shutdown has its own thread
+''')
+
