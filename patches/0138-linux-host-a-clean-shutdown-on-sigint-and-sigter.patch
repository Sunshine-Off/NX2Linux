+class Stall(unittest.TestCase):
+    def tearDown(self):
+        while OPEN: OPEN.pop().stop()
+
+    def test_off_by_default(self):
+        s, hz, clock, lines = make(); s.step(); hz.frames_presented = 5; advance(s, clock, hz, 600)
+        self.assertEqual(lines, []); self.assertEqual(s.stalls, 0)
+
+    def test_no_stall_before_the_first_frame(self):
+        s, hz, clock, lines = make(stall_after=30); advance(s, clock, hz, 300)
+        self.assertEqual(s.stalls, 0); self.assertEqual(lines, [])
+
+    def test_a_stall_is_reported_once_with_where_the_threads_are(self):
+        s, hz, clock, lines = make(stall_after=30); s.step(); advance(s, clock, hz, 20, frames_per_s=18)
+        advance(s, clock, hz, 100, frames_per_s=0)
+        self.assertEqual(s.stalls, 1)
+        self.assertEqual(len([l for l in lines if l.startswith('[stall] no frame')]), 1)
+        msg = [l for l in lines if l.startswith('[stall] no frame')][0]
+        self.assertIn('no frame presented for 30 s', msg); self.assertIn('frames so far 360', msg); self.assertIn('thread 1: nnMain', msg)
+
+    def test_it_re_arms_after_the_frames_resume(self):
+        s, hz, clock, lines = make(stall_after=10); s.step(); advance(s, clock, hz, 5, frames_per_s=10)
+        advance(s, clock, hz, 15)                      # first stall
+        advance(s, clock, hz, 3, frames_per_s=10)      # frames again
+        advance(s, clock, hz, 15)                      # second stall
+        self.assertEqual(s.stalls, 2); self.assertEqual(len([l for l in lines if l.startswith('[stall] frames again')]), 1)
+
+    def test_the_stall_flag_and_idle_seconds_are_in_the_file(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            s, hz, clock, _ = make(tmp, interval=1000, stall_after=5); s.step(); advance(s, clock, hz, 3, frames_per_s=10)
+            advance(s, clock, hz, 6)
+            rows = [dict(zip(hk.COLUMNS, l.split(','))) for l in Path(s.path).read_text().splitlines()[1:]]
+        self.assertEqual(rows[-1]['stall'], '1'); self.assertEqual(rows[-1]['idle_s'], '5'); self.assertEqual(rows[0]['stall'], '0')
+
+    def test_a_thread_report_that_fails_does_not_stop_the_detector(self):
+        s, hz, clock, lines = make(stall_after=5)
+        def boom(): raise RuntimeError('guest memory gone')
+        hz.thread_report = boom; s.step(); advance(s, clock, hz, 2, frames_per_s=10); advance(s, clock, hz, 8)
+        self.assertEqual(s.stalls, 1); self.assertTrue(any('no thread report: RuntimeError' in l for l in lines))
