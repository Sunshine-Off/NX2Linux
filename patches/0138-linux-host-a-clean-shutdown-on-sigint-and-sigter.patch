+    def test_a_second_signal_while_the_steps_run_leaves_at_once(self):
+        sd, lines, codes = make(); first = threading.Event(); gate = threading.Event()
+        sd.exit_fn = lambda c: (codes.append(c), first.set() if len(codes) == 1 else None)
+        sd.add('slow', lambda: gate.wait(10), timeout=10)
+        sg = hs.Signals(sd, sigs=(signal.SIGUSR1,)); sg.install()
+        try:
+            os.kill(os.getpid(), signal.SIGUSR1)
+            while not sd.running(): time.sleep(0.001)
+            os.kill(os.getpid(), signal.SIGUSR1)
+            self.assertTrue(first.wait(5), lines)
+            self.assertEqual(codes, [128 + signal.SIGUSR1]); self.assertIn('[shutdown] second signal: leaving now', lines)
+            self.assertEqual(sd.results, [])   # the slow step had not finished: nothing was waited for
+        finally: gate.set(); sg.uninstall()
