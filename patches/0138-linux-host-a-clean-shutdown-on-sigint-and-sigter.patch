+"""Long run sampler and stall detector (horizon_soak.py, issue 22). No game: a fake Horizon, a fake clock and a fake /proc reader."""
+import os, sys, tempfile, types, unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(TOOLS))
+import horizon_soak as hk
+
+
+OPEN = []   # every Soak a test made, closed after it
+
+
+class Clock:
+    def __init__(self): self.t = 1000.0
+    def __call__(self): return self.t
+
+
+def make(tmp=None, **kw):
+    hz = types.SimpleNamespace(frames_presented=0, thread_faults=[], thread_report=lambda: '  thread 1: nnMain 0.0 s ago: sub_1')
+    clock, lines = Clock(), []
+    path = os.path.join(tmp, 'soak.csv') if tmp else None
+    s = hk.Soak(hz, path, clock=clock, proc=lambda: (2048, 12, 30), say=lambda text, flush=False: lines.append(text), **kw)
+    OPEN.append(s)
+    return s, hz, clock, lines
+
+
+def advance(s, clock, hz, seconds, frames_per_s=0, tick=1.0):
+    """Moves the clock second by second, the game presenting `frames_per_s` frames each second"""
+    n = int(seconds / tick)
+    for _ in range(n):
+        clock.t += tick; hz.frames_presented += int(frames_per_s * tick); s.step()
+
+
+class Rows(unittest.TestCase):
+    def tearDown(self):
+        while OPEN: OPEN.pop().stop()
+
+    def test_the_file_has_a_header_then_a_line_every_interval(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            s, hz, clock, _ = make(tmp, interval=10)
+            s.step(); advance(s, clock, hz, 25, frames_per_s=18)
+            rows = Path(s.path).read_text().splitlines()
+        self.assertEqual(rows[0], ','.join(hk.COLUMNS))
+        self.assertEqual(len(rows), 1 + 3)   # t=0, t=10, t=20
+        first, second = rows[1].split(','), rows[2].split(',')
+        self.assertEqual(first[0], '0.0'); self.assertEqual(second[0], '10.0')
+        self.assertEqual(dict(zip(hk.COLUMNS, second))['rss_kb'], '2048'); self.assertEqual(dict(zip(hk.COLUMNS, second))['threads'], '12'); self.assertEqual(dict(zip(hk.COLUMNS, second))['fds'], '30')
+        self.assertEqual(dict(zip(hk.COLUMNS, second))['frames'], '180'); self.assertEqual(dict(zip(hk.COLUMNS, second))['fps'], '18.00')
+
+    def test_an_existing_file_is_appended_to_without_a_second_header(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            s, hz, clock, _ = make(tmp, interval=10); s.step(); s.file.close()
+            s2, hz2, clock2, _ = make(tmp, interval=10); s2.step()
+            lines = Path(s.path).read_text().splitlines()
+        self.assertEqual(sum(1 for l in lines if l.startswith('t_s')), 1); self.assertEqual(len(lines), 3)
+
+    def test_the_final_line_is_written_on_demand(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            s, hz, clock, _ = make(tmp, interval=10); s.step(); advance(s, clock, hz, 4, frames_per_s=10); s.final_row()
+            rows = Path(s.path).read_text().splitlines()
+        self.assertEqual(len(rows), 3); self.assertEqual(rows[-1].split(',')[0], '4.0'); self.assertEqual(rows[-1].split(',')[4], '40')
+
+    def test_a_proc_that_says_nothing_leaves_empty_cells(self):
