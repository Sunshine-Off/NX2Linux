+@unittest.skipUnless(sys.platform.startswith('linux'), 'real signals, Linux only')
+class Child(unittest.TestCase):
+    def run_child(self, sig, slow=False, second=False):
+        p = subprocess.Popen([sys.executable, '-I', '-c', CHILD % {'tools': str(TOOLS), 'slow': slow}], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        try:
+            self.assertEqual(p.stdout.readline().strip(), 'ready')
+            p.send_signal(sig)
+            if second:
+                while True:
+                    line = p.stdout.readline()
+                    if 'report: ok' in line or not line: break   # the next step, `slow`, is now running
+                p.send_signal(sig)
+            out, _ = p.communicate(timeout=20)
+        finally:
+            if p.poll() is None: p.kill()
+        return p.returncode, out
+
+    def test_ctrl_c_prints_the_report_and_exits_130(self):
+        code, out = self.run_child(signal.SIGINT)
+        self.assertEqual(code, 130, out); self.assertIn('report printed', out); self.assertIn('[shutdown] signal SIGINT: stopping', out)
+        self.assertIn('[shutdown] report: ok', out)
+
+    def test_sigterm_exits_143(self):
+        code, out = self.run_child(signal.SIGTERM)
+        self.assertEqual(code, 143, out); self.assertIn('report printed', out)
+
+    def test_a_second_ctrl_c_leaves_a_blocked_shutdown_at_once(self):
+        t0 = time.monotonic(); code, out = self.run_child(signal.SIGINT, slow=True, second=True)
+        self.assertEqual(code, 130, out); self.assertIn('second signal: leaving now', out); self.assertLess(time.monotonic() - t0, 20)
+
