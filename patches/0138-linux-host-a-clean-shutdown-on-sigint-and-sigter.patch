+class InProcess(unittest.TestCase):
+    def test_a_signal_runs_the_steps_and_the_code_is_128_plus_it(self):
+        sd, lines, codes = make(); done = threading.Event(); sd.exit_fn = lambda c: (codes.append(c), done.set())
+        ran = []; sd.add('a', lambda: ran.append('a'))
+        sg = hs.Signals(sd, sigs=(signal.SIGUSR1,))
+        self.assertTrue(sg.install())
