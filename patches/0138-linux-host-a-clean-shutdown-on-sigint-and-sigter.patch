+            self.assertEqual(dict(zip(hk.COLUMNS, Path(s.path).read_text().splitlines()[1].split(',')))['thread_faults'], '2')
+
+    def test_a_file_that_cannot_be_opened_says_so_and_the_run_goes_on(self):
+        s, hz, clock, lines = make(); s2 = hk.Soak(hz, '/nonexistent-dir/x.csv', clock=clock, proc=lambda: (1, 1, 1), say=lambda t, flush=False: lines.append(t))
