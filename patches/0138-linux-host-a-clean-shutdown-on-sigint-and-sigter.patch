diff --git a/dm/tools/horizon_shutdown.py b/dm/tools/horizon_shutdown.py
new file mode 100644
index 00000000..768a1147
--- /dev/null
+++ b/dm/tools/horizon_shutdown.py
@@ -0,0 +1,96 @@
+"""Clean shutdown of a run on Linux (issue 22): the end of the run, SIGINT and SIGTERM all stop the same way.
+Until now the run ended with os._exit(0) after a timer and a signal killed it without a report. Now every way out runs the same ordered steps, each with its own time limit: drain the GPU queue, print the report, close the audio mixer. A step that blocks or fails does not stop the others, and the run says which one did.
+The exit code is 0 at the end of the run and 128 plus the signal number after a signal (130 for Ctrl-C, 143 for SIGTERM). A second signal while the shutdown runs leaves at once.
+A signal reaches the main thread only between two Python instructions, and the main thread of a run is inside recompiled game code most of the time. So the C handler writes the signal number to a pipe (signal.set_wakeup_fd) and a thread reads it: the shutdown does not wait for the main thread."""
+import os, signal, threading, time
+
+SIGNALS = tuple(s for s in (getattr(signal, 'SIGINT', None), getattr(signal, 'SIGTERM', None)) if s is not None)
+
+
+class Shutdown:
+    """Ordered steps, run once. `exit_fn` ends the process (os._exit, a fake in the tests)"""
+
+    def __init__(self, say=print, exit_fn=os._exit, clock=time.monotonic):
+        self.steps, self.say, self.exit_fn, self.clock = [], say, exit_fn, clock
+        self.lock, self.began, self.results = threading.Lock(), None, []
+
+    def add(self, name, fn, timeout=5.0):
+        """A step. Steps run in the order they were added, each in its own thread, and one that is not back after `timeout` seconds is left behind"""
+        self.steps.append((name, fn, timeout))
+
+    def running(self):
+        return self.began is not None
+
+    def run(self, reason, code=0):
+        """Runs the steps, then ends the process with `code`. Returns False without doing anything if a shutdown is already running"""
+        with self.lock:
+            if self.began is not None: return False
+            self.began = self.clock()
+        self.say(f'[shutdown] {reason}: stopping', flush=True)
+        for name, fn, timeout in self.steps:
+            outcome = self.step(fn, timeout); self.results.append((name, outcome))
+            self.say(f'[shutdown] {name}: {outcome}', flush=True)
+        self.say(f'[shutdown] done in {self.clock() - self.began:.1f} s, exit code {code}', flush=True)
+        self.exit_fn(code)
+        return True
+
+    def step(self, fn, timeout):
+        box = {}
+        def target():
+            try: fn(); box['r'] = 'ok'
+            except BaseException as e: box['r'] = f'failed: {type(e).__name__}: {e}'
+        t = threading.Thread(target=target, name='shutdown-step', daemon=True); t.start(); t.join(timeout)
+        return box.get('r') or f'still running after {timeout:g} s, left behind'
+
+    def force(self, code):
+        self.say('[shutdown] second signal: leaving now', flush=True)
+        self.exit_fn(code)
+
+
+class Signals:
+    """SIGINT and SIGTERM start the shutdown with the code 128 plus the signal number, from a thread of our own"""
+
+    def __init__(self, sd, sigs=SIGNALS):
+        self.sd, self.sigs, self.old, self.old_fd, self.rfd, self.wfd, self.thread = sd, sigs, {}, -1, -1, -1, None
+
+    def install(self):
+        """Needs the main thread (Python allows signal handlers nowhere else). Returns False and changes nothing from another thread"""
+        if threading.current_thread() is not threading.main_thread(): return False
+        self.rfd, self.wfd = os.pipe(); os.set_blocking(self.wfd, False)
+        self.old_fd = signal.set_wakeup_fd(self.wfd, warn_on_full_buffer=False)
+        for s in self.sigs: self.old[s] = signal.signal(s, lambda *a: None)   # the C handler is what writes to the pipe, this Python one has nothing to do
+        self.thread = threading.Thread(target=self.watch, name='shutdown-signals', daemon=True); self.thread.start()
+        return True
+
+    def watch(self):
+        while True:
+            try: data = os.read(self.rfd, 16)
+            except OSError: return
+            if not data: return
+            for b in data:
+                if b in self.sigs: self.deliver(b)
+
+    def deliver(self, signum):
+        code = 128 + signum
+        if self.sd.running(): self.sd.force(code)
+        else: threading.Thread(target=self.sd.run, args=(f'signal {signal.Signals(signum).name}', code), name='shutdown', daemon=True).start()
+
+    def uninstall(self):
+        for s, h in self.old.items(): signal.signal(s, h)
+        if self.wfd >= 0:
+            signal.set_wakeup_fd(self.old_fd)
+            os.close(self.wfd)   # the end of the pipe ends watch()
+            if self.thread is not None: self.thread.join(2)
+            os.close(self.rfd); self.rfd = self.wfd = -1
+        self.old = {}
+
+
+def standard_steps(sd, hz, report, mixer_timeout=5.0):
+    """What a run of the host stops, in this order: the GPU queue drains so that the report counts the last frames, the report, then the mixer (a WAV file gets its final header)"""
+    def drain():
+        nvn = getattr(hz, 'nvn', None)
+        if nvn is not None and getattr(nvn, 'jobs', None) is not None: nvn.drain()
+    def close_mixer():
+        audio = getattr(hz, 'audio', None)
+        if audio is not None and getattr(audio, 'mixer', None): audio.mixer.close()
+    sd.add('gpu queue drain', drain, 5.0); sd.add('report', report, 30.0); sd.add('audio mixer', close_mixer, mixer_timeout)
diff --git a/dm/tools/horizon_soak.py b/dm/tools/horizon_soak.py
new file mode 100644
index 00000000..9e638b41
--- /dev/null
+++ b/dm/tools/horizon_soak.py
@@ -0,0 +1,111 @@
+"""Long run sampler and stall detector for the Linux host (issue 22).
+NX2LINUX_SOAK_LOG=FILE appends one line to FILE every NX2LINUX_SOAK_INTERVAL seconds (10 by default, at least 1): the time into the run, the resident memory, the threads and open files of the process, the frames presented, the frame rate since the last line, the seconds since the last new frame, the guest threads that stopped and whether a stall is on. The file is written as it goes and flushed, so a run that dies (killed, out of memory) leaves everything up to its last line. tools/soak_summary.py reads it.
+NX2LINUX_STALL_SECONDS=N reports a stall when no new frame was presented for N seconds, once the first frame exists (loading before it is never a stall): one `[stall]` message with where the guest threads are (Horizon.thread_report), once per stall, again after the frames resumed and stopped again. It reports and does not stop the run. 0 or unset turns it off.
+Off unless one of the two is set. A frame is seen when the sampler wakes up, once per second, so a stall is noticed up to a second late."""
+import os, threading, time
+
+COLUMNS = ('t_s', 'rss_kb', 'threads', 'fds', 'frames', 'fps', 'idle_s', 'thread_faults', 'stall')
+
+
+def read_proc(root='/proc/self'):
+    """(resident kB, threads, open files) of this process, None for what /proc does not say (no /proc: all None)"""
+    rss = threads = fds = None
+    try:
+        with open(f'{root}/status') as f:
+            for line in f:
+                if line.startswith('VmRSS:'): rss = int(line.split()[1])
+                elif line.startswith('Threads:'): threads = int(line.split()[1])
+    except (OSError, ValueError, IndexError): pass
+    try: fds = len(os.listdir(f'{root}/fd'))
+    except OSError: pass
+    return rss, threads, fds
+
+
+class Soak:
+    def __init__(self, hz, path=None, interval=10.0, stall_after=0.0, tick=1.0, clock=time.monotonic, proc=read_proc, say=print):
+        self.hz, self.path, self.interval, self.stall_after, self.tick = hz, path, max(interval, 0.0), stall_after, tick
+        self.clock, self.proc, self.say = clock, proc, say
+        self.t0 = clock(); self.last_frames, self.last_change = -1, self.t0
+        self.row_t, self.row_frames = None, 0
+        self.stalled, self.stalls, self.file, self.stop_ev, self.thread = False, 0, None, threading.Event(), None
+        if path: self.open()
+
+    def open(self):
+        try:
+            fresh = not os.path.exists(self.path) or os.path.getsize(self.path) == 0
+            self.file = open(self.path, 'a')
+            if fresh: self.file.write(','.join(COLUMNS) + '\n'); self.file.flush()
+        except OSError as e:
+            self.say(f'[soak] cannot write {self.path}: {e}: no soak log', flush=True); self.file = None
+
+    def frames(self): return getattr(self.hz, 'frames_presented', 0)
+
+    def step(self, now=None):
+        """One wake up: look for a stall, write a line when one is due"""
+        now = self.clock() if now is None else now
+        frames = self.frames()
+        if frames != self.last_frames:
+            if self.stalled: self.say(f'[stall] frames again after {now - self.last_change:.0f} s without one (now {frames})', flush=True)
+            self.last_frames, self.last_change, self.stalled = frames, now, False
+        idle = now - self.last_change
+        began = False
+        if self.stall_after > 0 and frames > 0 and idle >= self.stall_after and not self.stalled:
+            self.stalled, began = True, True; self.stalls += 1
+            self.say(f'[stall] no frame presented for {idle:.0f} s (frames so far {frames}). Guest threads:\n{self.where()}', flush=True)
+        if self.file and (began or self.row_t is None or now - self.row_t >= self.interval): self.row(now, frames, idle)
+
+    def where(self):
+        try: return self.hz.thread_report()
+        except Exception as e: return f'  (no thread report: {type(e).__name__}: {e})'
+
+    def row(self, now, frames, idle):
+        rss, threads, fds = self.proc()
+        dt = now - self.row_t if self.row_t is not None else 0
+        fps = (frames - self.row_frames) / dt if dt > 0 else 0.0
+        faults = len(getattr(self.hz, 'thread_faults', []))
+        cells = (f'{now - self.t0:.1f}', *('' if v is None else v for v in (rss, threads, fds)), frames, f'{fps:.2f}', f'{idle:.0f}', faults, int(self.stalled))
+        try: self.file.write(','.join(str(c) for c in cells) + '\n'); self.file.flush()
+        except (OSError, ValueError): self.file = None
+        self.row_t, self.row_frames = now, frames
+
+    def final_row(self):
+        """The line of the end of the run, so that the file ends at the end and not up to ten seconds before it"""
+        if self.file: self.row(self.clock(), self.frames(), self.clock() - self.last_change)
+
+    def loop(self):
+        while not self.stop_ev.is_set():
+            try: self.step()
+            except Exception as e: self.say(f'[soak] sampler error: {type(e).__name__}: {e}', flush=True)
+            self.stop_ev.wait(self.tick)
+
+    def start(self):
+        self.thread = threading.Thread(target=self.loop, name='soak', daemon=True); self.thread.start()
+        return self
+
+    def stop(self):
+        """Ends the sampler thread and closes the file"""
+        self.stop_ev.set()
+        if self.thread is not None and self.thread is not threading.current_thread(): self.thread.join(5)
+        f, self.file = self.file, None
+        if f:
+            try: f.close()
+            except OSError: pass
+
+
+def number(environ, name, default, say, low=0.0):
+    raw = environ.get(name, '').strip()
+    if not raw: return default
+    try: v = float(raw)
+    except ValueError: say(f'[soak] {name}={raw!r} is not a number: using {default:g}', flush=True); return default
+    return max(v, low)
+
+
+def from_env(hz, environ=None, say=print):
+    """A started Soak when NX2LINUX_SOAK_LOG or NX2LINUX_STALL_SECONDS is set, else None"""
+    environ = os.environ if environ is None else environ
+    path = environ.get('NX2LINUX_SOAK_LOG', '').strip() or None
+    stall = number(environ, 'NX2LINUX_STALL_SECONDS', 0.0, say)
+    if not path and stall <= 0: return None
+    s = Soak(hz, path, interval=number(environ, 'NX2LINUX_SOAK_INTERVAL', 10.0, say, low=1.0), stall_after=stall, say=say)
+    say(f'[soak] sampling every {s.interval:g} s' + (f' into {os.path.basename(path)}' if s.file else ' (no file)') + (f', a stall is {stall:g} s without a frame' if stall > 0 else ''), flush=True)
+    return s.start()
diff --git a/dm/tools/tests/test_horizon_run_shutdown.py b/dm/tools/tests/test_horizon_run_shutdown.py
