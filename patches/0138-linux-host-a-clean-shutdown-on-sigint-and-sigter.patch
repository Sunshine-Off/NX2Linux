@@ -0,0 +1,24 @@
+"""horizon_run.py wires the clean shutdown and the soak sampler (issue 22). The run itself needs a game, so this reads the source: the end of the run no longer calls os._exit by itself, it goes through the Shutdown steps."""
+import sys, unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parents[1]
+SRC = (TOOLS / 'horizon_run.py').read_text()
+
+
+class Wiring(unittest.TestCase):
+    def test_the_end_of_the_run_goes_through_the_shutdown(self):
+        stop = SRC[SRC.index('    def stop():'):SRC.index('    started = time.time()')]
+        self.assertIn("sd.run('end of the run', 0)", stop); self.assertNotIn('os._exit', stop)
+
+    def test_the_steps_the_signals_and_the_sampler_are_set_up_before_the_timer_starts(self):
+        for needle in ('horizon_shutdown.standard_steps(sd, hz, report)', 'horizon_soak.from_env(hz)', "sd.add('soak log', soak.final_row"):
+            self.assertIn(needle, SRC)
+        self.assertLess(SRC.index('horizon_shutdown.standard_steps'), SRC.index('threading.Timer(a.seconds, stop).start()'))
+        self.assertLess(SRC.index('threading.Timer(a.seconds, stop).start()'), SRC.index('horizon_shutdown.Signals(sd).install()'))
+
+    def test_the_modules_are_imported(self):
+        self.assertIn('import horizon_hle, horizon_overrides, horizon_shutdown, horizon_soak', SRC)
+
+
+if __name__ == '__main__': unittest.main()
diff --git a/dm/tools/tests/test_horizon_shutdown.py b/dm/tools/tests/test_horizon_shutdown.py
new file mode 100644
index 00000000..7ca05bab
--- /dev/null
+++ b/dm/tools/tests/test_horizon_shutdown.py
@@ -0,0 +1,170 @@
+"""Clean shutdown (horizon_shutdown.py, issue 22): ordered steps with a time limit each, one run, exit codes 128 plus the signal. No game: fake steps, and a child process that gets real SIGINT and SIGTERM."""
+import os, signal, subprocess, sys, textwrap, threading, time, types, unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(TOOLS))
+import horizon_shutdown as hs
+
+
+def make():
+    lines, codes = [], []
+    def say(text, flush=False): lines.append(text)
+    return hs.Shutdown(say=say, exit_fn=codes.append), lines, codes
+
+
+class Steps(unittest.TestCase):
+    def test_steps_run_in_the_order_they_were_added_then_the_process_ends(self):
+        sd, lines, codes = make(); order = []
+        sd.add('a', lambda: order.append('a')); sd.add('b', lambda: order.append('b')); sd.add('c', lambda: order.append('c'))
+        self.assertTrue(sd.run('test', 0))
+        self.assertEqual(order, ['a', 'b', 'c']); self.assertEqual(codes, [0])
+        self.assertEqual([r for r in sd.results], [('a', 'ok'), ('b', 'ok'), ('c', 'ok')])
+        self.assertEqual(lines[0], '[shutdown] test: stopping'); self.assertIn('exit code 0', lines[-1])
+
+    def test_a_step_that_fails_does_not_stop_the_others(self):
+        sd, lines, codes = make(); order = []
+        def bad(): raise RuntimeError('disk gone')
+        sd.add('bad', bad); sd.add('after', lambda: order.append('after'))
+        sd.run('test', 0)
+        self.assertEqual(order, ['after']); self.assertEqual(sd.results[0], ('bad', 'failed: RuntimeError: disk gone'))
+        self.assertEqual(codes, [0])
+
+    def test_a_step_that_blocks_is_left_behind_after_its_limit(self):
+        sd, lines, codes = make(); order = []; release = threading.Event()
+        sd.add('stuck', lambda: release.wait(30), timeout=0.2); sd.add('after', lambda: order.append('after'))
+        t0 = time.monotonic(); sd.run('test', 0); took = time.monotonic() - t0
+        release.set()
+        self.assertLess(took, 5); self.assertEqual(order, ['after'])
+        self.assertIn('still running after 0.2 s', sd.results[0][1]); self.assertEqual(codes, [0])
+
+    def test_a_system_exit_in_a_step_is_only_a_failed_step(self):
+        sd, lines, codes = make()
+        def leave(): raise SystemExit(3)
+        sd.add('leave', leave); sd.run('test', 0)
+        self.assertTrue(sd.results[0][1].startswith('failed: SystemExit')); self.assertEqual(codes, [0])
+
+    def test_only_the_first_call_runs(self):
+        sd, lines, codes = make(); count = []
+        sd.add('a', lambda: count.append(1))
+        self.assertTrue(sd.run('one', 0)); self.assertFalse(sd.run('two', 5))
+        self.assertEqual(count, [1]); self.assertEqual(codes, [0])
+
+    def test_two_calls_at_once_run_the_steps_once(self):
+        sd, lines, codes = make(); count = []; gate = threading.Event()
+        sd.add('slow', lambda: (gate.wait(5), count.append(1)))
+        t = threading.Thread(target=sd.run, args=('one', 0)); t.start()
+        while not sd.running(): time.sleep(0.001)
+        self.assertFalse(sd.run('two', 9)); gate.set(); t.join(5)
+        self.assertEqual(count, [1]); self.assertEqual(codes, [0])
+
+
+class Standard(unittest.TestCase):
+    def test_the_queue_drains_then_the_report_then_the_mixer(self):
+        order = []
+        nvn = types.SimpleNamespace(jobs=object(), drain=lambda: order.append('drain'))
+        audio = types.SimpleNamespace(mixer=types.SimpleNamespace(close=lambda: order.append('mixer')))
+        sd, lines, codes = make(); hs.standard_steps(sd, types.SimpleNamespace(nvn=nvn, audio=audio), lambda: order.append('report'))
+        sd.run('test', 0)
+        self.assertEqual(order, ['drain', 'report', 'mixer']); self.assertEqual([n for n, _ in sd.results], ['gpu queue drain', 'report', 'audio mixer'])
+
+    def test_a_run_without_gpu_queue_or_audio_still_reports(self):
+        order = []
+        sd, lines, codes = make(); hs.standard_steps(sd, types.SimpleNamespace(), lambda: order.append('report'))
+        sd.run('test', 0)
+        self.assertEqual(order, ['report']); self.assertTrue(all(r == 'ok' for _, r in sd.results))
+
