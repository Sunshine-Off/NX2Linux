+        self.prog_names = {}   # program pointer -> the stage keys of its last resolution (for the alpha variant)
+        self.export_buf = C.create_string_buffer(1 << 18)
+        self.check = False                      # NX2LINUX_NVN_REPLAY=check: every stream goes through both paths and the draws are compared
+        self.checked = self.differed = self.shown = 0
