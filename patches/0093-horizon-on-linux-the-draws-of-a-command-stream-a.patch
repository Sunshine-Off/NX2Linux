@@ -0,0 +1,263 @@
+"""The replay of NVN command streams in C (NX2Linux S7bis): linux/host/nvnreplay.inc keeps the state a draw reads from the streams nvnrec.c records and turns each draw into the GPU library's call without
+Python: the conversion nvn_gpu.py GpuBackend._draw does, ported. This module is its Python side: the callbacks the C code asks when it meets a program, a render target or a texture binding it has not
+seen (the answers are kept there, once per frame for textures: a texture the game wrote since is read again), the encoding of the commands Python records itself into the same records, and the
+export of the C state when Python does a command itself (a clear, a compute dispatch, an indirect draw, a draw with storage images). NX2LINUX_NVN_REPLAY=py turns it off; =check runs both and compares the draws."""
+import ctypes as C
+import struct
+
+import horizon_gpu as hg
+import nvn_gpu
+import nvn_rec
+import nvn_spirv
+import nvn_state
+
+U32, U64 = C.c_uint32, C.c_uint64
+KIND = {'vs': 0, 'ps': 1, 'gs': 2, 'tcs': 3, 'tes': 4}
+MISC_BLEND_COLOR, MISC_DEPTH_RANGE, MISC_ALPHA_REF, MISC_POLY_OFFSET, MISC_PATCH_SIZE = range(1, 6)
+# the skip reasons the C code finds, in the order of its enum (nvnreplay.inc SK_*)
+SKIPS = ('no program', 'targets', 'no target', 'vertex stream not bound', 'vertex format', 'unreadable buffer', 'index buffer', 'primitive', 'patches without tessellation shaders',
+         'tessellation without both stages', 'too many buffers', 'alpha test: no variant', 'texture slot', 'program skipped', 'image skipped', 'texture skipped', 'empty draw')
+STAT_NAMES = ('draws', 'lib_errors', 'write_backs', 'prog_callbacks', 'image_callbacks', 'texture_callbacks', 'fallbacks')
+
+
