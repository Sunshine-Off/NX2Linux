+                elif k == 'alpha_ref': out.append(record(nvn_rec.OP_MISC, MISC_ALPHA_REF, fbits(v), 0, 0, 0))
+                elif k == 'polygon_offset': out.append(record(nvn_rec.OP_MISC, MISC_POLY_OFFSET, *[fbits(x) for x in v], 0))
