+        return by_stage
+
+    def prog_cb(self, ptr, out):
+        b, info = self.b, out[0]
+        try:
+            by_stage = self.stages_of(ptr)
+            if 'vs' not in by_stage or (set(by_stage) - set(nvn_gpu.NVN_STAGE)): raise nvn_gpu.Skip('stages ' + '+'.join(sorted(by_stage)))
+            loaded = {st: b.shader_of(key) for st, key in by_stage.items()}
+            info.nst = len(loaded)
+            for i, (st, (module, _, res)) in enumerate(loaded.items()):
+                s = info.st[i]; s.module, s.kind, s.nvn_stage = module, KIND[st], nvn_gpu.NVN_STAGE[st]
+                if len(res['cbufs']) > 32 or len(res['sbufs']) > 32 or len(res['textures']) > 32: raise nvn_gpu.Skip('more than 32 resources of a kind')
+                s.ncb, s.nsb, s.ntx, s.nim = len(res['cbufs']), len(res['sbufs']), len(res['textures']), len(res['images'])
+                for k, cb in enumerate(res['cbufs']): s.cb[k].binding, s.cb[k].slot = cb['binding'], cb['slot']
+                for k, sb in enumerate(res['sbufs']): s.sb[k].binding, s.sb[k].cb_slot, s.sb[k].cb_offset, s.sb[k].flags = sb['binding'], sb['cb_slot'], sb['cb_offset'], sb['flags']
