+        L.nx2rep_run.argtypes = [C.c_char_p, U32, C.POINTER(U32)]; L.nx2rep_run.restype = C.c_int
+        L.nx2rep_export.argtypes = [C.c_char_p, U32, U32]; L.nx2rep_export.restype = U32
