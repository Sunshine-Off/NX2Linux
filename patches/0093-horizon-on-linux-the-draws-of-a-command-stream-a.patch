+        self.cbs = (PROG_CB(self.prog_cb), ALPHA_CB(self.alpha_cb), IMG_CB(self.img_cb), TEX_CB(self.tex_cb))   # kept alive: the library holds the raw pointers
+        L.nx2rep_callbacks(*[C.cast(c, C.c_void_p).value for c in self.cbs])
+        vk = (U32 * 256)(); [vk.__setitem__(k, v) for k, v in nvn_gpu.NVN_TO_VK.items() if k < 256]
+        bf = (C.c_int16 * 0x65)(*([-1] * 0x65)); [bf.__setitem__(k, v) for k, v in nvn_gpu.BLEND_FACTOR.items()]
+        wrap = (C.c_uint8 * 8)(*[nvn_gpu.WRAP.get(i, 0) for i in range(8)])
+        support = nvn_gpu.SUPPORT
+        L.nx2rep_tables(C.addressof(vk), C.addressof(bf), C.addressof(wrap), support, len(support), nvn_spirv.ALPHA_FUNC_OFFSET, nvn_spirv.ALPHA_REF_OFFSET)
