+
+    # ---- per submit ----
+    def begin(self):
+        dev = self.nvn.o.get(getattr(self.nvn, 'device', 0), {})
+        self.lib.nx2rep_depth_mode(int(dev.get('depth', 0) == 0))
+        self.lib.nx2rep_frame(self.nvn.stats['presents'] + 1)
+        self.lib.nx2rep_begin()
+
+    def bump(self, which): self.lib.nx2rep_epoch(which)
+
+    def run(self, chunk, state):
+        """Replays a stream of records; a draw C hands back is done here with the exported state"""
+        if self.check: return self.run_check(chunk, state)
+        stop = U32(0)
+        while chunk:
+            if not self.lib.nx2rep_run(chunk, len(chunk), C.byref(stop)): return
+            pos = stop.value; nw = struct.unpack_from('<Q', chunk, pos)[0] >> 32
+            call = self.rec.decode(chunk[pos:pos + 8 * nw])[0][1]
+            self.sync(state)
+            self.nvn.draw(state, call)
+            chunk = chunk[pos + 8 * nw:]
+
+    def sync(self, state, what=3):
+        """The state C keeps, into the state dict Python commands read"""
+        n = self.lib.nx2rep_export(self.export_buf, len(self.export_buf), what)
+        for c in self.rec.decode(self.export_buf.raw[:n]):
+            if c[0] == 'targets': state['rt'], state['depth'], state['rt_views'], state['depth_view'] = c[1], c[2], c[3], c[4]
+            else: self.nvn.apply_state(state, c)
+
+    # ---- the commands Python records itself, encoded for C ----
+    def apply_python(self, c):
+        out = self.encode(c)
+        if out: self.lib.nx2rep_apply(out, len(out))
+
+    def encode(self, c):
+        op, out = c[0], []
+        if op == 'program': out.append(record(nvn_rec.OP_PROGRAM, c[1], c[2]))
+        elif op == 'bind_state':
+            kind = next(i for i, s in enumerate(nvn_rec.STATE_KINDS) if s.name == c[1])
+            raw = nvn_rec.STATE_KINDS[kind].pack(c[2]).ljust(16, b'\0'); out.append(record(nvn_rec.OP_BIND_STATE, kind, *struct.unpack('<2Q', raw)))
