+        t.mip_mode = 1 if mn in (4, 5) else 0
+        t.wrap_s, t.wrap_t, t.wrap_r = (WRAP.get(sp.get(k, 1), 0) for k in ('wrap_s', 'wrap_t', 'wrap_r'))
+        t.lod_min, t.lod_max, t.lod_bias, t.aniso = sp.get('lod_min', 0.0), (sp.get('lod_max', 1000.0) if mn >= 2 else 0.0), sp.get('lod_bias', 0.0), max(1.0, sp.get('aniso', 1.0))
