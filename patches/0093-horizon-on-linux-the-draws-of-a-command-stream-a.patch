+        elif op in ('ubo', 'ssbo'):
+            for (stage, idx), (addr, size) in c[1].items(): out.append(record(nvn_rec.OP_UBO if op == 'ubo' else nvn_rec.OP_SSBO, stage, idx, addr, size))
+        elif op == 'vbuf':
+            for idx, (addr, size) in c[1].items(): out.append(record(nvn_rec.OP_VBUF, idx, addr, size))
+        elif op in ('tex', 'samp', 'img'):
+            code = {'tex': nvn_rec.OP_TEX, 'samp': nvn_rec.OP_SAMP, 'img': nvn_rec.OP_IMG}[op]
+            for (stage, idx), h in c[1].items(): out.append(record(code, stage, idx, h))
+        elif op == 'texpool': out.append(record(nvn_rec.OP_TEXPOOL, c[1]))
+        elif op == 'samppool': out.append(record(nvn_rec.OP_SAMPPOOL, c[1]))
+        elif op in ('viewports', 'scissors'):
+            v = c[1].get(0)
