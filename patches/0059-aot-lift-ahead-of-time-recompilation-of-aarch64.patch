index 0000000..dc96694
--- /dev/null
+++ b/dm/tools/aot_lift.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""Ahead-of-time recompilation of AArch64 functions to x86_64 (NX2Linux T3): each function is lifted to LLVM IR by Remill's remill-lift, compiled by clang++ with the host runtime (aot_runtime.cpp)
+and a generated table of the functions' addresses, into one shared library that Aot wraps for ctypes.
+  · the lifter is an existing brick (Remill); this file only drives it. REMILL_BUILD is Remill's build folder (bin/lift/remill-lift-*); REMILL_SRC its source folder (default: REMILL_BUILD/..)
+  · a function Remill cannot lift (its IR calls __remill_error) is a LiftError naming the address, the word and the instruction; an intrinsic the runtime does not define (svc, floating point...)
+    is a LinkError naming the symbols (the library is linked with --no-undefined): nothing is translated approximately
+  · what a direct `bl` or `b` reaches is resolved by the linker (sub_<address>); an indirect call or jump goes through the runtime's table (aot_runtime.cpp)
+Usage as a module (tests/test_aot_t3.py): Aot([(address, code bytes)]) then .map(), .run(pc, regs) and .stat()."""
+import ctypes, glob, itertools, os, re, struct, subprocess, tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+RET = 0xD65F03C0
+STATS = ('indirect_calls', 'indirect_jumps', 'fallback_requests', 'reads', 'writes', 'regions')
+
+
+class LiftError(Exception):
+    pass
+
+
+class LinkError(Exception):
+    pass
+
+
+def lifter():
+    """remill-lift of the Remill build named by REMILL_BUILD, or None"""
+    b = os.environ.get('REMILL_BUILD')
+    return next(iter(sorted(glob.glob(os.path.join(b, 'bin/lift/remill-lift-*')))), None) if b else None
+
+
+def include_dir():
+    return os.environ.get('REMILL_SRC', os.path.join(os.environ['REMILL_BUILD'], '..'))
+
+
+def _disasm(word, address):
+    try:
+        import capstone
+        i = next(capstone.Cs(capstone.CS_ARCH_ARM64, capstone.CS_MODE_ARM).disasm(struct.pack('<I', word), address))
+        return f'{i.mnemonic} {i.op_str}'.strip()
+    except Exception:
+        return '?'
+
+
+def _run_lift(code, address, ll):
+    subprocess.run([lifter(), '--arch', 'aarch64', '--address', hex(address), '--bytes', code.hex(), '--ir_out', ll], check=True, capture_output=True, text=True)
+    return '@__remill_error' in Path(ll).read_text()
+
+
+def lift(word, ll, address=0x1000):
+    """Lift one instruction (+ ret) to the IR file ll; LiftError when Remill has no semantics for it"""
+    if _run_lift(struct.pack('<2I', word, RET), address, ll):
+        raise LiftError(f'{address:#x}: {word:#010x} ({_disasm(word, address)}): Remill has no semantics for this instruction (the lifted code calls __remill_error)')
+
+
+def lift_function(code, address, ll):
+    """Lift the function whose bytes are code, at address, to ll; LiftError naming the first instruction Remill cannot lift"""
+    if not _run_lift(code, address, ll): return
+    scratch = ll + '.insn.ll'
+    for i, (w,) in enumerate(struct.iter_unpack('<I', code)):
+        try: lift(w, scratch, address + 4 * i)
+        except LiftError as e: raise LiftError(f'function {address:#x}: {e}') from None
+    raise LiftError(f'function {address:#x}: Remill could not lift it (its IR calls __remill_error), though each instruction lifts alone: a control flow it does not follow')
+
+
+_counter = itertools.count()
+
+
+class Aot:
+    def __init__(self, functions, tmp=None):
+        """functions: [(address, bytes)]; builds and loads the library. LiftError / LinkError otherwise"""
+        self.dir = tempfile.TemporaryDirectory() if tmp is None else None
+        d = tmp or self.dir.name
+        n = next(_counter)
+        lls = []
+        for addr, code in functions:
+            ll = os.path.join(d, f'f{n}_{addr:x}.ll'); lift_function(code, addr, ll); lls.append(ll)
+        table = os.path.join(d, f'table{n}.cpp')
+        rows = sorted(a for a, _ in functions)
+        Path(table).write_text('#include "remill/Arch/AArch64/Runtime/State.h"\n#include <cstdint>\n'
+                               + ''.join(f'extern "C" Memory *sub_{a:x}(State *, uint64_t, Memory *);\n' for a in rows)
+                               + 'struct AotEntry { uint64_t addr; Memory *(*fn)(State *, uint64_t, Memory *); };\n'
+                               + 'extern "C" const AotEntry aot_table[] = {' + ', '.join(f'{{{a:#x}, sub_{a:x}}}' for a in rows) + '};\n'
+                               + f'extern "C" const unsigned aot_table_n = {len(rows)};\n')
+        so = os.path.join(d, f'aot{n}.so')   # one path per library: dlopen of a path already loaded returns the old one
+        inc = include_dir()
+        r = subprocess.run(['clang++', '-O2', '-shared', '-fPIC', '-std=c++17', '-DADDRESS_SIZE_BITS=64', f'-I{inc}/include', f'-I{inc}', str(HERE / 'aot_runtime.cpp'), table, *lls, '-o', so, '-Wl,--no-undefined'],
+                           capture_output=True, text=True)
+        if r.returncode:
+            missing = sorted(set(re.findall(r'(?:undefined reference to|référence indéfinie vers) [«`\'"]*([A-Za-z_0-9]+)', r.stderr)))
+            if missing: raise LinkError('the runtime does not define: ' + ', '.join(missing) + ' (an instruction class not translated yet)')
+            raise LinkError('build failed:\n' + r.stderr[-2000:])
+        self.lib = ctypes.CDLL(so)
+        L = self.lib
+        L.aot_map.argtypes = [ctypes.c_uint64, ctypes.c_uint64]
+        L.aot_poke.argtypes = [ctypes.c_uint64, ctypes.c_char_p, ctypes.c_uint64]
+        L.aot_peek.argtypes = [ctypes.c_uint64, ctypes.c_char_p, ctypes.c_uint64]
+        L.aot_stat.argtypes = [ctypes.c_int]; L.aot_stat.restype = ctypes.c_uint64
+        L.aot_run.argtypes = [ctypes.c_void_p, ctypes.c_uint64, ctypes.c_char_p, ctypes.c_uint64]
+        self.regions = []
+
+    class _Guest(ctypes.Structure):
+        _fields_ = [('x', ctypes.c_uint64 * 31), ('sp', ctypes.c_uint64), ('nzcv', ctypes.c_uint64)]
+
+    def map(self, base, size, data=None):
+        self.lib.aot_map(base, size); self.regions.append((base, size, bytes(data) if data else bytes(size)))
+        self.reset()
+
+    def reset(self):
+        """Every region back to the contents it was mapped with (the guest memory is global: a run leaves its writes behind)"""
+        for b, _, data in self.regions: assert self.lib.aot_poke(b, data, len(data)) == 0
+
+    def peek(self, base, size):
+        buf = ctypes.create_string_buffer(size)
+        assert self.lib.aot_peek(base, buf, size) == 0
+        return buf.raw
+
+    def stat(self, name): return self.lib.aot_stat(STATS.index(name))
+
+    def run(self, pc, regs=None, nzcv=0, sp=0):
+        """Run the AOT function at pc. Returns {'x0'..'x30', 'sp', 'nzcv', 'mem': {base: bytes}} or {'fault': reason}"""
+        g = self._Guest()
+        for k, v in (regs or {}).items(): g.x[int(k[1:])] = v & (2 ** 64 - 1)
+        g.sp, g.nzcv = sp, nzcv
+        err = ctypes.create_string_buffer(300)
+        rc = self.lib.aot_run(ctypes.byref(g), pc, err, 300)
+        if rc: return {'fault': err.value.decode()}
+        out = {f'x{i}': g.x[i] for i in range(31)}; out['sp'] = g.sp; out['nzcv'] = g.nzcv
+        out['mem'] = {b: self.peek(b, n) for b, n, _ in self.regions}
+        return out
+
+    def close(self):
+        self.lib.aot_unmap_all()
+        if self.dir: self.dir.cleanup()
diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
new file mode 100644
index 0000000..38d5923
--- /dev/null
+++ b/dm/tools/aot_runtime.cpp
@@ -0,0 +1,114 @@
+// Host runtime of the ahead-of-time recompiled AArch64 code (NX2Linux T3). The functions Remill lifted (aot_lift.py) call the `__remill_*` intrinsics defined here:
+//   · guest memory: bounded regions, every access checked; an access outside them is an explicit error (address, size, read or write), never a host fault. Unaligned accesses are allowed, as on AArch64 normal memory.
+//   · indirect calls and jumps (blr, br): the target must be the entry of an AOT function in aot_table (generated); any other target is counted as a fallback request and is an explicit error until the JIT
+//     fallback (T4) takes it. A direct `bl` needs none of this: Remill lifted it into a call of sub_<address>, resolved at link time.
+//   · errors leave the lifted code by longjmp (its frames hold no destructors), and aot_run reports them as text.
+// ADDRESS_SIZE_BITS=64 and Remill's include folder are on the command line (aot_lift.py). Flag and compare intrinsics are markers whose first argument is already the value, as in remill_host.cpp.
+#include "remill/Arch/AArch64/Runtime/State.h"
+#include <csetjmp>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+typedef Memory *(*AotFn)(State *, uint64_t, Memory *);
+struct AotEntry { uint64_t addr; AotFn fn; };
+extern "C" const AotEntry aot_table[];   // generated by aot_lift.py, sorted by address
+extern "C" const unsigned aot_table_n;
+
+namespace {
+struct Region { uint64_t base, size; uint8_t *host; };
+std::vector<Region> g_regions;
+thread_local jmp_buf *g_jb;
+thread_local char g_err[300];
+uint64_t g_stats[6];   // indirect calls, indirect jumps, fallback requests, memory reads, memory writes, regions mapped
+enum { S_CALLS, S_JUMPS, S_FALLBACK, S_READS, S_WRITES, S_REGIONS };
+
+[[noreturn]] void fail(const char *fmt, ...) {
+    va_list ap; va_start(ap, fmt); vsnprintf(g_err, sizeof g_err, fmt, ap); va_end(ap);
+    if (!g_jb) { fprintf(stderr, "[RED] aot: %s (outside aot_run)\n", g_err); abort(); }
+    longjmp(*g_jb, 1);
+}
+
+uint8_t *guest(uint64_t a, uint64_t n, const char *what) {
+    for (const Region &r : g_regions)
+        if (a >= r.base && n <= r.size && a - r.base <= r.size - n) return r.host + (a - r.base);
+    fail("guest %s of %llu bytes at %#llx is outside every mapped region", what, (unsigned long long)n, (unsigned long long)a);
+}
+
+AotFn find(uint64_t pc) {
+    unsigned lo = 0, hi = aot_table_n;
+    while (lo < hi) { unsigned m = (lo + hi) / 2; if (aot_table[m].addr < pc) lo = m + 1; else hi = m; }
+    return lo < aot_table_n && aot_table[lo].addr == pc ? aot_table[lo].fn : nullptr;
+}
+}  // namespace
+
+extern "C" {
+bool __remill_flag_computation_sign(bool r, ...) { return r; }
+bool __remill_flag_computation_zero(bool r, ...) { return r; }
+bool __remill_flag_computation_carry(bool r, ...) { return r; }
+bool __remill_flag_computation_overflow(bool r, ...) { return r; }
+#define COMPARE(n) bool __remill_compare_##n(bool r) { return r; }
+COMPARE(eq) COMPARE(neq) COMPARE(slt) COMPARE(sle) COMPARE(sgt) COMPARE(sge) COMPARE(ult) COMPARE(ule) COMPARE(ugt) COMPARE(uge)
+
+#define ACCESS(N, T) \
+    T __remill_read_memory_##N(Memory *, uint64_t a) { T v; memcpy(&v, guest(a, sizeof(T), "read"), sizeof v); g_stats[S_READS]++; return v; } \
+    Memory *__remill_write_memory_##N(Memory *m, uint64_t a, T v) { memcpy(guest(a, sizeof(T), "write"), &v, sizeof v); g_stats[S_WRITES]++; return m; }
+ACCESS(8, uint8_t) ACCESS(16, uint16_t) ACCESS(32, uint32_t) ACCESS(64, uint64_t)
+
+Memory *__remill_function_return(State &, uint64_t, Memory *m) { return m; }   // `ret`: the C return of the lifted function is the AArch64 return (x30 is not consulted, see hypotheses.md)
+
+Memory *__remill_function_call(State &st, uint64_t pc, Memory *m) {   // blr
+    g_stats[S_CALLS]++;
+    if (AotFn f = find(pc)) return f(&st, pc, m);
+    g_stats[S_FALLBACK]++;
+    fail("indirect call to %#llx: not the entry of an AOT function, and no JIT fallback yet", (unsigned long long)pc);
+}
+
+Memory *__remill_jump(State &st, uint64_t pc, Memory *m) {   // br: a tail call, so the target must be a function entry too
+    g_stats[S_JUMPS]++;
+    if (AotFn f = find(pc)) return f(&st, pc, m);
+    g_stats[S_FALLBACK]++;
+    fail("indirect jump to %#llx: not the entry of an AOT function (a jump table inside a function is not supported yet), and no JIT fallback yet", (unsigned long long)pc);
+}
+
+// ---- the harness side (ctypes) ----
+struct Guest { uint64_t x[31]; uint64_t sp; uint64_t nzcv; };   // nzcv: N Z C V as bits 3..0
+
+void aot_map(uint64_t base, uint64_t size) {
+    for (const Region &r : g_regions) if (base < r.base + r.size && r.base < base + size) { fprintf(stderr, "[RED] aot: region %#llx+%#llx overlaps another\n", (unsigned long long)base, (unsigned long long)size); abort(); }
+    g_regions.push_back({base, size, (uint8_t *)calloc(1, size)}); g_stats[S_REGIONS]++;
+}
+void aot_unmap_all() { for (Region &r : g_regions) free(r.host); g_regions.clear(); }
+int aot_poke(uint64_t a, const uint8_t *src, uint64_t n) { jmp_buf jb; if (setjmp(jb)) return 1; g_jb = &jb; memcpy(guest(a, n, "poke"), src, n); g_jb = nullptr; return 0; }
+int aot_peek(uint64_t a, uint8_t *dst, uint64_t n) { jmp_buf jb; if (setjmp(jb)) return 1; g_jb = &jb; memcpy(dst, guest(a, n, "peek"), n); g_jb = nullptr; return 0; }
+uint64_t aot_stat(int i) { return g_stats[i]; }
+void aot_stats_reset() { memset(g_stats, 0, sizeof g_stats); }
+
+// Run the AOT function at pc on the registers of g; 0 when it returned, else 1 with the reason in err
+int aot_run(Guest *g, uint64_t pc, char *err, uint64_t errn) {
+    State st; memset(&st, 0, sizeof st);
+#define X(i) st.gpr.x##i.qword = g->x[i];
+    X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
+#undef X
+    st.gpr.sp.qword = g->sp;
+    st.sr.n = g->nzcv >> 3 & 1; st.sr.z = g->nzcv >> 2 & 1; st.sr.c = g->nzcv >> 1 & 1; st.sr.v = g->nzcv & 1;
+    jmp_buf jb; int rc = 0;
+    if (setjmp(jb)) rc = 1;
+    else {
+        g_jb = &jb;
+        AotFn f = find(pc);
+        if (!f) fail("no AOT function at %#llx", (unsigned long long)pc);
+        f(&st, pc, reinterpret_cast<Memory *>(&g_stats));   // the Memory token is never dereferenced: the regions are global
+    }
+    g_jb = nullptr;
+#define X(i) g->x[i] = st.gpr.x##i.qword;
+    X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
+#undef X
+    g->sp = st.gpr.sp.qword; g->nzcv = st.sr.n << 3 | st.sr.z << 2 | st.sr.c << 1 | st.sr.v;
+    if (rc) snprintf(err, errn, "%s", g_err); else if (errn) err[0] = 0;
+    return rc;
+}
+}
diff --git a/dm/tools/tests/arm64_ref.py b/dm/tools/tests/arm64_ref.py
index 79b9ffc..06f7702 100644
--- a/dm/tools/tests/arm64_ref.py
+++ b/dm/tools/tests/arm64_ref.py
@@ -8,6 +8,12 @@ MASK = (1 << 64) - 1
 BASE, STACK, STOP = 0x10000, 0x200000, 0x400000   # text mapped at BASE; STOP: the return address, where the run ends
 
 
+def xreg(i):
+    """Unicorn's constant for register xi: x0..x28 are consecutive, x29 and x30 are separate constants, so X0 + i is wrong from x29 on"""
+    from unicorn import arm64_const as c
+    return c.UC_ARM64_REG_X29 if i == 29 else c.UC_ARM64_REG_X30 if i == 30 else c.UC_ARM64_REG_X0 + i
+
+
 def run(name, regs=None, steps=10000):
     """Run function `name` of the fixture with registers {'x0': v, ...}; returns {'x0'..'x30', 'sp', 'nzcv'} (nzcv: N Z C V as bits 3..0). The run ends when the function returns to STOP.
     An exception of the core (an undecodable word, an unmapped access) propagates: a reference run never hides one."""
@@ -18,11 +24,11 @@ def run(name, regs=None, steps=10000):
     code = struct.pack('<%dI' % len(words), *words)
     uc = Uc(UC_ARCH_ARM64, UC_MODE_ARM)
     uc.mem_map(BASE, 0x10000); uc.mem_write(BASE, code); uc.mem_map(STACK - 0x10000, 0x10000); uc.mem_map(STOP, 0x1000)
-    for r, v in (regs or {}).items(): uc.reg_write(UC_ARM64_REG_X0 + int(r[1:]), v & MASK)
+    for r, v in (regs or {}).items(): uc.reg_write(xreg(int(r[1:])), v & MASK)
     uc.reg_write(UC_ARM64_REG_SP, STACK); uc.reg_write(UC_ARM64_REG_X30, STOP)
     start = BASE + ranges[name][0]
     uc.emu_start(start, STOP, count=steps)
-    out = {f'x{i}': uc.reg_read(UC_ARM64_REG_X0 + i) for i in range(31)}
+    out = {f'x{i}': uc.reg_read(xreg(i)) for i in range(31)}
     out['sp'] = uc.reg_read(UC_ARM64_REG_SP); out['nzcv'] = uc.reg_read(UC_ARM64_REG_NZCV) >> 28
     return out
 
@@ -54,8 +60,31 @@ def run_words(words, cases, steps=100):
     uc.mem_map(BASE, 0x10000); uc.mem_write(BASE, struct.pack('<%dI' % len(words), *words)); uc.mem_map(STOP, 0x1000)
     out = []
     for regs, nzcv in cases:
-        for i in range(31): uc.reg_write(UC_ARM64_REG_X0 + i, regs.get(f'x{i}', 0) & MASK)
+        for i in range(31): uc.reg_write(xreg(i), regs.get(f'x{i}', 0) & MASK)
         uc.reg_write(UC_ARM64_REG_NZCV, nzcv << 28); uc.reg_write(UC_ARM64_REG_X30, STOP); uc.reg_write(UC_ARM64_REG_SP, STOP)
         uc.emu_start(BASE, STOP, count=steps)
         out.append(({f'x{i}': uc.reg_read(UC_ARM64_REG_X0 + i) for i in range(4)}, uc.reg_read(UC_ARM64_REG_NZCV) >> 28))
     return out
+
+
+def run_image(code, entry, cases, mem=None, steps=1000000, stop=STOP):
+    """Run the function at `entry` of `code` (mapped at address 0) once per case on one Unicorn core, with the memory regions {base: bytes} (a size that is a whole number of pages) restored before each case.
+    A case is (registers {'x0': v, ...}, nzcv in, sp). Returns, per case, {'x0'..'x30', 'sp', 'nzcv', 'mem': {base: bytes}}, or {'fault': reason} when the core raised (a fetch, read or write outside the regions)."""
+    from unicorn import Uc, UcError, UC_ARCH_ARM64, UC_MODE_ARM
+    from unicorn.arm64_const import UC_ARM64_REG_X0, UC_ARM64_REG_X30, UC_ARM64_REG_SP, UC_ARM64_REG_NZCV
+    uc = Uc(UC_ARCH_ARM64, UC_MODE_ARM)
+    uc.mem_map(0, (len(code) + 0xFFF) & ~0xFFF); uc.mem_write(0, code); uc.mem_map(stop, 0x1000)
+    for b, data in (mem or {}).items(): uc.mem_map(b, len(data))
+    out = []
+    for regs, nzcv, sp in cases:
+        for b, data in (mem or {}).items(): uc.mem_write(b, data)
+        for i in range(31): uc.reg_write(xreg(i), regs.get(f'x{i}', 0) & MASK)
+        uc.reg_write(UC_ARM64_REG_X30, regs.get('x30', stop) & MASK); uc.reg_write(UC_ARM64_REG_SP, sp); uc.reg_write(UC_ARM64_REG_NZCV, nzcv << 28)
+        try: uc.emu_start(entry, stop, count=steps)
+        except UcError as e:
+            out.append({'fault': str(e)}); continue
+        r = {f'x{i}': uc.reg_read(xreg(i)) for i in range(31)}
+        r['sp'] = uc.reg_read(UC_ARM64_REG_SP); r['nzcv'] = uc.reg_read(UC_ARM64_REG_NZCV) >> 28
+        r['mem'] = {b: bytes(uc.mem_read(b, len(data))) for b, data in (mem or {}).items()}
+        out.append(r)
+    return out
