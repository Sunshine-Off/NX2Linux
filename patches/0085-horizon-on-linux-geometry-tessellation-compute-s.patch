+def fix_capabilities(spirv):
+    """The translator leaves out the capabilities of storage image reads and writes whose format the shader does not name (Vulkan: shaderStorageImageRead / WriteWithoutFormat, which the GPU
+    library enables): they are added to the module"""
+    head, ins = _instructions(spirv)
+    unknown = {x[1] for x in ins if x[0] & 0xFFFF == 25 and len(x) >= 9 and x[7] == 2 and x[8] == 0}   # OpTypeImage with Sampled = 2 (storage) and format Unknown
+    if not unknown: return spirv
+    need = set()
+    types_of = {x[2]: x[1] for x in ins if len(x) > 2 and x[0] & 0xFFFF in (61, 98)}   # result id -> result type
+    for x in ins:
+        op = x[0] & 0xFFFF
+        if op == 99: need.add(56)   # OpImageWrite
+        if op == 98 and types_of.get(x[2]) is not None: need.add(55)   # OpImageRead
+    have = {x[1] for x in ins if x[0] & 0xFFFF == 17}
+    add = [[(2 << 16) | 17, c] for c in sorted(need - have)]
+    if not add: return spirv
+    first = next(k for k, x in enumerate(ins) if x[0] & 0xFFFF != 17)   # after the capabilities already there
+    out = ins[:first] + add + ins[first:]
+    flat = head + [v for x in out for v in x]
+    return struct.pack(f'<{len(flat)}I', *flat)
