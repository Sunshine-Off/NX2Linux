+            [(5 << 16) | 65, ptr_uint, pf, sb, c_func], [(4 << 16) | 61, uint_t, func, pf],
+            [(5 << 16) | 65, ptr_int, pr, sb, c_ref], [(4 << 16) | 61, int_t, rbits, pr], [(4 << 16) | 124, comp, ref, rbits]]
+    cmp_ops = {7: 190, 6: 182, 5: 186, 4: 188, 3: 180, 2: 184}   # >=, !=, >, <=, ==, <
+    passed = true_c
+    for f in (7, 6, 5, 4, 3, 2):
+        c, isf, sel = next(it), next(it), next(it)
+        body += [[(5 << 16) | cmp_ops[f], bool_t, c, alpha, ref], [(5 << 16) | 170, bool_t, isf, func, consts[f]], [(6 << 16) | 169, bool_t, sel, isf, c, passed]]
+        passed = sel
+    isf1, sel1 = next(it), next(it)
+    body += [[(5 << 16) | 170, bool_t, isf1, func, consts[1]], [(6 << 16) | 169, bool_t, sel1, isf1, false_c, passed]]
+    body += [[(3 << 16) | 247, merge, 0], [(4 << 16) | 250, sel1, merge, kill], [(2 << 16) | 248, kill], [(1 << 16) | 252], [(2 << 16) | 248, merge], [(1 << 16) | 253], [(1 << 16) | 56]]
+    out = []
+    first_fn = next(k for k, x in enumerate(ins) if x[0] & 0xFFFF == 54)
+    for k, x in enumerate(ins):
+        if k == first_fn: out += add
+        y = list(x)
+        if x[0] & 0xFFFF == 15 and k == entry: y[2] = new_main
+        if x[0] & 0xFFFF == 16 and x[1] == main_id: y[1] = new_main   # OpExecutionMode of the entry
+        out.append(y)
