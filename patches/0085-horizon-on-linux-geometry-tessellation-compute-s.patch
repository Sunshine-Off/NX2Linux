+    add = []   # global declarations to insert before the first function
+    def find_or_add(match, build):
+        for x in ins + add:
+            if match(x): return x[2] if x[0] & 0xFFFF in (41, 42, 43) else x[1]   # a constant's id follows its type
+        i = new_id(); add.append(build(i)); return i
+    bool_t = find_or_add(lambda x: x[0] & 0xFFFF == 20, lambda i: [(2 << 16) | 20, i])
+    def ptr(storage, pointee): return find_or_add(lambda x: x[0] & 0xFFFF == 32 and x[2] == storage and x[3] == pointee, lambda i: [(4 << 16) | 32, i, storage, pointee])
+    def const_u(v): return find_or_add(lambda x: x[0] & 0xFFFF == 43 and x[1] == uint_t and x[3] == v, lambda i: [(4 << 16) | 43, uint_t, i, v])
+    true_c = find_or_add(lambda x: x[0] & 0xFFFF == 41 and x[1] == bool_t, lambda i: [(3 << 16) | 41, bool_t, i])
+    false_c = find_or_add(lambda x: x[0] & 0xFFFF == 42 and x[1] == bool_t, lambda i: [(3 << 16) | 42, bool_t, i])
+    if not any(x[0] & 0xFFFF == 21 and x[1] == uint_t and x[2] == 32 and x[3] == 0 for x in ins): return None
+    void_t = next((x[1] for x in ins if x[0] & 0xFFFF == 19), None)
+    fn_t = next((x[4] for x in ins if x[0] & 0xFFFF == 54 and x[2] == main_id), None)
+    if void_t is None or fn_t is None: return None
+    ptr_uint, ptr_int = ptr(2, uint_t), ptr(2, int_t)   # Uniform
+    c_func, c_ref = const_u(SUPPORT_UINT_MEMBER), const_u(SUPPORT_INT_MEMBER)
+    consts = {f: const_u(f) for f in range(1, 8)}
+    new_main, lbl, kill, merge = new_id(), new_id(), new_id(), new_id()
+    ids = [new_id() for _ in range(40)]
+    it = iter(ids)
+    call, color, alpha, pf, func, pr, rbits, ref = (next(it) for _ in range(8))
+    body = [[(5 << 16) | 54, void_t, new_main, 0, fn_t], [(2 << 16) | 248, lbl], [(4 << 16) | 57, void_t, call, main_id],
