From: shikosu <teovidal01@gmail.com>
Date: Wed, 4 Nov 2026 00:51:01 +0100
Subject: [PATCH] runtime: nx2_aes for the AES instructions Remill now lifts
 (remill-patches 0009); tests: crypto, FRSQRTE, FRECPS/FRSQRTS against
 Unicorn, AES FIPS-197 vector

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Upstream-Status: pending
Reason: NX2Linux milestone B: the 27 functions of nn::crypto and nn::hid that Remill could not lift (AES, SHA, PMULL, FRSQRTE) now lift; the runtime provides the AES S-box step
Issue: none yet (NX2Linux, branch Téo/jalon-a-reproductibilite)

---
 dm/tools/aot_runtime.cpp        | 39 ++++++++++++++++++++++++
 dm/tools/tests/test_aot_simd.py | 54 +++++++++++++++++++++++++++++++++
 2 files changed, 93 insertions(+)

diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index a832ea5..4a70773 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -29,6 +29,45 @@ extern "C" uint64_t __nx2_read_cntpct(void) {
     return ((uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec) * 192ull / 10000ull;
 }
 
+// AESE / AESD / AESMC / AESIMC (the AArch64 cryptographic extension), called by the semantics Remill lifts them to (remill-patches 0009). d and n are 16 bytes, result is written whole.
+// op 0 AESE: SubBytes(ShiftRows(d ^ n)); 1 AESD: InvSubBytes(InvShiftRows(d ^ n)); 2 AESMC: MixColumns(n); 3 AESIMC: InvMixColumns(n). The S-box is computed from its definition (inverse in GF(2^8), affine map), once.
+namespace {
+struct AesTables {
+    uint8_t sbox[256], inv[256];
+    static uint8_t mul(uint8_t a, uint8_t b) { uint8_t p = 0; for (; b; b >>= 1) { if (b & 1) p ^= a; a = (uint8_t)((a << 1) ^ ((a & 0x80) ? 0x1B : 0)); } return p; }
+    AesTables() {
+        for (int x = 0; x < 256; x++) {
+            uint8_t y = 0;   // the multiplicative inverse (0 for 0)
+            for (int c = 1; c < 256 && x; c++) if (mul((uint8_t)x, (uint8_t)c) == 1) { y = (uint8_t)c; break; }
+            uint8_t s = y;
+            for (int k = 1; k <= 4; k++) s ^= (uint8_t)((y << k) | (y >> (8 - k)));
+            s ^= 0x63; sbox[x] = s; inv[s] = (uint8_t)x;
+        }
+    }
+};
+}
+extern "C" void nx2_aes(unsigned op, uint64_t *result, const uint64_t *d, const uint64_t *n) {
+    static const AesTables T;
+    uint8_t a[16], b[16], r[16];
+    memcpy(a, d, 16); memcpy(b, n, 16);
+    if (op < 2) {
+        uint8_t t[16];
+        for (int i = 0; i < 16; i++) t[i] = a[i] ^ b[i];
+        for (int i = 0; i < 16; i++) {
+            if (op == 0) r[i] = T.sbox[t[(i + 4 * (i % 4)) % 16]];            // ShiftRows, then SubBytes
+            else r[(i + 4 * (i % 4)) % 16] = T.inv[t[i]];                      // InvShiftRows, then InvSubBytes
+        }
+    } else {
+        for (int c = 0; c < 4; c++) {
+            const uint8_t *x = b + 4 * c; uint8_t *y = r + 4 * c;
+            const uint8_t m[4] = {2, 3, 1, 1}, im[4] = {14, 11, 13, 9};
+            const uint8_t *k = op == 2 ? m : im;
+            for (int i = 0; i < 4; i++) y[i] = AesTables::mul(x[0], k[(4 - i) % 4]) ^ AesTables::mul(x[1], k[(5 - i) % 4]) ^ AesTables::mul(x[2], k[(6 - i) % 4]) ^ AesTables::mul(x[3], k[(7 - i) % 4]);
+        }
+    }
+    memcpy(result, r, 16);
+}
+
 #define XREGS(X) X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
 
 namespace {
diff --git a/dm/tools/tests/test_aot_simd.py b/dm/tools/tests/test_aot_simd.py
index 36e48c3..69302b4 100644
--- a/dm/tools/tests/test_aot_simd.py
+++ b/dm/tools/tests/test_aot_simd.py
@@ -235,6 +235,15 @@ NEON_MORE = (   # batch 6b: scalar SIMD forms, by-element integer forms, and a f
     ['smsubl x0, w1, w2, x3', 'umsubl x0, w1, w2, x3', 'ldursb x0, [x2, #-3]', 'ldursh x0, [x2, #-30]', 'ldursb x0, [x2]', 'ldursh x0, [x2, #7]'])
 
 
+CRYPTO = (   # batch 7: the cryptographic extension (AES, SHA-1, SHA-256, PMULL) and FRSQRTE: the 27 functions of nn::crypto and nn::hid that Remill did not lift
+    ['aese v0.16b, v1.16b', 'aesd v0.16b, v1.16b', 'aesmc v0.16b, v1.16b', 'aesimc v0.16b, v1.16b', 'aese v3.16b, v3.16b', 'aesmc v4.16b, v4.16b'] +
+    ['sha1c q0, s1, v2.4s', 'sha1p q0, s1, v2.4s', 'sha1m q0, s1, v2.4s', 'sha1h s0, s1', 'sha1su0 v0.4s, v1.4s, v2.4s', 'sha1su1 v0.4s, v1.4s'] +
+    ['sha256h q0, q1, v2.4s', 'sha256h2 q0, q1, v2.4s', 'sha256su0 v0.4s, v1.4s', 'sha256su1 v0.4s, v1.4s, v2.4s'] +
+    ['pmull v0.8h, v1.8b, v2.8b', 'pmull2 v0.8h, v1.16b, v2.16b', 'pmull v0.1q, v1.1d, v2.1d', 'pmull2 v0.1q, v1.2d, v2.2d'])
+FRSQRTE = [f'frsqrte {d}, {s}' for d, s in (('s0', 's1'), ('d0', 'd1'), ('v0.2s', 'v1.2s'), ('v0.4s', 'v1.4s'), ('v0.2d', 'v1.2d'))]
+NEWTON = [f'{op} {r}0, {r}1, {r}2' for op in ('frecps', 'frsqrts') for r in ('s', 'd')] + [f'{op} v0.{a}, v1.{a}, v2.{a}' for op in ('frecps', 'frsqrts') for a in ('2s', '4s', '2d')]
+
+
 @unittest.skipUnless(AS and OBJCOPY and READY, 'needs aarch64-linux-gnu-as, REMILL_BUILD, clang++ and unicorn')
 class Batch(unittest.TestCase):
     @classmethod
@@ -294,6 +303,51 @@ class Batch(unittest.TestCase):
 
     def test_scalar_simd_and_element_forms(self): self.check('more', NEON_MORE, cases=40, nan_free=False)
 
+    def test_crypto_extension_batch(self): self.check('crypto', CRYPTO, cases=200, nan_free=False)
+
+    def test_frsqrte_equals_unicorn_value_and_flags(self):
+        h = Harness(FRSQRTE, self.tmp.name); self.groups['frsqrte'] = h
+        rng = random.Random('frsqrte')
+        special = [0, 1 << 63, 0x7F800000, 0xFF800000, 0x7FC00000, 0x7F800001, 0xFFC00000, 1, 0x007FFFFF, 0x00400000, 0x80000001, 0x3F800000, 0x40800000, 0x7F7FFFFF,
+                   0x7FF0000000000000, 0xFFF0000000000000, 0x7FF8000000000000, 0x7FF0000000000001, 0x000FFFFFFFFFFFFF, 0x0008000000000000, 0x3FF0000000000000, 0x7FEFFFFFFFFFFFFF, 0x4010000000000000]
+        for i, line in enumerate(FRSQRTE):
+            cases = []
+            for bits in special + [rng.getrandbits(64) for _ in range(300)] + [(rng.getrandbits(32) & 0x7FFFFFFF) | (rng.getrandbits(32) & 0x7FFFFFFF) << 32 for _ in range(200)]:
+                cases.append(({'x0': DATA}, 0, {f'v{k}': (bits | rng.getrandbits(64) << 64) if k == 1 else 0 for k in range(32)}))
+            eq, diffs, fpsr = h.compare(i, cases)
+            self.assertEqual((diffs, fpsr), ([], []), line)
+
+    def test_newton_steps_batch(self): self.check('newton', NEWTON, cases=64)
+
+    def test_newton_steps_with_nan_operands(self): self.check('newton_nan', NEWTON, cases=200, nan_free=False)
+
+    def test_aes_128_encrypts_the_fips_197_vector(self):
+        """Independent of Unicorn: AES-128 as the cryptographic extension does it (nine aese + aesmc, a last aese, the last round key xor) turns the plaintext of FIPS-197 appendix C.1 into its ciphertext"""
+        def mul(a, b):
+            p = 0
+            while b:
+                if b & 1: p ^= a
+                a = ((a << 1) ^ (0x1B if a & 0x80 else 0)) & 0xFF; b >>= 1
+            return p
+        sbox = []
+        for x in range(256):
+            y = next((c for c in range(1, 256) if mul(x, c) == 1), 0) if x else 0
+            r = y
+            for k in range(1, 5): r ^= ((y << k) | (y >> (8 - k))) & 0xFF
+            sbox.append(r ^ 0x63)
+        w, rc = [list(bytes(range(16))[4 * i:4 * i + 4]) for i in range(4)], 1
+        for i in range(4, 44):
+            t = list(w[i - 1])
+            if i % 4 == 0: t = [sbox[t[1]] ^ rc, sbox[t[2]], sbox[t[3]], sbox[t[0]]]; rc = mul(rc, 2)
+            w.append([w[i - 4][j] ^ t[j] for j in range(4)])
+        keys = [bytes(sum(w[4 * r:4 * r + 4], [])) for r in range(11)]
+        lines = ['; '.join(f'aese v0.16b, v{r + 1}.16b; aesmc v0.16b, v0.16b' for r in range(9)) + '; aese v0.16b, v10.16b; eor v0.16b, v0.16b, v11.16b']
+        h = Harness(lines, self.tmp.name); self.groups['aes_kat'] = h
+        self.assertEqual(h.unlifted, {})
+        v = {f'v{r + 1}': int.from_bytes(keys[r], 'little') for r in range(11)}; v['v0'] = int.from_bytes(bytes.fromhex('00112233445566778899aabbccddeeff'), 'little')
+        got = h.aot.run(CODE, {'x30': ref.STOP}, 0, SP, vregs=v)
+        self.assertEqual(got['v0'].to_bytes(16, 'little').hex(), '69c4e0d86a7b0430d8cdb78070b4c55a')
+
     def test_exclusives_batch(self): self.check('excl', EXCL, nan_free=False)
 
 
