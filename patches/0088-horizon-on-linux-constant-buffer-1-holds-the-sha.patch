+def shader_c1(stage, ctl, code):
+    """The constant segment of a shader (what its constant buffer 1 holds: the literals the compiler kept out of the instructions): the bytes between control +0x700 and +0x704 of the code area, or what
+    follows part B of a vertex shader in two parts. The driver binds it as c1 (engine/dm/gfx/tools/dmsh_build.py job_for)"""
+    if stage == 'vs':
+        ab = vertex_ab(code, ctl)
+        if ab: return ab[1]
+    c1o, c1t = struct.unpack_from('<2I', ctl, 0x700)
+    return code[c1o:c1t] if 0 <= c1o <= c1t <= len(code) else b''
+
+
 def make_job(key, stage, ctl, code, workdir):
     """The translator's job for one shader: the file of instructions written under workdir, the rest as data"""
-    c1o, c1t = struct.unpack_from('<2I', ctl, 0x700)
-    c1 = code[c1o:c1t] if 0 <= c1o <= c1t <= len(code) else b''
+    c1 = shader_c1(stage, ctl, code)
     if stage == 'vs':
         ab = vertex_ab(code, ctl)
-        if ab: code, c1 = ab
+        if ab: code = ab[0]
     if stage != 'cs': code = code[0x30:]   # the header; the translator reads the 0x50-byte SPH after it itself
     elif code[:4] == bytes.fromhex('79563412'): code = code[0x100:]   # a compute code area with a header: the instructions start at +0x100
     path = os.path.join(workdir, key + '.bin'); open(path, 'wb').write(code)
