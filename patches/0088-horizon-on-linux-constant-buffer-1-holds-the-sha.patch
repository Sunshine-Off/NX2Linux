+// A hash of guest memory, to tell whether the game wrote it since the last look (a texture streamed in after its first use). blocks = 0: all n bytes; else n bytes are sampled as that many
+// 4 KB blocks spread over the range (a big texture is rewritten whole, a sample sees it). 0 when the range is not mapped
+uint64_t aot_hash64(uint64_t a, uint64_t n, uint64_t blocks) {
+    jmp_buf jb, *outer = g_jb; g_jb = &jb;
+    if (setjmp(jb)) { g_jb = outer; return 0; }
+    const uint8_t *p = (const uint8_t *)guest(a, n ? n : 1, "hash");
+    uint64_t h0 = 0x9E3779B97F4A7C15ull, h1 = 0xC2B2AE3D27D4EB4Full, h2 = 0x165667B19E3779F9ull, h3 = 0x27D4EB2F165667C5ull;
+    auto run = [&](const uint8_t *q, uint64_t len) {
+        uint64_t i = 0;
+        for (; i + 32 <= len; i += 32) {
+            uint64_t w[4]; memcpy(w, q + i, 32);
+            h0 = (h0 ^ w[0]) * 0x100000001B3ull; h1 = (h1 ^ w[1]) * 0x100000001B3ull; h2 = (h2 ^ w[2]) * 0x100000001B3ull; h3 = (h3 ^ w[3]) * 0x100000001B3ull;
+            h0 ^= h0 >> 29; h1 ^= h1 >> 29; h2 ^= h2 >> 29; h3 ^= h3 >> 29;
+        }
+        for (; i < len; i++) h0 = (h0 ^ q[i]) * 0x100000001B3ull;
+    };
+    if (!blocks || n <= blocks * 4096) run(p, n);
+    else for (uint64_t b = 0; b < blocks; b++) run(p + (n - 4096) / (blocks > 1 ? blocks - 1 : 1) * b, 4096);
+    g_jb = outer;
+    return (h0 ^ (h1 * 3) ^ (h2 * 5) ^ (h3 * 7)) | 1;
+}
 uint64_t aot_stat(int i) {
     if (i != S_READS && i != S_WRITES) return g_stats[i];
     std::lock_guard<std::mutex> g(g_counts_mu); uint64_t n = 0;
