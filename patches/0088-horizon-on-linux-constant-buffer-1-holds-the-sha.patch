+    def test_a_shaders_constant_segment_is_its_constant_buffer_1(self):
+        import nvn_gpu, nvn_spirv
+        class Nvn:
+            shader_bytes = {}; stats = {'presents': 0}
+        n = Nvn()
+        code = bytearray(0x300); code[:4] = bytes.fromhex('78563412'); code[0x30:0x34] = struct.pack('<I', 1 | 5 << 10)   # a pixel shader's header
+        code[0x100:0x110] = struct.pack('<4f', 0.5, 1.0, 2.0, 4.0)
+        ctl = bytearray(0x880); struct.pack_into('<2I', ctl, 0x700, 0x100, 0x200)
+        n.shader_bytes['k'] = (bytes(ctl), bytes(code))
+        b = nvn_gpu.GpuBackend(n, self.gpu)
+        c1 = b.constant_segment('k', 'ps')
+        self.assertEqual(struct.unpack_from('<4f', c1), (0.5, 1.0, 2.0, 4.0))
+        self.assertEqual(len(c1), nvn_gpu.DRIVER_SEGMENT_BYTES)
