+++ b/dm/tools/aot_lift.py
@@ -14,6 +14,11 @@ RET = 0xD65F03C0
 STATS = ('indirect_calls', 'indirect_jumps', 'fallback_requests', 'reads', 'writes', 'regions', 'jit_entries', 'jit_to_aot', 'jit_invalidations', 'jit_pages')
 
 
+def missing_symbols(linker_stderr):
+    """The symbols a failed link reports as undefined, in the linker's English or French wording (« name » has a space inside the quotes)"""
+    return sorted(set(re.findall(r'(?:undefined reference to|référence indéfinie vers)[\s«`\'"]*([A-Za-z_0-9]+)', linker_stderr)))
+
+
 class LiftError(Exception):
     pass
 
@@ -125,7 +130,7 @@ class Aot:
             cmd = ['clang++', '-shared', '-std=c++17', *base, str(HERE / 'aot_runtime.cpp'), table, *lls, '-o', so, '-Wl,--no-undefined']
         r = subprocess.run(cmd, capture_output=True, text=True)
         if r.returncode:
-            missing = sorted(set(re.findall(r'(?:undefined reference to|référence indéfinie vers) [«`\'"]*([A-Za-z_0-9]+)', r.stderr)))
+            missing = missing_symbols(r.stderr)
             if missing: raise LinkError('the runtime does not define: ' + ', '.join(missing) + ' (an instruction class not translated yet)')
             raise LinkError('build failed:\n' + r.stderr[-2000:])
         self.lib = ctypes.CDLL(so)
diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index fb6abfa..53e4a6f 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -79,6 +79,7 @@ COMPARE(eq) COMPARE(neq) COMPARE(slt) COMPARE(sle) COMPARE(sgt) COMPARE(sge) COM
     T __remill_read_memory_##N(Memory *, uint64_t a) { T v; memcpy(&v, guest(a, sizeof(T), "read"), sizeof v); count(S_READS); return v; } \
     Memory *__remill_write_memory_##N(Memory *m, uint64_t a, T v) { memcpy(guest(a, sizeof(T), "write"), &v, sizeof v); count(S_WRITES); if (aot_write_hook) aot_write_hook(a, sizeof(T)); return m; }
 ACCESS(8, uint8_t) ACCESS(16, uint16_t) ACCESS(32, uint32_t) ACCESS(64, uint64_t)
+ACCESS(f32, float) ACCESS(f64, double)   // scalar floating-point loads and stores (ldr s0, str d0...)
 
 // Atomics. An exclusive store (stxr, stlxr) is a compare-and-swap against the value the exclusive load read (the Remill patch keeps it in MONITOR_VALUE), so it fails when another thread wrote
 // the location in between. The access must be naturally aligned, as the hardware requires of an exclusive access: otherwise an explicit error.
