diff --git a/dm/tools/aot_report.py b/dm/tools/aot_report.py
new file mode 100644
index 00000000..fa87b7e6
--- /dev/null
+++ b/dm/tools/aot_report.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""The numbers of one run of a recompiled game, as a JSON file (NX2Linux Phase 2, #14 and #17): how much of the code is native (the static count of survey.py) and how much of the running went through the JIT fallback or
+back (the counters of aot_runtime.cpp), so that "the AOT/JIT ratio" and "the transitions" are figures to compare between runs and not impressions. horizon_run.py --report-json writes it when the run ends (and with
+--build-only, with the static part only). Nothing of the game is in it: counts, addresses of functions and mnemonics, the same as survey.py prints.
+  static     functions, lifted, replaced by the host, left to the JIT (with --jit) or not translated, by reason and mnemonic, cache hits and misses
+  runtime    every counter of aot_lift.STATS: indirect_calls, indirect_jumps, fallback_requests, reads, writes, regions, jit_entries (AOT to JIT), jit_to_aot (JIT back to AOT), jit_invalidations (a write into
+             code the JIT had translated), jit_pages, unlifted_calls (a call of a function that was not lifted), svc_calls, import_calls
+  derived    aot_function_share (lifted / (lifted + left to the JIT), the replaced ones leave the count: they are not code of the game), jit_entries_per_second, and the share of the indirect transfers that
+             the AOT table could not take (fallback_requests / (indirect_calls + indirect_jumps))
+Usage: aot_report.py show <report.json>      print it
+       aot_report.py compare <a.json> <b.json>   the counters side by side (two runs: with and without --jit, or before and after a change)"""
+import json, os, sys, tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+VERSION = 1
+RATE = ('jit_entries', 'jit_to_aot', 'jit_invalidations', 'unlifted_calls', 'fallback_requests', 'svc_calls', 'import_calls')
+
+
+def runtime_counters(aot):
+    """{name: value} of every counter the runtime keeps (aot_lift.STATS)"""
+    import aot_lift
+    return {name: int(aot.stat(name)) for name in aot_lift.STATS}
+
+
+def derived(static, runtime, seconds):
+    """The ratios that need both parts. None where a denominator is 0: a ratio of nothing is not 1 and not 0"""
+    lifted, left = static.get('lifted', 0), static.get('jit_fallback', 0) + static.get('not_translated', 0)
+    indirect = runtime.get('indirect_calls', 0) + runtime.get('indirect_jumps', 0)
+    out = {'aot_function_share': lifted / (lifted + left) if lifted + left else None,
+           'fallback_share_of_indirect_transfers': runtime.get('fallback_requests', 0) / indirect if indirect else None}
+    out['per_second'] = {k: runtime.get(k, 0) / seconds for k in RATE} if seconds and seconds > 0 else None
+    return out
+
+
+def build(static, runtime=None, *, seconds=None, frames=None, jit=False, extra=None):
+    """The report: static is survey.classify's dict (plus modules, cache hits and misses), runtime the counters (None for a build with no run)"""
+    rep = {'format': f'nx2linux-aot-report/{VERSION}', 'jit': bool(jit), 'static': static}
+    if runtime is not None:
+        rep['runtime'] = runtime
+        rep['seconds'] = seconds
+        if frames is not None: rep['frames_presented'] = frames
+        rep['derived'] = derived(static, runtime, seconds)
+    if extra: rep['extra'] = extra
+    return rep
+
+
+def write(path, report):
+    """The report to path, whole or not at all (a run killed while writing leaves the previous file)"""
+    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.part')
+    with os.fdopen(fd, 'w') as f: json.dump(report, f, indent=1, sort_keys=True); f.write('\n')
+    os.replace(tmp, path)
+
+
+def load(path):
+    try: rep = json.loads(Path(path).read_text())
+    except (OSError, ValueError) as e: raise SystemExit(f'[RED] {path}: {e}')
+    if not isinstance(rep, dict) or not str(rep.get('format', '')).startswith('nx2linux-aot-report/'): raise SystemExit(f'[RED] {path}: not an nx2linux AOT report')
+    return rep
+
+
+def text(rep):
+    s = rep['static']; lines = [f"jit {'on' if rep['jit'] else 'off'}: {s.get('functions', '?')} entries, lifted {s.get('lifted', '?')}, replaced {s.get('replaced', '?')}, "
+                                f"left to the JIT {s.get('jit_fallback', 0)}, not translated {s.get('not_translated', 0)}"]
+    for k in ('jit_fallback_by_reason', 'not_translated_by_reason'):
+        if s.get(k): lines.append(f'  {k}: ' + ', '.join(f'{a} {b}' for a, b in s[k].items()))
+    for k, v in (s.get('instruction_details') or {}).items(): lines.append(f'  {k}: ' + ', '.join(f'{m} {n}' for m, n in v.items()))
+    if 'runtime' in rep:
+        lines.append(f"ran {rep.get('seconds') or 0:.0f} s, frames presented {rep.get('frames_presented', '?')}")
+        lines.append('  ' + ', '.join(f'{k} {v}' for k, v in rep['runtime'].items()))
+        d = rep['derived']
+        lines.append('  aot function share ' + ('n/a' if d['aot_function_share'] is None else f"{d['aot_function_share']:.4%}") + ', fallback share of indirect transfers ' +
+                     ('n/a' if d['fallback_share_of_indirect_transfers'] is None else f"{d['fallback_share_of_indirect_transfers']:.4%}"))
+    return '\n'.join(lines)
+
+
+def compare(a, b):
+    lines = [f'{"":<28}{"a":>16}{"b":>16}']
+    def row(name, x, y): lines.append(f'{name:<28}{"-" if x is None else x:>16}{"-" if y is None else y:>16}')
+    for k in ('functions', 'lifted', 'replaced', 'jit_fallback', 'not_translated'): row(k, a['static'].get(k), b['static'].get(k))
+    for k in sorted(set(a.get('runtime', {})) | set(b.get('runtime', {}))): row(k, a.get('runtime', {}).get(k), b.get('runtime', {}).get(k))
+    row('seconds', None if a.get('seconds') is None else round(a['seconds']), None if b.get('seconds') is None else round(b['seconds']))
+    return '\n'.join(lines)
+
+
+def main(argv=None):
+    argv = sys.argv[1:] if argv is None else argv
+    if len(argv) == 2 and argv[0] == 'show': print(text(load(argv[1]))); return 0
+    if len(argv) == 3 and argv[0] == 'compare': print(compare(load(argv[1]), load(argv[2]))); return 0
+    sys.exit(__doc__)
+
+
+if __name__ == '__main__': sys.exit(main())
