diff --git a/dm/tools/tests/test_aot_report.py b/dm/tools/tests/test_aot_report.py
new file mode 100644
index 00000000..73949137
--- /dev/null
+++ b/dm/tools/tests/test_aot_report.py
@@ -0,0 +1,133 @@
+"""aot_report.py and horizon_run.py --report-json (NX2Linux Phase 2, #14): the numbers of a run of a recompiled game as a JSON file. The arithmetic, the file and the text need nothing. The run of a fixture module
+through the JIT (a function Remill cannot lift, called N times: N entries into the JIT) needs REMILL_BUILD, DYNARMIC_DIR, clang++, unicorn and capstone, and is skipped otherwise. No game data."""
+import json, os, subprocess, sys, tempfile, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+TOOLS = HERE.parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(TOOLS))
+import aot_report as ar
+
+try:
+    import capstone  # noqa: F401
+    from test_aot_t3 import READY
+except ImportError: capstone, READY = None, False
+JIT_READY = bool(READY and capstone and os.path.exists(os.path.join(os.environ.get('DYNARMIC_DIR', '/nonexistent'), 'build/src/dynarmic/libdynarmic.a')))
+
+STATIC = {'functions': 110, 'lifted': 95, 'replaced': 10, 'jit_fallback': 5, 'not_translated': 0, 'jit_fallback_by_reason': {'instruction without semantics': 5}, 'instruction_details': {'instruction without semantics': {'cls': 5}}}
+RUNTIME = {'indirect_calls': 600, 'indirect_jumps': 400, 'fallback_requests': 50, 'reads': 1, 'writes': 2, 'regions': 3, 'jit_entries': 40, 'jit_to_aot': 30, 'jit_invalidations': 2, 'jit_pages': 4,
+           'unlifted_calls': 40, 'svc_calls': 7, 'import_calls': 9}
+
+
+class Arithmetic(unittest.TestCase):
+    def test_the_share_leaves_the_replaced_functions_out(self):
+        d = ar.derived(STATIC, RUNTIME, 10)
+        self.assertAlmostEqual(d['aot_function_share'], 95 / 100)   # 10 replaced functions are the host's, not game code left behind
+        self.assertAlmostEqual(d['fallback_share_of_indirect_transfers'], 0.05)
+        self.assertEqual(d['per_second']['jit_entries'], 4.0)
+
+    def test_a_ratio_of_nothing_is_none_not_zero_or_one(self):
+        d = ar.derived({'lifted': 0, 'jit_fallback': 0, 'not_translated': 0}, {'indirect_calls': 0, 'indirect_jumps': 0, 'fallback_requests': 0}, 0)
+        self.assertEqual((d['aot_function_share'], d['fallback_share_of_indirect_transfers'], d['per_second']), (None, None, None))
+
+    def test_a_build_without_a_run_has_the_static_part_only(self):
+        rep = ar.build(STATIC, None, jit=True)
+        self.assertEqual(set(rep), {'format', 'jit', 'static'}); self.assertTrue(rep['jit'])
+
+    def test_a_run_adds_the_counters_the_ratios_and_the_frames(self):
+        rep = ar.build(STATIC, RUNTIME, seconds=10, frames=300, jit=True, extra={'title': 'x'})
+        self.assertEqual((rep['runtime'], rep['frames_presented'], rep['seconds'], rep['extra']), (RUNTIME, 300, 10, {'title': 'x'}))
+        self.assertIn('derived', rep)
+
+    def test_the_counters_are_the_ones_of_the_runtime(self):
+        import aot_lift
+        self.assertEqual(set(RUNTIME), set(aot_lift.STATS))   # a counter added to the runtime has to be in this fixture and in the report
+
+
+class Files(unittest.TestCase):
+    def test_write_then_load_gives_the_same_report_and_leaves_no_partial_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            rep = ar.build(STATIC, RUNTIME, seconds=3.5, frames=10, jit=False)
+            ar.write(Path(d) / 'sub' / 'r.json', rep)
+            self.assertEqual(ar.load(Path(d) / 'sub' / 'r.json'), json.loads(json.dumps(rep)))
+            self.assertEqual([p.name for p in (Path(d) / 'sub').iterdir()], ['r.json'])
+
+    def test_a_file_that_is_not_a_report_is_an_explicit_exit(self):
+        with tempfile.TemporaryDirectory() as d:
+            for name, text, why in (('a.json', '{nope', 'Expecting'), ('b.json', '[]', 'not an nx2linux AOT report'), ('c.json', '{"format": "other"}', 'not an nx2linux AOT report')):
+                (Path(d) / name).write_text(text)
+                with self.subTest(name), self.assertRaises(SystemExit) as cm: ar.load(Path(d) / name)
+                self.assertIn(why, str(cm.exception))
+            with self.assertRaises(SystemExit) as cm: ar.load(Path(d) / 'missing.json')
+            self.assertIn('[RED]', str(cm.exception))
+
+    def test_show_and_compare_print_the_figures_of_both_runs(self):
+        a, b = ar.build(STATIC, RUNTIME, seconds=10, frames=5, jit=True), ar.build(dict(STATIC, jit_fallback=0, not_translated=5), dict(RUNTIME, jit_entries=0), seconds=12, jit=False)
+        t = ar.text(a)
+        for part in ('jit on', 'left to the JIT 5', 'cls 5', 'jit_entries 40', '95.0000%', '5.0000%'): self.assertIn(part, t)
+        c = ar.compare(a, b)
+        self.assertRegex(c, r'jit_entries\s+40\s+0'); self.assertRegex(c, r'jit_fallback\s+5\s+0'); self.assertRegex(c, r'seconds\s+10\s+12')
+
+    def test_the_command_line_shows_and_compares(self):
+        with tempfile.TemporaryDirectory() as d:
+            ar.write(Path(d) / 'a.json', ar.build(STATIC, RUNTIME, seconds=1, jit=True)); ar.write(Path(d) / 'b.json', ar.build(STATIC, None))
+            for args, want in ((['show', str(Path(d) / 'a.json')], 'jit on'), (['compare', str(Path(d) / 'a.json'), str(Path(d) / 'b.json')], 'jit_entries')):
+                r = subprocess.run([sys.executable, '-I', str(TOOLS / 'aot_report.py'), *args], capture_output=True, text=True)
+                self.assertEqual(r.returncode, 0, r.stderr); self.assertIn(want, r.stdout)
+            self.assertNotEqual(subprocess.run([sys.executable, '-I', str(TOOLS / 'aot_report.py')], capture_output=True, text=True).returncode, 0)
+
+
+class RunnerOption(unittest.TestCase):
+    def test_the_option_is_named_and_written_at_the_end_of_a_run_and_of_a_build(self):
+        r = subprocess.run([sys.executable, '-I', str(TOOLS / 'horizon_run.py'), '--help'], capture_output=True, text=True, timeout=120)
+        self.assertIn('--report-json', r.stdout)
+        src = (TOOLS / 'horizon_run.py').read_text()
+        self.assertLess(src.index('if a.build_only:\n        write_report()'), src.index('hz.attach()'))   # a build writes the static part before the game starts
+        self.assertIn('write_report(aot_report.runtime_counters(hz.aot)', src)
+
+
+@unittest.skipUnless(JIT_READY, 'needs REMILL_BUILD, DYNARMIC_DIR, clang++, unicorn and capstone')
+class FixtureRun(unittest.TestCase):
+    """module_c: c_main starts with an instruction Remill cannot lift, so it runs in the JIT, and calls a host function"""
+    @classmethod
+    def setUpClass(cls):
+        import elf_module as em, module_fixture as mf
+        cls.tmp = tempfile.TemporaryDirectory()
+        nso, _ = mf.build(mf.module_c()); (Path(cls.tmp.name) / 'c.nso').write_bytes(nso)
+        em.convert_nso(Path(cls.tmp.name) / 'c.nso', cls.tmp.name, 'c')
+
+    @classmethod
+    def tearDownClass(cls): cls.tmp.cleanup()
+
+    def test_n_calls_of_a_jit_function_are_n_entries_in_the_report(self):
+        import elf_module as em, survey
+        ms = em.ModuleSet([str(Path(self.tmp.name) / 'c.manifest.json')], {'hle_add': lambda r: r.__setitem__(0, (r[0] + r[1]) & ar_mask())})
+        aot = ms.build(jit=True)
+        try:
+            self.assertEqual(aot.stat('jit_entries'), 0)
+            for i in range(7):
+                self.assertNotIn('fault', ms.call('c_main', {'x0': i, 'x1': 2}))
+            runtime = ar.runtime_counters(aot)
+            total = sum(len(m.functions) + len(m.jump_targets) for m in ms.modules)
+            static = survey.classify(aot.unlifted, total, {}, True)
+            rep = ar.build(static, runtime, seconds=1.0, jit=True)
+            self.assertEqual(rep['static']['jit_fallback'], 1); self.assertEqual(rep['static']['not_translated'], 0)
+            self.assertEqual(rep['runtime']['jit_entries'], 7); self.assertGreaterEqual(rep['runtime']['import_calls'], 7)
+            self.assertAlmostEqual(rep['derived']['aot_function_share'], rep['static']['lifted'] / (rep['static']['lifted'] + 1))
+            self.assertEqual(rep['derived']['per_second']['jit_entries'], 7.0)
+        finally: aot.close()
+
+    def test_a_build_with_the_runner_writes_the_static_part(self):
+        out = Path(self.tmp.name) / 'build.json'
+        cache = Path(self.tmp.name) / 'cache'
+        r = subprocess.run([sys.executable, '-I', str(TOOLS / 'horizon_run.py'), '--modules', self.tmp.name, '--order', 'c', '--title', '0000000000000000', '--jit', '--build-only',
+                            '--cache', str(cache), '--report-json', str(out)], capture_output=True, text=True, timeout=600)
+        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+        rep = ar.load(out)
+        self.assertEqual((rep['jit'], rep['static']['jit_fallback'], rep['static']['functions']), (True, 1, 2)); self.assertNotIn('runtime', rep)
+
+
+def ar_mask(): return (1 << 64) - 1
+
+
+if __name__ == '__main__': unittest.main()
