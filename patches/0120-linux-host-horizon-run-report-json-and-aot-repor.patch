     p.add_argument('--no-profile', action='store_true', help='do not apply the per-title workarounds'); p.add_argument('--verbose', action='store_true')
     a = p.parse_args()
     import horizon_game
@@ -37,12 +38,26 @@ def main():
     except em.ModuleError as e: sys.exit(f'[RED] {e}')
     hz = horizon_hle.Horizon(ms, verbose=a.verbose, romfs=a.romfs, title_id=a.title, game=game)
     ovr = horizon_overrides.install(hz)
-    if not a.no_profile: ovr.update(horizon_overrides.install_profile(hz, game.workarounds()))
+    origin = {s: horizon_overrides.ORIGIN.get(s, 'handwritten') for s in ovr}   # for the report: who replaced each function
+    if not a.no_profile:
+        work = horizon_overrides.install_profile(hz, game.workarounds())
+        ovr.update(work); origin.update({s: 'game profile' for s in work})
     t = time.time()
     hz.aot = ms.build(jit=a.jit, overrides=ovr, cache=a.cache)
     print(f'built in {time.time() - t:.0f} s ({hz.aot.cache_hits} cached, {hz.aot.cache_misses} built, {len(hz.aot.unlifted)} not translated)', flush=True)
+    built_in = time.time() - t
