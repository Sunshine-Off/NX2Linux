+LLVM_LINK = 'llvm-link'
+
+
+def group_size():
+    """AOT_GROUP: about how many functions share one compiled object. 0 (the default, and any value under 2): one object per function"""
+    try: n = int(os.environ.get('AOT_GROUP', '0'))
+    except ValueError: return 0
+    return n if n >= 2 else 0
+
+
+def group_units(items, size):
+    """The functions (address first in each item) cut into groups of about size, in address order. A group ends before a function whose address hashes to a multiple of size, or at 4 times size,
+    so the boundaries depend on the addresses and not on how many functions come before: adding, removing or changing one function changes its group and at most the next one"""
+    groups, cur = [], []
+    for f in sorted(items, key=lambda f: f[0]):
+        if cur and (int.from_bytes(hashlib.sha256(b'group|%x' % f[0]).digest()[:4], 'big') % size == 0 or len(cur) >= 4 * size): groups.append(cur); cur = []
+        cur.append(f)
+    return groups + ([cur] if cur else [])
+
+
+def ref_symbols(text):
+    """The names the IR of a lifted function uses (calls and references), declarations left out: what its compiled object can leave undefined"""
+    names = set()
+    for line in text.splitlines():
+        if line.startswith('declare ') or re.match(r'@[\w.$]+ = (external|extern_weak)', line): continue
+        names.update(re.findall(r'@([\w.$]+)', line))
+    return names
+
