+"""Grouping the compiled objects (aot_lift.Aot with AOT_GROUP=N, issue #18, option B).
+A cache holds one object, a .syms and a .fail per function: 622,259 objects of 4 KB on average took 6.3 GB on disk for 2.7 GB of content, because every small file takes a 4 KB block,
+and each object repeats its ELF headers and symbol table (25% of its bytes). With AOT_GROUP=N about N functions are lifted, merged by llvm-link and compiled into one object, with a .grp beside it.
+  · the boundaries of the groups depend on the addresses only, so one changed function misses its group and not the ones after it;
+  · a grouped build runs the same code as an ungrouped one and leaves far fewer files;
+  · a function Remill cannot lift, and a function that needs a symbol the runtime does not define, are handled as before, the second by splitting its group into one object per function;
+  · a group that cannot be merged or compiled is split the same way, and the build goes on.
+Needs REMILL_BUILD, clang++, llvm-link and unicorn; skipped otherwise. Group size is set by the tests, never by the environment they run in."""
+import json, os, shutil, struct, sys, tempfile, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import aot_lift
+import arm64_ref as ref
+from test_aot_t3 import SP, READY, MEM
+from test_aot_lift_batch import Counting, MOVZ_X0, CLS_X0_X0, functions, has_batch
+
+BASE = 0x10000
+NEEDS = READY and shutil.which('llvm-link')
+
+
+def files(cache, suffix): return sorted(p for p in Path(cache).rglob('*' + suffix) if p.is_file())
+
+
+class Units(unittest.TestCase):
+    """The grouping itself: no Remill needed"""
+    def setUp(self): self.addrs = [(BASE + 0x40 * i, b'', BASE + 0x40 * i) for i in range(5000)]
+
+    def test_group_size_comes_from_the_environment_and_a_bad_value_means_none(self):
+        saved = os.environ.pop('AOT_GROUP', None)
+        try:
+            self.assertEqual(aot_lift.group_size(), 0)
+            for value, want in (('64', 64), ('1', 0), ('0', 0), ('-5', 0), ('many', 0), ('2', 2)):
+                os.environ['AOT_GROUP'] = value
+                self.assertEqual(aot_lift.group_size(), want, value)
+        finally:
+            if saved is None: os.environ.pop('AOT_GROUP', None)
+            else: os.environ['AOT_GROUP'] = saved
+
+    def test_groups_are_about_the_size_asked_and_never_more_than_four_times_it(self):
+        groups = aot_lift.group_units(self.addrs, 64)
+        sizes = [len(g) for g in groups]
+        self.assertEqual(sum(sizes), 5000); self.assertLessEqual(max(sizes), 256)
+        self.assertTrue(40 <= 5000 / len(groups) <= 100, 5000 / len(groups))
+        self.assertEqual([f[0] for g in groups for f in g], [f[0] for f in self.addrs], 'the order is the address order')
+
+    def test_one_function_more_or_less_changes_at_most_two_groups(self):
+        before = {tuple(f[0] for f in g) for g in aot_lift.group_units(self.addrs, 64)}
+        for i in (3, 1234, 4999):
+            fewer = self.addrs[:i] + self.addrs[i + 1:]
+            after = {tuple(f[0] for f in g) for g in aot_lift.group_units(fewer, 64)}
+            self.assertLessEqual(len(after - before), 2, i); self.assertLessEqual(len(before - after), 2, i)
+
+    def test_the_order_of_the_input_does_not_matter(self):
+        a = aot_lift.group_units(self.addrs, 32); b = aot_lift.group_units(list(reversed(self.addrs)), 32)
+        self.assertEqual([[f[0] for f in g] for g in a], [[f[0] for f in g] for g in b])
+
+
+@unittest.skipUnless(NEEDS, 'needs REMILL_BUILD, clang++, llvm-link and unicorn')
+class Grouped(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory(); self.root = Path(self.dir.name)
+        self.saved = {k: os.environ.get(k) for k in ('AOT_GROUP', 'AOT_LIFT_BATCH')}
+        os.environ['AOT_GROUP'] = '8'
+
+    def tearDown(self):
+        for k, v in self.saved.items():
+            if v is None: os.environ.pop(k, None)
+            else: os.environ[k] = v
+        aot_lift.LLVM_LINK = 'llvm-link'
+        self.dir.cleanup()
+
+    def build(self, fs, cache='c', **kw): return aot_lift.Aot(fs, cache=str(self.root / cache) if cache else None, **kw)
+
+    def check(self, a, fs, picks=(0, 1, 17, -1)):
+        for i in picks:
+            addr, code = fs[i][0], fs[i][1]
+            self.assertEqual(a.run(addr, {'x30': ref.STOP}, 0, SP)['x0'], (i % len(fs)) + 1, f'function {i}')
+
+    def test_a_grouped_build_runs_the_same_code_and_leaves_far_fewer_files(self):
+        fs = functions(64)
+        a = self.build(fs, jobs=4)
+        try:
+            self.check(a, fs)
+            self.assertEqual((a.cache_hits, a.cache_misses), (0, 64)); self.assertEqual(a.group_splits, 0)
+        finally: a.close()
+        objs, grps = files(self.root / 'c', '.o'), files(self.root / 'c', '.grp')
+        self.assertGreaterEqual(len(grps), 3); self.assertEqual(len(objs), len(grps), 'one object per group')
+        self.assertLessEqual(len(objs), 16, 'against 64 objects, 64 .syms files')
+        self.assertEqual(files(self.root / 'c', '.syms'), [], 'no file per function')
+
+    def test_the_second_build_hits_every_group_and_a_changed_function_misses_its_group_only(self):
+        fs = functions(64)
+        self.build(fs).close()
+        more = fs + [(BASE + 0x40 * 64, struct.pack('<2I', MOVZ_X0 | (65 << 5), aot_lift.RET))]   # a library of other functions, so that the objects are what is looked up
+        a = self.build(more)
+        try:
+            self.assertGreaterEqual(a.cache_hits, 50, 'the groups of the first build are found')
+            self.assertGreaterEqual(a.group_hits, 3)
+        finally: a.close()
+        changed = list(fs); changed[10] = (fs[10][0], struct.pack('<2I', MOVZ_X0 | (99 << 5), aot_lift.RET))
+        b = self.build(changed)
+        try:
+            members = next(len(g) for g in aot_lift.group_units(changed, 8) if fs[10][0] in [f[0] for f in g])
+            self.assertEqual(b.cache_misses, members); self.assertEqual(b.group_builds, 1)
+            self.assertEqual(b.run(fs[10][0], {'x30': ref.STOP}, 0, SP)['x0'], 99)
+        finally: b.close()
+
+    def test_an_unliftable_function_is_remembered_with_the_group_and_gives_the_same_reason(self):
+        g = (BASE + 0x40 * 5 + 4 * 0x1000, struct.pack('<2I', CLS_X0_X0, aot_lift.RET))
+        fs = functions(20) + [g]
+        os.environ['AOT_GROUP'] = '0'
+        alone = self.build(fs, cache=None, stub_unliftable=True); why = alone.unlifted[g[0]]; alone.close()
+        os.environ['AOT_GROUP'] = '8'
+        a = self.build(fs, stub_unliftable=True)
+        try: self.assertEqual(a.unlifted[g[0]], why); self.check(a, fs, (0, 7, 19))
+        finally: a.close()
+        if has_batch():
+            groups = aot_lift.group_units(fs, 8)
+            other = next(grp for grp in groups if all(f[0] != g[0] for f in grp))   # a group that does not hold the unliftable function
+            changed = [(f[0], struct.pack('<2I', MOVZ_X0 | (77 << 5), aot_lift.RET)) if f[0] == other[0][0] else f for f in fs]
+            with Counting() as c:
+                b = self.build(changed, stub_unliftable=True)
+                try: self.assertEqual(b.unlifted[g[0]], why); self.assertEqual(b.group_builds, 1)
+                finally: b.close()
+                self.assertEqual(c.starts, 1, 'only the group that changed is lifted again, the failure of the other one is remembered')
+        with self.assertRaises(aot_lift.LiftError) as e: self.build(fs, cache='c2', stub_unliftable=False)
+        self.assertIn('cls', str(e.exception))
+
+    def test_a_function_that_needs_an_undefined_symbol_is_stubbed_and_its_group_is_split(self):
+        fs = functions(16)
+        target = fs[9][0]
+        real = aot_lift.lift_function
+        def lift_function(code, address, ll, entry=None, lifted=None):
+            real(code, address, ll, entry, lifted)
+            if address == target:
+                with open(ll, 'a') as f: f.write('\ndeclare void @nx_missing_symbol()\ndefine void @nx_user() { call void @nx_missing_symbol() ret void }\n')
+        aot_lift.lift_function = lift_function
+        try: a = self.build(fs, stub_unliftable=True)
+        finally: aot_lift.lift_function = real
+        try:
+            self.assertEqual(list(a.unlifted), [target]); self.assertIn('nx_missing_symbol', a.unlifted[target])
+            self.assertGreaterEqual(a.group_splits, 1)
+            self.check(a, fs, (0, 8, 10, 15))
+        finally: a.close()
+
+    def test_a_group_that_cannot_be_merged_is_split_and_the_build_goes_on(self):
+        fs = functions(24)
+        aot_lift.LLVM_LINK = str(self.root / 'no-such-llvm-link')
+        a = self.build(fs)
+        try:
+            self.assertGreaterEqual(a.group_splits, 1); self.check(a, fs, (0, 11, 23))
+        finally: a.close()
+        self.assertTrue(files(self.root / 'c', '.syms'), 'the split groups have an object and a .syms per function')
+        aot_lift.LLVM_LINK = 'llvm-link'
+        more = fs + [(BASE + 0x40 * 99, struct.pack('<2I', MOVZ_X0 | (100 << 5), aot_lift.RET))]
+        before = {tuple(f[0] for f in g) for g in aot_lift.group_units(fs, 8)}
+        untouched = sum(len(g) for g in aot_lift.group_units(more, 8) if tuple(f[0] for f in g) in before)
+        b = self.build(more)
+        try:
+            self.assertGreater(untouched, 0); self.assertEqual(b.cache_hits, untouched, 'a split group is read back from its per-function objects')
+            self.assertEqual(b.group_builds, 1)
+        finally: b.close()
+
+    def test_functions_of_a_group_are_not_inlined_into_each_other(self):
+        """A call between two functions of one object stays a call: the code is the one an ungrouped build makes"""
+        from nso_asm import STP_PRE, LDP_POST
+        import arm64_fixture as fx
+        callee = next(a for a in range(BASE + 0x140, BASE + 0x2000, 0x40) if len(aot_lift.group_units([(a - 0x40, b'', 0), (a, b'', 0)], 100)) == 1)
+        caller = callee - 0x40
+        fs = [(caller, struct.pack('<5I', STP_PRE(29, 30, 31, -16), fx.BL(caller + 4, callee), LDP_POST(29, 30, 31, 16), aot_lift.RET, aot_lift.RET)),
+              (callee, struct.pack('<2I', MOVZ_X0 | (5 << 5), aot_lift.RET))]
+        os.environ['AOT_GROUP'] = '100'
+        self.assertEqual(len(aot_lift.group_units(fs, 100)), 1, 'both functions are in one group')
+        a = self.build(fs)
+        for b, data in MEM.items(): a.map(b, len(data), data)
+        try: self.assertEqual(a.run(caller, {'x30': ref.STOP}, 0, SP)['x0'], 5)
+        finally: a.close()
+        obj = files(self.root / 'c', '.o')[0]
+        import subprocess
+        relocs = subprocess.run(['llvm-readelf', '-r', str(obj)], capture_output=True, text=True).stdout
+        self.assertIn(f'sub_{callee:x}', relocs, 'the call to the callee is still there')
+
+    def test_ungrouped_stays_the_default(self):
+        os.environ.pop('AOT_GROUP')
+        a = self.build(functions(12))
+        a.close()
+        self.assertEqual(files(self.root / 'c', '.grp'), []); self.assertEqual(len(files(self.root / 'c', '.o')), 12)
+
+    def test_a_grouped_build_without_a_cache_works_too(self):
+        fs = functions(30)
+        a = self.build(fs, cache=None, jobs=2)
+        try: self.check(a, fs, (0, 15, 29))
+        finally: a.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
