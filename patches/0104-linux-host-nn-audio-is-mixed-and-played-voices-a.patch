+"""horizon_movie.py: opening a movie fails explicitly and is counted, with the SDK's own code (the host has no decoder behind movie::Decoder)"""
+import sys, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_movie as hm
+import horizon_overrides as ho
+
+
+class FakeHz:
+    def __init__(self): self.mem, self.logs = bytearray(0x1000), []
+    def cstring(self, a, limit=256): return bytes(self.mem[a:a + limit]).split(b'\0')[0].decode()
+    def log(self, m): self.logs.append(m)
+
+
+def call(hz, sym, *args):
+    r = [0] * 39; r[:len(args)] = args
+    ho.TABLE[sym][0](hz, r); return r[0]
+
+
+class Movie(unittest.TestCase):
+    def test_every_way_of_opening_a_movie_is_refused_with_the_sdks_own_code_and_counted(self):
+        hz = FakeHz(); hz.mem[0x100:0x120] = b'stream/movie/mv10010100.webm\0'
+        self.assertEqual(call(hz, '_ZN5movie9Extractor13SetDataSourceEPKc', 0x10, 0x100), hm.NO_IMPLEMENTATION)
+        self.assertEqual(call(hz, '_ZN5movie11NnExtractor13SetDataSourceEPKvi', 0x10, 0x200, 4096), hm.NO_IMPLEMENTATION)
+        self.assertEqual(call(hz, '_ZN5movie9Extractor13SetDataSourceEPNS_18ClientStreamReaderEPKc', 0x10, 0x20, 0x100), hm.NO_IMPLEMENTATION)
+        self.assertEqual(len(hm.refused(hz)), 3)
+        self.assertIn('mv10010100.webm', hz.logs[0]); self.assertIn('no movie decoder', hz.logs[0])
+        self.assertIn('3 openings refused', hm.report(hz))
+
+    def test_the_log_names_the_first_four_and_counts_the_rest(self):
+        hz = FakeHz()
+        for _ in range(9): call(hz, '_ZN5movie9Extractor13SetDataSourceEPKc', 0x10, 0x100)
+        self.assertEqual((len(hz.logs), len(hm.refused(hz))), (4, 9))
+
+    def test_a_run_that_opened_no_movie_says_so(self):
+        self.assertEqual(hm.report(FakeHz()), 'movie: the game opened no movie')
+
+
+if __name__ == '__main__': unittest.main()
