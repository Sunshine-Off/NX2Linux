+        h = hz.rd64(0x400); hz.wr(0x1000, data)
+        self.assertEqual(self.call(hz, 'write', h, 0, 0x1000, len(data), 0), 0); self.call(hz, 'close', h)
+
+    def get(self, hz, path):
+        self.text(hz, 0x300, path)
+        if self.call(hz, 'open', 0x400, 0x300, 1): return None
+        h = hz.rd64(0x400); self.call(hz, 'getsize', 0x500, h); n = hz.rd64(0x500)
+        self.call(hz, 'read', 0x600, h, 0, 0x2000, n); self.call(hz, 'close', h)
+        return hz.rd(0x2000, n)
+
+    def test_a_save_that_was_not_committed_is_not_there_after_a_restart(self):
+        hz = self.boot(); self.put(hz, 'save:/slot0.bin', b'first')
+        self.assertEqual(self.get(hz, 'save:/slot0.bin'), b'first')   # the game sees its own writes at once
+        self.assertEqual(self.get(self.boot(), 'save:/slot0.bin'), None)   # a run that ends here saved nothing
