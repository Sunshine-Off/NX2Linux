diff --git a/dm/tools/tests/test_horizon_audio.py b/dm/tools/tests/test_horizon_audio.py
new file mode 100644
index 0000000..94d13e8
--- /dev/null
+++ b/dm/tools/tests/test_horizon_audio.py
@@ -0,0 +1,160 @@
+"""horizon_audio.py: the voices, wave buffers and audio-out buffers a game queues are mixed into the output (a WAV file here), at the right level, rate and pitch, and released when played. A fake guest memory; the mixer
+library (libnx2linux_audio.so) is needed, the test is skipped without it."""
+import math, os, struct, sys, tempfile, unittest, wave
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_audio as ha
+import horizon_mix
+from horizon_overrides import TABLE
+
+S = '_ZN2nn5audio'
+SYMS = dict(acquire=S + '16AcquireVoiceSlotEPNS0_19AudioRendererConfigEPNS0_9VoiceTypeEiiNS0_12SampleFormatEiPKvm', append=S + '16AppendWaveBufferEPNS0_9VoiceTypeEPKNS0_10WaveBufferE',
+            play=S + '17SetVoicePlayStateEPNS0_9VoiceTypeENS1_9PlayStateE', pitch=S + '13SetVoicePitchEPNS0_9VoiceTypeEf', mixvol=S + '17SetVoiceMixVolumeEPNS0_9VoiceTypeEPNS0_12FinalMixTypeEfii',
+            released=S + '21GetReleasedWaveBufferEPNS0_9VoiceTypeE', sink=S + '13AddDeviceSinkEPNS0_19AudioRendererConfigEPNS0_14DeviceSinkTypeEPNS0_12FinalMixTypeEPKaiPKc',
+            openout=S + '19OpenDefaultAudioOutEPNS0_8AudioOutERKNS0_17AudioOutParameterE', startout=S + '13StartAudioOutEPNS0_8AudioOutE',
+            appendout=S + '20AppendAudioOutBufferEPNS0_8AudioOutEPNS0_14AudioOutBufferE', releasedout=S + '25GetReleasedAudioOutBufferEPNS0_8AudioOutE',
+            volume=S + '14SetVoiceVolumeEPNS0_9VoiceTypeEf')
+
+
+class FakeHz:
+    def __init__(self): self.mem, self.logs, self.handles = bytearray(0x100000), [], {}
+    def rd(self, a, n): return bytes(self.mem[a:a + n])
+    def wr(self, a, d): self.mem[a:a + len(d)] = d
+    def rd32(self, a): return struct.unpack('<I', self.rd(a, 4))[0]
+    def rd64(self, a): return struct.unpack('<Q', self.rd(a, 8))[0]
+    def log(self, m): self.logs.append(m)
+    def signal_event(self, ev): pass
+
+
+def call(hz, name, *args, f=None):
+    r = [0] * 39
+    r[:len(args)] = args
+    if f is not None: r[31] = struct.unpack('<I', struct.pack('<f', f))[0]
+    TABLE[SYMS[name]][0](hz, r)
+    return r[0]
+
+
+def sine(frames, hz=480.0, rate=48000, amp=0.5):
+    return b''.join(struct.pack('<h', int(amp * 32767 * math.sin(2 * math.pi * hz * i / rate))) for i in range(frames))
+
+
+@unittest.skipUnless(horizon_mix.library_path(), 'libnx2linux_audio.so is not built')
+class Mix(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(); self.wav = str(Path(self.tmp.name) / 'out.wav')
+        self.old = os.environ.get('NX2LINUX_AUDIO'); os.environ['NX2LINUX_AUDIO'] = 'wav:' + self.wav
+        self.hz = FakeHz(); self.a = ha.state(self.hz); self.a.rate, self.a.tick_samples = 48000, 240
+        self.a.open_mixer()
+        self.real_start, ha.Audio.start_ticker = ha.Audio.start_ticker, lambda self: None   # the test ticks by hand
+
+    def tearDown(self):
+        ha.Audio.start_ticker = self.real_start
+        self.a.mixer.close()
+        if self.old is None: os.environ.pop('NX2LINUX_AUDIO', None)
+        else: os.environ['NX2LINUX_AUDIO'] = self.old
+        self.tmp.cleanup()
+
+    def voice(self, data, channels=1, fmt=2, rate=48000, addr=0x1000, wb=0x2000, loop=0, start=0, end=0):
+        self.hz.wr(0x40000, data)
+        call(self.hz, 'acquire', 0x500, addr, rate, channels, fmt)
+        self.hz.wr(wb, struct.pack('<QQiiB', 0x40000, len(data), start, end, loop))
+        self.assertEqual(call(self.hz, 'append', addr, wb), 1)
+        return addr
+
+    def samples(self):
+        self.a.mixer.close()
+        with wave.open(self.wav) as w: raw = w.readframes(w.getnframes())
+        return [v[0] for v in struct.iter_unpack('<h', raw)]   # interleaved stereo
+
+    def test_a_started_voice_reaches_the_output_at_its_mix_volume_and_the_buffer_is_released_when_played(self):
+        v = self.voice(sine(480))   # 10 ms of 480 Hz
+        call(self.hz, 'mixvol', v, 0, 0, 0, f=0.5); call(self.hz, 'mixvol', v, 0, 0, 1, f=0.25)   # source 0 to bus 0 at 0.5 (left), to bus 1 at 0.25 (right): (voice, mix, source, bus)
+        call(self.hz, 'play', v, 0)
+        self.a.tick(); self.assertEqual(call(self.hz, 'released', v), 0)   # 240 of 480 frames played
+        self.a.tick(); self.assertEqual(call(self.hz, 'released', v), 0x2000)   # all played
+        s = self.samples()
+        left, right = s[0::2], s[1::2]
+        self.assertEqual(len(left), 480)
+        self.assertAlmostEqual(max(left) / 32767, 0.25, delta=0.01); self.assertAlmostEqual(max(right) / 32767, 0.125, delta=0.01)   # 0.5 * 0.5 and 0.5 * 0.25
+
+    def test_a_voice_that_is_not_started_is_silent_and_the_output_keeps_its_clock(self):
+        v = self.voice(sine(480)); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0)
+        self.a.tick(); self.assertEqual(max(map(abs, self.samples())), 0)
+
+    def test_the_pitch_changes_the_speed_the_buffer_is_played_at(self):
+        v = self.voice(sine(960)); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'pitch', v, f=2.0); call(self.hz, 'play', v, 0)
+        self.a.tick(); self.a.tick()
+        self.assertEqual(call(self.hz, 'released', v), 0x2000)   # twice as fast: 960 frames take two ticks of 240
+
+    def test_the_sample_rate_of_a_voice_is_converted_to_the_output_rate(self):
+        v = self.voice(sine(240, rate=24000), rate=24000); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'play', v, 0)
+        self.a.tick(); self.assertEqual(call(self.hz, 'released', v), 0)   # 240 frames at 24 kHz last 480 output samples
+        self.a.tick(); self.assertEqual(call(self.hz, 'released', v), 0x2000)
+
+    def test_a_looping_buffer_is_never_released_and_the_voice_goes_on_sounding(self):
+        v = self.voice(sine(240), loop=1); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'play', v, 0)
+        for _ in range(5): self.a.tick()
+        self.assertEqual(call(self.hz, 'released', v), 0)
+        self.assertGreater(max(map(abs, self.samples()[-480:])), 10000)
+
+    def test_a_stereo_voice_sends_each_channel_to_its_bus_and_the_sink_names_the_output_channels(self):
+        pcm = b''.join(struct.pack('<hh', 10000, -20000) for _ in range(240))
+        v = self.voice(pcm, channels=2)
+        call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'mixvol', v, 1, 1, 1, f=1.0); call(self.hz, 'play', v, 0)
+        self.hz.wr(0x3000, bytes([1, 0])); call(self.hz, 'sink', 0x500, 0x600, 0x700, 0x3000, 2)   # the sink reads bus 1 as its left channel and bus 0 as its right
+        self.a.tick(); s = self.samples()
+        self.assertAlmostEqual(s[0], -20000, delta=2); self.assertAlmostEqual(s[1], 10000, delta=2)
+
+    def test_a_5_1_sink_is_downmixed_to_stereo(self):
+        v = self.voice(b''.join(struct.pack('<h', 10000) for _ in range(240)))
+        call(self.hz, 'mixvol', v, 0, 0, 2, f=1.0); call(self.hz, 'play', v, 0)   # source 0 to the centre bus (2)
+        self.hz.wr(0x3000, bytes(range(6))); call(self.hz, 'sink', 0x500, 0x600, 0x700, 0x3000, 6)
+        self.a.tick(); s = self.samples()
+        self.assertAlmostEqual(s[0], 7071, delta=3); self.assertAlmostEqual(s[1], 7071, delta=3)   # the centre at 0.7071 into both sides
+
+    def test_a_format_that_is_not_decoded_stays_silent_is_counted_and_the_game_still_gets_its_buffers_back(self):
+        v = self.voice(b'\0' * 64, fmt=3, start=0, end=240); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'play', v, 0)
+        self.a.tick()
+        self.assertEqual(call(self.hz, 'released', v), 0x2000); self.assertEqual(self.a.unsupported, {3: 1})
+        self.assertTrue(any('not decoded' in m for m in self.hz.logs))
+
+    def adpcm_voice(self, data, coef, addr=0x1000, wb=0x2000):
+        self.hz.wr(0x40000, data); self.hz.wr(0x41000, struct.pack('<16h', *coef))
+        call(self.hz, 'acquire', 0x500, addr, 48000, 1, 6, 0, 0x41000, 32)
+        self.hz.wr(wb, struct.pack('<QQiiB', 0x40000, len(data), 0, 0, 0))
+        call(self.hz, 'append', addr, wb)
+        return addr
+
+    def test_adpcm_is_decoded_with_the_coefficients_the_game_gave(self):
+        # predictor 0 with both coefficients 0: a sample is its 4-bit difference shifted by the scale. Two frames (28 samples), scale 4: differences 1, -1, 7, -8, 0 ...
+        frame = bytes([0x04]) + bytes([0x1F, 0x78, 0x00, 0x11, 0x1F, 0x78, 0x00])   # nibbles: 1 F 7 8 0 0 1 1 1 F 7 8 0 0
+        v = self.adpcm_voice(frame + frame, (0,) * 16)
+        call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'play', v, 0)
+        self.a.tick(); left = self.samples()[0::2][:28]
+        want = [d * 16 for d in (1, -1, 7, -8, 0, 0, 1, 1, 1, -1, 7, -8, 0, 0)] * 2
+        self.assertEqual(left, [max(-32768, min(32767, w)) for w in want])   # the mixer's float path is exact for these
+
+    def test_adpcm_history_goes_on_across_buffers(self):
+        coef = (2048, 0) + (0,) * 14   # predictor 0: the previous sample, as a gain of 1.0 (a running sum of the differences)
+        frame = bytes([0x00]) + bytes([0x11] * 7)   # scale 0, every difference +1: 14 samples 1..14
+        v = self.adpcm_voice(frame, coef); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0)
+        self.hz.wr(0x3000, struct.pack('<QQiiB', 0x40000, len(frame), 0, 0, 0)); call(self.hz, 'append', v, 0x3000)   # the same data again: the sum goes on from 14
+        call(self.hz, 'play', v, 0); self.a.tick(); left = self.samples()[0::2][:28]
+        self.assertEqual(left, list(range(1, 29)))
+
+    def test_the_audio_out_buffers_are_mixed_and_handed_back_as_they_are_played(self):
+        call(self.hz, 'openout', 0x800, 0x900); self.hz.wr(0x40000, b''.join(struct.pack('<hh', 5000, -5000) for _ in range(480)))
+        self.hz.wr(0xA00, struct.pack('<QQQ', 0x40000, 1920, 1920))
+        call(self.hz, 'startout', 0x800); call(self.hz, 'appendout', 0x800, 0xA00)
+        self.a.tick(); self.assertEqual(call(self.hz, 'releasedout', 0x800), 0)   # 240 of 480 frames
+        self.a.tick(); self.assertEqual(call(self.hz, 'releasedout', 0x800), 0xA00)
+        s = self.samples(); self.assertAlmostEqual(s[0], 5000, delta=2); self.assertAlmostEqual(s[1], -5000, delta=2)
+
+    def test_the_output_says_what_it_produced(self):
+        v = self.voice(sine(240)); call(self.hz, 'mixvol', v, 0, 0, 0, f=1.0); call(self.hz, 'play', v, 0)
+        self.a.tick(); st = self.a.mixer.stats()
+        self.assertEqual(st['frames'], 240); self.assertGreater(st['loud_frames'], 200); self.assertAlmostEqual(st['peak'], 0.5, delta=0.02)
+
+
+if __name__ == '__main__': unittest.main()
diff --git a/dm/tools/tests/test_horizon_fs.py b/dm/tools/tests/test_horizon_fs.py
new file mode 100644
index 0000000..d72f989
--- /dev/null
+++ b/dm/tools/tests/test_horizon_fs.py
@@ -0,0 +1,133 @@
+"""horizon_fs.py: save data has a journal (changes live in a working copy until nn::fs::CommitSaveData, a restart without a commit finds the saved state), and the file operations a game uses on its saves. A fake guest memory
+and a temporary save folder; nothing of any game."""
+import os, shutil, struct, sys, tempfile, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_fs as hf
+from horizon_overrides import TABLE
+
+P = '_ZN2nn2fs'
+SYM = dict(mount=P + '13MountSaveDataEPKcRKNS_7account3UidE', mount_ro=P + '21MountSaveDataReadOnlyEPKcNS_13ApplicationIdERKNS_7account3UidE', commit=P + '14CommitSaveDataEPKc', unmount=P + '7UnmountEPKc',
+           create=P + '10CreateFileEPKcl', create3=P + '10CreateFileEPKcli', open=P + '8OpenFileEPNS0_10FileHandleEPKci', write=P + '9WriteFileENS0_10FileHandleElPKvmRKNS0_11WriteOptionE',
+           read=P + '8ReadFileEPmNS0_10FileHandleElPvm', close=P + '9CloseFileENS0_10FileHandleE', delete=P + '10DeleteFileEPKc', mkdir=P + '15CreateDirectoryEPKc', rmdir=P + '15DeleteDirectoryEPKc',
+           rmrf=P + '26DeleteDirectoryRecursivelyEPKc', rename=P + '10RenameFileEPKcS2_', renamed=P + '15RenameDirectoryEPKcS2_', setsize=P + '11SetFileSizeENS0_10FileHandleEl',
+           free=P + '16GetFreeSpaceSizeEPlPKc', total=P + '17GetTotalSpaceSizeEPlPKc', getsize=P + '11GetFileSizeEPlNS0_10FileHandleE', commit_all=P + '6CommitEPKPKci', entry=P + '12GetEntryTypeEPNS0_18DirectoryEntryTypeEPKc')
+
+
+class FakeHz:
+    def __init__(self, save_root):
+        self.mem, self.logs = bytearray(0x10000), []
+        self.fs = hf.FileSystem(self, None, 't'); self.fs.save_root = Path(save_root)
+    def rd(self, a, n): return bytes(self.mem[a:a + n])
+    def wr(self, a, d): self.mem[a:a + len(d)] = d
+    def rd64(self, a): return struct.unpack('<Q', self.rd(a, 8))[0]
+    def wr64(self, a, v): self.wr(a, struct.pack('<Q', v))
+    def wr32(self, a, v): self.wr(a, struct.pack('<I', v))
+    def cstring(self, a, limit=256): return self.rd(a, limit).split(b'\0')[0].decode()
+    def log(self, m): self.logs.append(m)
+
+
+class Saves(unittest.TestCase):
+    def setUp(self): self.tmp = tempfile.TemporaryDirectory(); self.root = Path(self.tmp.name) / 'saves'
+    def tearDown(self): self.tmp.cleanup()
+
+    def boot(self):
+        """A new run on the same save folder, with save: mounted"""
+        hz = FakeHz(self.root); self.call(hz, 'mount', self.text(hz, 0x100, 'save'), 0x200)
+        return hz
+
+    def text(self, hz, at, s): hz.wr(at, s.encode() + b'\0'); return at
+
+    def call(self, hz, name, *args):
+        r = [0] * 39; r[:len(args)] = args
+        TABLE[SYM[name]][0](hz, r)
+        return r[0]
+
+    def put(self, hz, path, data, size=None):
+        self.assertEqual(self.call(hz, 'create', self.text(hz, 0x300, path), len(data) if size is None else size), 0)
