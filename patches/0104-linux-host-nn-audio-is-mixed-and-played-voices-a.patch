@@ -0,0 +1,68 @@
+"""The audio mixer library (linux/host/audio.c, libnx2linux_audio.so) for horizon_audio.py: resampling one channel of a wave buffer into a bus, and the output (an SDL3 stream, a WAV file, or nothing).
+NX2LINUX_AUDIO selects the output: unset or `auto` the default device, `off` no mixer at all (the game's audio runs silent, as before), `null` a mixer that only counts, `wav:<file>` a 16-bit stereo WAV file.
+NX2LINUX_AUDIO_LIB names the library (default ~/.cache/nx2linux/build-host/libnx2linux_audio.so)."""
+import ctypes as C, os
+from pathlib import Path
+
+FMT_PCM8, FMT_PCM16, FMT_FLOAT = 1, 2, 5   # nn::audio::SampleFormat values the mixer reads
+
+
+def library_path():
+    p = os.environ.get('NX2LINUX_AUDIO_LIB') or str(Path.home() / '.cache/nx2linux/build-host/libnx2linux_audio.so')
+    return p if os.path.exists(p) else None
+
+
+class MixError(Exception):
+    pass
+
+
+_lib = None
+
+
+def library():
+    """The library, loaded once (the ADPCM decoder needs it whether or not an output is open); None when it is not built"""
+    global _lib
+    if _lib is None:
+        path = library_path()
+        if not path: return None
+        _lib = C.CDLL(path)
+        _lib.nx2audio_adpcm.argtypes = [C.c_char_p, C.c_uint32, C.c_void_p, C.c_void_p, C.POINTER(C.c_int32), C.POINTER(C.c_int32)]; _lib.nx2audio_adpcm.restype = C.c_uint32
+    return _lib
+
+
+def adpcm_decode(data, coef, h1=0, h2=0):
+    """(PCM 16-bit samples as a ctypes array, the samples' number, h1, h2) of DSP-ADPCM data (coef: the 16 predictor coefficients); None when the library is missing"""
+    L = library()
+    if L is None: return None
+    n = len(data) // 8 * 14
+    out = (C.c_int16 * max(1, n))(); c = (C.c_int16 * 16)(*coef); a, b = C.c_int32(h1), C.c_int32(h2)
+    got = L.nx2audio_adpcm(data, len(data), c, out, C.byref(a), C.byref(b))
+    return out, got, a.value, b.value
+
+
+class Mixer:
+    def __init__(self, rate, mode=''):
+        path = library_path()
+        if not path: raise MixError('libnx2linux_audio.so is not built (cmake --build ~/.cache/nx2linux/build-host)')
+        L = self.lib = library()
+        L.nx2audio_open.argtypes = [C.c_uint32, C.c_char_p]; L.nx2audio_open.restype = C.c_int
+        L.nx2audio_error.restype = C.c_char_p; L.nx2audio_device.restype = C.c_char_p
+        L.nx2audio_submit.argtypes = [C.c_void_p, C.c_uint32]; L.nx2audio_submit.restype = C.c_uint32
+        L.nx2audio_stats.argtypes = [C.POINTER(C.c_uint64)]
+        L.nx2audio_mix.argtypes = [C.c_void_p, C.c_uint32, C.c_void_p, C.c_uint32, C.c_uint32, C.c_uint32, C.c_uint32, C.POINTER(C.c_double), C.c_double, C.c_float]; L.nx2audio_mix.restype = C.c_uint32
+        if L.nx2audio_open(rate, mode.encode()): raise MixError(L.nx2audio_error().decode())
+        self.device = L.nx2audio_device().decode()
+
+    def mix(self, dst, n_out, data, fmt, frames, channels, ch, pos, step, gain):
+        """Adds channel ch of the wave data (frames frames of `channels`) into dst (a float array), from fractional frame pos, step frames per output sample; (output samples made, the new pos)"""
+        p = C.c_double(pos)
+        n = self.lib.nx2audio_mix(dst, n_out, data, fmt, frames, channels, ch, C.byref(p), step, gain)
+        return n, p.value
+
+    def submit(self, lr, frames): return self.lib.nx2audio_submit(lr, frames)
+
+    def stats(self):
+        a = (C.c_uint64 * 4)(); self.lib.nx2audio_stats(a)
+        return dict(frames=a[0], loud_frames=a[1], dropped=a[2], peak=a[3] / 1000.0)
+
+    def close(self): self.lib.nx2audio_close()
