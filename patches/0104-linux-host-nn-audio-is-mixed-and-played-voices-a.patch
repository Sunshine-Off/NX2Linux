+    def master(self, buses, left, right, n):
+        """The device sink's inputs make the output channels: one is mono, two are stereo, six are 5.1 (front left, front right, centre, low frequency, rear left, rear right: downmixed to stereo)"""
+        ins = self.sink
+        def bus(i): return buses.get(ins[i]) if i < len(ins) else None
+        def add(dst, src, g):
+            if src is not None:
+                for k in range(n): dst[k] += src[k] * g
+        if len(ins) == 1: add(left, bus(0), 1.0); add(right, bus(0), 1.0)
+        elif len(ins) >= 6:
+            add(left, bus(0), 1.0); add(right, bus(1), 1.0); add(left, bus(2), 0.7071); add(right, bus(2), 0.7071); add(left, bus(4), 0.7071); add(right, bus(5), 0.7071)
+        else: add(left, bus(0), 1.0); add(right, bus(1), 1.0)
+
+    def mix_outs(self, left, right, n):
+        """The audio-out buffers (PCM 16-bit stereo) the game queued: played into the same output, released when played"""
+        for o in self.outs.values():
+            if not o.started: continue
+            need = n
+            while need and o.queue:
+                addr, data = o.queue[0]
+                frames = min(need, (len(data) - o.off) // 4)
+                for k in range(frames):
+                    l, r = struct.unpack_from('<hh', data, o.off + 4 * k)
+                    left[n - need + k] += l / 32768.0; right[n - need + k] += r / 32768.0
+                o.off += frames * 4; need -= frames
+                if o.off >= len(data): o.queue.pop(0); o.released.append(addr); o.off = 0
+                elif frames == 0: break
+
 
