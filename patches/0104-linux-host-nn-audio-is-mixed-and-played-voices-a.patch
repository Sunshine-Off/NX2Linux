+    def walk(self, v, n, entries, buses):
+        """The voice's next n output samples: its wave buffers resampled into the buses of its mix volumes (entries: (source channel, bus, gain)). A finished buffer is released; a looping one starts again"""
+        remaining, out_at = n, 0
+        step = v.rate / self.rate * v.pitch
+        while remaining and v.waves:
+            w = v.waves[0]; made, pos = 0, w.pos
+            if self.mixer:
+                for ch, bus, gain in entries or ((0, None, 0.0),):
+                    b = buses.setdefault(bus, (ctypes.c_float * n)()) if bus is not None else self.scratch(n)
+                    dst = ctypes.byref(b, 4 * out_at)
+                    made, pos = self.mixer.mix(dst, remaining, w.data, w.fmt, min(w.end, w.frames), v.channels, min(ch, v.channels - 1), w.pos, step, gain)
+            else: made, pos = remaining, w.pos + remaining * step if not w.loop or w.pos + remaining * step < w.end else w.pos + remaining * step
+            w.pos = pos; v.played += int(made * step); remaining -= made; out_at += made
+            if w.pos >= min(w.end, w.frames) or not made and remaining:   # the buffer is played
+                if w.loop and w.end > w.start and made: w.pos = float(w.start)
+                else: v.waves.pop(0); v.released.append(w.addr)
+
+    def scratch(self, n):
