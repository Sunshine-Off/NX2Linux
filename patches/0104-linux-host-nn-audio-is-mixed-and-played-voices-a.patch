+                entries = [(src, dst, vol * v.volume) for (src, dst), vol in v.mixvol.items() if vol * v.volume != 0.0]
+                self.walk(v, n, entries, buses)
+            left, right = ((ctypes.c_float * n)() for _ in range(2))
+            self.master(buses, left, right, n)
