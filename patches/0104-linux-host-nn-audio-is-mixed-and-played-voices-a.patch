--- /dev/null
+++ b/dm/tools/horizon_movie.py
@@ -0,0 +1,38 @@
+"""The SDK's movie library on the Linux host (NX2Linux S7bis, milestone E). A game plays a movie by opening it with a movie::Extractor (SetDataSource: the SDK's own demuxer), then feeding the packets to a movie::Decoder, which on the
+Switch is NVIDIA's hardware decoder. The host has no decoder behind that interface yet (the Mach host's hle_movie.c decodes VP8 / VP9 with libvpx and Vorbis with stb_vorbis; it has not been ported), and a Decoder that answers 0
+to everything would let the player wait for pictures that never come. So the opening of a movie fails here, explicitly and with the code the SDK itself returns when it has no implementation object (0x1000): the game's own
+player reports that it could not open the movie, and goes on without it. Every refusal is counted and named, and the end of the run says how many movies the game asked for."""
+from horizon_overrides import hle
+
+NO_IMPLEMENTATION = 0x1000   # what the SDK returns for a data source it has no implementation object for (engine/dm/host/hle_movie.c)
+
+
+def refused(hz): return hz.__dict__.setdefault('movies_refused', [])
+
+
+def refuse(hz, what):
+    """Records the refusal and says so (the first four in full, every later one only counted)"""
+    n = refused(hz); n.append(what)
+    if len(n) <= 4: hz.log(f'[movie] opening refused: {what}: the host has no movie decoder yet (the game goes on without the movie)')
+    return NO_IMPLEMENTATION
+
+
+def report(hz):
+    n = refused(hz)
+    if not n: return 'movie: the game opened no movie'
+    return f'movie: {len(n)} openings refused, no decoder on the Linux host (first: {n[0]})'
+
+
+def _install():
+    for sym, who in (('_ZN5movie9Extractor13SetDataSourceEPKc', 'movie::Extractor::SetDataSource(path)'),
+                     ('_ZN5movie11NnExtractor13SetDataSourceEPKc', 'movie::NnExtractor::SetDataSource(path)')):
+        hle(sym, 'the host has no movie decoder: opening fails with the SDK\'s own "no implementation" code')(lambda hz, r, who=who: r.__setitem__(0, refuse(hz, f'{who} {hz.cstring(r[1], 0x200)!r}')))
+    for sym, who in (('_ZN5movie9Extractor13SetDataSourceEPKvi', 'movie::Extractor::SetDataSource(memory)'),
+                     ('_ZN5movie11NnExtractor13SetDataSourceEPKvi', 'movie::NnExtractor::SetDataSource(memory)')):
+        hle(sym, 'the host has no movie decoder: opening fails with the SDK\'s own "no implementation" code')(lambda hz, r, who=who: r.__setitem__(0, refuse(hz, f'{who} {r[2] & 0xFFFFFFFF} bytes')))
+    for sym, who in (('_ZN5movie9Extractor13SetDataSourceEPNS_18ClientStreamReaderEPKc', 'movie::Extractor::SetDataSource(stream reader)'),
+                     ('_ZN5movie11NnExtractor13SetDataSourceEPNS_18ClientStreamReaderEPKc', 'movie::NnExtractor::SetDataSource(stream reader)')):
+        hle(sym, 'the host has no movie decoder: opening fails with the SDK\'s own "no implementation" code')(lambda hz, r, who=who: r.__setitem__(0, refuse(hz, f'{who} {hz.cstring(r[2], 0x200)!r}' if r[2] else who)))
+
+
+_install()
