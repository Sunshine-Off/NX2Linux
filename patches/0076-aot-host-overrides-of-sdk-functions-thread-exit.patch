         out = {f'x{i}': g.x[i] for i in range(31)}; out['sp'] = g.sp; out['nzcv'] = g.nzcv; out['tpidr_el0'] = g.tpidr_el0
         for i in range(32): out[f'v{i}'] = g.v[2 * i] | g.v[2 * i + 1] << 64
