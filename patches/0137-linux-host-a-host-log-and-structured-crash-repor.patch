--- /dev/null
+++ b/dm/tools/horizon_crash.py
@@ -0,0 +1,319 @@
+"""Host logs and crash reports of the Linux host (NX2Linux Phase 3, issue #23).
+
+A run of horizon_run.py writes under $XDG_STATE_HOME/nx2linux/logs (else ~/.local/state/nx2linux/logs), the folder the Qt front end already uses:
+  host-<title>-<UTC time>-<pid>.log    a copy of everything the run prints, with the home folder shortened to ~. It is the raw local log: it can hold strings the game itself prints
+  crash-<title>-<UTC time>-<pid>.json  one report per crash (at most MAX_REPORTS a run), meant to be attached to an issue: it holds no path of yours, no user name, no key, no game file name
+                                        and no memory of the game. Guest addresses are written as module+offset, never as the name of a function of the game (NX2LINUX_CRASH_SYMBOLS=1 adds them)
+  crash-<title>-<UTC time>-<pid>.raw   what faulthandler wrote when the process died of a signal (SEGV, BUS, ILL, ABRT, FPE). A dying process cannot clean its own text, so the next run turns this
+                                        file into a crash-*.json report (convert_raw_dumps) and removes it
+The kinds of report: guest-fault (a guest thread stopped on a fault), boot-fault (the boot sequence faulted), guest-break (the game called svcBreak), python-exception (the host raised, in any thread)
+and fatal-signal. NX2LINUX_HOST_LOG=0 turns the log and the reports off, NX2LINUX_LOG_KEEP=<n> is how many host logs are kept (20), NX2LINUX_CRASH_REGS=1 adds x0..x30 to a report.
+Known gap: the AOT runtime installs its own SIGSEGV handler when a guest thread first runs, and for a fault that is not a guest access it restores the default action. A SEGV in a host library
+after that point ends the process with no raw dump. The other fatal signals are caught."""
+import faulthandler
+import getpass
+import json
+import os
+import platform
+import re
+import struct
+import sys
+import threading
+import time
+import traceback
+from datetime import datetime, timezone
+from pathlib import Path
+
+SCHEMA = 1
+MAX_REPORTS = 5          # a run writes at most this many reports: one crash tends to bring several
+KEEP_LOGS = 20           # host logs kept (NX2LINUX_LOG_KEEP)
+KEEP_REPORTS = 50
+RECENT_SVCS = 16         # the last kernel calls kept per guest thread
+MAX_THREADS = 64
+MAX_TEXT = 4000
+NAME = r'[0-9A-Za-z]{1,32}'
+LOG_RE = re.compile(rf'^host-{NAME}-\d{{8}}T\d{{6}}Z-\d+\.log$')
+REPORT_RE = re.compile(rf'^crash-{NAME}-\d{{8}}T\d{{6}}Z-\d+\.json$')
+RAW_RE = re.compile(rf'^crash-({NAME})-(\d{{8}}T\d{{6}}Z)-(\d+)\.raw$')
+SIGNALS = {'Segmentation fault': 'SIGSEGV', 'Bus error': 'SIGBUS', 'Illegal instruction': 'SIGILL', 'Aborted': 'SIGABRT', 'Floating point exception': 'SIGFPE'}
+
+
+def state_dir(environ=None):
+    """$XDG_STATE_HOME/nx2linux when that is an absolute path, else ~/.local/state/nx2linux: the rule of the Qt front end and of linux/cli/nx2linux.py"""
+    env = (os.environ if environ is None else environ).get('XDG_STATE_HOME')
+    if env and Path(env).is_absolute(): return Path(env) / 'nx2linux'
+    return Path.home() / '.local' / 'state' / 'nx2linux'
+
+
+def logs_dir(environ=None): return state_dir(environ) / 'logs'
+
+
+def enabled(environ=None): return (os.environ if environ is None else environ).get('NX2LINUX_HOST_LOG', '1') != '0'
+
+
+def _stamp(t=None): return datetime.fromtimestamp(time.time() if t is None else t, timezone.utc).strftime('%Y%m%dT%H%M%SZ')
+def _title(t): return re.sub(r'[^0-9A-Za-z]', '', str(t))[:32] or 'unknown'
+
+
+class Redactor:
+    """Takes what is personal out of a text: the home folder (to ~), the folders of the run (to <modules>, <romfs>, <cache>), the user name, any other /home/<name>, key files and game packages.
+    paths: [(path, token)], the longest path is replaced first so that <modules> wins over ~/..."""
+    OTHER_HOME = re.compile(r"/home/[^/\s'\"]+")
+    KEYS = re.compile(r"\S*\.keys\S*")
+    PACKAGE = re.compile(r"\S+\.(?:nsp|xci|nsz|xcz)\b", re.I)
+
+    def __init__(self, paths=(), environ=None):
+        env = os.environ if environ is None else environ
+        pairs = {(str(p).rstrip('/'), t) for p, t in paths if p}
+        home = {env.get('HOME'), str(Path.home())}
+        home |= {os.path.realpath(h) for h in list(home) if h}
+        pairs |= {(h.rstrip('/'), '~') for h in home if h}
+        pairs = [(p, t) for p, t in pairs if p and p != '/']
+        self.paths = [(re.compile(re.escape(p) + r'(?![\w.-])'), t) for p, t in sorted(pairs, key=lambda x: (-len(x[0]), x[0]))]
+        try: user = getpass.getuser()
+        except Exception: user = ''
+        user = env.get('USER') or env.get('LOGNAME') or user
+        self.user = re.compile(r'(?<![\w.-])' + re.escape(user) + r'(?![\w.-])') if user and len(user) >= 3 and user != 'root' else None
+
+    def __call__(self, text):
+        s = str(text)
+        for rx, token in self.paths: s = rx.sub(token, s)
+        s = self.OTHER_HOME.sub('~', s)
+        s = self.KEYS.sub('<keys>', s)
+        s = self.PACKAGE.sub('<package>', s)
+        if self.user: s = self.user.sub('<user>', s)
+        return s
+
+
+class Tee:
+    """A text stream that goes on writing to the console and also copies to the log (redacted). A failing log never reaches the run"""
+    def __init__(self, console, log, redact):
+        self.console, self.log, self.redact, self.lock = console, log, redact, threading.Lock()
+    def write(self, s):
+        n = self.console.write(s)
+        with self.lock:
+            if self.log:
+                try: self.log.write(self.redact(s))
+                except Exception: self.log = None
+        return n
+    def flush(self):
+        self.console.flush()
+        with self.lock:
+            if self.log:
+                try: self.log.flush()
+                except Exception: self.log = None
+    def __getattr__(self, name): return getattr(self.console, name)   # fileno, isatty, encoding...
+
+
+def _private_dir(path):
+    path.mkdir(parents=True, exist_ok=True)
+    try: os.chmod(path, 0o700)
+    except OSError: pass
+    return path
+
+
+def _rotate(folder, rx, keep):
+    """Keep the `keep` newest files of folder whose name matches rx. Nothing else in the folder is looked at"""
+    try:
+        files = sorted((p for p in folder.iterdir() if rx.match(p.name)), key=lambda p: p.stat().st_mtime, reverse=True)
+        for p in files[keep:]:
+            try: p.unlink()
+            except OSError: pass
+    except OSError: pass
+
+
+class Crash:
+    def __init__(self, title='0000000000000000', paths=(), environ=None, console=None):
+        self.environ = os.environ if environ is None else environ
+        self.title, self.pid, self.started = _title(title), os.getpid(), time.monotonic()
+        self.stamp = _stamp()
+        self.dir = logs_dir(self.environ)
+        self.redact = Redactor(paths, self.environ)
+        self.hz, self.count, self.lock = None, 0, threading.Lock()
+        self.log_path = self.raw_path = None
+        self._log = self._raw = None
+        self._streams = None
+        self.engine_dir = str(Path(__file__).resolve().parents[2])
+        self.redact.paths.insert(0, (re.compile(re.escape(self.engine_dir) + r'(?![\w.-])'), '<engine>'))
+        self.console = console or sys.__stderr__
+
+    # ---- setup ----
+    def attach(self, hz):
+        self.hz = hz; hz.crash = self
+        return self
+
+    def start_log(self):
+        """Copy stdout and stderr to host-<title>-<time>-<pid>.log (and keep the newest NX2LINUX_LOG_KEEP of those)"""
+        _private_dir(self.dir)
+        self.log_path = self.dir / f'host-{self.title}-{self.stamp}-{self.pid}.log'
+        fd = os.open(self.log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+        self._log = os.fdopen(fd, 'w', encoding='utf-8', errors='replace')
+        self._streams = (sys.stdout, sys.stderr)
+        sys.stdout, sys.stderr = Tee(sys.stdout, self._log, self.redact), Tee(sys.stderr, self._log, self.redact)
+        try: keep = int(self.environ.get('NX2LINUX_LOG_KEEP', KEEP_LOGS))
+        except ValueError: keep = KEEP_LOGS
+        _rotate(self.dir, LOG_RE, max(1, keep))
+        _rotate(self.dir, REPORT_RE, KEEP_REPORTS)
+        return self.log_path
+
+    def enable_faulthandler(self):
+        """A fatal signal writes the Python stacks of every thread into crash-*.raw. Opened now because a dying process cannot open files safely"""
+        if self.environ.get('NX2LINUX_CRASH_FAULTHANDLER', '1') == '0': return None
+        _private_dir(self.dir)
+        self.raw_path = self.dir / f'crash-{self.title}-{self.stamp}-{self.pid}.raw'
+        fd = os.open(self.raw_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        self._raw = os.fdopen(fd, 'w')
+        faulthandler.enable(file=self._raw, all_threads=True)
+        return self.raw_path
+
+    def install_hooks(self):
+        """An exception nobody caught, in the main thread or in any other, becomes a report"""
+        prev, prev_thread = sys.excepthook, threading.excepthook
+        def hook(t, v, tb):
+            self.report('python-exception', exc_info=(t, v, tb)); prev(t, v, tb)
+        def thread_hook(args):
+            self.report('python-exception', exc_info=(args.exc_type, args.exc_value, args.exc_traceback), thread_name=getattr(args.thread, 'name', None)); prev_thread(args)
+        sys.excepthook, threading.excepthook = hook, thread_hook
+
+    def finish(self):
+        """The run ends on purpose: no raw dump is left, the console streams are back"""
+        try:
+            if self._raw:
+                faulthandler.disable()
+                size = os.fstat(self._raw.fileno()).st_size
+                self._raw.close(); self._raw = None
+                if not size and self.raw_path:
+                    try: self.raw_path.unlink()
+                    except OSError: pass
+            if self._streams:
+                for s in (sys.stdout, sys.stderr):
+                    if isinstance(s, Tee):
+                        with s.lock:
+                            if s.log: s.log.flush()
+                sys.stdout, sys.stderr = self._streams; self._streams = None
+            if self._log:
+                self._log.close(); self._log = None
+        except Exception: pass
+
+    # ---- the report ----
+    def loc(self, a):
+        """A guest address as module+offset (hex if no module holds it)"""
+        a = int(a)
+        for mod in getattr(getattr(self.hz, 'ms', None), 'modules', ()) or ():
+            if mod.base <= a < mod.base + mod.size: return f'{mod.name}+{a - mod.base:#x}'
+        return f'{a:#x}'
+
+    def symbol(self, a):
+        """The name of the nearest exported function: game data, asked for with NX2LINUX_CRASH_SYMBOLS=1 only"""
+        try: return self.hz.where([0] * 29 + [0, int(a)], 0)
+        except Exception: return None
+
+    def chain(self, regs, depth=24):
+        """x30 and the return addresses along the x29 frame chain, as module+offset"""
+        out, fp = [], regs[29] if len(regs) > 29 else 0
+        if len(regs) > 30 and regs[30]: out.append(regs[30])
+        for _ in range(depth):
+            try: fp, lr = struct.unpack('<QQ', self.hz.rd(fp, 16))
+            except Exception: break
+            if not lr: break
+            out.append(lr)
+        return [self.loc(a) for a in out]
+
+    def threads(self, limit=MAX_THREADS):
+        hz, now, out = self.hz, time.monotonic(), []
+        seen = [hz.main_thread_obj] + [o for o in list(hz.handles.values()) if hasattr(o, 'recent') and o is not hz.main_thread_obj]
+        for t in seen[:limit]:
+            calls = list(t.recent)
+            if not calls and t is not hz.main_thread_obj: continue
+            out.append({'tid': t.tid, 'done': bool(getattr(t, 'done', False)),
+                        'last_svcs': [{'name': n, 'at': self.loc(o), 'seconds_ago': round(now - at, 3)} for n, o, at in calls]})
+        return out
+
+    def environment(self):
+        keep = {k: self.redact(v)[:200] for k, v in sorted(self.environ.items()) if k.startswith(('NX2LINUX_', 'AOT_'))}
+        keep.pop('NX2LINUX_NICK', None)   # a name the player chose
+        return keep
+
+    def host(self):
+        info = {'python': platform.python_version(), 'system': platform.system(), 'kernel': platform.release(), 'machine': platform.machine(), 'cpus': os.cpu_count()}
+        try:
+            names = (Path(self.engine_dir) / 'dm' / 'fork_patches.txt').read_text().split()
+            info['engine_patches'] = len(names)
+        except OSError: pass
+        return info
+
+    def build(self, kind, thread=None, fault=None, regs=None, exc_info=None, detail=None, thread_name=None):
+        hz = self.hz
+        rep = {'schema': SCHEMA, 'kind': kind, 'time_utc': _stamp(), 'pid': self.pid, 'title': self.title, 'seconds_since_start': round(time.monotonic() - self.started, 3), 'host': self.host()}
+        if thread is not None: rep['thread'] = {'tid': getattr(thread, 'tid', None)}
+        elif thread_name: rep['thread'] = {'name': self.redact(thread_name)}
+        if fault is not None: rep['fault'] = self.redact(str(fault))[:MAX_TEXT]
+        if detail: rep['detail'] = {k: (self.redact(v) if isinstance(v, str) else v) for k, v in detail.items()}
+        if exc_info is not None and exc_info[0] is not None:
+            rep['exception'] = {'type': exc_info[0].__name__, 'traceback': self.redact(''.join(traceback.format_exception(*exc_info)))[-MAX_TEXT:]}
+        if hz is not None:
+            if regs is not None:
+                guest = {'pc_or_lr': self.loc(regs[30]) if len(regs) > 30 else None, 'call_chain': self.chain(regs)}
+                if self.environ.get('NX2LINUX_CRASH_SYMBOLS') == '1' and len(regs) > 30: guest['symbol'] = self.symbol(regs[30])
+                if self.environ.get('NX2LINUX_CRASH_REGS') == '1': guest['registers'] = {f'x{i}': f'{regs[i]:#x}' for i in range(min(31, len(regs)))}
+                rep['guest'] = guest
+            rep['run'] = {'frames_presented': getattr(hz, 'frames_presented', 0), 'svc_calls': dict(hz.stats), 'unhandled_svcs': dict(hz.unhandled), 'thread_faults': [[tid, self.redact(f)] for tid, f in hz.thread_faults],
+                          'stop_reason': hz.stop_reason}
+            try: rep['run']['gpu'] = self.redact(hz.nvn.gpu.gpu.name)
+            except Exception: pass
+            rep['threads'] = self.threads()
+        rep['environment'] = self.environment()
+        return rep
+
+    def report(self, kind, **kw):
+        """Write one crash report. Returns its path, or None when the run is over its limit or the folder cannot be written. Never raises: a crash report must not crash"""
+        try:
+            if not enabled(self.environ): return None
+            with self.lock:
+                if self.count >= MAX_REPORTS: return None
+                self.count += 1; n = self.count
+            rep = self.build(kind, **kw)
+            _private_dir(self.dir)
+            path = self.dir / f'crash-{self.title}-{self.stamp}-{self.pid}.json' if n == 1 else self.dir / f'crash-{self.title}-{self.stamp}-{self.pid}-{n}.json'
+            return _write_json(path, rep, say=lambda s: print(s, file=sys.stderr, flush=True))
+        except Exception as e:
+            try: print(f'[crash] could not write the report: {type(e).__name__}', file=self.console, flush=True)
+            except Exception: pass
+            return None
+
+
+def _write_json(path, rep, say=None):
+    tmp = path.with_name(path.name + '.tmp')
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, 'w', encoding='utf-8') as f: json.dump(rep, f, indent=2, sort_keys=True); f.write('\n')
+    os.replace(tmp, path)
+    if say: say(f'[crash] {rep["kind"]} report: {path}')
+    return path
+
+
+def convert_raw_dumps(folder=None, environ=None, redact=None):
+    """Turn every crash-*.raw a dead run left into a crash-*.json report and remove the raw file. A raw file that is still empty belongs to a run that is going: it is left alone.
+    Returns the reports written"""
+    env = os.environ if environ is None else environ
+    folder = folder or logs_dir(env)
+    redact = redact or Redactor(environ=env)
+    out = []
+    try: names = sorted(os.listdir(folder))
+    except OSError: return out
+    for name in names:
+        m = RAW_RE.match(name)
+        if not m: continue
+        raw = Path(folder) / name
+        try:
+            if raw.stat().st_size == 0: continue
+            text = raw.read_text(errors='replace')
+        except OSError: continue
+        title, stamp, pid = m.groups()
+        first = text.strip().splitlines()[0] if text.strip() else ''
+        sig = next((v for k, v in SIGNALS.items() if k.lower() in first.lower()), None)
+        rep = {'schema': SCHEMA, 'kind': 'fatal-signal', 'time_utc': stamp, 'pid': int(pid), 'title': title, 'signal': sig, 'native': {'summary': redact(first)[:200], 'python_stacks': redact(text)[-MAX_TEXT * 2:]}}
+        try:
+            out.append(_write_json(Path(folder) / f'crash-{title}-{stamp}-{pid}.json', rep))
+            raw.unlink()
+        except OSError: pass
+    return out
