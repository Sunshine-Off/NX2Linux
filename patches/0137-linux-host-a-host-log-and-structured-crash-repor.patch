diff --git a/dm/tools/tests/test_horizon_crash.py b/dm/tools/tests/test_horizon_crash.py
new file mode 100644
index 00000000..decf06f8
--- /dev/null
+++ b/dm/tools/tests/test_horizon_crash.py
@@ -0,0 +1,279 @@
+"""Host logs and crash reports (horizon_crash.py, NX2Linux issue #23). No game, no Remill, no GPU: a Horizon on a fake guest memory, a fake home folder and a state folder in a temporary directory.
+The point of the reports is that someone can attach one to an issue: the tests look for the fake home folder, the fake user name, the folders of the run, a key file and a package name in every byte written."""
+import io, json, os, subprocess, sys, tempfile, threading, types, unittest, unittest.mock
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent)); sys.path.insert(0, str(HERE))
+import horizon_crash as hc
+import horizon_hle as hh
+from test_horizon_hle import FakeAot
+
+FAKE_USER = 'fakeperson'
+FAKE_HOME = f'/home/{FAKE_USER}'
+MODULES, ROMFS = f'{FAKE_HOME}/games/xc2/modules', f'{FAKE_HOME}/games/xc2/RomFS.img'
+SECRETS = (FAKE_HOME, FAKE_USER, 'games/xc2', 'prod.keys', 'secret-game.nsp', 'RomFS.img')
+
+
+class RunningAot(FakeAot):
+    """A guest that faults as soon as it runs, after making two kernel calls from inside the thread, as a recompiled thread would"""
+    def __init__(self, hz_ref, fault):
+        super().__init__(); self.hz_ref, self.fault = hz_ref, fault
+    def run(self, entry, regs=None, nzcv=0, sp=0, tpidr_el0=0, tpidrro_el0=0, **kw):
+        hz = self.hz_ref[0]
+        for n in range(20): hz.svc(0x1e, [0] * 31, 0x1000 + 4 * n)   # GetSystemTick, 20 times: only the last 16 are kept
+        hz.svc(0x0b, [0] * 31, 0x2000)                                # SleepThread(0)
+        return {'fault': self.fault, 'x29': 0, 'x30': 0x1234}
+
+
+def horizon(fault='guest access at 0xffec90 is outside every mapped region'):
+    ref = []
+    aot = RunningAot(ref, fault)
+    ms = types.SimpleNamespace(aot=aot, modules=[types.SimpleNamespace(name='main', base=0x800000, size=0x400000, exports={})], TLS=0x1000, STOP=0xFFFF0000)
+    hz = hh.Horizon(ms, out=io.StringIO()); ref.append(hz)
+    return hz
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
+        self.state = Path(self.tmp.name) / 'state'; self.out = self.state / 'nx2linux' / 'logs'   # XDG_STATE_HOME and the folder the reports go to
+        self.env = {'HOME': FAKE_HOME, 'USER': FAKE_USER, 'XDG_STATE_HOME': str(self.state), 'NX2LINUX_GPU': '1', 'NX2LINUX_DUMP_FRAME': f'{FAKE_HOME}/frames', 'NX2LINUX_NICK': 'Somebody'}
+        self.saved = (sys.stdout, sys.stderr, sys.excepthook, threading.excepthook)
+        self.addCleanup(self.restore)
+        # Path.home() reads HOME on POSIX: the redactor must see the fake one
+        self.old_home = os.environ.get('HOME'); os.environ['HOME'] = FAKE_HOME; self.addCleanup(self.reset_home)
+
+    def reset_home(self):
+        if self.old_home is None: os.environ.pop('HOME', None)
+        else: os.environ['HOME'] = self.old_home
+
+    def restore(self): sys.stdout, sys.stderr, sys.excepthook, threading.excepthook = self.saved
+
+    def crash(self, **kw):
+        return hc.Crash('0100E95004038000', paths=[(MODULES, '<modules>'), (ROMFS, '<romfs>')], environ=self.env, **kw)
+
+    def assertClean(self, text):
+        for s in SECRETS: self.assertNotIn(s, text)
+
+    def logs(self): return sorted(p.name for p in self.out.iterdir()) if self.out.is_dir() else []
+
+
+class Folders(Base):
+    def test_an_absolute_xdg_state_home_is_used(self):
+        self.assertEqual(hc.logs_dir({'XDG_STATE_HOME': '/var/lib/me'}), Path('/var/lib/me/nx2linux/logs'))
+
+    def test_a_relative_one_is_ignored_like_the_front_end_does(self):
+        self.assertEqual(hc.state_dir({'XDG_STATE_HOME': 'relative/dir'}), Path.home() / '.local/state/nx2linux')
+
+    def test_without_it_the_default_is_under_home(self):
+        self.assertEqual(hc.state_dir({}), Path(FAKE_HOME) / '.local/state/nx2linux')
+
+
+class Redaction(Base):
+    def test_every_personal_thing_goes(self):
+        r = hc.Redactor([(MODULES, '<modules>'), (ROMFS, '<romfs>')], self.env)
+        text = f'{MODULES}/main.manifest.json {ROMFS} {FAKE_HOME}/.cache/nx2linux/aot-cache user {FAKE_USER} /home/someoneelse/x /mnt/disk/secret-game.nsp --keys {FAKE_HOME}/.switch/prod.keys'
+        out = r(text)
+        self.assertClean(out); self.assertNotIn('someoneelse', out)
+        self.assertIn('<modules>/main.manifest.json', out); self.assertIn('<romfs>', out); self.assertIn('~/.cache/nx2linux/aot-cache', out)
+
+    def test_a_word_that_only_contains_the_user_name_stays(self):
+        r = hc.Redactor([], self.env)
+        self.assertEqual(r('fakepersonal and my-fakeperson-x'), 'fakepersonal and my-fakeperson-x')
+
+    def test_the_longest_folder_wins(self):
+        r = hc.Redactor([(MODULES, '<modules>')], self.env)
+        self.assertEqual(r(f'{MODULES}/sdk.elf'), '<modules>/sdk.elf')
+
+
+class Log(Base):
+    def test_the_log_copies_the_console_and_shortens_the_home(self):
+        c = self.crash(); out, err = io.StringIO(), io.StringIO(); sys.stdout, sys.stderr = out, err
+        path = c.start_log()
+        print(f'[profile] modules in {MODULES}', flush=True); print(f'warning from {ROMFS}', file=sys.stderr, flush=True)
+        c.finish()
+        self.assertIn(MODULES, out.getvalue()); self.assertIn(ROMFS, err.getvalue())   # the console is not changed
+        text = path.read_text()
+        self.assertIn('[profile]', text); self.assertClean(text)
+        self.assertEqual((sys.stdout, sys.stderr), (out, err))   # the streams are back
+        self.assertTrue(path.name.startswith('host-0100E95004038000-') and path.name.endswith(f'-{os.getpid()}.log'))
+        self.assertEqual(oct(path.stat().st_mode & 0o777), '0o600'); self.assertEqual(oct(path.parent.stat().st_mode & 0o777), '0o700')
+
+    def test_a_log_that_cannot_be_written_never_reaches_the_run(self):
+        c = self.crash(); sys.stdout, sys.stderr = io.StringIO(), io.StringIO()
+        c.start_log(); c._log.close()
+        print('still running', flush=True)   # the copy fails, the console does not
+        self.assertIn('still running', sys.stdout.console.getvalue())
+
+    def test_rotation_keeps_the_newest_logs_and_touches_nothing_else(self):
+        logs = self.out; logs.mkdir(parents=True)
+        for i in range(5):
+            p = logs / f'host-0100E95004038000-2026110{i + 1}T120000Z-{100 + i}.log'; p.write_text('old'); os.utime(p, (1000 + i, 1000 + i))
+        other = [logs / 'qt-run-abc.log', logs / 'notes.txt', logs / 'host-bad name.log']
+        for p in other: p.write_text('mine')
+        env = dict(self.env, NX2LINUX_LOG_KEEP='3'); c = hc.Crash('0100E95004038000', environ=env); sys.stdout, sys.stderr = io.StringIO(), io.StringIO()
+        c.start_log(); c.finish()
+        names = self.logs()
+        self.assertEqual(sum(n.startswith('host-0100') for n in names), 3)   # the new one and the two newest old ones
+        self.assertNotIn('host-0100E95004038000-20261101T120000Z-100.log', names)
+        for p in other: self.assertTrue(p.exists(), p.name)
+
+
+class Reports(Base):
+    def run_thread(self, hz, crash):
+        crash.attach(hz)
+        t = hh.KThread(hz, 0x800100, 0, 0x300000, 44, 0x5000); t.handle = hz.new_handle(t)
+        t.start(); t.py.join(10)
+        return t
+
+    def test_a_guest_thread_that_faults_leaves_a_readable_report(self):
+        hz = horizon(f'guest access at 0xffec90 in {MODULES}/main.elf for {FAKE_USER} secret-game.nsp prod.keys'); c = self.crash(); sys.stderr = io.StringIO()
+        t = self.run_thread(hz, c)
+        files = sorted((self.out).glob('crash-*.json'))
+        self.assertEqual(len(files), 1, self.logs())
+        text = files[0].read_text(); rep = json.loads(text)
+        self.assertClean(text)
+        self.assertEqual((rep['schema'], rep['kind'], rep['title']), (1, 'guest-fault', '0100E95004038000'))
+        self.assertEqual(rep['thread']['tid'], t.tid); self.assertIn('0xffec90', rep['fault'])
+        self.assertEqual(rep['guest']['pc_or_lr'], '0x1234'); self.assertNotIn('registers', rep['guest'])   # not inside a module, no registers by default
+        mine = next(x for x in rep['threads'] if x['tid'] == t.tid)
+        self.assertEqual(len(mine['last_svcs']), 16)                      # the last 16 of 21 calls
+        self.assertEqual(mine['last_svcs'][-1]['name'], 'SleepThread'); self.assertEqual(mine['last_svcs'][-1]['at'], '0x2000')
+        self.assertEqual(rep['run']['svc_calls']['GetSystemTick'], 20)
+        self.assertEqual(rep['environment']['NX2LINUX_GPU'], '1'); self.assertNotIn('NX2LINUX_NICK', rep['environment'])   # the nickname is a choice of the player
+        self.assertEqual(rep['environment']['NX2LINUX_DUMP_FRAME'], '~/frames')
+        self.assertEqual(oct(files[0].stat().st_mode & 0o777), '0o600')
+
+    def test_an_address_in_a_module_is_written_as_module_and_offset(self):
+        hz = horizon(); c = self.crash(); c.attach(hz)
+        self.assertEqual(c.loc(0x800123), 'main+0x123'); self.assertEqual(c.loc(0x10), '0x10')
+
+    def test_the_names_of_the_game_are_left_out_unless_asked(self):
+        hz = horizon(); c = self.crash(); c.attach(hz)
+        rep = c.build('guest-fault', regs=[0] * 29 + [0, 0x800123])
+        self.assertNotIn('symbol', rep['guest'])
+        c.environ = dict(self.env, NX2LINUX_CRASH_SYMBOLS='1', NX2LINUX_CRASH_REGS='1')
+        rep = c.build('guest-fault', regs=[0] * 29 + [0, 0x800123])
+        self.assertIn('symbol', rep['guest']); self.assertEqual(rep['guest']['registers']['x30'], '0x800123')
+
+    def test_a_run_writes_at_most_five_reports(self):
+        hz = horizon(); c = self.crash(); c.attach(hz); sys.stderr = io.StringIO()
+        paths = [c.report('guest-fault', fault='x') for _ in range(8)]
+        self.assertEqual(len([p for p in paths if p]), hc.MAX_REPORTS)
+        self.assertEqual(len(list((self.out).glob('crash-*.json'))), hc.MAX_REPORTS)
+
+    def test_a_python_exception_in_any_thread_is_a_report(self):
+        hz = horizon(); c = self.crash(); c.attach(hz); sys.stderr = io.StringIO(); c.install_hooks()
+        def boom():
+            raise ValueError(f'cannot read {ROMFS} for {FAKE_USER}')
+        t = threading.Thread(target=boom, name='worker-1'); t.start(); t.join(10)
+        files = sorted((self.out).glob('crash-*.json'))
+        self.assertEqual(len(files), 1)
+        text = files[0].read_text(); rep = json.loads(text)
+        self.assertClean(text)
+        self.assertEqual((rep['kind'], rep['exception']['type'], rep['thread']['name']), ('python-exception', 'ValueError', 'worker-1'))
+        self.assertIn('ValueError', rep['exception']['traceback']); self.assertIn('<romfs>', rep['exception']['traceback'])
+
+    def test_svc_break_is_a_report_before_the_process_ends(self):
+        hz = horizon(); c = self.crash(); c.attach(hz); sys.stderr = io.StringIO()
+        hz.on_break = lambda *a: None   # the real one is os._exit(3)
+        r = [0] * 31; r[0], r[1], r[2] = 0x80000000, 0x1234, 8
+        hz.svc(0x26, r, 0x800010)
+        rep = json.loads(next((self.out).glob('crash-*.json')).read_text())
+        self.assertEqual((rep['kind'], rep['detail']['reason']), ('guest-break', '0x80000000')); self.assertEqual(rep['run']['stop_reason'], 'svcBreak(0x80000000)')
+
+    def test_the_off_switch(self):
+        self.env['NX2LINUX_HOST_LOG'] = '0'
+        self.assertFalse(hc.enabled(self.env))
+        hz = horizon(); c = self.crash(); c.attach(hz)
+        self.assertIsNone(c.report('guest-fault', fault='x')); self.assertFalse(self.state.exists())
+
+    def test_an_unwritable_state_folder_does_not_raise(self):
+        (Path(self.tmp.name) / 'file').write_text('x'); self.env['XDG_STATE_HOME'] = str(Path(self.tmp.name) / 'file')   # a file where the folder should be
+        hz = horizon(); c = self.crash(console=io.StringIO()); c.attach(hz)
+        self.assertIsNone(c.report('guest-fault', fault='x'))
+
+
+class FatalSignals(Base):
+    CHILD = """
+import sys, os
+sys.path.insert(0, {tools!r})
+import horizon_crash as hc
+c = hc.Crash('0100E95004038000', paths=[({modules!r}, '<modules>')], environ=dict(os.environ))
+c.enable_faulthandler()
+if sys.argv[1] == 'clean': c.finish(); print('clean exit')
+else: os.abort()
+"""
+
+    def child(self, mode):
+        env = {k: v for k, v in os.environ.items() if not k.startswith('NX2LINUX_')}
+        env.update(HOME=FAKE_HOME, USER=FAKE_USER, XDG_STATE_HOME=str(self.state))
+        return subprocess.run([sys.executable, '-I', '-c', self.CHILD.format(tools=str(HERE.parent), modules=MODULES), mode], env=env, capture_output=True, text=True, timeout=60)
+
+    def test_a_process_that_dies_of_a_signal_is_turned_into_a_report_by_the_next_run(self):
+        r = self.child('abort'); self.assertEqual(r.returncode, -6, r.stderr)
+        raws = list((self.out).glob('crash-*.raw'))
+        self.assertEqual(len(raws), 1); self.assertGreater(raws[0].stat().st_size, 0)
+        made = hc.convert_raw_dumps(self.out, environ=self.env, redact=hc.Redactor([(MODULES, '<modules>')], self.env))
+        self.assertEqual(len(made), 1)
+        text = made[0].read_text(); rep = json.loads(text)
+        self.assertClean(text)
+        self.assertEqual((rep['kind'], rep['signal'], rep['title']), ('fatal-signal', 'SIGABRT', '0100E95004038000'))
+        self.assertIn('Fatal Python error', rep['native']['summary'])
+        self.assertEqual(list((self.out).glob('crash-*.raw')), [])   # converted, then removed
+
+    def test_a_run_that_ends_on_purpose_leaves_no_raw_file(self):
+        r = self.child('clean'); self.assertEqual(r.returncode, 0, r.stderr); self.assertIn('clean exit', r.stdout)
+        self.assertEqual(list((self.out).glob('crash-*')), [])
+
+    def test_an_empty_raw_file_belongs_to_a_run_that_is_going(self):
+        logs = self.out; logs.mkdir(parents=True)
+        raw = logs / 'crash-0100E95004038000-20261108T120000Z-4242.raw'; raw.write_text('')
+        self.assertEqual(hc.convert_raw_dumps(logs, environ=self.env), []); self.assertTrue(raw.exists())
+
+    def test_a_name_that_is_not_ours_is_left_alone(self):
+        logs = self.out; logs.mkdir(parents=True)
+        other = logs / 'crash-dump.raw'; other.write_text('Fatal Python error: Segmentation fault'); keep = logs / 'crash-x-1.json'; keep.write_text('{}')
+        self.assertEqual(hc.convert_raw_dumps(logs, environ=self.env), []); self.assertTrue(other.exists() and keep.exists())
+
+
+class RunnerWiring(Base):
+    """horizon_run.start_log: what a run does before the game starts"""
+    def start(self, **env):
+        import horizon_run
+        a = types.SimpleNamespace(title='0100E95004038000', modules=MODULES, romfs=ROMFS, cache=f'{FAKE_HOME}/.cache/nx2linux/aot-cache')
+        patched = {**os.environ, **self.env, **env}
+        with unittest.mock.patch.dict(os.environ, patched, clear=True):
+            return horizon_run.start_log(a)
+
+    def test_the_run_starts_a_log_and_a_signal_handler(self):
+        sys.stdout, sys.stderr = io.StringIO(), io.StringIO()
+        c = self.start()
+        try:
+            self.assertIsNotNone(c); self.assertTrue(c.log_path.is_file()); self.assertTrue(c.raw_path.is_file())
+            self.assertIn('[host] log:', sys.stdout.console.getvalue())
+        finally: c.finish()
+        self.assertEqual(list(self.out.glob('crash-*.raw')), [])   # ended on purpose: the empty raw file is gone
+
+    def test_a_dump_left_by_a_dead_run_is_reported_at_the_start_of_the_next(self):
+        self.out.mkdir(parents=True)
+        (self.out / 'crash-0100E95004038000-20261101T100000Z-777.raw').write_text(f'Fatal Python error: Segmentation fault\n\nCurrent thread 0x1 (most recent call first):\n  File "{FAKE_HOME}/x.py", line 3\n')
+        sys.stdout, sys.stderr = io.StringIO(), io.StringIO()
+        c = self.start()
+        try: self.assertIn('died of a signal', sys.stdout.console.getvalue())
+        finally: c.finish()
+        rep = json.loads((self.out / 'crash-0100E95004038000-20261101T100000Z-777.json').read_text())
+        self.assertEqual(rep['signal'], 'SIGSEGV'); self.assertClean(json.dumps(rep))
+
+    def test_with_the_off_switch_nothing_is_created(self):
+        c = self.start(NX2LINUX_HOST_LOG='0')
+        self.assertIsNone(c); self.assertFalse(self.state.exists())
+
+    def test_a_state_folder_that_cannot_be_written_costs_the_log_only(self):
+        (Path(self.tmp.name) / 'file').write_text('x'); sys.stdout, sys.stderr = io.StringIO(), io.StringIO()
+        self.assertIsNone(self.start(XDG_STATE_HOME=str(Path(self.tmp.name) / 'file')))
+        self.assertIn('no log or crash report', sys.stderr.getvalue())
+
+
+if __name__ == '__main__': unittest.main()
