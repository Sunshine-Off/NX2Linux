+++ b/dm/tools/tests/test_horizon_input.py
@@ -0,0 +1,34 @@
+"""horizon_input.py: window events and scripted presses become NpadState buttons"""
+import os, sys, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_hid
+import horizon_input as hi
+
+
+class Hz: pass
+
+
+class Input(unittest.TestCase):
+    def test_keys_and_gamepad_buttons_set_and_clear_bits(self):
+        hz, clock = Hz(), [0.0]
+        i = hi.Input(hz, now=lambda: clock[0])
+        i.event(('key_down', ord('x'), 0, 0)); self.assertEqual(horizon_hid.state(hz).buttons, hi.BUTTONS['A'])
+        i.event(('pad_down', 11, 0, 0)); self.assertEqual(horizon_hid.state(hz).buttons, hi.BUTTONS['A'] | hi.BUTTONS['Up'])
+        i.event(('key_up', ord('x'), 0, 0)); self.assertEqual(horizon_hid.state(hz).buttons, hi.BUTTONS['Up'])
+        i.event(('pad_axis', 11, 5, 0)); self.assertEqual(horizon_hid.state(hz).buttons, hi.BUTTONS['Up'])
+
+    def test_a_scripted_press_lasts_its_duration(self):
+        os.environ['NX2LINUX_PRESS'] = 'A@10:0.5,Plus@20'
+        try:
+            hz, clock = Hz(), [0.0]
+            i = hi.Input(hz, now=lambda: clock[0])
+            for t, want in ((9.9, 0), (10.1, hi.BUTTONS['A']), (10.6, 0), (20.1, hi.BUTTONS['Plus']), (20.5, 0)):
+                clock[0] = t; i.poll()
+                self.assertEqual(horizon_hid.state(hz).buttons, want, t)
+        finally: del os.environ['NX2LINUX_PRESS']
+
+
+if __name__ == '__main__':
+    unittest.main()
