diff --git a/dm/tools/horizon_input.py b/dm/tools/horizon_input.py
new file mode 100644
index 0000000..19d4dab
--- /dev/null
+++ b/dm/tools/horizon_input.py
@@ -0,0 +1,46 @@
+"""Input for the Linux host (NX2Linux S7bis): the keyboard and gamepad events of the window become the buttons of NpadState (horizon_hid.py). Keys: X A, Z B, C X, V Y, arrows and Return (Plus),
+Backspace (Minus), A / S the shoulders, Q / W the triggers. A gamepad uses the physical layout (SDL's east button is Switch A). NX2LINUX_PRESS=A@45:0.3,Plus@60 presses a button at a time in seconds
+(for how long, 0.2 s by default) without a person: how a title screen is passed in a test run."""
+import os, time
+
+import horizon_hid
+
+BUTTONS = {n: 1 << i for i, n in enumerate(('A', 'B', 'X', 'Y', 'StickL', 'StickR', 'L', 'R', 'ZL', 'ZR', 'Plus', 'Minus', 'Left', 'Up', 'Right', 'Down'))}
+KEYS = {ord('x'): 'A', ord('z'): 'B', ord('c'): 'X', ord('v'): 'Y', ord('a'): 'L', ord('s'): 'R', ord('q'): 'ZL', ord('w'): 'ZR', 0x0D: 'Plus', 0x08: 'Minus', 0x20: 'A', 0x1B: 'B',
+        0x4000004F: 'Right', 0x40000050: 'Left', 0x40000051: 'Down', 0x40000052: 'Up'}
+GAMEPAD = {0: 'B', 1: 'A', 2: 'Y', 3: 'X', 4: 'Minus', 6: 'Plus', 7: 'StickL', 8: 'StickR', 9: 'L', 10: 'R', 11: 'Up', 12: 'Down', 13: 'Left', 14: 'Right'}   # SDL_GamepadButton
+
+
+def script():
+    """[(button mask, start, end)] from NX2LINUX_PRESS"""
+    out = []
+    for item in filter(None, os.environ.get('NX2LINUX_PRESS', '').split(',')):
+        name, _, when = item.partition('@')
+        start, _, length = when.partition(':')
+        if name in BUTTONS and start: out.append((BUTTONS[name], float(start), float(start) + float(length or 0.2)))
+    return out
+
+
+class Input:
+    def __init__(self, hz, now=time.monotonic):
+        self.hz, self.now, self.t0, self.held, self.script = hz, now, now(), 0, script()
+
+    def event(self, ev):
+        """One window event: (name, key, ...)"""
+        name, key = ev[0], ev[1]
+        bit = BUTTONS.get(KEYS.get(key)) if name.startswith('key') else BUTTONS.get(GAMEPAD.get(key)) if name.startswith('pad') and name not in ('pad_added', 'pad_removed', 'pad_axis') else None
+        if not bit: return
+        down = name.endswith('down')
+        self.held = self.held | bit if down else self.held & ~bit
+        self.apply()
+
+    def poll(self):
+        """Applies the scripted presses that are on now"""
+        if self.script: self.apply()
+
+    def apply(self):
+        t = self.now() - self.t0
+        scripted = 0
+        for bit, a, b in self.script:
+            if a <= t < b: scripted |= bit
+        horizon_hid.state(self.hz).buttons = self.held | scripted
