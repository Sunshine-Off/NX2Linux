+    def copy(self, state, c):
+        """A texture copy: buffer to texture is read from the game's memory and uploaded, texture to texture stays on the GPU. Texture to buffer is not done yet"""
+        n = self.nvn
+        if c['kind'] == 'b2t':
+            im = self.image_of(c['tex'], target=True)
+            d = n.o[c['tex']]['d']
+            bpb, bw, bh = nvn_layout.fmt_of(d.format)
+            x, y, z, w, h, dep = c['region']
+            view = c['view']
+            level = view['base_level'] if view and view['set_levels'] else 0
+            layer0 = view['min_layer'] if view and view['set_layers'] else 0
+            row_bytes = nvn_layout.blk(w, bw) * bpb
+            rows = nvn_layout.blk(h, bh)
+            misc = state.get('misc', {})
+            row_stride = misc.get('copy_row_stride') or row_bytes
+            img_stride = misc.get('copy_image_stride') or row_stride * rows
+            slices = max(1, dep)
+            parts = []
+            for k in range(slices):
+                base = c['src'] + k * img_stride
+                if row_stride == row_bytes: parts.append(n.hz.rd(base, row_bytes * rows))
+                else:
+                    raw = n.hz.rd(base, row_stride * (rows - 1) + row_bytes)
+                    parts.append(b''.join(raw[r * row_stride:r * row_stride + row_bytes] for r in range(rows)))
+            if im['kind']: self.gpu.upload(im['id'], b''.join(parts), w, h, slices, level, 0, x, y, z)
+            else:
+                for k, data in enumerate(parts): self.gpu.upload(im['id'], data, w, h, 1, level, layer0 + z + k, x, y, 0)
+        elif c['kind'] == 't2t':
