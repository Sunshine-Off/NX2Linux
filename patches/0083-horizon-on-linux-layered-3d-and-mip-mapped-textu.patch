+            sx, sy, sz, w, h, dep = c['src_region']
+            dx, dy, dz = c['dst_region'][:3]
+            sv, dv = c['src_view'], c['dst_view']
+            slevel, slayer = (sv['base_level'] if sv and sv['set_levels'] else 0), (sv['min_layer'] if sv and sv['set_layers'] else 0)
+            dlevel, dlayer = (dv['base_level'] if dv and dv['set_levels'] else 0), (dv['min_layer'] if dv and dv['set_layers'] else 0)
+            if si['fmt'] != di['fmt']: raise Skip('copy between formats')
+            if si['kind'] or di['kind']: self.gpu.copy_image(si['id'], di['id'], (w, h, max(1, dep)), (sx, sy, sz), (dx, dy, dz), slevel, 0, dlevel, 0)
+            else:
+                for k in range(max(1, dep)): self.gpu.copy_image(si['id'], di['id'], (w, h, 1), (sx, sy, 0), (dx, dy, 0), slevel, slayer + sz + k, dlevel, dlayer + dz + k)
