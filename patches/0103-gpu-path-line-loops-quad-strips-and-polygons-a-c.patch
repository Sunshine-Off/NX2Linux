+    def test_a_shader_that_samples_a_3d_texture_as_2d_is_translated_again_with_the_type_the_game_binds(self):
+        import nvn_gpu, nvn_spirv, types
+        tex3d = dict(self.RGBA8, target=2, depth=4)   # NVN_TEXTURE_TARGET_3D
+        b, mem = self.backend({7: tex3d})
+        b.image_of(7, target=True)   # a texture the GPU wrote: no upload from the fake memory
+        b.nvn.o[100] = {'tex': {5: 7}}; b.nvn.shader_bytes = {'k': (b'ctl', b'code')}; b.nvn.creplay = None
+        b.shaders['k'] = (b.gpu.shader(spirv(FRAG_2D, 'frag')), 'ps', {'cbufs': [], 'sbufs': [], 'textures': [], 'images': []})
+        first = b.shaders['k']
+        t = hg.Tex()
+        with self.assertRaises(nvn_gpu.TypeMismatch) as cm: b.fill_texture(t, 100, 0, 5, 3)   # a shader that declares a 2D texture
+        self.assertEqual(cm.exception.actual, '3d')
+        b.fill_texture(t, 100, 0, 5, 4)    # one that declares 3D fits
+        asked, answer = [], {'type': 4}
+        def fake_translate(items):
+            asked.extend(items)
+            kind = answer['type']
+            return {items[0][0]: (spirv(FRAG_3D, 'frag'), {'stage': 'ps', 'cbufs': [], 'sbufs': [], 'textures': [{'binding': 160, 'type': kind, 'cbuf_slot': -1, 'handle': 14}], 'images': []})}, {}
+        real, nvn_spirv.translate = nvn_spirv.translate, fake_translate
+        try:
+            tx = {'cbuf_slot': -1, 'handle': 14, 'type': 3, 'binding': 160}   # c2 word 14: texture slot 3
+            self.assertTrue(b.learn_type('k', tx, '3d'))
+            self.assertFalse(b.learn_type('k', tx, '3d'), 'a slot that was told its type is not told again')
+            self.assertFalse(b.learn_type('k', dict(tx, cbuf_slot=3), '3d'), 'a bindless handle names no slot')
+            answer['type'] = 3   # the translator keeps the 2D its instruction names: nothing is learned, and the slot is not asked again
+            tx5 = dict(tx, handle=8 + 2 * 5); n_asked = len(asked)
+            self.assertFalse(b.learn_type('k', tx5, '3d')); self.assertFalse(b.learn_type('k', tx5, '3d'))
+            self.assertEqual(len(asked), n_asked + 1)
+        finally: nvn_spirv.translate = real
+        self.assertEqual(asked[0][3], {'3': '3d'}); self.assertEqual(asked[0][1:3], (b'ctl', b'code'))
+        self.assertIsNot(b.shaders['k'], first)   # the shader of the key is the variant now
+        self.assertEqual(b.tex_facts, {'k': {'3': '3d'}}); self.assertIn(('k', 5), b.unlearnable)
