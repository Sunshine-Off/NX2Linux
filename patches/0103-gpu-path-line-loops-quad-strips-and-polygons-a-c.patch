index 0000000..18ffed4
--- /dev/null
+++ b/dm/tools/framediff.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Compares rendered frames with reference frames (NX2Linux S7bis, milestone D): two PNG files, or two folders whose files are matched by name (NX2LINUX_DUMP_FRAME=<dir> writes the frames of a run). For each pair: the size,
+the mean and the largest difference per channel, the share of pixels that differ by more than a tolerance, and the PSNR; --diff writes a PNG of the differences. The reference is yours (a frame of the same scene from another
+renderer, or an earlier run you judged right): none comes with the repository, since a frame of a game is the game's data.
+Usage: framediff.py <frame or folder> <reference frame or folder> [--tolerance N] [--max-different PERCENT] [--diff DIR]
+Exit status: 0 when every pair is within --max-different (default 1.0 %), 1 when one is not, 2 for an unreadable or missing file."""
+import argparse, math, struct, sys, zlib
+from pathlib import Path
+
+
+def read_png(path):
+    """(width, height, rgba bytes) of an 8-bit RGB, RGBA, gray or gray+alpha PNG that is not interlaced"""
+    data = Path(path).read_bytes()
+    if data[:8] != b'\x89PNG\r\n\x1a\n': raise ValueError(f'{path}: not a PNG file')
+    pos, idat, head = 8, [], None
+    while pos < len(data):
+        n, kind = struct.unpack_from('>I4s', data, pos)
+        body = data[pos + 8:pos + 8 + n]
+        if kind == b'IHDR': head = struct.unpack('>IIBBBBB', body)
+        elif kind == b'IDAT': idat.append(body)
+        pos += 12 + n
+    if not head: raise ValueError(f'{path}: no header')
+    w, h, depth, ctype, _, _, interlace = head
+    if depth != 8 or interlace or ctype not in (0, 2, 4, 6): raise ValueError(f'{path}: only 8-bit PNGs that are not interlaced are read (depth {depth}, colour type {ctype}, interlace {interlace})')
+    bpp = {0: 1, 2: 3, 4: 2, 6: 4}[ctype]
+    raw, stride = zlib.decompress(b''.join(idat)), w * bpp
+    rows, prev = [], bytearray(stride)
+    for y in range(h):
+        f, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
+        for i in range(stride):
+            a = line[i - bpp] if i >= bpp else 0
+            b = prev[i]
+            c = prev[i - bpp] if i >= bpp else 0
+            if f == 1: line[i] = (line[i] + a) & 255
+            elif f == 2: line[i] = (line[i] + b) & 255
+            elif f == 3: line[i] = (line[i] + (a + b) // 2) & 255
+            elif f == 4:
+                p = a + b - c; pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
+                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
+            elif f: raise ValueError(f'{path}: filter {f}')
+        rows.append(bytes(line)); prev = line
+    out = bytearray()
+    for r in rows:
+        for x in range(w):
+            px = r[x * bpp:(x + 1) * bpp]
+            out += bytes((px[0], px[0], px[0], 255)) if ctype == 0 else bytes((px[0], px[0], px[0], px[1])) if ctype == 4 else bytes((*px, 255)) if ctype == 2 else px
+    return w, h, bytes(out)
+
+
+def write_png(path, w, h, rgba):
+    def chunk(kind, body): return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body))
+    raw = b''.join(b'\0' + rgba[y * w * 4:(y + 1) * w * 4] for y in range(h))
+    Path(path).write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(raw)) + chunk(b'IEND', b''))
+
+
+def compare(a, b, tolerance=0):
+    """{'size': ..., 'mean': [r, g, b, a], 'max': [...], 'different': share of pixels over the tolerance in percent, 'psnr': dB or inf, 'diff': rgba bytes of the differences} for two (w, h, rgba) images"""
+    (wa, ha, pa), (wb, hb, pb) = a, b
+    if (wa, ha) != (wb, hb): return {'size': f'{wa}x{ha} against {wb}x{hb}', 'different': 100.0, 'mean': None, 'max': None, 'psnr': 0.0, 'diff': None}
+    n = wa * ha; sums, mx, bad, sq = [0] * 4, [0] * 4, 0, 0
+    diff = bytearray(n * 4)
+    for i in range(n):
+        d = [abs(pa[4 * i + c] - pb[4 * i + c]) for c in range(4)]
+        for c in range(4):
+            sums[c] += d[c]; sq += d[c] * d[c]
+            if d[c] > mx[c]: mx[c] = d[c]
+        if max(d) > tolerance: bad += 1; diff[4 * i:4 * i + 4] = bytes((min(255, d[0] * 4), min(255, d[1] * 4), min(255, d[2] * 4), 255))
+        else: diff[4 * i + 3] = 255
+    mse = sq / (n * 4) if n else 0
+    return {'size': f'{wa}x{ha}', 'mean': [round(s / n, 3) for s in sums], 'max': mx, 'different': round(100.0 * bad / n, 3) if n else 0.0, 'psnr': math.inf if mse == 0 else round(10 * math.log10(255 * 255 / mse), 2), 'diff': bytes(diff)}
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    p.add_argument('frame'); p.add_argument('reference'); p.add_argument('--tolerance', type=int, default=0, help='a pixel differs when a channel is off by more than this (0..255)')
+    p.add_argument('--max-different', type=float, default=1.0, help='the share of differing pixels (percent) a pair may have'); p.add_argument('--diff', help='write the difference images here')
+    a = p.parse_args(argv)
+    fa, fb = Path(a.frame), Path(a.reference)
+    pairs = [(fa, fb)] if fa.is_file() else [(f, fb / f.name) for f in sorted(fa.glob('*.png'))]
+    if not pairs: print('no frame to compare', file=sys.stderr); return 2
+    worst = 0
+    for x, y in pairs:
+        try: r = compare(read_png(x), read_png(y), a.tolerance)
+        except (OSError, ValueError, zlib.error) as e: print(f'{x.name}: {e}', file=sys.stderr); return 2
+        print(f"{x.name}: {r['size']}  different {r['different']} %  mean {r['mean']}  max {r['max']}  PSNR {r['psnr']} dB")
+        if a.diff and r['diff']: Path(a.diff).mkdir(parents=True, exist_ok=True); write_png(Path(a.diff) / x.name, *map(int, r['size'].split('x')), r['diff'])
+        worst = max(worst, r['different'])
+    return 0 if worst <= a.max_different else 1
+
+
+if __name__ == '__main__': sys.exit(main())
