+++ b/dm/tools/tests/test_framediff.py
@@ -0,0 +1,48 @@
+"""framediff.py: reads PNGs and measures the difference between two frames (synthetic frames only)"""
+import sys, tempfile, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import framediff as fd
+
+
+def frame(w, h, f): return b''.join(bytes(f(x, y)) + b'\xff' for y in range(h) for x in range(w))
+
+
+class Diff(unittest.TestCase):
+    def test_a_png_round_trips_and_identical_frames_have_no_difference(self):
+        with tempfile.TemporaryDirectory() as d:
+            px = frame(4, 3, lambda x, y: (x * 60, y * 90, 7))
+            fd.write_png(Path(d) / 'a.png', 4, 3, px)
+            self.assertEqual(fd.read_png(Path(d) / 'a.png'), (4, 3, px))
+            r = fd.compare(fd.read_png(Path(d) / 'a.png'), (4, 3, px))
+            self.assertEqual((r['different'], r['max'], r['psnr']), (0.0, [0, 0, 0, 0], float('inf')))
+
+    def test_a_changed_pixel_is_counted_and_a_tolerance_forgives_small_errors(self):
+        a = frame(4, 4, lambda x, y: (100, 100, 100)); b = bytearray(a); b[0] = 110; b[4] = 160
+        r = fd.compare((4, 4, a), (4, 4, bytes(b)))
+        self.assertEqual((r['different'], r['max']), (12.5, [60, 0, 0, 0]))
+        self.assertEqual(fd.compare((4, 4, a), (4, 4, bytes(b)), tolerance=20)['different'], 6.25)   # only the large one is left
+
+    def test_frames_of_another_size_never_match(self):
+        r = fd.compare((2, 2, frame(2, 2, lambda x, y: (0, 0, 0))), (3, 2, frame(3, 2, lambda x, y: (0, 0, 0))))
+        self.assertEqual((r['different'], r['size']), (100.0, '2x2 against 3x2'))
+
+    def test_the_command_matches_folders_by_name_and_sets_its_exit_status(self):
+        with tempfile.TemporaryDirectory() as d:
+            a, b = Path(d) / 'a', Path(d) / 'b'; a.mkdir(); b.mkdir()
+            same = frame(8, 8, lambda x, y: (x * 30, 0, 0)); other = frame(8, 8, lambda x, y: (x * 30, 255, 0))
+            fd.write_png(a / '1.png', 8, 8, same); fd.write_png(b / '1.png', 8, 8, same)
+            self.assertEqual(fd.main([str(a), str(b)]), 0)
+            fd.write_png(a / '2.png', 8, 8, same); fd.write_png(b / '2.png', 8, 8, other)
+            self.assertEqual(fd.main([str(a), str(b), '--diff', str(Path(d) / 'out')]), 1)
+            self.assertTrue((Path(d) / 'out' / '2.png').exists())
+            self.assertEqual(fd.main([str(a / '1.png'), str(Path(d) / 'missing.png')]), 2)
+
+    def test_a_png_that_is_not_one_is_refused(self):
+        with tempfile.TemporaryDirectory() as d:
+            (Path(d) / 'x.png').write_bytes(b'nope')
+            with self.assertRaises(ValueError): fd.read_png(Path(d) / 'x.png')
+
+
+if __name__ == '__main__': unittest.main()
