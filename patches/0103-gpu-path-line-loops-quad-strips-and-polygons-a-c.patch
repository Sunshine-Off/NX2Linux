+    def backend(self, textures):
+        """An nvn_gpu backend on the real library with a fake NVN (textures: pointer -> description) and a guest memory of 64 KB"""
+        import types, nvn_gpu
+        mem = bytearray(0x10000)
+        hz = types.SimpleNamespace(rd=lambda a, n: bytes(mem[a:a + n]), wr=lambda a, data: mem.__setitem__(slice(a, a + len(data)), data))
+        nvn = types.SimpleNamespace(o={p: {'d': types.SimpleNamespace(**d)} for p, d in textures.items()}, hz=hz, stats={'presents': 0}, pool_addr=lambda *a: 0)
+        return nvn_gpu.GpuBackend(nvn, gpu=self.gpu), mem
