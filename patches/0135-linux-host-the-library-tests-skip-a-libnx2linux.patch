From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shikosu <teovidal01@gmail.com>
Date: Sun, 8 Nov 2026 14:28:26 +0100
Subject: [PATCH] Linux host: the library tests skip a libnx2linux_sync.so
 older than the host (#19)

A library built before a pull speaks an older interface: a run stays on
Python and says so, and the tests that need the library are skipped with a
reason instead of failing.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Upstream-Status: fork-only
Reason: Skip the native library tests when the built library is older than the host, instead of failing
Issue: Sunshine-Off/NX2Linux#19

---
 dm/tools/horizon_sync.py              | 8 ++++++++
 dm/tools/tests/test_aot_svc_native.py | 1 +
 dm/tools/tests/test_horizon_sync.py   | 1 +
 3 files changed, 10 insertions(+)

diff --git a/dm/tools/horizon_sync.py b/dm/tools/horizon_sync.py
index 04ef6951..0e97104b 100644
--- a/dm/tools/horizon_sync.py
+++ b/dm/tools/horizon_sync.py
@@ -21,6 +21,14 @@ def library_path(environ=None):
     return p if os.path.exists(p) else None
 
 
+def library_matches(path):
+    """True when the file loads and speaks the interface version this host wants (a library built before a pull is older than the Python: the tests skip on it and a run stays on Python)"""
+    try:
+        lib = C.CDLL(path); lib.nx2sync_abi.restype = C.c_int
+        return lib.nx2sync_abi() == ABI
+    except (OSError, AttributeError): return False
+
+
 def requested(environ=None):
     """True, False, or None when the value is not 0 or 1 (the run then stays on Python and says so)"""
     v = (os.environ if environ is None else environ).get('NX2LINUX_SVC_NATIVE', '0').strip()
diff --git a/dm/tools/tests/test_aot_svc_native.py b/dm/tools/tests/test_aot_svc_native.py
index 2e3013c2..67d23b27 100644
--- a/dm/tools/tests/test_aot_svc_native.py
+++ b/dm/tools/tests/test_aot_svc_native.py
@@ -12,6 +12,7 @@ import horizon_sync as hs
 from test_aot_t3 import READY, DATA, STACK, STACK_SIZE
 
 LIB = hs.library_path()
+if LIB and not hs.library_matches(LIB): LIB = None   # older than this host: rebuild it (cmake --build)
 WAITFN, SIGNALFN, LOCKFN, UNLOCKFN, OTHERFN = 0x100, 0x120, 0x140, 0x160, 0x180
 M = (1 << 64) - 1
 STACKS = [STACK + 0x4000 * i for i in range(1, 5)]
diff --git a/dm/tools/tests/test_horizon_sync.py b/dm/tools/tests/test_horizon_sync.py
index 4e14a190..28fbdd86 100644
--- a/dm/tools/tests/test_horizon_sync.py
+++ b/dm/tools/tests/test_horizon_sync.py
@@ -11,6 +11,7 @@ import horizon_sync as hs
 from test_horizon_hle import FakeAot
 
 LIB = hs.library_path()
+if LIB and not hs.library_matches(LIB): print(f'test_horizon_sync: {LIB} is older than this host (rebuild it with cmake --build): the tests that need it are skipped', file=sys.stderr); LIB = None
 PEEK = C.CFUNCTYPE(C.c_int, C.c_uint64, C.c_void_p, C.c_uint64)
 CAS = C.CFUNCTYPE(C.c_uint32, C.c_uint64, C.c_uint32, C.c_uint32)
 
