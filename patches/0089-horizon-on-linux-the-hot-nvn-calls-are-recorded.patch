diff --git a/dm/tools/nvn_rec.py b/dm/tools/nvn_rec.py
new file mode 100644
index 0000000..56ed68f
--- /dev/null
+++ b/dm/tools/nvn_rec.py
@@ -0,0 +1,141 @@
+"""NVN command recording in C (NX2Linux S7bis): the hot NVN calls (bindings, viewports, draws, the setters of state objects) are host functions written in C (linux/host/nvnrec.c, in libnx2linux_gpu.so) that
+the recompiled game calls without going through Python. A command buffer call appends a binary record to that buffer's stream; this module turns the stream into the tuples horizon_nvn.py records itself
+(Nvn.replay reads either), and defines the state setters in C from the layouts of nvn_state.py. NX2LINUX_NVN_NATIVE=0 turns it off. The record layouts below mirror nvnrec.c."""
+import ctypes as C
+import os
+import struct
+
+import nvn_state
+
+OP_UBO, OP_SSBO, OP_VBUF, OP_TEX, OP_VIEWPORT, OP_SCISSOR, OP_PROGRAM, OP_BIND_STATE, OP_VATTR, OP_VSTREAM, OP_DRAW, OP_TARGETS, OP_STENCIL = range(1, 14)
+STATE_KINDS = (nvn_state.BLEND, nvn_state.COLOR, nvn_state.CHMASK, nvn_state.MULTISAMPLE, nvn_state.POLYGON, nvn_state.DEPTH_STENCIL)   # the order of nvnrec.c r_bind_state
+STENCIL_KEYS = ('stencil_ref_', 'stencil_mask_', 'stencil_value_mask_')
+F_MASK, F_BOOL, F_ADV_MODE, F_NOT = range(4)
+SP_NONE, SP_BLEND_ENABLE, SP_CHMASK, SP_STENCIL_FUNC, SP_STENCIL_OP = range(5)
+
+
+class Fld(C.Structure): _fields_ = [('off', C.c_uint8), ('width', C.c_uint8), ('mode', C.c_uint8)]
+class SetDesc(C.Structure): _fields_ = [('size', C.c_uint32), ('special', C.c_uint32), ('nf', C.c_uint32), ('f', Fld * 8)]
+
+
+# (kind, setter) -> (special, [(field, mode)]): the setters of nvn_state.OBJECTS that run in C. The tests compare each against its Python version on the same arguments
+NATIVE_SETTERS = {
+    'BlendState': {'SetBlendTarget': (SP_NONE, [('target', F_MASK)]), 'SetBlendFunc': (SP_NONE, [('src_rgb', F_MASK), ('dst_rgb', F_MASK), ('src_a', F_MASK), ('dst_a', F_MASK)]),
+                   'SetBlendEquation': (SP_NONE, [('eq_rgb', F_MASK), ('eq_a', F_MASK)]), 'SetAdvancedMode': (SP_NONE, [('adv', F_ADV_MODE)]),
+                   'SetAdvancedPremultipliedSrc': (SP_NONE, [('adv_npm', F_NOT)]), 'SetAdvancedOverlap': (SP_NONE, [('adv_ovl', F_MASK)])},
+    'ColorState': {'SetBlendEnable': (SP_BLEND_ENABLE, [('blend_en', F_MASK)]), 'SetAlphaTest': (SP_NONE, [('alpha_func', F_MASK)]), 'SetLogicOp': (SP_NONE, [('logic_op', F_MASK)])},
+    'ChannelMaskState': {'SetChannelMask': (SP_CHMASK, [('mask', F_MASK)])},
+    'MultisampleState': {'SetMultisampleEnable': (SP_NONE, [('enable', F_BOOL)]), 'SetSamples': (SP_NONE, [('samples', F_MASK)]), 'SetAlphaToCoverageEnable': (SP_NONE, [('a2c', F_BOOL)]),
+                         'SetAlphaToCoverageDither': (SP_NONE, [('a2c_dither', F_BOOL)]), 'SetRasterSamples': (SP_NONE, [('raster_samples', F_MASK)]), 'SetCoverageModulationMode': (SP_NONE, [('cov_mod', F_MASK)]),
+                         'SetCoverageToColorEnable': (SP_NONE, [('cov2color_en', F_BOOL)]), 'SetCoverageToColorOutput': (SP_NONE, [('cov2color_out', F_MASK)]),
+                         'SetSampleLocationsEnable': (SP_NONE, [('sl_en', F_BOOL)]), 'SetSampleLocationsGridEnable': (SP_NONE, [('sl_grid', F_BOOL)])},
+    'PolygonState': {'SetCullFace': (SP_NONE, [('cull', F_MASK)]), 'SetFrontFace': (SP_NONE, [('front', F_MASK)]), 'SetPolygonMode': (SP_NONE, [('mode', F_MASK)]),
+                     'SetPolygonOffsetEnables': (SP_NONE, [('offset_en', F_MASK)])},
+    'DepthStencilState': {'SetDepthTestEnable': (SP_NONE, [('dt', F_BOOL)]), 'SetDepthWriteEnable': (SP_NONE, [('dw', F_BOOL)]), 'SetDepthFunc': (SP_NONE, [('df', F_MASK)]),
+                          'SetStencilTestEnable': (SP_NONE, [('st', F_BOOL)]), 'SetStencilFunc': (SP_STENCIL_FUNC, [('sf_f', F_MASK), ('sf_b', F_MASK)]),
+                          'SetStencilOp': (SP_STENCIL_OP, [(k, F_MASK) for k in ('fail_f', 'zfail_f', 'zpass_f', 'fail_b', 'zfail_b', 'zpass_b')])},
+    'VertexAttribState': {'SetFormat': (SP_NONE, [('fmt', F_MASK), ('offset', F_MASK)]), 'SetStreamIndex': (SP_NONE, [('stream', F_MASK)])},
+    'VertexStreamState': {'SetStride': (SP_NONE, [('stride', F_MASK)]), 'SetDivisor': (SP_NONE, [('divisor', F_MASK)])},
+}
+
+
+def descriptor(spec, special, fields):
+    offsets, off = {}, 0
+    for f, w in spec.fields: offsets[f] = (off, w); off += w
+    d = SetDesc(size=spec.size, special=special, nf=len(fields))
+    for i, (f, mode) in enumerate(fields): d.f[i] = Fld(offsets[f][0], offsets[f][1], mode)
+    return d
+
+
+class Recorder:
+    """The C recorder of one library: registers the native host functions and takes the streams of command buffers back as recorded tuples"""
+    def __init__(self, lib, guest_ptr):
+        self.lib = L = lib
+        L.nx2rec_init.argtypes = [C.c_void_p]
+        L.nx2rec_define_setter.argtypes = [C.c_char_p, C.POINTER(SetDesc)]
+        L.nx2rec_native.argtypes = [C.c_char_p, C.POINTER(C.c_void_p), C.POINTER(C.c_void_p)]
+        L.nx2rec_count.argtypes = [C.c_char_p]; L.nx2rec_count.restype = C.c_uint64
+        L.nx2rec_names.argtypes = [C.c_char_p, C.c_uint64]
+        L.nx2rec_len.argtypes = [C.c_uint64]; L.nx2rec_len.restype = C.c_uint32
+        L.nx2rec_take.argtypes = [C.c_uint64, C.c_char_p, C.c_uint32]; L.nx2rec_take.restype = C.c_uint32
+        L.nx2rec_reset.argtypes = [C.c_uint64]
+        L.nx2rec_init(guest_ptr)
+        self.defined = 0
+        for kind, setters in NATIVE_SETTERS.items():
+            spec = nvn_state.OBJECTS[kind][0]
+            for name, (special, fields) in setters.items():
+                if L.nx2rec_define_setter(f'nvn{kind}{name}'.encode(), C.byref(descriptor(spec, special, fields))): raise RuntimeError(f'too many natives at nvn{kind}{name}')
+                self.defined += 1
+        buf = C.create_string_buffer(1 << 14)
+        n = L.nx2rec_names(buf, len(buf))
+        self.names = set(buf.raw[:n].decode().split())
+        self.cache = {}   # (op, raw bytes) -> decoded state objects, shared: nothing changes them after they are recorded
+
+    def native(self, name):
+        """(function pointer, context pointer) of the C version of an NVN function, or None"""
+        if name not in self.names: return None
+        fn, ctx = C.c_void_p(), C.c_void_p()
+        if self.lib.nx2rec_native(name.encode(), C.byref(fn), C.byref(ctx)): return None
+        return fn.value, ctx.value
+
+    def counts(self): return {n: c for n in self.names if (c := self.lib.nx2rec_count(n.encode()))}
+
+    def reset(self, cb): self.lib.nx2rec_reset(cb)
+
+    def pending(self, cb): return self.lib.nx2rec_len(cb)
+
+    def take(self, cb):
+        """The commands recorded in C for the command buffer at cb since the last take, as the tuples horizon_nvn.rec makes"""
+        n = self.lib.nx2rec_len(cb)
+        if not n: return []
+        buf = C.create_string_buffer(n)
+        n = self.lib.nx2rec_take(cb, buf, n)
+        return self.decode(buf.raw[:n])
+
+    def decode(self, raw):
+        out, pos, end, cache = [], 0, len(raw), self.cache
+        while pos < end:
+            head = struct.unpack_from('<Q', raw, pos)[0]; op, nwords = head & 0xFFFFFFFF, head >> 32
+            body = pos + 8; pos += 8 * nwords
+            if op == OP_UBO or op == OP_SSBO:
+                stage, idx, addr, size = struct.unpack_from('<4Q', raw, body); out.append(('ubo' if op == OP_UBO else 'ssbo', {(stage, idx): (addr, size)}))
+            elif op == OP_VBUF:
+                idx, addr, size = struct.unpack_from('<3Q', raw, body); out.append(('vbuf', {idx: (addr, size)}))
+            elif op == OP_TEX:
+                stage, idx, h = struct.unpack_from('<3Q', raw, body); out.append(('tex', {(stage, idx): h}))
+            elif op == OP_VIEWPORT or op == OP_SCISSOR:
+                out.append(('viewports' if op == OP_VIEWPORT else 'scissors', {0: struct.unpack_from('<4q', raw, body)}))
+            elif op == OP_PROGRAM:
+                ptr, stages = struct.unpack_from('<2Q', raw, body); out.append(('program', ptr, stages))
+            elif op == OP_BIND_STATE:
+                kind = struct.unpack_from('<Q', raw, body)[0]; spec = STATE_KINDS[kind]; data = raw[body + 8:body + 8 + spec.size]
+                d = cache.get((op, kind, data))
+                if d is None: d = cache[(op, kind, data)] = spec.unpack(data)
+                out.append(('bind_state', spec.name, d))
+            elif op == OP_VATTR or op == OP_VSTREAM:
+                k = struct.unpack_from('<Q', raw, body)[0]; spec = nvn_state.VERTEX_ATTRIB if op == OP_VATTR else nvn_state.VERTEX_STREAM
+                data = raw[body + 8:body + 8 + k * spec.size]
+                d = cache.get((op, data))
+                if d is None: d = cache[(op, data)] = [spec.unpack(data[i * spec.size:(i + 1) * spec.size]) for i in range(k)]
+                out.append(('vattr' if op == OP_VATTR else 'vstream', d))
+            elif op == OP_DRAW:
+                el, prim, first, count, itype, ibuf, bv, bi, inst = struct.unpack_from('<2Q2q2Qq2q', raw, body)
+                if el: out.append(('draw', {'kind': 'elements', 'prim': prim, 'index_type': itype, 'count': count, 'index_buffer': ibuf, 'base_vertex': bv, 'base_instance': bi, 'instances': inst}))
+                else: out.append(('draw', {'kind': 'arrays', 'prim': prim, 'first': first, 'count': count, 'base_instance': bi, 'instances': inst}))
+            elif op == OP_TARGETS:
+                k, depth, has_dv = struct.unpack_from('<3Q', raw, body); dv_raw = raw[body + 24:body + 40]
+                ptrs, views = [], []
+                for i in range(k):
+                    ptr, has, = struct.unpack_from('<2Q', raw, body + 40 + 32 * i); vraw = raw[body + 56 + 32 * i:body + 72 + 32 * i]
+                    ptrs.append(ptr); views.append(self.view(vraw) if has else None)
+                out.append(('targets', ptrs, depth, views, self.view(dv_raw) if has_dv else None))
+            elif op == OP_STENCIL:
+                which, faces, value = struct.unpack_from('<3Q', raw, body); key = STENCIL_KEYS[which]
+                out.append(('misc', {f'{key}{f}': value for f in (1, 2) if faces & f}))
+            else: raise ValueError(f'unknown record {op} in the stream of a command buffer')
+        return out
+
+    def view(self, raw):
+        d = self.cache.get(('view', raw))
+        if d is None: d = self.cache[('view', raw)] = nvn_state.TEXTURE_VIEW.unpack(raw)
+        return d
