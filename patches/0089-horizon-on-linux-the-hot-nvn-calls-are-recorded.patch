index 91f4a8d..9decbbe 100644
--- a/dm/tools/aot_lift.py
+++ b/dm/tools/aot_lift.py
@@ -349,6 +349,12 @@ class Aot:
             cb = self.IMPORT(call); self._imports = getattr(self, '_imports', []) + [cb]   # kept alive: the library holds only the raw pointer
         return L.aot_register_import(addr, ctypes.cast(cb, ctypes.c_void_p).value if cb else None, None, name.encode())
 
+    def register_native(self, addr, fn, ctx, name):
+        """A host function written in C (a function pointer and its context, from a library loaded in this process) at a guest address: the call never reaches Python. Returns 0, or 1 when the address is taken"""
+        L = self.lib
+        L.aot_register_import.argtypes = [ctypes.c_uint64, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p]
+        return L.aot_register_import(addr, fn, ctx, name.encode())
+
     def peek(self, base, size):
         buf = ctypes.create_string_buffer(size)
         assert self.lib.aot_peek(base, buf, size) == 0
