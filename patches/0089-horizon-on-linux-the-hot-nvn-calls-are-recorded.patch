+"""nvn_rec.py / linux/host/nvnrec.c: the NVN calls recorded in C give the same commands, and change state objects to the same bytes, as the Python versions in horizon_nvn.py (random arguments, a fake guest memory)"""
+import ctypes as C
+import random, struct, sys, unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+import horizon_gpu
+import horizon_nvn as hn
+import nvn_rec
+import nvn_state
+
+LIB = horizon_gpu.library_path()
+CB, SIZE = 0x10000, 0x100000
+M64 = (1 << 64) - 1
+IMPORT = C.CFUNCTYPE(None, C.POINTER(C.c_uint64), C.c_void_p)
+
+
+class FakeHz:
+    def __init__(self, mem): self.mem, self.logs = mem, []
+    def rd(self, a, n):
+        assert 0 <= a and a + n <= len(self.mem), 'out of range'
+        return bytes(self.mem[a:a + n])
+    def wr(self, a, d): self.mem[a:a + len(d)] = d
+    def log(self, m): self.logs.append(m)
+    verbose_nvn = False
+
+
+@unittest.skipUnless(LIB, 'libnx2linux_gpu.so is not built')
+class Native(unittest.TestCase):
+    def setUp(self):
+        rnd = self.rnd = random.Random(7)
+        self.mem_py = bytearray(rnd.randbytes(SIZE)); self.mem_c = bytearray(self.mem_py)
+        self.buf = (C.c_char * SIZE).from_buffer(self.mem_c)
+        base = C.addressof(self.buf)
+        def guest(a, n): return base + a if a + n <= SIZE and n >= 0 else None
+        self.guest = C.CFUNCTYPE(C.c_void_p, C.c_uint64, C.c_uint64)(guest)
+        self.rec = nvn_rec.Recorder(C.CDLL(LIB), C.cast(self.guest, C.c_void_p))
+        self.py, self.c = hn.Nvn(FakeHz(self.mem_py)), hn.Nvn(FakeHz(self.mem_c)); self.c.rec = self.rec
+        for n in (self.py, self.c): n.get(CB)['cmds'] = []
+        self.rec.reset(CB)
+        # tables the calls read: target pointers, view pointers
+        for mem in (self.mem_py, self.mem_c):
+            struct.pack_into('<4Q', mem, 0x20000, 0x30000, 0x30100, 0x30200, 0x30300)
+            struct.pack_into('<4Q', mem, 0x21000, 0x22000, 0, 0x22040, 0x22080)
+
+    def native(self, name):
+        fn, ctx = self.rec.native(name)
+        return C.cast(fn, IMPORT), ctx
+
+    def call_c(self, name, args):
+        fn, ctx = self.native(name)
+        regs = (C.c_uint64 * 39)(*[a & M64 for a in args])
+        fn(regs, ctx)
+        return regs[0]
+
+    def call_py(self, name, args):
+        r = list(args) + [0] * (39 - len(args)); hn.IMPL[name](self.py, r); return r[0]
+
+    def both(self, name, args):
+        self.call_py(name, args); self.call_c(name, args)
+
+    def r64(self): return self.rnd.getrandbits(64)
+
+    def check(self):
+        self.assertEqual(self.c.commands(CB), self.py.commands(CB))
+
+    def test_bindings_viewports_and_programs(self):
+        for name in ('nvnCommandBufferBindUniformBuffer', 'nvnCommandBufferBindStorageBuffer', 'nvnCommandBufferBindVertexBuffer', 'nvnCommandBufferBindTexture', 'nvnCommandBufferSetViewport',
+                     'nvnCommandBufferSetScissor', 'nvnCommandBufferBindProgram', 'nvnCommandBufferSetStencilRef', 'nvnCommandBufferSetStencilMask', 'nvnCommandBufferSetStencilValueMask'):
+            for _ in range(20): self.both(name, [CB] + [self.r64() if self.rnd.random() < 0.5 else self.rnd.randrange(1 << 20) for _ in range(5)])
+        self.check()
+
+    def test_draws(self):
+        for name in ('nvnCommandBufferDrawArrays', 'nvnCommandBufferDrawArraysInstanced', 'nvnCommandBufferDrawElements', 'nvnCommandBufferDrawElementsBaseVertex', 'nvnCommandBufferDrawElementsInstanced'):
+            for _ in range(20): self.both(name, [CB] + [self.r64() if self.rnd.random() < 0.5 else self.rnd.randrange(1 << 20) for _ in range(7)])
+        self.check()
+
+    def test_state_objects_and_vertex_arrays(self):
+        for kind in ('Blend', 'Color', 'ChannelMask', 'Multisample', 'Polygon', 'DepthStencil'):
+            for _ in range(5): self.both(f'nvnCommandBufferBind{kind}State', [CB, 0x40000 + 64 * self.rnd.randrange(100)])
+        for name in ('nvnCommandBufferBindVertexAttribState', 'nvnCommandBufferBindVertexStreamState'):
+            for k in (0, 1, 3, 16, 17, 100): self.both(name, [CB, k, 0x50000 + 8 * self.rnd.randrange(100)])
+        self.check()
+
+    def test_render_targets(self):
+        for k, views, dview in ((0, 0, 0), (1, 0, 0), (2, 0x21000, 0x23000), (4, 0x21000, 0), (3, 0, 0x23040)):
+            self.both('nvnCommandBufferSetRenderTargets', [CB, k, 0x20000, views, self.r64(), dview])
+        self.check()
+
+    def test_the_order_of_commands_from_python_and_c_is_kept(self):
+        self.call_c('nvnCommandBufferSetViewport', [CB, 1, 2, 3, 4])
+        hn.rec(self.c, [CB], 'misc', {'x': 1})
+        self.call_c('nvnCommandBufferSetScissor', [CB, 5, 6, 7, 8])
+        self.assertEqual([c[0] for c in self.c.commands(CB)], ['viewports', 'misc', 'scissors'])
+
+    def test_every_setter_changes_the_struct_as_python_does(self):
+        for kind, setters in nvn_rec.NATIVE_SETTERS.items():
+            spec = nvn_state.OBJECTS[kind][0]
+            for name in setters:
+                for i in range(30):
+                    addr = 0x60000 + 32 * i
+                    args = [addr] + [self.rnd.choice((0, 1, 2, 3, 0xFF, 0x100, 0x1F, 0x20, self.r64())) for _ in range(5)]
+                    for mem in (self.mem_py, self.mem_c): mem[addr:addr + spec.size] = spec.pack(spec.default()) if i % 2 else bytes(spec.size)
+                    self.both(f'nvn{kind}{name}', args)
+                    self.assertEqual(self.mem_py[addr:addr + spec.size], self.mem_c[addr:addr + spec.size], f'{kind}{name} {args}')
+
+    def test_texture_handles_and_the_counts(self):
+        self.assertEqual(self.call_c('nvnDeviceGetTextureHandle', [0, 5, 7]), self.call_py('nvnDeviceGetTextureHandle', [0, 5, 7]))
+        self.assertEqual(self.call_c('nvnDeviceGetTexelFetchHandle', [0, 0x1_0000_0005]), self.call_py('nvnDeviceGetTexelFetchHandle', [0, 0x1_0000_0005]))
+        self.assertEqual(self.rec.counts()['nvnDeviceGetTextureHandle'], 1)
+
+
+if __name__ == '__main__': unittest.main()
