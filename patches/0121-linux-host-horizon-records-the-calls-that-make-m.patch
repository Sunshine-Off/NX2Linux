index fa87b7e6..8a33add1 100644
--- a/dm/tools/aot_report.py
+++ b/dm/tools/aot_report.py
@@ -35,6 +35,22 @@ def derived(static, runtime, seconds):
     return out
 
 
+def jit_targets(log, ranges, top=20):
+    """Where the JIT was entered, from Aot.jit_log() ("#seq pc=0x... kind count=N" per target and kind) and the (start, end) of every module image: targets inside a module are functions Remill did not lift (or an
+    address the AOT table did not hold), targets outside every module are code that was generated at run time. Addresses and counts only"""
+    inside, outside = {}, {}
+    for line in log.splitlines():
+        parts = line.split()
+        try:
+            pc = int(parts[1].split('=')[1], 16); kind = parts[2]; count = int(parts[3].split('=')[1])
+        except (IndexError, ValueError): continue
+        where = inside if any(a <= pc < b for a, b in ranges) else outside
+        where[pc, kind] = where.get((pc, kind), 0) + count
+    def rows(d): return [dict(pc=hex(pc), kind=kind, count=n) for (pc, kind), n in sorted(d.items(), key=lambda kv: -kv[1])[:top]]
+    return dict(targets_in_modules=len(inside), entries_in_modules=sum(inside.values()), targets_outside_modules=len(outside), entries_outside_modules=sum(outside.values()),
+                top_in_modules=rows(inside), top_outside_modules=rows(outside))
+
+
 def build(static, runtime=None, *, seconds=None, frames=None, jit=False, extra=None):
     """The report: static is survey.classify's dict (plus modules, cache hits and misses), runtime the counters (None for a build with no run)"""
     rep = {'format': f'nx2linux-aot-report/{VERSION}', 'jit': bool(jit), 'static': static}
@@ -74,6 +90,13 @@ def text(rep):
         d = rep['derived']
         lines.append('  aot function share ' + ('n/a' if d['aot_function_share'] is None else f"{d['aot_function_share']:.4%}") + ', fallback share of indirect transfers ' +
                      ('n/a' if d['fallback_share_of_indirect_transfers'] is None else f"{d['fallback_share_of_indirect_transfers']:.4%}"))
+    ex = rep.get('extra') or {}
+    if 'dynamic_code' in ex:
+        d = ex['dynamic_code']
+        lines.append(f"  calls that make memory executable: {d['executable_requests']} " + ('(' + ', '.join(f'{k} {v}' for k, v in d['counts'].items()) + ')' if d['counts'] else '(none)'))
+    if 'jit_targets' in ex:
+        j = ex['jit_targets']
+        lines.append(f"  JIT entered at {j['targets_in_modules']} places inside the modules ({j['entries_in_modules']} entries) and {j['targets_outside_modules']} outside them ({j['entries_outside_modules']} entries: generated code)")
     return '\n'.join(lines)
 
 
