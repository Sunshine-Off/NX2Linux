diff --git a/dm/tools/tests/test_aot_dynamic_code.py b/dm/tools/tests/test_aot_dynamic_code.py
new file mode 100644
index 00000000..47538d71
--- /dev/null
+++ b/dm/tools/tests/test_aot_dynamic_code.py
@@ -0,0 +1,169 @@
+"""Generated and self-modifying code (NX2Linux Phase 2, #17): what the JIT fallback and the Horizon layer do when a program writes code and runs it, tested on fixtures (no game data).
+  · across threads: a thread that has run generated code sees the new code after ANOTHER thread rewrote it, by a store of guest code or by the harness (hypotheses.md H15 was fixed in T5 and nothing
+    tested it across threads: `blocages-connus.md` item 5 still lists it as open)
+  · the cache maintenance sequence a JIT emits after writing code (dc cvau, dsb, ic ivau, dsb, isb) runs
+  · horizon_hle records the calls that make memory executable (SetMemoryPermission with X, code memory), and aot_report classifies where the JIT was entered: inside the modules, or outside them (generated code)
+The first group needs REMILL_BUILD, DYNARMIC_DIR, clang++ and unicorn, and is skipped otherwise. The others need nothing."""
+import io, struct, sys, threading, types, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import aot_report as ar
+import horizon_hle as hh
+
+
+class CodeRequests(unittest.TestCase):
+    def make(self):
+        ms = types.SimpleNamespace(aot=types.SimpleNamespace(regions=[(0, 0x4000, b'')], lib=None), modules=[], TLS=0x1000, STOP=0xFFFF0000)
+        return hh.Horizon(ms, out=io.StringIO())
+
+    def call(self, hz, num, *args):
+        r = [0] * 31
+        for i, a in enumerate(args): r[i] = a
+        hz.svc(num, r, 0x4000 + num)
+        return r
+
+    def test_a_permission_with_the_x_bit_is_a_request_for_executable_memory_and_one_without_is_not(self):
+        hz = self.make()
+        self.call(hz, 0x02, 0x10000, 0x1000, 3)   # SetMemoryPermission, read and write
+        self.call(hz, 0x02, 0x20000, 0x1000, 5)   # read and execute
+        s = hz.code_summary()
+        self.assertEqual(s['counts'], {'SetMemoryPermission': 1, 'SetMemoryPermission (X)': 1}); self.assertEqual(s['executable_requests'], 1)
+        self.assertEqual([q['executable'] for q in hz.code_requests], [False, True])
+
+    def test_code_memory_calls_are_named_counted_and_still_refused_as_before(self):
+        hz = self.make()
+        # CreateCodeMemory(addr, size), ControlCodeMemory(handle, op, addr, size, perm), MapProcessCodeMemory(process, dst, src, size), SetProcessMemoryPermission(process, addr, size, perm)
+        for num, name, args in ((0x4b, 'CreateCodeMemory', (0x10000, 0x1000)), (0x4c, 'ControlCodeMemory', (0xD000, 0, 0x30000, 0x1000, 5)), (0x77, 'MapProcessCodeMemory', (0xD001, 0x40000, 0x10000, 0x1000)),
+                                (0x73, 'SetProcessMemoryPermission', (0xD001, 0x40000, 0x1000, 5))):
+            r = self.call(hz, num, *args)
+            self.assertEqual(r[0], hh.R_NOT_IMPLEMENTED, name)   # naming them changed nothing for the game: they were unhandled and still are
+            self.assertEqual(hz.stats[name], 1)
+        self.assertEqual(hz.unhandled, {'CreateCodeMemory': 1, 'ControlCodeMemory': 1, 'MapProcessCodeMemory': 1, 'SetProcessMemoryPermission': 1})
+        self.assertEqual(hz.code_summary()['counts'], {'CreateCodeMemory': 1, 'ControlCodeMemory (X)': 1, 'MapProcessCodeMemory': 1, 'SetProcessMemoryPermission (X)': 1})
+
+    def test_an_svc_that_has_nothing_to_do_with_code_is_not_recorded_and_an_unknown_one_stays_unnamed(self):
+        hz = self.make()
+        self.call(hz, 0x3F, 1, 2, 3)
+        self.assertEqual((hz.code_summary()['counts'], hz.unhandled), ({}, {'svc0x3f': 1}))
+
+    def test_the_record_is_bounded_and_keeps_only_addresses_and_numbers(self):
+        hz = self.make()
+        for i in range(500): self.call(hz, 0x02, 0x10000 + i * 0x1000, 0x1000, 5)
+        self.assertEqual(len(hz.code_requests), 200); self.assertEqual(hz.code_counts['SetMemoryPermission (X)'], 500)
+        first = hz.code_summary()['first']
+        self.assertEqual(len(first), 10); self.assertTrue(all(isinstance(v, str) for v in first[0]['args'])); self.assertEqual(set(first[0]), {'svc', 'site', 'args', 'executable'})
+
+    def test_the_first_call_of_each_kind_is_logged_once(self):
+        hz = self.make()
+        for _ in range(3): self.call(hz, 0x02, 0x10000, 0x1000, 5)
+        self.assertEqual(hz.out.getvalue().count('[dyncode] SetMemoryPermission'), 1); self.assertIn('asks for executable memory', hz.out.getvalue())
+
+
+class JitTargets(unittest.TestCase):
+    LOG = ('#1 pc=0x8001000 jump count=3\n#2 pc=0x8001000 call count=2\n#3 pc=0x9000040 call count=7\n#4 pc=0xa0000000 call count=5\n#5 pc=0xa0000010 jump count=1\n'
+           'not a log line\n#6 pc=zz call count=4\n')
+
+    def test_targets_inside_a_module_and_outside_every_module_are_counted_apart(self):
+        j = ar.jit_targets(self.LOG, [(0x8000000, 0x9000000)])
+        self.assertEqual((j['targets_in_modules'], j['entries_in_modules']), (2, 5))
+        self.assertEqual((j['targets_outside_modules'], j['entries_outside_modules']), (3, 13))
+        self.assertEqual(j['top_outside_modules'][0], dict(pc='0x9000040', kind='call', count=7))   # biggest first
+        self.assertEqual([r['count'] for r in j['top_in_modules']], [3, 2])
+
+    def test_no_module_means_everything_is_outside_and_an_empty_log_means_nothing(self):
+        self.assertEqual(ar.jit_targets(self.LOG, [])['targets_in_modules'], 0)
+        j = ar.jit_targets('', [(0, 1)])
+        self.assertEqual((j['entries_in_modules'], j['entries_outside_modules'], j['top_outside_modules']), (0, 0, []))
+
+    def test_the_list_is_cut_to_the_top(self):
+        log = ''.join(f'#{i} pc={0xb0000000 + 4 * i:#x} call count={i + 1}\n' for i in range(50))
+        self.assertEqual(len(ar.jit_targets(log, [], top=5)['top_outside_modules']), 5)
+
+    def test_the_report_text_says_both(self):
+        s = {'functions': 5, 'lifted': 4, 'replaced': 0, 'jit_fallback': 1, 'not_translated': 0}
+        rep = ar.build(s, {'indirect_calls': 1, 'indirect_jumps': 0, 'fallback_requests': 0}, seconds=1, jit=True,
+                       extra={'dynamic_code': {'counts': {'SetMemoryPermission (X)': 2}, 'executable_requests': 2, 'first': []}, 'jit_targets': ar.jit_targets(self.LOG, [(0x8000000, 0x9000000)])})
+        t = ar.text(rep)
+        self.assertIn('calls that make memory executable: 2 (SetMemoryPermission (X) 2)', t); self.assertIn('2 places inside the modules (5 entries) and 3 outside them (13 entries: generated code)', t)
+        none = ar.text(ar.build(s, {'indirect_calls': 0, 'indirect_jumps': 0, 'fallback_requests': 0}, seconds=1, jit=True, extra={'dynamic_code': {'counts': {}, 'executable_requests': 0, 'first': []}}))
+        self.assertIn('(none)', none)
+
+
+try:
+    import test_aot_jit as tj
+    JIT_READY = tj.READY
+except ImportError: tj, JIT_READY = None, False
+
+
+@unittest.skipUnless(JIT_READY, 'needs REMILL_BUILD, DYNARMIC_DIR, clang++ and unicorn')
+class AcrossThreads(unittest.TestCase):
+    """The fixtures of test_aot_jit: SLOT holds generated code (`nop ; ret`), `indirect` calls the address in x1, PATCHME stores the word x1 at [x0] and calls it"""
+    def setUp(self):
+        self.a = tj.make(('indirect',))
+
+    def tearDown(self): self.a.close()
+
+    def call_slot(self):
+        r = self.a.run(tj.RANGES['indirect'][0], {'x1': tj.SLOT, 'x2': tj.RETONLY, 'x30': tj.ref.STOP}, 0, tj.SP)
+        self.assertNotIn('fault', r); return r['x0']
+
+    def rewrite_by_guest_code(self, word):
+        r = self.a.run(tj.PATCHME, {'x0': tj.SLOT, 'x1': word, 'x30': tj.ref.STOP}, 0, tj.SP)
+        self.assertNotIn('fault', r); return r['x0']
+
+    def test_a_thread_that_ran_the_generated_code_sees_it_after_another_thread_rewrote_it_with_a_store(self):
+        """thread A runs SLOT (so its own JIT holds it), thread B rewrites it by guest code, A runs it again: the round trip is repeated, with both orders of the words"""
+        a_ready, b_done, a_saw = threading.Event(), threading.Event(), []
+        words = [tj.fx.MOVZ(0, v) for v in (7, 9, 7, 300, 1, 2)]
+        errors = []
+        def thread_a():
+            try:
+                for _ in words:
+                    a_ready.set(); b_done.wait(30); b_done.clear()
+                    a_saw.append(self.call_slot())
+            except Exception as e: errors.append(e)
+        def thread_b():
+            try:
+                for w in words:
+                    a_ready.wait(30); a_ready.clear()
+                    self.rewrite_by_guest_code(w)
+                    b_done.set()
+            except Exception as e: errors.append(e)
+        # A runs the first version before any rewrite so that its code cache holds it
+        self.assertEqual(self.call_slot(), 0)
+        ta, tb = threading.Thread(target=thread_a), threading.Thread(target=thread_b)
+        ta.start(); tb.start(); ta.join(60); tb.join(60)
+        self.assertEqual(errors, []); self.assertEqual(a_saw, [7, 9, 7, 300, 1, 2], 'a thread ran stale code after another thread rewrote it')
+        self.assertGreaterEqual(self.a.stat('jit_invalidations'), len(words))
+
+    def test_a_rewrite_by_the_harness_reaches_a_thread_that_already_ran_the_code(self):
+        seen = []
+        self.assertEqual(self.call_slot(), 0)
+        def other():
+            for imm in (11, 12, 13): seen.append(self.call_slot())
+        for imm in (11, 12, 13):
+            self.a.lib.aot_poke(tj.SLOT, struct.pack('<I', tj.fx.MOVZ(0, imm)), 4)
+            t = threading.Thread(target=lambda: seen.append(self.call_slot())); t.start(); t.join(30)
+        self.assertEqual(seen, [11, 12, 13])
+
+    def test_the_cache_maintenance_sequence_a_jit_emits_runs_and_the_code_it_covers_is_the_new_code(self):
+        """dc cvau, dsb ish, ic ivau, dsb ish, isb after the store, as an emitter of generated code writes it: it must run in the JIT and leave the new code in place"""
+        import test_aot_simd as ts, tempfile
+        with tempfile.TemporaryDirectory() as tmp:
+            (w,) = ts.assemble(['str w1, [x0]; dc cvau, x0; dsb ish; ic ivau, x0; dsb ish; isb; stp x29, x30, [sp, #-16]!; blr x0; ldp x29, x30, [sp], #16'], tmp)
+        code = struct.pack('<%dI' % len(w), *w)
+        base = 0x600
+        img = bytearray(tj.IMG); img[base:base + len(code)] = code
+        a = tj.aot_lift.Aot([(tj.RANGES['indirect'][0], tj.IMG[tj.RANGES['indirect'][0]:tj.RANGES['indirect'][1]])], jit=True)
+        try:
+            for b, data in tj.MEM.items(): a.map(b, len(data), data)
+            a.map(0, len(img), bytes(img))
+            for imm in (21, 22, 23):
+                r = a.run(base, {'x0': tj.SLOT, 'x1': tj.fx.MOVZ(0, imm), 'x30': tj.ref.STOP}, 0, tj.SP)
+                self.assertNotIn('fault', r); self.assertEqual(r['x0'], imm)
