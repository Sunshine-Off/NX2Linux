+# The calls through which a program makes memory it wrote executable: how generated code (a JIT, a decompressed or patched function) reaches the machine. Counted and recorded by Horizon.svc, so that "does the
+# game generate code" is read from a run (issue #17). name -> the argument that is a permission and the operation that sets it (None: every call counts: it creates or maps code memory)
+CODE_SVCS = {'SetMemoryPermission': 2, 'SetProcessMemoryPermission': 3, 'ControlCodeMemory': 4, 'CreateCodeMemory': None, 'MapProcessCodeMemory': None, 'UnmapProcessCodeMemory': None}
+PERM_X = 4
+
+
 # MemoryType values QueryMemory reports (the ones a game checks)
 MT_UNMAPPED, MT_CODE, MT_CODE_DATA, MT_NORMAL, MT_STACK, MT_HEAP = 0, 3, 4, 5, 11, 5
 PERM_NONE, PERM_R, PERM_RW, PERM_RX = 0, 1, 3, 5
@@ -122,6 +129,7 @@ class Horizon:
         self.services = {}      # sm: name -> factory(hz) -> Service
         self.named_ports = {}   # ConnectToNamedPort names -> factory
         self.stats, self.unhandled, self.start = {}, {}, time.monotonic()
+        self.code_requests, self.code_counts = [], {}   # calls that make memory executable or create code memory (CODE_SVCS): the first 200, and a count by name
         self.stop_reason = None
         self.verbose_nvn = bool(os.environ.get('NX2LINUX_NVN_LOG'))
         self.display_factory = None   # () -> horizon_display.Display, called when the game first presents a frame
@@ -236,10 +244,25 @@ class Horizon:
             if name == stop_after: return dict(r, step=name)
         return dict(r, step='nnMain')
 
+    def note_code_request(self, name, r, orig):
+        """Record a call that may make memory executable. executable: the permission it asks for has the X bit (SetMemoryPermission, SetProcessMemoryPermission, ControlCodeMemory), or it creates or maps code memory.
+        Only addresses, sizes, permissions and the address of the calling instruction are kept"""
+        arg = CODE_SVCS[name]
+        executable = True if arg is None else bool(r[arg] & PERM_X)
+        key = name + (' (X)' if executable and arg is not None else '')
+        self.code_counts[key] = self.code_counts.get(key, 0) + 1
+        if len(self.code_requests) < 200: self.code_requests.append(dict(svc=name, site=orig, args=[r[i] for i in range(5)], executable=executable))
+        if self.code_counts[key] == 1: self.log(f'[dyncode] {name}({", ".join(hex(r[i]) for i in range(5))}) at {orig:#x}' + (': asks for executable memory' if executable else ''))
+
+    def code_summary(self):
+        """{svc name: count} (X marks the calls asking for executable permission), the number of calls that made memory executable, and the first few calls"""
+        return dict(counts=dict(self.code_counts), executable_requests=sum(1 for q in self.code_requests if q['executable']), first=[dict(q, args=[hex(a) for a in q['args']], site=hex(q['site'])) for q in self.code_requests[:10]])
+
     # ---- the SVC entry ----
     def svc(self, num, r, orig):
         name = SVC_NAMES.get(num, f'svc{num:#x}')
         self.stats[name] = self.stats.get(name, 0) + 1
+        if name in CODE_SVCS: self.note_code_request(name, r, orig)
         f = getattr(self, f'svc_{name}', None)
         if f is None:
             self.unhandled[name] = self.unhandled.get(name, 0) + 1
