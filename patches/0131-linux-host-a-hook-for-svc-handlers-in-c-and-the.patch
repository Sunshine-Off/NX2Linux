     aot_unregister_imports();
+    for (SvcNativeEnt &e : g_svc_native) e.fn.store(nullptr);   // the native service handlers go with the regions, like the imports
     std::lock_guard<std::mutex> g(g_regions_mu);
     for (unsigned i = 0, n = g_nregions.load(); i < n; i++) { const Region &r = g_regions[i]; const uint64_t lo = r.base & ~(PAGE - 1), hi = (r.base + (r.size.load() ? r.size.load() : 1) + PAGE - 1) & ~(PAGE - 1); mmap(nx2_gbase + lo, hi - lo, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0); g_regions[i].size = 0; g_regions[i].host = nullptr; }
