@@ -0,0 +1,121 @@
+"""The switch and the loader of the native synchronisation calls (horizon_sync.py, issue 19, step a1) and Horizon.bind. No game and no Remill: a Horizon on a fake guest memory, and the real libnx2linux_sync.so
+when it is built (cmake -S linux/host -B ~/.cache/nx2linux/build-host, or NX2LINUX_SYNC_LIB), else those tests are skipped."""
+import ctypes as C, io, os, sys, tempfile, threading, types, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent)); sys.path.insert(0, str(HERE))
+import horizon_hle as hh
+import horizon_sync as hs
+from test_horizon_hle import FakeAot
+
