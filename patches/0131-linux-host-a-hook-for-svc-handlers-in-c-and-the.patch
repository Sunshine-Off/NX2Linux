diff --git a/dm/tools/horizon_sync.py b/dm/tools/horizon_sync.py
new file mode 100644
index 00000000..0121e042
--- /dev/null
+++ b/dm/tools/horizon_sync.py
@@ -0,0 +1,69 @@
+"""The kernel synchronisation calls in C (NX2Linux Phase 3, issue 19): the loader of linux/host/svcsync.c (libnx2linux_sync.so) and the one place where the host tells it which logical thread a host thread acts for.
+NX2LINUX_SVC_NATIVE=1 asks for the C path, anything else (the default) keeps every call in Python. The value is read once, when the run attaches, and never changes during a run: a thread parked on the Python side would never be woken
+by a signal sent on the C side, so the two paths must not mix. A library that is not built, or that does not fit this host, leaves the Python path and says so. NX2LINUX_SYNC_LIB names the library
+(default ~/.cache/nx2linux/build-host/libnx2linux_sync.so, where `cmake -S linux/host -B ~/.cache/nx2linux/build-host` puts it).
+Step a1: the library answers no call yet, so a run with the switch on behaves exactly as with it off."""
+import ctypes as C
+import os
+from pathlib import Path
+
+ABI = 1
+
+
+def library_path(environ=None):
+    env = os.environ if environ is None else environ
+    p = env.get('NX2LINUX_SYNC_LIB') or str(Path.home() / '.cache/nx2linux/build-host/libnx2linux_sync.so')
+    return p if os.path.exists(p) else None
+
+
+def requested(environ=None):
+    """True, False, or None when the value is not 0 or 1 (the run then stays on Python and says so)"""
+    v = (os.environ if environ is None else environ).get('NX2LINUX_SVC_NATIVE', '0').strip()
+    return {'0': False, '1': True}.get(v)
+
+
+class Native:
+    """The loaded library, bound to one Horizon. `calls` are the svc numbers it took over"""
+    def __init__(self, hz, lib, path):
+        self.hz, self.lib, self.path, self.calls = hz, lib, path, []
+        lib.nx2sync_bind.argtypes = [C.c_uint32, C.c_uint32]; lib.nx2sync_bind.restype = C.c_int
+        lib.nx2sync_current.argtypes = []; lib.nx2sync_current.restype = C.c_uint32
+        lib.nx2sync_handles.argtypes = [C.c_int]; lib.nx2sync_handles.restype = C.c_int
+        lib.nx2sync_abi.argtypes = []; lib.nx2sync_abi.restype = C.c_int
+
+    def bind(self, thread):
+        """The calling host thread acts for this logical thread (a KThread), or for the main thread when None"""
+        t = thread or self.hz.main_thread_obj
+        self.lib.nx2sync_bind(t.tid, getattr(t, 'handle', 0) or 0)
+
+
+def install(hz, environ=None):
+    """Called by Horizon.attach before the guest runs. Returns the Native bound to hz, or None when the calls stay in Python"""
+    want = requested(environ)
+    if want is None:
+        hz.log(f'[svc] NX2LINUX_SVC_NATIVE={(os.environ if environ is None else environ).get("NX2LINUX_SVC_NATIVE")!r} is not 0 or 1: the synchronisation calls stay in Python')
+        return None
+    if not want: return None
+    path = library_path(environ)
+    if not path:
+        hz.log('[svc] NX2LINUX_SVC_NATIVE=1 but libnx2linux_sync.so is not built (cmake -S linux/host -B ~/.cache/nx2linux/build-host && cmake --build ~/.cache/nx2linux/build-host): the synchronisation calls stay in Python')
+        return None
+    try:
+        lib = C.CDLL(path)
+        lib.nx2sync_abi.restype = C.c_int
+        if lib.nx2sync_abi() != ABI: raise OSError(f'interface {lib.nx2sync_abi()}, this host wants {ABI}')
+        aot = hz.aot.lib
+        lib.nx2sync_init.argtypes = [C.c_void_p, C.c_void_p]; lib.nx2sync_init.restype = C.c_int
+        if lib.nx2sync_init(C.cast(aot.aot_peek, C.c_void_p).value, C.cast(aot.aot_cas32, C.c_void_p).value): raise OSError('init failed')
+        n = Native(hz, lib, path)
+        fn = C.cast(lib.nx2sync_svc, C.c_void_p).value
+        for num in range(256):
+            if lib.nx2sync_handles(num):
+                if hz.aot.register_native_svc(num, fn, None): raise OSError(f'svc {num:#x} is taken')
+                n.calls.append(num)
+    except (OSError, AttributeError) as e:
+        hz.log(f'[svc] cannot use {path}: {e}. The synchronisation calls stay in Python')
+        return None
+    hz.log(f'[svc] native synchronisation: {len(n.calls)} kernel calls in C ({path})')
+    n.bind(None)   # the thread that boots the game is the main thread
+    return n
