index 1f7c670c..b02af8a1 100644
--- a/dm/tools/aot_runtime.h
+++ b/dm/tools/aot_runtime.h
@@ -33,6 +33,12 @@ extern AotFallback aot_fallback;
 // Its return value is not used: a service answers in the registers, as on the console. Without a handler an svc is an explicit error.
 typedef uint64_t (*AotSvcHandler)(int num, uint64_t *regs, uint64_t orig_addr);
 extern AotSvcHandler aot_svc_handler;
+// Native service handlers (issue 19): an svc number may have a handler written in C that runs before aot_svc_handler. It answers 1 when it did the call (the registers are the results, as for the Python handler)
+// and 0 when it did not, and then nothing has changed and aot_svc_handler runs as if it were not there. Registered before the guest runs, then only read. Both the AOT code and the JIT code go through aot_svc_dispatch.
+#define AOT_SVC_MAX 256
+typedef int (*AotSvcNative)(int num, uint64_t *regs, uint64_t orig_addr, void *ctx);
+int aot_register_svc_native(int num, AotSvcNative fn, void *ctx);   // 0, or 1 when num is out of range or already has a handler. fn null removes the handler
+void aot_svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr);
 // Imports of a loaded module (elf_module.py): an address in guest space that is no code but a host function, as the GOT of a module points at the HLE functions of the real loader. Calling it
 // (blr, br, or a call from JIT code) runs fn(regs, ctx) with x0..x30 (it writes its answers back there); fn null: the import is unresolved and calling it is an explicit error naming it.
 typedef void (*AotImportFn)(uint64_t *regs, void *ctx);
