diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index afe8a3aa..e9abee6e 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -275,6 +275,25 @@ Memory *__remill_jump(State &st, uint64_t pc, Memory *m) {   // br: a tail call,
 
 // svc: Remill lifts it to an asynchronous hyper call carrying the number; the registers go to the Horizon service handler (the shape of svc_dispatch) and its results come back into them
 AotSvcHandler aot_svc_handler;
+namespace { struct SvcNativeEnt { std::atomic<AotSvcNative> fn; void *ctx; }; SvcNativeEnt g_svc_native[AOT_SVC_MAX]; std::mutex g_svc_native_mu; }
+extern "C" {
+int aot_register_svc_native(int num, AotSvcNative fn, void *ctx) {
+    if ((unsigned)num >= AOT_SVC_MAX) return 1;
+    std::lock_guard<std::mutex> g(g_svc_native_mu);
+    SvcNativeEnt &e = g_svc_native[num];
+    if (!fn) { e.fn.store(nullptr, std::memory_order_release); return 0; }
+    if (e.fn.load()) return 1;
+    e.ctx = ctx; e.fn.store(fn, std::memory_order_release);   // the context first: a reader that sees fn sees it
+    return 0;
+}
+void aot_svc_dispatch(int num, uint64_t *regs, uint64_t at) {
+    if ((unsigned)num < AOT_SVC_MAX) {
+        SvcNativeEnt &e = g_svc_native[num];
+        if (AotSvcNative f = e.fn.load(std::memory_order_acquire)) { if (f(num, regs, at, e.ctx)) return; }
+    }
+    aot_svc_handler(num, regs, at);
+}
+}
