+
+class Native:
+    """A service handler in C for svc 0x2A (here a ctypes callback: what a library's function pointer is to the runtime). It answers x0 * 5 and x1 = 0x77, or declines"""
+    def __init__(self, a, answer=True):
+        self.a, self.answer, self.calls = a, answer, []
+        def fn(num, regs, orig, ctx):
+            self.calls.append((num, orig, regs[0], ctx))
+            if not self.answer: return 0
+            regs[0] = (regs[0] * 5) & M; regs[1] = 0x77
+            return 1
+        self.cb = a.SVC_NATIVE(fn)   # kept alive: the runtime holds only the raw pointer
+    def register(self, num=0x2A, ctx=0x1234): return self.a.register_native_svc(num, ctypes.cast(self.cb, ctypes.c_void_p).value, ctx)
+    def remove(self, num=0x2A): return self.a.register_native_svc(num, None)
+
+
+class NativeSvcChecks:
+    """What a native service handler promises, in AOT code and in JIT code. Needs self.a, self.h and self.call(regs) -> result of the guest function that makes svc 0x2A"""
+    def tearDown(self): self.a.register_native_svc(0x2A, None)
+
+    def test_a_native_handler_that_answers_replaces_the_python_one(self):
+        n = Native(self.a); self.assertEqual(n.register(), 0)
+        got = self.call({'x0': 6, 'x1': 1})
+        self.assertEqual((got['x0'], got['x1']), (30, 0x77))
+        self.assertEqual(self.h.log, [])   # the Python handler never ran
+        self.assertEqual(len(n.calls), 1); self.assertEqual(n.calls[0][0], 0x2A); self.assertEqual(n.calls[0][3], 0x1234)   # the number, the context
+        self.assertGreater(self.a.stat('svc_calls'), 0)
+
+    def test_a_native_handler_that_declines_leaves_the_call_to_python_unchanged(self):
+        want = self.call({'x0': 6, 'x1': 1}); self.assertEqual(self.h.log, [(0x2A, self.entry, 6)])   # no native yet: the Python result
+        n = Native(self.a, answer=False); n.register()
+        got = self.call({'x0': 6, 'x1': 1})
+        self.assertEqual(len(n.calls), 1)
+        self.assertEqual({k: got[k] for k in ('x0', 'x1')}, {k: want[k] for k in ('x0', 'x1')})
+        self.assertEqual(self.h.log, [(0x2A, self.entry, 6)])
+
+    def test_the_handler_is_per_number(self):
+        n = Native(self.a); n.register(0x2B)
+        got = self.call({'x0': 6, 'x1': 1})
+        self.assertEqual(n.calls, []); self.assertEqual(self.h.log, [(0x2A, self.entry, 6)])
+        self.a.register_native_svc(0x2B, None)
+
+    def test_removing_it_gives_the_call_back_to_python(self):
+        n = Native(self.a); n.register(); self.call({'x0': 1}); self.assertEqual(self.h.log, [])
+        self.assertEqual(n.remove(), 0)
+        self.call({'x0': 1}); self.assertEqual(self.h.log, [(0x2A, self.entry, 1)])
+
+    def test_a_number_out_of_range_or_taken_is_refused(self):
+        n = Native(self.a)
+        self.assertEqual(n.register(256), 1); self.assertEqual(n.register(-1), 1)
+        self.assertEqual(n.register(), 0); self.assertEqual(n.register(), 1)   # the second handler for the number
+
+
+@unittest.skipUnless(READY, 'needs REMILL_BUILD, clang++ and unicorn')
+class NativeSvc(NativeSvcChecks, unittest.TestCase):
+    entry = ECHO
+    @classmethod
+    def setUpClass(cls): cls.a, cls.h = aot_lib([(ECHO, 2)])
+    @classmethod
+    def tearDownClass(cls): cls.a.close()
+    def call(self, regs): return run(self.a, self.h, ECHO, regs)
+
+    def test_closing_the_library_drops_the_handlers(self):
+        a, h = aot_lib([(ECHO, 2)]); n = Native(a); n.register()
+        a.lib.aot_unmap_all()   # what close() does first
+        self.assertEqual(n.register(), 0)   # free again
+        a.close()
+
+@unittest.skipUnless(JIT_READY, 'needs REMILL_BUILD, DYNARMIC_DIR, clang++ and unicorn')
+class NativeJitSvc(NativeSvcChecks, unittest.TestCase):
+    """The same promises when the svc is executed by the JIT: it goes through the same dispatch"""
+    entry = ECHO
+    @classmethod
+    def setUpClass(cls): cls.a, cls.h = aot_lib(['indirect'], jit=True)
+    @classmethod
+    def tearDownClass(cls): cls.a.close()
+    def call(self, regs): return run(self.a, self.h, RANGES['indirect'][0], dict(regs, x1=ECHO, x2=RETONLY))
+
 @unittest.skipUnless(JIT_READY, 'needs REMILL_BUILD, DYNARMIC_DIR, clang++ and unicorn')
