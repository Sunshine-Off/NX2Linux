+"""The game a run is for (horizon_game.py) and the coverage survey's bookkeeping (survey.py): a profile folder decides, a title without one runs on generic defaults and is flagged. No game data."""
+import io, os, sys, tempfile, types, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+
+
+def profile_folder(root, title, rows, workarounds=None):
+    d = Path(root) / title; d.mkdir()
+    (d / 'game.tsv').write_text(''.join(f'{k}\t{v}\n' for k, v in rows))
+    if workarounds: (d / 'linux_profile.py').write_text(workarounds)
+    return d
+
+
+class Profile(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(); self.old = os.environ.get('DM_GAMES_DIR')
+        os.environ['DM_GAMES_DIR'] = self.tmp.name
+        import horizon_game; self.hg = horizon_game
+
+    def tearDown(self):
+        if self.old is None: os.environ.pop('DM_GAMES_DIR', None)
+        else: os.environ['DM_GAMES_DIR'] = self.old
+        self.tmp.cleanup()
+
+    def test_a_title_without_a_profile_is_flagged_and_gets_generic_defaults(self):
+        g = self.hg.HorizonGame('0123456789abcdef')
+        self.assertFalse(g.known)
+        self.assertEqual((g.program_id, g.app_pool, g.mem_used, g.sys_resource), (0x0123456789ABCDEF, None, None, None))
+        self.assertEqual(g.modules(['sdk', 'main', 'rtld']), ['main', 'sdk'])
+        self.assertEqual(g.workarounds(), {})
+
+    def test_a_profile_decides_the_constants_and_the_module_order(self):
+        profile_folder(self.tmp.name, '0ABCDEF000000000', [('title_id', '0ABCDEF000000000'), ('name', 'Test'), ('program_id', '0ABCDEF000000001'), ('modules', 'main subsdk0 sdk'), ('app_pool', '0xCD500000'), ('sys_resource', '0x0')])
+        g = self.hg.HorizonGame('0abcdef000000000')
+        self.assertTrue(g.known)
+        self.assertEqual((g.name, g.program_id, g.app_pool, g.sys_resource, g.mem_used), ('Test', 0x0ABCDEF000000001, 0xCD500000, 0, None))
+        self.assertEqual(g.modules(['sdk', 'main']), ['main', 'subsdk0', 'sdk'])
+
+    def test_rtld_is_the_hosts_and_never_loaded(self):
+        profile_folder(self.tmp.name, '0ABCDEF000000002', [('title_id', '0ABCDEF000000002'), ('modules', 'rtld main sdk')])
+        self.assertEqual(self.hg.HorizonGame('0abcdef000000002').modules(), ['main', 'sdk'])
+
+    def test_workarounds_come_from_the_profile_folder(self):
+        profile_folder(self.tmp.name, '0ABCDEF000000003', [('title_id', '0ABCDEF000000003')], "PROFILE = {'_Z3foov': (lambda hz, r: None, 'why')}\n")
+        w = self.hg.HorizonGame('0abcdef000000003').workarounds()
+        self.assertEqual(list(w), ['_Z3foov']); self.assertEqual(w['_Z3foov'][1], 'why')
+
+    def test_getinfo_reports_the_profile(self):
+        profile_folder(self.tmp.name, '0ABCDEF000000004', [('title_id', '0ABCDEF000000004'), ('program_id', '0ABCDEF000000004'), ('app_pool', '0x40000000'), ('mem_used', '0x4000000'), ('sys_resource', '0x100000')])
+        import horizon_hle as hh
+        from test_horizon_hle import make
+        hz, aot = make(); hz.game = self.hg.HorizonGame('0abcdef000000004')
+        got = {}
+        for kind in (6, 7, 16, 18):
+            r = [0, kind, 0, 0] + [0] * 27; hz.svc_GetInfo(r); got[kind] = r[1]
+        self.assertEqual(got, {6: 0x1_0000_0000, 7: 0x2000_0000, 16: 0x100000, 18: 0x0ABCDEF000000004})   # 6 and 7: the host's own totals, whatever the profile's pool
+
+    def test_getinfo_without_a_profile_keeps_the_generic_values(self):
+        from test_horizon_hle import make
+        hz, aot = make()
+        r = [0, 18, 0, 0] + [0] * 27; hz.svc_GetInfo(r)
+        self.assertEqual(r[1], 0)   # the title of the fake run is 0
+
+
+class Survey(unittest.TestCase):
+    def test_mangled_names_give_their_namespace(self):
+        import survey
+        self.assertEqual(survey.namespace('_ZN2nn2fs4OpenEPNS0_10FileHandleEPKci'), 'nn::fs')
+        self.assertEqual(survey.namespace('_ZN5movie7Decoder4InitEv'), 'movie::Decoder')
+        self.assertEqual(survey.namespace('_ZN2nn3hid6detail3FooEv'), 'nn::hid')
+        self.assertEqual(survey.namespace('nndiagStartup'), '(c)')
+
+    def test_reasons_are_classified(self):
+        import survey
+        c = survey.reason_class
+        self.assertEqual(c('replaced by a host function'), ('replaced', ''))
+        self.assertEqual(c('function 0x10: 0x14: 0x4e287821 (aesimc v1.16b, v1.16b): Remill has no semantics for this instruction (the lifted code calls __remill_error)'), ('instruction without semantics', 'aesimc'))
+        self.assertEqual(c('function 0x826fdf0: 81288 bytes are more than the 60000 remill-lift takes'), ('too large for one lift', ''))
+        self.assertEqual(c(''), ('without a reason', ''))
+        self.assertEqual(c('something odd')[0], 'other')
+
+    def test_the_report_counts_every_function_once(self):
+        import survey
+        unlifted = {0x100: 'replaced by a host function', 0x200: 'replaced by a host function', 0x300: 'replaced by a host function',
+                    0x400: 'function 0x400: 0x404: 0x4e287821 (aesimc v1.16b, v1.16b): Remill has no semantics for this instruction', 0x500: ''}
+        by_addr = {0x100: ('_ZN2nn2fs4OpenEv', 'hand-written port'), 0x200: ('_ZN2nn3hid3FooEv', 'not ported (answers 0)'), 0x300: ('_ZN2nn2fs5CloseEv', 'hand-written port')}
+        r = survey.classify(unlifted, 1000, by_addr, jit=False)
+        self.assertEqual((r['functions'], r['lifted'], r['replaced'], r['not_translated'], r['jit_fallback'], r['without_reason']), (1000, 995, 3, 2, 0, 1))
+        self.assertEqual(r['replaced_by_origin'], {'hand-written port': 2, 'not ported (answers 0)': 1})
+        self.assertEqual(r['replaced_namespaces']['hand-written port'], {'nn::fs': 2})
+        self.assertEqual(r['instruction_details']['instruction without semantics'], {'aesimc': 1})
+        j = survey.classify(unlifted, 1000, by_addr, jit=True)
+        self.assertEqual((j['jit_fallback'], j['not_translated']), (2, 0))
+        self.assertEqual(r['lifted'] + r['replaced'] + r['not_translated'], 1000)
+
+
+if __name__ == '__main__': unittest.main()
