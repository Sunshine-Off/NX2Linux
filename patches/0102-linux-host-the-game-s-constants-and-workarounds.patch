new file mode 100644
index 0000000..3e340bf
--- /dev/null
+++ b/dm/tools/survey.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Coverage survey of a game's recompilation (NX2Linux S7bis, milestone C): for a title and its converted modules, how every function is handled and why, so that "compilable" is a count and not an impression.
+  lifted             translated to x86_64 by Remill
+  replaced           the host provides it (a hand-written port, a trivial one that does nothing or returns a constant, a "not ported" stub that answers 0, a workaround of the game's profile)
+  jit fallback       with --jit: the function Remill cannot lift (or lifts too large) runs in dynarmic
+  not translated     the rest, each with its reason: a call stops the thread with the address and the reason
+  without a reason   a function that is none of the above and has no reason recorded: this must be 0
+  unknown            the instruction classes (register numbers masked) of the modules that Remill does not lift (--census)
+Usage: survey.py --modules <dir with <name>.manifest.json> --title <id> [--romfs IMG] [--cache DIR] [--order a,b,c] [--jit] [--census] [--json OUT]
+Needs REMILL_BUILD (and DYNARMIC_DIR with --jit): the functions not in the cache are lifted. Prints addresses, counts and mnemonics only; nothing of the game's code or data."""
+import argparse, collections, json, re, sys, time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+
+def namespace(sym):
+    """The namespace a mangled Itanium name lives in, as nn::fs: '_ZN2nn2fs4OpenE...' -> 'nn::fs' (the first two components, the last being the function when the name has only two); a name that is not nested -> '(c)'"""
+    if not sym.startswith('_ZN'): return '(c)'
+    rest, parts = sym[3:].lstrip('K'), []
+    while True:
+        n = re.match(r'(\d+)', rest)
+        if not n: break
+        k = int(n.group(1)); parts.append(rest[len(n.group(1)):len(n.group(1)) + k]); rest = rest[len(n.group(1)) + k:]
+    if len(parts) > 2: parts = parts[:2]
+    elif len(parts) == 2: parts = parts[:1]   # Class::method -> the class's namespace is just the first component
+    return '::'.join(parts) if parts else '(c)'
+
+
+def reason_class(why):
+    """(class, detail) of the reason Aot recorded for a function that is not lifted"""
+    if not why: return 'without a reason', ''
+    if why == 'replaced by a host function': return 'replaced', ''
+    if 'bytes are more than' in why: return 'too large for one lift', ''
+    m = re.search(r'0x[0-9a-f]+ \(([\w.]+)[ )]', why)
+    if m and 'no semantics' in why: return 'instruction without semantics', m.group(1)
+    if m and ('decode' in why or 'not decoded' in why or 'undefined' in why): return 'instruction not decoded', m.group(1)
+    if 'does not define' in why: return 'needs a symbol the runtime lacks', ', '.join(re.findall(r'needs ([^,]+?)(?:,|, which)', why))[:80]
+    return 'other', why[:100]
+
+
+def classify(unlifted, total, by_addr, jit):
+    """The report from Aot.unlifted ({address: reason}), the number of functions and by_addr ({address: (symbol, origin)} of the replaced ones)"""
+    replaced = collections.Counter(); ns = collections.defaultdict(collections.Counter)
+    left = collections.Counter(); detail = collections.defaultdict(collections.Counter)
+    for a, why in unlifted.items():
+        cls, det = reason_class(why)
+        if cls == 'replaced':
+            sym, origin = by_addr.get(a, ('?', 'unknown origin'))
+            replaced[origin] += 1; ns[origin][namespace(sym)] += 1
+        else:
+            left[cls] += 1
+            if det: detail[cls][det] += 1
+    nleft = sum(left.values()); nrep = sum(replaced.values())
+    return {
+        'functions': total, 'lifted': total - len(unlifted), 'replaced': nrep, 'replaced_by_origin': dict(replaced),
+        'replaced_namespaces': {o: dict(c.most_common(12)) for o, c in ns.items()},
+        'jit_fallback': nleft if jit else 0, 'not_translated': 0 if jit else nleft,
+        'not_translated_by_reason': {} if jit else dict(left), 'jit_fallback_by_reason': dict(left) if jit else {},
+        'instruction_details': {k: dict(v.most_common(30)) for k, v in detail.items()},
+        'without_reason': left.get('without a reason', 0),
+    }
+
+
+def text(report):
+    r = report; lines = [f"{r['game']}: {r['functions']} functions in {', '.join(f'{k} {v}' for k, v in r['modules'].items())}"]
+    lines.append(f"  lifted          {r['lifted']:>7}")
+    lines.append(f"  replaced        {r['replaced']:>7}  " + ', '.join(f'{k} {v}' for k, v in sorted(r['replaced_by_origin'].items())))
+    for o, c in r['replaced_namespaces'].items(): lines.append(f"      {o}: " + ', '.join(f'{k} {v}' for k, v in c.items()))
+    lines.append(f"  jit fallback    {r['jit_fallback']:>7}" + ('' if r['jit'] else '  (not asked: --jit)') + (('  ' + ', '.join(f'{k} {v}' for k, v in r['jit_fallback_by_reason'].items())) if r['jit_fallback'] else ''))
+    lines.append(f"  not translated  {r['not_translated']:>7}" + (('  ' + ', '.join(f'{k} {v}' for k, v in r['not_translated_by_reason'].items())) if r['not_translated'] else ''))
+    for k, v in r['instruction_details'].items(): lines.append(f"      {k}: " + ', '.join(f'{m} {n}' for m, n in v.items()))
+    lines.append(f"  without a reason{r['without_reason']:>6}   (must be 0)")
+    if 'build_seconds' in r: lines.append(f"  built in {r['build_seconds']:.0f} s ({r['cache_hits']} cached, {r['cache_misses']} lifted now)")
+    return '\n'.join(lines)
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    p.add_argument('--modules', required=True); p.add_argument('--title', required=True); p.add_argument('--romfs')
+    p.add_argument('--order', default=''); p.add_argument('--cache', default=str(Path.home() / '.cache/nx2linux/aot-cache'))
+    p.add_argument('--jit', action='store_true'); p.add_argument('--census', action='store_true', help='also list every instruction class of the modules Remill does not lift (module_validate.py census)')
+    p.add_argument('--json', help='write the report here'); p.add_argument('--top', type=int, default=40)
+    a = p.parse_args(argv)
+    import elf_module as em, horizon_game, horizon_hle, horizon_overrides
+    game = horizon_game.HorizonGame(a.title)
+    have = sorted(q.name[:-len('.manifest.json')] for q in Path(a.modules).glob('*.manifest.json'))
+    order = a.order.split(',') if a.order else game.modules(have)
+    ms = em.ModuleSet([f'{a.modules}/{n}.manifest.json' for n in order], {})
+    hz = horizon_hle.Horizon(ms, romfs=a.romfs, title_id=a.title, game=game)
+    ovr = horizon_overrides.install(hz)
+    origin = {s: horizon_overrides.ORIGIN.get(s, 'handwritten') for s in ovr}
+    work = horizon_overrides.install_profile(hz, game.workarounds())
+    ovr.update(work); origin.update({s: 'game profile' for s in work})
+    t = time.time()
+    aot = ms.build(jit=a.jit, overrides=ovr, cache=a.cache)
+    names = {'handwritten': 'hand-written port', 'trivial': 'trivial (nothing or a constant)', 'stubbed': 'not ported (answers 0)', 'game profile': 'game profile'}
+    by_addr = {ms.exports[s]: (s, names.get(o, o)) for s, o in origin.items() if s in ms.exports}
+    total = sum(len(m.functions) + len(m.jump_targets) for m in ms.modules)
+    report = classify(aot.unlifted, total, by_addr, a.jit)
+    report.update(game=game.name, known_profile=game.known, jit=a.jit, modules={m.name: len(m.functions) for m in ms.modules},
+                  build_seconds=time.time() - t, cache_hits=aot.cache_hits, cache_misses=aot.cache_misses)
+    print(text(report))
+    if a.census:
+        import argparse as ap, module_validate as mv
+        mv.cmd_census(ap.Namespace(exefs='-', work=a.modules, module=','.join(order), top=a.top))
+    if a.json: Path(a.json).write_text(json.dumps(report, indent=1))
+    return 0
+
+
+if __name__ == '__main__': sys.exit(main())
