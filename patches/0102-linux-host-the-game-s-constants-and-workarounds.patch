diff --git a/dm/tools/horizon_game.py b/dm/tools/horizon_game.py
new file mode 100644
index 0000000..e45f9a1
--- /dev/null
+++ b/dm/tools/horizon_game.py
@@ -0,0 +1,67 @@
+"""The game a run is for (NX2Linux S7bis, milestone C): everything specific to one title comes from its profile folder dm/games/<base game title ID>/, the same folder the Mac host and the shader tools read, through dm/games/game.py
+(DM_GAMES_DIR adds folders outside the repository, e.g. the provisional profile the NSP script writes). Nothing about a game is written in the runtime.
+Keys read from game.tsv: title_id, program_id (GetInfo ProgramId), modules (load order, `rtld` is the host's), sys_resource (GetInfo SystemResourceSizeTotal). app_pool and mem_used are Mac-host partition constants: the Linux host reports its own totals (see svc_GetInfo).
+An optional linux_profile.py beside it holds the game's workarounds for the Linux host: PROFILE = {exported symbol: (fn(hz, regs), why)}, applied as the Mach host's per-game patches are.
+A title without a profile runs with generic Horizon defaults and says so (`known` is False): the run is a survey of what the game needs, not a validated game."""
+import importlib.util, sys
+from pathlib import Path
+
+GAMES = Path(__file__).resolve().parents[1] / 'games'
+if str(GAMES) not in sys.path: sys.path.insert(0, str(GAMES))
+import game as games
+
+
+def parse_title(title_id):
+    """The title ID as an integer, from 16 hex digits with or without 0x"""
+    s = str(title_id).strip().lower()
+    return int(s[2:] if s.startswith('0x') else s, 16)
+
+
+class HorizonGame:
+    DEFAULT_ORDER = ('main', 'sdk', 'subsdk0')   # only for a title with no profile: the modules the Switch SDK builds have
+
+    def __init__(self, title_id, profile=None):
+        self.title = parse_title(title_id)
+        self.profile = profile if profile is not None else games.by_title(self.title)
+
+    @classmethod
+    def load(cls, title_id): return cls(title_id)
+
+    @property
+    def known(self): return self.profile is not None
+
+    @property
+    def id(self): return f'{self.title:016x}'
+
+    @property
+    def name(self): return self.profile.get('name', self.id) if self.known else f'{self.id} (no profile)'
+
+    def _int(self, key, default=None, base=0):
+        if not self.known: return default
+        v = self.profile.get(key, '')
+        return int(v, base) if v else default
+
+    @property
+    def program_id(self): return self._int('program_id', self.title, 16)   # an ID is hexadecimal without 0x in game.tsv
+    @property
+    def app_pool(self): return self._int('app_pool')
+    @property
+    def mem_used(self): return self._int('mem_used')
+    @property
+    def sys_resource(self): return self._int('sys_resource')
+
+    def modules(self, available=()):
+        """Load order: the profile's `modules` (without rtld); with no profile, the generic order restricted to what is in `available`"""
+        order = [m for m in self.profile.words('modules', '') if m != 'rtld'] if self.known else [m for m in self.DEFAULT_ORDER if not available or m in available]
+        return order
+
+    def workarounds(self):
+        """{symbol: (fn, why)} of the profile's linux_profile.py, {} when there is none"""
+        if not self.known: return {}
+        path = self.profile.dir / 'linux_profile.py'
+        if not path.exists(): return {}
+        spec = importlib.util.spec_from_file_location(f'linux_profile_{self.id}', path)
+        mod = importlib.util.module_from_spec(spec); sys.path.insert(0, str(Path(__file__).resolve().parent))
+        try: spec.loader.exec_module(mod)
+        finally: sys.path.pop(0)
+        return dict(mod.PROFILE)
