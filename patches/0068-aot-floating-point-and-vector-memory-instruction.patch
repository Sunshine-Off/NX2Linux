+def _nan(x):
+    return ((x >> 52) & 0x7FF == 0x7FF and x & ((1 << 52) - 1)) or any((x >> sh & 0xFFFFFFFF) >> 23 & 0xFF == 0xFF and (x >> sh & 0x7FFFFF) for sh in (0, 32))
