+    [f'fcsel {r}0, {r}1, {r}2, {c}' for r in 'ds' for c in ('eq', 'ne', 'cs', 'cc', 'mi', 'pl', 'vs', 'vc', 'hi', 'ls', 'ge', 'lt', 'gt', 'le', 'al')] +
