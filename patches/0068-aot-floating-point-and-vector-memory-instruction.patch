diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index 898d333..6d90e85 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -4,6 +4,7 @@
 //     fallback (T4) takes it. A direct `bl` needs none of this: Remill lifted it into a call of sub_<address>, resolved at link time.
 //   · errors leave the lifted code by longjmp (its frames hold no destructors), and aot_run reports them as text.
 // ADDRESS_SIZE_BITS=64 and Remill's include folder are on the command line (aot_lift.py). Flag and compare intrinsics are markers whose first argument is already the value, as in remill_host.cpp.
+#include <cfenv>   // before Remill's headers: they define __FE_DENORM as a macro, which breaks glibc's own fenv.h
 #include "aot_runtime.h"
 #include <atomic>
 #include <csetjmp>
@@ -135,6 +136,16 @@ CAS(8, uint8_t) CAS(16, uint16_t) CAS(32, uint32_t) CAS(64, uint64_t)
 Memory *__remill_atomic_begin(Memory *m) { return m; }   // the CAS above is the atomic operation; these only bracket the instruction
 Memory *__remill_atomic_end(Memory *m) { return m; }
 
+// Floating-point exception flags. Remill's AArch64 semantics clear them, run the operation on the host FPU and read them back into FPSR; the masks are AArch64's FPSR bit positions
+// (invalid 1, divide by zero 2, overflow 4, underflow 8, inexact 16, input denormal 128: x86 has no flag for that last one, so it is never reported)
+static int fe_of(int32_t m) { return (m & 1 ? FE_INVALID : 0) | (m & 2 ? FE_DIVBYZERO : 0) | (m & 4 ? FE_OVERFLOW : 0) | (m & 8 ? FE_UNDERFLOW : 0) | (m & 16 ? FE_INEXACT : 0); }
+int32_t __remill_fpu_exception_test(int32_t mask) {
+    int e = fetestexcept(fe_of(mask));
+    return (e & FE_INVALID ? 1 : 0) | (e & FE_DIVBYZERO ? 2 : 0) | (e & FE_OVERFLOW ? 4 : 0) | (e & FE_UNDERFLOW ? 8 : 0) | (e & FE_INEXACT ? 16 : 0);
+}
+void __remill_fpu_exception_clear(int32_t mask) { feclearexcept(fe_of(mask)); }
+void __remill_fpu_exception_raise(int32_t mask) { feraiseexcept(fe_of(mask)); }
+
 // Barriers, each ordering what its name says on any host (free on x86 but store->load, which needs the full fence)
 Memory *__remill_barrier_load_load(Memory *m) { std::atomic_thread_fence(std::memory_order_acquire); return m; }
 Memory *__remill_barrier_load_store(Memory *m) { std::atomic_thread_fence(std::memory_order_acquire); return m; }
@@ -204,7 +215,7 @@ Memory *aot_unlifted(State *st, uint64_t pc, Memory *m, const char *why) {
 }
 
