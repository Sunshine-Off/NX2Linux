+class TargetedWakeups(unittest.TestCase):
+    """A signal wakes the threads that wait for it and no others: every thread parks on an event of its own"""
+    def call(self, hz, num, *args):
+        r = [0] * 31
+        for i, a in enumerate(args): r[i] = a
+        hz.svc(num, r, 0); return r
+
+    def run_thread(self, hz, fn):
+        import threading
+        def body(): hz.local.thread = hh.KThread(hz, 0, 0, 0, 44, 0); fn()
+        t = threading.Thread(target=body, daemon=True); t.start(); return t
+
+    def test_signal_wakes_only_the_waiters_of_that_key(self):
+        import time
+        hz, _ = make(); out = {}
+        hz.wr32(0x200, 0x22); hz.wr32(0x204, 0x23)
+        a = self.run_thread(hz, lambda: out.__setitem__('a', self.call(hz, 0x1c, 0x200, 0x300, 0x22, (1 << 64) - 1)[0]))
+        b = self.run_thread(hz, lambda: out.__setitem__('b', self.call(hz, 0x1c, 0x204, 0x310, 0x23, (1 << 64) - 1)[0]))
+        time.sleep(0.1); self.call(hz, 0x1d, 0x300, 1); a.join(2)
+        self.assertEqual(out, {'a': 0}); self.assertTrue(b.is_alive())
+        self.call(hz, 0x1d, 0x310, 1); b.join(2); self.assertEqual(out, {'a': 0, 'b': 0})
+
+    def test_wait_synchronization_returns_when_the_event_is_signaled(self):
+        import time
+        hz, aot = make(); r = self.call(hz, 0x45); w = r[1]
+        aot.mem[0x100:0x104] = struct.pack('<I', w); out = []
+        t = self.run_thread(hz, lambda: out.append(self.call(hz, 0x18, 0, 0x100, 1, (1 << 64) - 1)[:2]))
+        time.sleep(0.1); self.assertEqual(out, [])
+        self.call(hz, 0x11, w); t.join(2); self.assertEqual(out, [[0, 0]])
+        self.assertEqual(hz.handles[w].waiters, [])   # the waiter took itself off the list
+
+    def test_wait_synchronization_reports_which_of_two_events_and_times_out(self):
+        import time
+        hz, aot = make(); e1, e2 = self.call(hz, 0x45)[1], self.call(hz, 0x45)[1]
+        aot.mem[0x100:0x108] = struct.pack('<II', e1, e2); out = []
+        t = self.run_thread(hz, lambda: out.append(self.call(hz, 0x18, 0, 0x100, 2, (1 << 64) - 1)[:2]))
+        time.sleep(0.1); self.call(hz, 0x11, e2); t.join(2)
+        self.assertEqual(out, [[0, 1]])
+        r = self.call(hz, 0x18, 0, 0x100, 1, 2_000_000)   # e1 is not signaled: the wait ends by timeout
+        self.assertEqual(r[0], hh.R_TIMEOUT); self.assertEqual(hz.handles[e1].waiters, [])
+
+    def test_a_host_signal_wakes_a_waiter(self):
+        import time
+        hz, aot = make(); w = self.call(hz, 0x45)[1]; aot.mem[0x100:0x104] = struct.pack('<I', w); out = []
+        t = self.run_thread(hz, lambda: out.append(self.call(hz, 0x18, 0, 0x100, 1, (1 << 64) - 1)[0]))
+        time.sleep(0.1); hz.signal_event(hz.handles[w]); t.join(2); self.assertEqual(out, [0])
+
+    def test_an_auto_reset_event_lets_one_of_two_waiters_through(self):
+        import time
+        hz, aot = make(); e = hh.Event(auto=True); w = hz.new_handle(e); aot.mem[0x100:0x104] = struct.pack('<I', w); out = []
+        ts = [self.run_thread(hz, lambda: out.append(self.call(hz, 0x18, 0, 0x100, 1, (1 << 64) - 1)[0])) for _ in range(2)]
+        time.sleep(0.1); self.call(hz, 0x11, w); time.sleep(0.2)
+        self.assertEqual(out, [0]); self.call(hz, 0x11, w); [t.join(2) for t in ts]; self.assertEqual(out, [0, 0])
+
+
