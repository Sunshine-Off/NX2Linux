+    def park(self, me, timeout=None):
+        """Sleep until another thread wakes this one (its `wake` event) or the timeout ends, with self.cv released meanwhile; the caller holds self.cv and checks its condition again afterwards.
+        Whoever changes what a thread waits for sets that one thread's event, so a signal wakes the threads concerned and not every waiter of the process"""
+        me.wake.clear()
+        self.cv.release()
+        try: me.wake.wait(timeout)
+        finally: self.cv.acquire()
+
+    @staticmethod
+    def wake_all(threads):
+        for t in threads: t.wake.set()
