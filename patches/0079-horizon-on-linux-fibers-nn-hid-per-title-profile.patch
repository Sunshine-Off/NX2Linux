diff --git a/dm/tools/horizon_overrides.py b/dm/tools/horizon_overrides.py
index 5ec1084..5d94818 100644
--- a/dm/tools/horizon_overrides.py
+++ b/dm/tools/horizon_overrides.py
@@ -32,12 +32,34 @@ noop('_ZN2nn4pctl10InitializeEv', 'connect to the pctl parental controls service
 noop('_ZN2nn4diag34InitializeApplicationAbortObserverEv', "register with the system's abort observer; the host prints crashes itself")
 
 
+def _stub(symbol):
+    def f(hz, r):
+        n = hz.stub_calls[symbol] = hz.stub_calls.get(symbol, 0) + 1
+        if n == 1: hz.log(f'[stub] {symbol} is not ported, answers 0 (x0={r[0]:#x} x1={r[1]:#x})')
+        r[0] = 0
+    return f
+
+
+def install_profile(horizon, profile):
+    """Per-title workarounds ({symbol: (fn, why)}), logged as such, added to the table for this run"""
+    exported = set().union(*(m.exports for m in horizon.ms.modules))
+    out = {}
+    for sym, (fn, why) in profile.items():
+        if sym not in exported: horizon.log(f'[profile] {sym} is not exported by this build: skipped'); continue
+        horizon.log(f'[profile] workaround in place: {sym}: {why}')
+        out[sym] = (lambda r, f=fn: f(horizon, r))
+    return out
+
+
 def install(horizon):
     """The table as {symbol: fn(regs)} for ModuleSet.build(overrides=...); symbols the loaded modules do not export are left out (the game may not use them)"""
-    import horizon_fs, horizon_account, horizon_oe, horizon_vi, horizon_nvn   # register the nn::fs, nn::account, nn::oe, nn::vi/nv and NVN entries
+    import horizon_fs, horizon_account, horizon_oe, horizon_vi, horizon_nvn, horizon_hid, horizon_fiber   # register the nn::fs, nn::account, nn::oe, nn::vi/nv and NVN entries
     import horizon_trivial
     for sym, value, why, src in horizon_trivial.TRIVIAL:   # generated from the Mach host: entries that do nothing or return a constant; a hand-written port of the same symbol wins
         if sym in TABLE: continue
         TABLE[sym] = ((lambda hz, r: None) if value is None else (lambda hz, r, v=value: r.__setitem__(0, v)), why)
+    for sym, why, src in horizon_trivial.STUBBED:   # not ported yet: answers 0, and the first call of each is logged
+        if sym in TABLE: continue
+        TABLE[sym] = (_stub(sym), f'not ported from {src}: answers 0 ({why})')
     exported = set().union(*(m.exports for m in horizon.ms.modules))
     return {sym: (lambda r, f=fn: f(horizon, r)) for sym, (fn, _) in TABLE.items() if sym in exported}
diff --git a/dm/tools/horizon_profile_xc2.py b/dm/tools/horizon_profile_xc2.py
new file mode 100644
index 0000000..7079df3
--- /dev/null
+++ b/dm/tools/horizon_profile_xc2.py
@@ -0,0 +1,15 @@
+"""Per-title workarounds for Xenoblade Chronicles 2 (0100E95004038000), declared as such: each one replaces a function of the GAME (main), not of the SDK, and says what is missing in the host that makes it necessary.
+They are applied only when NX2LINUX_PROFILE names the title (horizon_profile.apply). Remove an entry when the host grows the feature it stands for."""
+from horizon_overrides import hle
+
+TITLE = '0100e95004038000'
+PROFILE = {}
+
+
+def workaround(symbol, why):
+    def deco(fn): PROFILE[symbol] = (fn, why); return fn
+    return deco
+
+
+@workaround('_ZN3ssd9SoundCore4InitERKNS0_9InitParamE', 'no nn::audio renderer server on the host yet: the game\'s sound engine is not started (it would assert in ssd::SystemCorePlatform::QuitAudioDevice); sound is off')
+def sound_init(hz, r): r[0] = 1
diff --git a/dm/tools/horizon_run.py b/dm/tools/horizon_run.py
new file mode 100644
index 0000000..b8f9ed2
--- /dev/null
+++ b/dm/tools/horizon_run.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Run a recompiled game on the Linux host (NX2Linux S7bis): load its modules, replace the SDK functions the host provides, start nn::init::Start's sequence and let the game run for a while.
+Usage: horizon_run.py --modules <dir with <name>.manifest.json> --romfs <RomFS.img> --title <id> [--display|--hidden] [--seconds N] [--profile xc2] [--cache DIR]
+Needs REMILL_BUILD (the lifter) for functions not in the cache. The window needs linux/host built (libnx2linux_display.so, see horizon_display.py)."""
+import argparse, os, sys, time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import elf_module as em
+import horizon_hle, horizon_overrides
+
+PROFILES = {'0100e95004038000': 'horizon_profile_xc2'}
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    p.add_argument('--modules', required=True, help='folder holding <name>.manifest.json and <name>.elf')
+    p.add_argument('--order', default='main,sdk,subsdk0', help='module names in load order')
+    p.add_argument('--romfs'); p.add_argument('--title', default='0000000000000000')
+    p.add_argument('--cache', default=str(Path.home() / '.cache/nx2linux/aot-cache'))
+    p.add_argument('--display', action='store_true', help='open a window when the game first presents a frame'); p.add_argument('--hidden', action='store_true', help='with --display: keep the window hidden')
+    p.add_argument('--seconds', type=float, default=60, help='stop after this long (the game runs on its own threads)')
+    p.add_argument('--no-profile', action='store_true', help='do not apply the per-title workarounds'); p.add_argument('--verbose', action='store_true')
+    a = p.parse_args()
+    mods = [f'{a.modules}/{n}.manifest.json' for n in a.order.split(',')]
+    ms = em.ModuleSet(mods, {})
+    hz = horizon_hle.Horizon(ms, verbose=a.verbose, romfs=a.romfs, title_id=a.title)
+    ovr = horizon_overrides.install(hz)
+    prof = PROFILES.get(a.title)
+    if prof and not a.no_profile:
+        mod = __import__(prof); ovr.update(horizon_overrides.install_profile(hz, mod.PROFILE))
+    t = time.time()
+    hz.aot = ms.build(jit=False, overrides=ovr, cache=a.cache)
+    print(f'built in {time.time() - t:.0f} s ({hz.aot.cache_hits} cached, {hz.aot.cache_misses} built, {len(hz.aot.unlifted)} not translated)', flush=True)
+    hz.attach()
+    if a.display:
+        import horizon_display
+        hz.display_factory = lambda: horizon_display.Display(a.title, 1280, 720, hidden=a.hidden)
+    # the boot runs on this thread; the game's own threads do the rest. A timer ends the run.
+    import threading
+    threading.Timer(a.seconds, lambda: (print(f'[run] {a.seconds:.0f} s elapsed: stopping', flush=True), os._exit(0))).start()
+    r = hz.boot()
+    print('result', {k: (hex(v) if isinstance(v, int) else v) for k, v in r.items() if k in ('fault', 'x0', 'step')})
+    print('frames presented:', getattr(hz, 'frames_presented', 0), '| svc calls:', hz.stats, '| not translated functions called:', hz.aot.stat('unlifted_calls'))
+    if hasattr(hz, 'nvn'): print('nvn:', hz.nvn.stats, '| not implemented NVN calls:', sorted(hz.nvn.unimpl)[:40])
+    print('stubbed overrides called:', sorted(hz.stub_calls))
+
+
+if __name__ == '__main__': main()
