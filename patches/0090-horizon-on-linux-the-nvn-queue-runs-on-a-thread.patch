+class AsyncQueue(unittest.TestCase):
+    """The queue on a thread of its own: a fence is signaled when the queue reaches it, not before"""
+    def setUp(self):
+        self.hz = FakeHz(); self.n = hn.Nvn(self.hz); self.n.start_worker()
+        call(self.n, 'nvnQueueInitialize', QUEUE); call(self.n, 'nvnSyncInitialize', 0x16000)
+
+    def test_a_fence_waits_for_the_work_before_it(self):
+        import threading
+        gate = threading.Event(); seen = []
+        orig = self.n.replay
+        self.n.replay = lambda cmds, state: (gate.wait(5), seen.append('ran'))   # the first submit holds the queue
+        call(self.n, 'nvnCommandBufferInitialize', CB); call(self.n, 'nvnCommandBufferBeginRecording', CB)
+        h = call(self.n, 'nvnCommandBufferEndRecording', CB); self.hz.wr(0x13000, struct.pack('<Q', h))
+        call(self.n, 'nvnQueueSubmitCommands', QUEUE, 1, 0x13000)
+        call(self.n, 'nvnQueueFenceSync', QUEUE, 0x16000, 0, 0)
+        self.assertEqual(call(self.n, 'nvnSyncWait', 0x16000, 1_000_000), hn.SYNC_TIMEOUT)   # 1 ms: the queue has not got there
+        gate.set()
+        self.assertIn(call(self.n, 'nvnSyncWait', 0x16000, 5_000_000_000), (hn.SYNC_ALREADY_SIGNALED, hn.SYNC_CONDITION_SATISFIED))
+        self.assertEqual(seen, ['ran'])
+
+    def test_a_sync_never_fenced_times_out_at_once(self):
+        self.assertEqual(call(self.n, 'nvnSyncWait', 0x16000, 5_000_000_000), hn.SYNC_TIMEOUT)
+
+    def test_finish_waits_for_everything_submitted(self):
+        done = []
+        self.n.replay = lambda cmds, state: (__import__('time').sleep(0.05), done.append(1))
+        call(self.n, 'nvnCommandBufferInitialize', CB); call(self.n, 'nvnCommandBufferBeginRecording', CB)
+        h = call(self.n, 'nvnCommandBufferEndRecording', CB); self.hz.wr(0x13000, struct.pack('<Q', h))
+        call(self.n, 'nvnQueueSubmitCommands', QUEUE, 1, 0x13000); call(self.n, 'nvnQueueFinish', QUEUE)
+        self.assertEqual(done, [1])
+
+
