+    # ---- the queue as a GPU: the game's thread hands work over and goes on; one thread replays it in order ----
+    def start_worker(self):
+        self.jobs = queue.SimpleQueue()
+        threading.Thread(target=self.work, name='nvn-queue', daemon=True).start()
+
+    def work(self):
+        while True:
+            job = self.jobs.get()
+            try:
+                if job[0] == 'submit':
+                    state = {}
+                    for cmds in job[1]: self.replay(cmds, state)
+                elif job[0] == 'present': self.present(job[1], job[2])
+            except Exception as e:
+                self.hz.log(f'[nvn] queue job {job[0]} failed: {type(e).__name__}: {e}')
+            finally:
+                if job[-1] is not None: job[-1].set()   # the event the job ends with: a fence, a finished present, a drain
+
+    def enqueue(self, op, *args, event=None):
+        self.jobs.put((op, *args, event))
+
+    def drain(self):
+        """Waits until everything submitted so far has run"""
+        if self.jobs is None: return
+        ev = threading.Event(); self.enqueue('drain', event=ev); ev.wait(60)
+
     def all_calls(self):
