+@unittest.skipUnless(READELF and shutil.which('clang'), 'needs llvm-readelf and clang')
+class CacheStats(unittest.TestCase):
+    def make_cache(self, d, n=12):
+        """A cache folder shaped like aot_lift's (obj/<2 chars>/<key>.o, .syms, .fail, lib/<key>.so) from real objects of generated C, no game data"""
+        root = Path(d) / 'aot-cache'
+        src = Path(d) / 'a.c'
+        for i in range(n):
+            src.write_text(f'int f{i}(int x) {{ int s = 0; for (int i = 0; i < x + {i}; i++) s += i * {i + 2}; return s; }}\n')
+            key = f'{i:02x}' + 'ab' * 15
+            (root / 'obj' / key[:2]).mkdir(parents=True, exist_ok=True)
+            subprocess.run(['clang', '-c', '-O2', '-fPIC', str(src), '-o', str(root / 'obj' / key[:2] / f'{key}.o')], check=True)
+            (root / 'obj' / key[:2] / f'{key}.syms').write_text('__remill_x')
+        (root / 'obj' / '00' / ('zz' * 16 + '.fail')).write_text('no semantics')
+        (root / 'lib').mkdir(); (root / 'lib' / 'k.so').write_bytes(b'\0' * 5000)
+        return root
+
+    def test_the_counts_the_sizes_and_the_sample_are_read_and_nothing_is_written(self):
+        import argparse
+        with tempfile.TemporaryDirectory() as d:
+            root = self.make_cache(d)
+            before = sorted((str(p), p.stat().st_mtime_ns, p.stat().st_size) for p in root.rglob('*'))
+            res = ac.cache_stats(argparse.Namespace(cache=str(root), sample=5, seed=1, no_compress=False))
+            self.assertEqual(sorted((str(p), p.stat().st_mtime_ns, p.stat().st_size) for p in root.rglob('*')), before)   # read-only
+        self.assertEqual((res['files']['.o']['count'], res['files']['.syms']['count'], res['files']['.fail']['count']), (12, 12, 1))
+        self.assertEqual((res['libraries']['count'], res['libraries']['bytes']), (1, 5000)); self.assertEqual(res['sample']['objects'], 5)
+        self.assertIn('code', res['sample']['sections']); self.assertIn('compressed', res['sample'])
+        text = ac.cache_text(res)
+        self.assertIn('12 objects', text); self.assertIn('1 finished libraries', text); self.assertIn('sample of 5 objects', text)
+
+    def test_no_compress_does_not_read_the_objects_bytes_for_compression(self):
+        import argparse
