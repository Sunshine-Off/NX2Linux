+class Measure(unittest.TestCase):
+    def test_a_small_measurement_has_every_variant_and_the_shapes_the_proposal_relies_on(self):
+        import argparse
+        res = ac.measure(argparse.Namespace(functions=40, jobs=2, seed=2))
+        self.assertEqual(set(res['variants']), {'base', 'no-unwind', 'slim', 'slim-Os', 'slim-O1', 'thin-lto', 'group64'})
+        b, s, g = res['variants']['base'], res['variants']['slim'], res['variants']['group64']
+        self.assertGreater(res['functions'], 30); self.assertEqual(b['objects'], res['functions'])
+        self.assertLessEqual(s['total_bytes'], b['total_bytes'])   # the slim flags remove sections, never add one
+        self.assertLess(g['objects'], b['objects']); self.assertLess(g['bytes_per_function'], b['bytes_per_function'])   # one object per group of 64: the headers and symbols are paid once
+        self.assertLess(b['compressed']['gzip6'], b['compressed']['raw']); self.assertIn('link', b)
+        self.assertIn('code', b['sections']); self.assertIn('headers', b['sections'])
+        text = ac.measure_text(res)
+        for name in res['variants']: self.assertIn(name, text)
