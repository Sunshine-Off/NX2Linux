diff --git a/dm/tools/aot_runtime.cpp b/dm/tools/aot_runtime.cpp
index de91bd3..5586a1c 100644
--- a/dm/tools/aot_runtime.cpp
+++ b/dm/tools/aot_runtime.cpp
@@ -13,6 +13,7 @@
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <ctime>
 #include <mutex>
 #include <vector>
 
@@ -20,6 +21,12 @@ struct AotEntry { uint64_t addr; AotFn fn; };
 extern "C" const AotEntry aot_table[];   // generated by aot_lift.py, sorted by address
 extern "C" const unsigned aot_table_n;
 
+// mrs xN, cntpct_el0: the virtual counter, 19.2 MHz as on the Switch (CNTFRQ_EL0), from the host's monotonic clock
+extern "C" uint64_t __nx2_read_cntpct(void) {
+    timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ((uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec) * 192ull / 10000ull;
+}
+
 #define XREGS(X) X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16) X(17) X(18) X(19) X(20) X(21) X(22) X(23) X(24) X(25) X(26) X(27) X(28) X(29) X(30)
 
 namespace {
diff --git a/dm/tools/tests/test_aot_sysregs.py b/dm/tools/tests/test_aot_sysregs.py
new file mode 100644
index 0000000..796c5f4
--- /dev/null
+++ b/dm/tools/tests/test_aot_sysregs.py
@@ -0,0 +1,38 @@
+"""MRS of the EL0 registers a game reads: the counter and its frequency (timing), CTR_EL0 and DCZID_EL0 (cache maintenance loops in memcpy/memset). Found on Xenoblade Chronicles 2's sdk, where
+`mrs x0, cntpct_el0` stopped the boot. Synthetic code, no game data. Needs REMILL_BUILD and clang++; skipped otherwise."""
+import struct, sys, time, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE)); sys.path.insert(0, str(HERE.parent))
+import aot_lift
+from test_aot_t3 import READY
+
+RET = 0xD65F03C0
+STOP = 0xFFFF0000
+FRQ, PCT, CTR, DCZID = 0xD53BE000, 0xD53BE020, 0xD53B0020, 0xD53B00E0   # mrs x0, <reg>
+
+
+def run(word):
+    a = aot_lift.Aot([(0x1000, struct.pack('<2I', word, RET))])
+    try: return a.run(0x1000, {'x30': STOP})
+    finally: a.close()
+
+
+@unittest.skipUnless(READY, 'needs REMILL_BUILD, clang++ and unicorn')
+class SysRegs(unittest.TestCase):
+    def test_the_frequency_and_cache_registers_are_the_switch_constants(self):
+        self.assertEqual(run(FRQ)['x0'], 19200000)
+        self.assertEqual(run(CTR)['x0'], 0x8444C004)
+        self.assertEqual(run(DCZID)['x0'], 4)
+
+    def test_the_counter_follows_the_host_clock_at_the_declared_frequency(self):
+        a, t0 = run(PCT)['x0'], time.monotonic()
+        time.sleep(0.2)
+        b, t1 = run(PCT)['x0'], time.monotonic()
+        ticks = (b - a) / 19200000
+        self.assertGreater(b, a)
+        self.assertAlmostEqual(ticks, t1 - t0, delta=0.1)
+
+
+if __name__ == '__main__': unittest.main()
