+// by element: the second operand is lane `idx` of a vector register, for every lane of the first (scalar forms: Q=0 would be 2 lanes; they use the lane count N)
+#define NX_FELEM(NAME, EXPR) \
+  template <int E, int N> DEF_SEM(NAME, V128W dst, V128 src1, V128 src2, I32 idx) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src1), b = NxRead(src2), r = {}; \
+    T y = NxGetF<E>(b, static_cast<int>(Read(idx))); \
+    NX_FBEGIN \
+    for (int i = 0; i < N; i++) { T x = NxGetF<E>(a, i); T res = EXPR; NxSetF<E>(r, i, res); } \
+    NX_FEND \
+    NxWrite(dst, r); return memory; }
+#define NX_FELEM_ACC(NAME, EXPR) \
+  template <int E, int N> DEF_SEM(NAME, V128W dst, V128 accv, V128 src1, V128 src2, I32 idx) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src1), b = NxRead(src2), c = NxRead(accv), r = {}; \
+    T y = NxGetF<E>(b, static_cast<int>(Read(idx))); \
+    NX_FBEGIN \
+    for (int i = 0; i < N; i++) { T x = NxGetF<E>(a, i), z = NxGetF<E>(c, i); T res = EXPR; NxSetF<E>(r, i, res); } \
+    NX_FEND \
+    NxWrite(dst, r); return memory; }
+NX_FELEM(NX_FMUL_E, ArmNaN(x * y, x, y))
+NX_FELEM_ACC(NX_FMLA_E, ArmNaN(std::fma(x, y, z), x, y, z))
+NX_FELEM_ACC(NX_FMLS_E, ArmNaN(std::fma(-x, y, z), x, y, z))
+
+// two-register FP: negate, absolute value, square root, rounding to integral
+#define NX_FMISC(NAME, EXPR) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 src) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src), r = {}; \
+    NX_FBEGIN \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i); T res = EXPR; NxSetF<E>(r, i, res); } \
+    NX_FEND \
+    NxWrite(dst, r); return memory; }
+NX_FMISC(NX_FNEGV, -x)
+NX_FMISC(NX_FABSV, NxAbsF(x))
+NX_FMISC(NX_FSQRTV, ArmNaN((E == 4 ? static_cast<T>(__builtin_sqrtf(static_cast<float>(x))) : static_cast<T>(__builtin_sqrt(static_cast<double>(x)))), x))
+template <int E, int Q, int MODE, bool INEXACT> DEF_SEM(NX_FRINTV, V128W dst, V128 src) {
+  typedef typename NxF<E>::T T;
+  NxVec a = NxRead(src), r = {};
+  for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i); T res = static_cast<T>(NxRound(static_cast<double>(x), MODE)); if (INEXACT && res != x) state.sr.ixc = 1; NxSetF<E>(r, i, res); }
+  NxWrite(dst, r); return memory;
+}
+// integer <-> float lane conversions (same lane size); fbits fraction bits for the fixed-point forms
+template <int E, int Q, bool S> DEF_SEM(NX_CVTFV, V128W dst, V128 src, I32 fbits) {
+  typedef typename NxF<E>::T T;
+  NxVec a = NxRead(src), r = {};
+  const int fb = static_cast<int>(Read(fbits));
+  NX_FBEGIN
+  for (int i = 0; i < NxN<E, Q>::n; i++) {
+    T v = S ? static_cast<T>(NxGetS<E>(a, i)) : static_cast<T>(NxGet<E>(a, i));
+    if (fb) v = (E == 4) ? static_cast<T>(__builtin_ldexpf(static_cast<float>(v), -fb)) : static_cast<T>(__builtin_ldexp(static_cast<double>(v), -fb));
+    NxSetF<E>(r, i, v);
+  }
+  NX_FEND
+  NxWrite(dst, r); return memory;
+}
+template <int E, int Q, bool S> DEF_SEM(NX_FCVTZV, V128W dst, V128 src, I32 fbits) {
+  typedef typename NxF<E>::T T;
+  NxVec a = NxRead(src), r = {};
+  const uint32_t fb = Read(fbits);
+  for (int i = 0; i < NxN<E, Q>::n; i++) {
+    double x = static_cast<double>(NxGetF<E>(a, i));
+    uint64_t v;
+    if (E == 4) v = S ? static_cast<uint64_t>(NxFloatToInt<int32_t>(state, x, kNxRZ, fb)) : static_cast<uint64_t>(NxFloatToInt<uint32_t>(state, x, kNxRZ, fb));
+    else v = S ? static_cast<uint64_t>(NxFloatToInt<int64_t>(state, x, kNxRZ, fb)) : static_cast<uint64_t>(NxFloatToInt<uint64_t>(state, x, kNxRZ, fb));
+    NxSet<E>(r, i, v);
+  }
+  NxWrite(dst, r); return memory;
+}
+// FCVTN (double -> single, Q keeps the lower half and fills the upper) and FCVTL (single -> double; Q reads the upper half)
+template <int Q> DEF_SEM(NX_FCVTN, V128W dst, V128 accv, V128 src) {
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  if (Q) r.d[0] = c.d[0];
+  NX_FBEGIN
+  for (int i = 0; i < 2; i++) r.f[Q * 2 + i] = static_cast<float>(a.g[i]);
+  NX_FEND
+  NxWrite(dst, r); return memory;
+}
+template <int Q> DEF_SEM(NX_FCVTL, V128W dst, V128 src) {
+  NxVec a = NxRead(src), r = {};
+  for (int i = 0; i < 2; i++) r.g[i] = static_cast<double>(a.f[Q * 2 + i]);
+  NxWrite(dst, r); return memory;
+}
+// FMOV (vector, immediate): the immediate is the float's bits, replicated
+template <int E, int Q> DEF_SEM(NX_FMOVI, V128W dst, I64 imm) {
+  NxVec r = {};
+  for (int i = 0; i < NxN<E, Q>::n; i++) NxSet<E>(r, i, Read(imm));
+  NxWrite(dst, r); return memory;
+}
