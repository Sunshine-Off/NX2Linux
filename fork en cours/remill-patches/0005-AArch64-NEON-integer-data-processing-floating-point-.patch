+// by element, single or double: sz=0 index H:L (Rm is M:Rm), sz=1 index H (L must be 0, Q must be 1); scalar forms have no arrangement
+static bool NxFElem(const InstData &data, Instruction &inst, bool acc, bool scalar) {
+  unsigned idx = data.sz ? data.H : (data.H << 1) | data.L;
+  if (data.sz && (data.L || (!scalar && !data.Q))) return false;
+  unsigned rm = (data.M << 4) | (static_cast<unsigned>(data.Rm) & 0xF);
+  inst.function += scalar ? (data.sz ? "_SD" : "_SS") : (data.sz ? (data.Q ? "_2D" : "_BAD") : (data.Q ? "_4S" : "_2S"));
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, static_cast<aarch64::RegNum>(rm));
+  AddImmOperand(inst, idx, kUnsigned, 32);
+  return true;
+}
+static bool NxFmovImm(const InstData &data, Instruction &inst, bool dbl) {
