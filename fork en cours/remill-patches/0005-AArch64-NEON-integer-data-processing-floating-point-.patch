+// ---- structure loads and stores ----
+// Multiple structures: RPT registers' worth of SELEM-way interleaved elements. Element e of structure member s of repetition r is at address + ((r * lanes + e) * SELEM + s) * E.
+template <int E, int Q, int RPT, int SELEM>
+ALWAYS_INLINE static void NxLoadMulti(Memory *memory, uint64_t addr, NxVec *rv) {
+  constexpr int lanes = (Q ? 16 : 8) / E;
+  for (int r = 0; r < RPT; r++) for (int e = 0; e < lanes; e++) for (int s = 0; s < SELEM; s++) {
+    const uint64_t a = addr + ((r * lanes + e) * SELEM + s) * E;
+    uint64_t v;
+    if constexpr (E == 1) v = __remill_read_memory_8(memory, a); else if constexpr (E == 2) v = __remill_read_memory_16(memory, a); else if constexpr (E == 4) v = __remill_read_memory_32(memory, a); else v = __remill_read_memory_64(memory, a);
+    NxSet<E>(rv[r + s], e, v);
+  }
+}
+template <int E, int Q, int RPT, int SELEM>
+ALWAYS_INLINE static Memory *NxStoreMulti(Memory *memory, uint64_t addr, const NxVec *rv) {
+  constexpr int lanes = (Q ? 16 : 8) / E;
+  for (int r = 0; r < RPT; r++) for (int e = 0; e < lanes; e++) for (int s = 0; s < SELEM; s++) {
+    const uint64_t a = addr + ((r * lanes + e) * SELEM + s) * E;
+    const uint64_t v = NxGet<E>(rv[r + s], e);
+    if constexpr (E == 1) memory = __remill_write_memory_8(memory, a, static_cast<uint8_t>(v)); else if constexpr (E == 2) memory = __remill_write_memory_16(memory, a, static_cast<uint16_t>(v));
+    else if constexpr (E == 4) memory = __remill_write_memory_32(memory, a, static_cast<uint32_t>(v)); else memory = __remill_write_memory_64(memory, a, v);
+  }
+  return memory;
+}
+// One lane of SELEM registers (LDn/STn single structure): the SELEM elements are consecutive in memory
+template <int E, int SELEM>
+ALWAYS_INLINE static void NxLoadLane(Memory *memory, uint64_t addr, NxVec *rv, int lane) {
+  for (int s = 0; s < SELEM; s++) {
+    const uint64_t a = addr + s * E;
+    uint64_t v;
+    if constexpr (E == 1) v = __remill_read_memory_8(memory, a); else if constexpr (E == 2) v = __remill_read_memory_16(memory, a); else if constexpr (E == 4) v = __remill_read_memory_32(memory, a); else v = __remill_read_memory_64(memory, a);
+    NxSet<E>(rv[s], lane, v);
+  }
+}
+template <int E, int SELEM>
+ALWAYS_INLINE static Memory *NxStoreLane(Memory *memory, uint64_t addr, const NxVec *rv, int lane) {
+  for (int s = 0; s < SELEM; s++) {
+    const uint64_t a = addr + s * E;
+    const uint64_t v = NxGet<E>(rv[s], lane);
+    if constexpr (E == 1) memory = __remill_write_memory_8(memory, a, static_cast<uint8_t>(v)); else if constexpr (E == 2) memory = __remill_write_memory_16(memory, a, static_cast<uint16_t>(v));
+    else if constexpr (E == 4) memory = __remill_write_memory_32(memory, a, static_cast<uint32_t>(v)); else memory = __remill_write_memory_64(memory, a, v);
+  }
+  return memory;
+}
+// LDnR: one element of each of SELEM structures is loaded and replicated to every lane of its register
+template <int E, int Q, int SELEM>
+ALWAYS_INLINE static void NxLoadRep(Memory *memory, uint64_t addr, NxVec *rv) {
+  for (int s = 0; s < SELEM; s++) {
+    const uint64_t a = addr + s * E;
+    uint64_t v;
+    if constexpr (E == 1) v = __remill_read_memory_8(memory, a); else if constexpr (E == 2) v = __remill_read_memory_16(memory, a); else if constexpr (E == 4) v = __remill_read_memory_32(memory, a); else v = __remill_read_memory_64(memory, a);
+    for (int e = 0; e < (Q ? 16 : 8) / E; e++) NxSet<E>(rv[s], e, v);
+  }
+}
