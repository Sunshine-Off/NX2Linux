+// Shift of a lane by the signed byte in the low 8 bits of the second operand (USHL/SSHL): left for positive, right for negative; rounding for the R forms
+template <int E> ALWAYS_INLINE static uint64_t NxUShl(uint64_t x, int8_t sh, bool round) {
+  constexpr int bits = E * 8;
+  if (sh >= 0) return sh >= bits ? 0 : (x << sh);
+  int n = -sh;
+  if (n > bits) return 0;
+  NxI128 r = static_cast<NxI128>(x) + (round ? (static_cast<NxI128>(1) << (n - 1)) : 0);
+  return static_cast<uint64_t>(r >> n);
+}
+template <int E> ALWAYS_INLINE static uint64_t NxSShl(int64_t x, int8_t sh, bool round) {
+  constexpr int bits = E * 8;
+  if (sh >= 0) return sh >= bits ? 0 : (static_cast<uint64_t>(x) << sh);
+  int n = -sh;
+  if (n > bits) n = bits;   // all sign bits (or rounding to 0 / -1 below)
+  NxI128 r = static_cast<NxI128>(x) + (round ? (static_cast<NxI128>(1) << (n - 1)) : 0);
+  return static_cast<uint64_t>(r >> n);
+}
