+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  uint64_t imm8 = ConcatABCDEFGHToU8(data);
+  AddImmOperand(inst, dbl ? VFPExpandImmToFloat64(imm8) : VFPExpandImmToFloat32(imm8), kUnsigned, 64);
+  return true;
+}
