+// ---- floating-point vectors: E is 4 (single) or 8 (double); the flags of all lanes accumulate in FPSR, a NaN made by an invalid operation is ARM's default NaN ----
+template <int E> struct NxF { typedef float T; };
+template <> struct NxF<8> { typedef double T; };
+template <int E> ALWAYS_INLINE static typename NxF<E>::T NxGetF(const NxVec &v, int i) { if constexpr (E == 4) return v.f[i]; else return v.g[i]; }
+template <int E> ALWAYS_INLINE static void NxSetF(NxVec &v, int i, typename NxF<E>::T x) { if constexpr (E == 4) v.f[i] = x; else v.g[i] = x; }
+template <typename T> ALWAYS_INLINE static T NxAbsF(T x) { return x < 0 ? -x : (x == 0 ? static_cast<T>(0) : x); }
+#define NX_FBEGIN __remill_fpu_exception_clear(kFPUExceptionAll); BarrierReorder();
+#define NX_FEND BarrierReorder(); SetFPSRStatusFlags(state, __remill_fpu_exception_test(kFPUExceptionAll));
+#define NX_FSAME(NAME, EXPR) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 src1, V128 src2) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src1), b = NxRead(src2), r = {}; \
+    NX_FBEGIN \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i), y = NxGetF<E>(b, i); T res = EXPR; NxSetF<E>(r, i, res); } \
+    NX_FEND \
+    NxWrite(dst, r); return memory; }
+#define NX_FSAME_ACC(NAME, EXPR) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 accv, V128 src1, V128 src2) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src1), b = NxRead(src2), c = NxRead(accv), r = {}; \
+    NX_FBEGIN \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i), y = NxGetF<E>(b, i), z = NxGetF<E>(c, i); T res = EXPR; NxSetF<E>(r, i, res); } \
+    NX_FEND \
+    NxWrite(dst, r); return memory; }
+// comparison masks: all ones or zero, in an integer lane of the same size
+#define NX_FCMP(NAME, EXPR) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 src1, V128 src2) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src1), b = NxRead(src2), r = {}; \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i), y = NxGetF<E>(b, i); NxSet<E>(r, i, (EXPR) ? NX_ALL1 : 0); } \
+    NxWrite(dst, r); return memory; }
+#define NX_FCMPZ(NAME, EXPR) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 src) { \
+    typedef typename NxF<E>::T T; \
+    NxVec a = NxRead(src), r = {}; \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { T x = NxGetF<E>(a, i), y = 0; NxSet<E>(r, i, (EXPR) ? NX_ALL1 : 0); } \
+    NxWrite(dst, r); return memory; }
+NX_FSAME(NX_FADD, ArmNaN(x + y, x, y))
+NX_FSAME(NX_FSUB, ArmNaN(x - y, x, y))
+NX_FSAME(NX_FMUL, ArmNaN(x * y, x, y))
+NX_FSAME(NX_FDIV, ArmNaN(x / y, x, y))
+NX_FSAME(NX_FMAX, NxMax(x, y))
+NX_FSAME(NX_FMIN, NxMin(x, y))
+NX_FSAME(NX_FMAXNM, NxMaxNum(x, y))
+NX_FSAME(NX_FMINNM, NxMinNum(x, y))
+NX_FSAME(NX_FABD, ArmNaN(NxAbsF(x - y), x, y))
+NX_FSAME_ACC(NX_FMLA, ArmNaN(std::fma(x, y, z), x, y, z))
+NX_FSAME_ACC(NX_FMLS, ArmNaN(std::fma(-x, y, z), x, y, z))
+NX_FCMP(NX_FCMEQ, x == y) NX_FCMP(NX_FCMGE, x >= y) NX_FCMP(NX_FCMGT, x > y)
+NX_FCMP(NX_FACGE, NxAbsF(x) >= NxAbsF(y)) NX_FCMP(NX_FACGT, NxAbsF(x) > NxAbsF(y))
+NX_FCMPZ(NX_FCMEQZ, x == y) NX_FCMPZ(NX_FCMGEZ, x >= y) NX_FCMPZ(NX_FCMGTZ, x > y) NX_FCMPZ(NX_FCMLEZ, x <= y) NX_FCMPZ(NX_FCMLTZ, x < y)
