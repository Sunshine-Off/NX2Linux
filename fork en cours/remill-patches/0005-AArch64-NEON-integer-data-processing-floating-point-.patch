+bool TryDecodeLD1_ASISDLSOP_B1_I1B(const InstData &data, Instruction &inst) { return NxLdSt(data, inst, true, 1, 1, 1, 1, 1); }
+bool TryDecodeLD1_ASISDLSOP_BX1_R1B(const InstData &data, Instruction &inst) { return NxLdSt(data, inst, true, 1, 1, 2, 1, 1); }
