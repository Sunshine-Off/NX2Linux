+}
+// narrow (XTN/XTN2): E is the destination element size, the source elements are 2E wide; Q=1 writes the upper half and keeps the lower
+template <int E, int Q> DEF_SEM(NX_XTN, V128W dst, V128 accv, V128 src) {
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  if (Q) r.d[0] = c.d[0];
+  constexpr int n = 8 / E;
+  for (int i = 0; i < n; i++) {
+    uint64_t x = E == 1 ? a.h[i] : E == 2 ? a.s[i] : a.d[i];
+    NxSet<E>(r, Q * n + i, x);
+  }
+  NxWrite(dst, r); return memory;
+}
+// shift right and narrow: SHRN, RSHRN (and the saturating SQSHRN/SQRSHRN/UQSHRN... forms): destination elements E bytes wide
+template <int E, int Q, int KIND> DEF_SEM(NX_SHRN, V128W dst, V128 accv, V128 src, I32 sh) {
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  if (Q) r.d[0] = c.d[0];
+  constexpr int n = 8 / E;
+  const int s = static_cast<int>(Read(sh));
+  for (int i = 0; i < n; i++) {
+    NxI128 x = (KIND == 0 || KIND == 1) ? static_cast<NxI128>(E == 1 ? a.h[i] : E == 2 ? a.s[i] : a.d[i]) : static_cast<NxI128>(E == 1 ? static_cast<int16_t>(a.h[i]) : E == 2 ? static_cast<int32_t>(a.s[i]) : static_cast<int64_t>(a.d[i]));
+    if (KIND == 1 || KIND == 3) x += static_cast<NxI128>(1) << (s - 1);   // rounding forms
+    x >>= s;
+    uint64_t v = (KIND == 0 || KIND == 1) ? static_cast<uint64_t>(x) : NxSatS(state, x, E * 8);
+    NxSet<E>(r, Q * n + i, v);
+  }
+  NxWrite(dst, r); return memory;
+}
+// widening shift left: SSHLL/USHLL(2) and SHLL(2): E is the source element size; Q=1 reads the upper half
+template <int E, int Q, bool S> DEF_SEM(NX_SHLL, V128W dst, V128 src, I32 sh) {
+  NxVec a = NxRead(src), r = {};
+  constexpr int n = 8 / E;
+  const int s = static_cast<int>(Read(sh));
+  for (int i = 0; i < n; i++) {
+    NxI128 x = S ? static_cast<NxI128>(NxGetS<E>(a, Q * n + i)) : static_cast<NxI128>(NxGet<E>(a, Q * n + i));
+    uint64_t v = static_cast<uint64_t>(x << s);
+    if constexpr (E == 1) r.h[i] = static_cast<uint16_t>(v); else if constexpr (E == 2) r.s[i] = static_cast<uint32_t>(v); else r.d[i] = v;
+  }
+  NxWrite(dst, r); return memory;
+}
+
+// ---- shifts by immediate (SHL, USHR, SSHR, and the accumulating USRA/SSRA, SLI/SRI) ----
+template <int E, int Q> DEF_SEM(NX_SHL, V128W dst, V128 src, I32 sh) {
+  NxVec a = NxRead(src), r = {};
+  const int s = static_cast<int>(Read(sh));
+  for (int i = 0; i < NxN<E, Q>::n; i++) NxSet<E>(r, i, NxGet<E>(a, i) << s);
+  NxWrite(dst, r); return memory;
+}
+template <int E, int Q, bool S, bool ACC, bool ROUND> DEF_SEM(NX_SHR, V128W dst, V128 accv, V128 src, I32 sh) {
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  const int s = static_cast<int>(Read(sh));
+  for (int i = 0; i < NxN<E, Q>::n; i++) {
+    NxI128 x = S ? static_cast<NxI128>(NxGetS<E>(a, i)) : static_cast<NxI128>(NxGet<E>(a, i));
+    if (ROUND) x += static_cast<NxI128>(1) << (s - 1);
+    uint64_t v = static_cast<uint64_t>(x >> s);
+    if (ACC) v += NxGet<E>(c, i);
+    NxSet<E>(r, i, v);
+  }
+  NxWrite(dst, r); return memory;
+}
+template <int E, int Q, bool LEFT> DEF_SEM(NX_SLI, V128W dst, V128 accv, V128 src, I32 sh) {   // SLI (LEFT) and SRI: shift and insert, keeping the destination's other bits
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  const int s = static_cast<int>(Read(sh));
+  constexpr int bits = E * 8;
+  for (int i = 0; i < NxN<E, Q>::n; i++) {
+    uint64_t x = NxGet<E>(a, i), d = NxGet<E>(c, i), mask, v;
+    const uint64_t all = NX_ALL1;
+    if (LEFT) { mask = (all << s) & all; v = (x << s) & all; }
+    else { mask = s >= bits ? 0 : (all >> s); v = s >= bits ? 0 : (x >> s); }
+    NxSet<E>(r, i, (d & ~mask) | v);
+  }
+  NxWrite(dst, r); return memory;
+}
+
+// ---- permutes ----
+template <int E, int Q, int KIND> DEF_SEM(NX_PERM, V128W dst, V128 src1, V128 src2) {   // KIND: 0 UZP1, 1 UZP2, 2 ZIP1, 3 ZIP2, 4 TRN1, 5 TRN2
+  NxVec a = NxRead(src1), b = NxRead(src2), r = {};
+  constexpr int n = NxN<E, Q>::n;
+  for (int i = 0; i < n; i++) {
+    uint64_t v;
+    if (KIND == 0 || KIND == 1) { const int k = 2 * i + (KIND == 1); v = k < n ? NxGet<E>(a, k) : NxGet<E>(b, k - n); }
+    else if (KIND == 2 || KIND == 3) { const int h = (KIND == 3) ? n / 2 : 0; v = (i & 1) ? NxGet<E>(b, h + i / 2) : NxGet<E>(a, h + i / 2); }
+    else { const int o = (KIND == 5); v = (i & 1) ? NxGet<E>(b, (i & ~1) + o) : NxGet<E>(a, (i & ~1) + o); }
+    NxSet<E>(r, i, v);
+  }
+  NxWrite(dst, r); return memory;
+}
+
+// ---- element moves ----
+template <int E, int Q> DEF_SEM(NX_DUP_ELEM, V128W dst, V128 src, I32 idx) {
+  NxVec a = NxRead(src), r = {};
+  const uint64_t v = NxGet<E>(a, static_cast<int>(Read(idx)));
+  for (int i = 0; i < NxN<E, Q>::n; i++) NxSet<E>(r, i, v);
+  NxWrite(dst, r); return memory;
+}
+template <int E> DEF_SEM(NX_INS_ELEM, V128W dst, V128 accv, V128 src, I32 didx, I32 sidx) {
+  NxVec a = NxRead(src), r = NxRead(accv);
+  NxSet<E>(r, static_cast<int>(Read(didx)), NxGet<E>(a, static_cast<int>(Read(sidx))));
+  NxWrite(dst, r); return memory;
+}
+// BIC/ORR (vector, immediate): the immediate is already shifted; W is the lane width in bytes (2 or 4); Q picks 64 or 128 bits
+template <int W, int Q, bool OR> DEF_SEM(NX_LOGIC_IMM, V128W dst, V128 accv, I32 imm) {
+  NxVec c = NxRead(accv), r = {};
+  const uint64_t m = Read(imm);
+  for (int i = 0; i < NxN<W, Q>::n; i++) NxSet<W>(r, i, OR ? (NxGet<W>(c, i) | m) : (NxGet<W>(c, i) & ~m));
+  NxWrite(dst, r); return memory;
+}
+// TBL with LEN registers: out-of-range indices give 0
+template <int LEN, int Q> DEF_SEM(NX_TBL1, V128W dst, V128 t0, V128 idx) {
+  NxVec t[1] = {NxRead(t0)}, ix = NxRead(idx), r = {};
+  for (int i = 0; i < (Q ? 16 : 8); i++) { uint8_t k = ix.b[i]; r.b[i] = k < 16 ? t[0].b[k] : 0; }
+  NxWrite(dst, r); return memory;
+}
+template <int Q> DEF_SEM(NX_TBL2, V128W dst, V128 t0, V128 t1, V128 idx) {
+  NxVec t[2] = {NxRead(t0), NxRead(t1)}, ix = NxRead(idx), r = {};
+  for (int i = 0; i < (Q ? 16 : 8); i++) { uint8_t k = ix.b[i]; r.b[i] = k < 32 ? t[k >> 4].b[k & 15] : 0; }
+  NxWrite(dst, r); return memory;
+}
+template <int Q> DEF_SEM(NX_TBL3, V128W dst, V128 t0, V128 t1, V128 t2, V128 idx) {
+  NxVec t[3] = {NxRead(t0), NxRead(t1), NxRead(t2)}, ix = NxRead(idx), r = {};
+  for (int i = 0; i < (Q ? 16 : 8); i++) { uint8_t k = ix.b[i]; r.b[i] = k < 48 ? t[k >> 4].b[k & 15] : 0; }
+  NxWrite(dst, r); return memory;
+}
+template <int Q> DEF_SEM(NX_TBL4, V128W dst, V128 t0, V128 t1, V128 t2, V128 t3, V128 idx) {
+  NxVec t[4] = {NxRead(t0), NxRead(t1), NxRead(t2), NxRead(t3)}, ix = NxRead(idx), r = {};
+  for (int i = 0; i < (Q ? 16 : 8); i++) { uint8_t k = ix.b[i]; r.b[i] = k < 64 ? t[k >> 4].b[k & 15] : 0; }
+  NxWrite(dst, r); return memory;
+}
+
+// ---- widening arithmetic: E is the narrow element size; Q=1 reads the upper halves of the narrow operands ----
+// KIND: 0 SMULL, 1 UMULL, 2 SMLAL, 3 UMLAL, 4 SMLSL, 5 UMLSL, 6 SADDL, 7 UADDL, 8 SSUBL, 9 USUBL, 10 SABDL, 11 UABDL
+template <int E, int Q, int KIND> DEF_SEM(NX_LONG, V128W dst, V128 accv, V128 src1, V128 src2) {
+  NxVec a = NxRead(src1), b = NxRead(src2), c = NxRead(accv), r = {};
+  constexpr int n = 8 / E;
+  constexpr bool S = (KIND == 0 || KIND == 2 || KIND == 4 || KIND == 6 || KIND == 8 || KIND == 10);
+  for (int i = 0; i < n; i++) {
+    NxI128 x = S ? static_cast<NxI128>(NxGetS<E>(a, Q * n + i)) : static_cast<NxI128>(NxGet<E>(a, Q * n + i));
+    NxI128 y = S ? static_cast<NxI128>(NxGetS<E>(b, Q * n + i)) : static_cast<NxI128>(NxGet<E>(b, Q * n + i));
+    uint64_t acc = E == 1 ? c.h[i] : E == 2 ? c.s[i] : c.d[i];
+    NxI128 v;
+    if (KIND <= 1) v = x * y; else if (KIND <= 3) v = x * y + acc; else if (KIND <= 5) v = static_cast<NxI128>(acc) - x * y;
+    else if (KIND <= 7) v = x + y; else if (KIND <= 9) v = x - y; else v = x > y ? x - y : y - x;
+    uint64_t u = static_cast<uint64_t>(v);
+    if constexpr (E == 1) r.h[i] = static_cast<uint16_t>(u); else if constexpr (E == 2) r.s[i] = static_cast<uint32_t>(u); else r.d[i] = u;
+  }
+  NxWrite(dst, r); return memory;
+}
+// widening add/subtract of a wide and a narrow operand (SADDW/UADDW/SSUBW/USUBW(2)): KIND 0 SADDW, 1 UADDW, 2 SSUBW, 3 USUBW
+template <int E, int Q, int KIND> DEF_SEM(NX_WIDE, V128W dst, V128 src1, V128 src2) {
+  NxVec a = NxRead(src1), b = NxRead(src2), r = {};
+  constexpr int n = 8 / E;
+  constexpr bool S = (KIND == 0 || KIND == 2);
+  for (int i = 0; i < n; i++) {
+    NxI128 w = E == 1 ? a.h[i] : E == 2 ? a.s[i] : static_cast<NxI128>(a.d[i]);
+    NxI128 y = S ? static_cast<NxI128>(NxGetS<E>(b, Q * n + i)) : static_cast<NxI128>(NxGet<E>(b, Q * n + i));
+    uint64_t u = static_cast<uint64_t>(KIND >= 2 ? w - y : w + y);
+    if constexpr (E == 1) r.h[i] = static_cast<uint16_t>(u); else if constexpr (E == 2) r.s[i] = static_cast<uint32_t>(u); else r.d[i] = u;
+  }
+  NxWrite(dst, r); return memory;
+}
