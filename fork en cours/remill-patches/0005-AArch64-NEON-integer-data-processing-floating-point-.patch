+// pairwise add long (UADDLP/SADDLP) and accumulate (UADALP/SADALP): E is the source element size; destination elements are 2E wide
+template <int E, int Q, bool S, bool ACC> DEF_SEM(NX_ADDLP, V128W dst, V128 accv, V128 src) {
+  NxVec a = NxRead(src), c = NxRead(accv), r = {};
+  constexpr int n = NxN<E, Q>::n / 2;
+  for (int i = 0; i < n; i++) {
+    NxI128 x = S ? static_cast<NxI128>(NxGetS<E>(a, 2 * i)) + NxGetS<E>(a, 2 * i + 1) : static_cast<NxI128>(NxGet<E>(a, 2 * i)) + NxGet<E>(a, 2 * i + 1);
