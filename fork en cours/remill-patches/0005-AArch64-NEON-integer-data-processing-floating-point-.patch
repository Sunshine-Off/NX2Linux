+
+// ---- NX2Linux: NEON integer data processing. Registers are always read as 128-bit (kRegQ); a 64-bit arrangement is handled by the semantics (lane count) ----
+static void NxQ3(const InstData &data, Instruction &inst, bool acc) {
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+}
+// three registers of one arrangement; sizes: bit i set when element size 8<<i is allowed
+static bool NxSameInt(const InstData &data, Instruction &inst, unsigned sizes, bool acc) {
+  if (!((sizes >> data.size) & 1) || (data.size == 3 && !data.Q)) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  NxQ3(data, inst, acc);
+  return true;
+}
+static bool NxMisc(const InstData &data, Instruction &inst, unsigned sizes, bool acc) {
+  if (!((sizes >> data.size) & 1) || (data.size == 3 && !data.Q)) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+// pairwise long / across lanes: the arrangement is the source's
+static bool NxLongMisc(const InstData &data, Instruction &inst, bool acc, bool across) {
+  if (data.size == 3) return false;
+  if (across && data.size == 2 && !data.Q) return false;   // UADDLV 2S is reserved
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+// narrowing: the arrangement is the destination's (size = destination element); Q is the "2" form that fills the upper half
+static bool NxNarrow(const InstData &data, Instruction &inst, bool shift) {
+  unsigned esize, sh = 0;
+  if (shift) {
+    unsigned immh = data.immh.uimm;
+    if (immh == 0 || (immh & 8)) return false;
+    uint64_t k = 0; MostSignificantSetBit(immh, &k);
+    esize = 8U << k;
+    sh = 2 * esize - ((immh << 3) | data.immb.uimm);
+  } else {
+    if (data.size == 3) return false;
+    esize = 8U << data.size;
+  }
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, esize);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  if (shift) AddImmOperand(inst, sh, kUnsigned, 32);
+  return true;
+}
+// shifts by immediate: left (SHL, SLI) or right (USHR, SSHR, USRA, SSRA, SRI...), same-size arrangement
+static bool NxShiftImm(const InstData &data, Instruction &inst, bool left, bool acc) {
+  unsigned immh = data.immh.uimm;
+  if (immh == 0) return false;
+  uint64_t k = 0; MostSignificantSetBit(immh, &k);
+  unsigned esize = 8U << k;
+  if (k == 3 && !data.Q) return false;
+  unsigned immhb = (immh << 3) | data.immb.uimm;
+  unsigned sh = left ? immhb - esize : 2 * esize - immhb;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, esize);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, sh, kUnsigned, 32);
+  return true;
+}
+// widening shift left (SSHLL/USHLL, the "2" forms when Q): the arrangement is the source's
+static bool NxShiftLong(const InstData &data, Instruction &inst) {
+  unsigned immh = data.immh.uimm;
+  if (immh == 0 || (immh & 8)) return false;
+  uint64_t k = 0; MostSignificantSetBit(immh, &k);
+  unsigned esize = 8U << k;
+  unsigned sh = ((immh << 3) | data.immb.uimm) - esize;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, esize);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, sh, kUnsigned, 32);
+  return true;
+}
+// SHLL, SHLL2: shift left by the element size
+static bool NxShll(const InstData &data, Instruction &inst) {
+  if (data.size == 3) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, 8U << data.size, kUnsigned, 32);
+  return true;
+}
+static bool NxPerm(const InstData &data, Instruction &inst) { return NxSameInt(data, inst, 0xF, false); }
+static bool NxLongDiff(const InstData &data, Instruction &inst, bool acc, bool wide) {   // arrangement of the narrow operands
+  if (data.size == 3) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+static bool NxDupElem(const InstData &data, Instruction &inst) {
+  uint64_t size = 0;
+  if (!LeastSignificantSetBit(data.imm5.uimm, &size) || size > 3 || (size == 3 && !data.Q)) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, data.imm5.uimm >> (size + 1), kUnsigned, 32);
+  return true;
+}
+static bool NxInsElem(const InstData &data, Instruction &inst) {
+  uint64_t size = 0;
+  if (!LeastSignificantSetBit(data.imm5.uimm, &size) || size > 3) return false;
+  inst.function += size == 0 ? "_B" : size == 1 ? "_H" : size == 2 ? "_S" : "_D";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, data.imm5.uimm >> (size + 1), kUnsigned, 32);
+  AddImmOperand(inst, data.imm4.uimm >> size, kUnsigned, 32);
+  return true;
+}
+static bool NxLogicImm(const InstData &data, Instruction &inst, bool is16) {
+  // reuse the MOVI decoder for the arrangement and the shifted immediate, then add the destination as a source before the immediate
+  if (is16 ? !TryDecodeMOVI_ASIMDIMM_L_HL(data, inst) : !TryDecodeMOVI_ASIMDIMM_L_SL(data, inst)) return false;
+  Operand rd_read = inst.operands[0];
+  rd_read.action = Operand::kActionRead;
+  inst.operands.insert(inst.operands.begin() + 1, rd_read);
+  return true;
+}
+static bool NxTbl(const InstData &data, Instruction &inst, unsigned len) {
+  AddQArrangementSpecifier(data, inst, "16B", "8B");
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  for (unsigned i = 0; i < len; i++) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, static_cast<aarch64::RegNum>((static_cast<unsigned>(data.Rn) + i) & 31));
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+
+
+// ---- NX2Linux: structure loads and stores, scalar SIMD forms, by-element integer forms ----
+// Memory operand of a structure load/store: no write-back, an immediate post-index (the bytes transferred) or a register post-index (the new address is the base + Xm, computed by the semantics)
+static void NxMemOp(const InstData &data, Instruction &inst, bool load, int post, unsigned bytes) {
+  const Action act = load ? kActionRead : kActionWrite;
+  if (post == 0) AddBasePlusOffsetMemOp(inst, act, 8, data.Rn, 0);
+  else if (post == 1) AddPostIndexMemOp(inst, act, 8, data.Rn, bytes);
+  else { AddPostIndexMemOp(inst, act, 8, data.Rn, 0); AddRegOperand(inst, kActionRead, kRegX, kUseAsValue, data.Rm); }
+}
+static void NxRegs(const InstData &data, Instruction &inst, bool write, unsigned n) {
+  for (unsigned i = 0; i < n; i++) AddRegOperand(inst, write ? kActionWrite : kActionRead, kRegQ, kUseAsValue, static_cast<aarch64::RegNum>((static_cast<unsigned>(data.Rt) + i) & 31));
+}
+// kind: 0 multiple structures, 1 a lane, 2 replicate
+static bool NxLdSt(const InstData &data, Instruction &inst, bool load, unsigned rpt, unsigned selem, int post, int kind, unsigned lane_e) {
+  const unsigned n = rpt * selem;
+  unsigned bytes;
+  if (kind == 0) {
+    if (data.size == 3 && !data.Q && selem > 1) return false;   // 1D is reserved for LD2..LD4
+    AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+    bytes = n * (data.Q ? 16 : 8);
+    NxRegs(data, inst, load, n);
+    NxMemOp(data, inst, load, post, bytes);
+    return true;
   }
-  uint64_t shift = 128 - ((data.immh.uimm << 3) + data.immb.uimm);
-  AddRegOperand(inst, kActionWrite, kRegV, kUseAsValue, data.Rd);
-  AddRegOperand(inst, kActionRead, kRegV, kUseAsValue, data.Rn);
-  AddImmOperand(inst, shift);
+  if (kind == 2) {   // replicate: the arrangement is the destination's
+    if (data.size == 3 && !data.Q && false) return false;
+    AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+    bytes = selem << data.size;
+    NxRegs(data, inst, true, n);
+    NxMemOp(data, inst, true, post, bytes);
+    return true;
+  }
+  // a lane of E-byte elements; the index is Q:S:size (bytes), Q:S:size<1> (halves), Q:S (words), Q (doublewords)
+  unsigned idx;
+  switch (lane_e) {
+    case 1: idx = (data.Q << 3) | (data.S << 2) | data.size; break;
+    case 2: if (data.size & 1) return false; idx = (data.Q << 2) | (data.S << 1) | (data.size >> 1); break;
+    case 4: if (data.size != 0) return false; idx = (data.Q << 1) | data.S; break;
+    default: if (data.size != 1 || data.S) return false; idx = data.Q; break;
+  }
+  bytes = selem * lane_e;
+  NxRegs(data, inst, load, n);
+  if (load) NxRegs(data, inst, false, n);
+  NxMemOp(data, inst, load, post, bytes);
+  AddImmOperand(inst, idx, kUnsigned, 32);
   return true;
 }
