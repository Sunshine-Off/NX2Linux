+ALWAYS_INLINE static uint64_t NxSatU(State &state, NxI128 v, int bits) {
+  const NxI128 hi = (static_cast<NxI128>(1) << bits) - 1;
+  if (v > hi) { state.fpsr.flat |= (1u << 27); return static_cast<uint64_t>(hi); }
+  if (v < 0) { state.fpsr.flat |= (1u << 27); return 0; }
+  return static_cast<uint64_t>(v);
