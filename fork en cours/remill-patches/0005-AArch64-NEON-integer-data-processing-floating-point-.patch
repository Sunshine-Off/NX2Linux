-// USHR  <Vd>.<T>, <Vn>.<T>, #<shift>
-bool TryDecodeUSHR_ASIMDSHF_R(const InstData &data, Instruction &inst) {
-  return false;  // TODO remove this after adding semantics for vector version
-  if (((data.immh.uimm & 8) != 0) && !data.Q) {
-    return false;  // `if immh<3>:Q == '10' then ReservedValue();`
+// scalar SIMD forms of the same-size operations: the element size becomes a suffix (B, H, S, D)
+static bool NxScalar3(const InstData &data, Instruction &inst, unsigned sizes) {
+  if (!((sizes >> data.size) & 1)) return false;
+  inst.function += data.size == 0 ? "_B" : data.size == 1 ? "_H" : data.size == 2 ? "_S" : "_D";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+static bool NxScalarF3(const InstData &data, Instruction &inst) {
+  inst.function += data.sz ? "_D" : "_S";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+static bool NxScalarFCvt(const InstData &data, Instruction &inst) {
+  inst.function += data.sz ? "_D" : "_S";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, 0, kUnsigned, 32);
+  return true;
+}
+static bool NxDupScalar(const InstData &data, Instruction &inst) {
+  uint64_t size = 0;
+  if (!LeastSignificantSetBit(data.imm5.uimm, &size) || size > 3) return false;
+  inst.function += size == 0 ? "_B" : size == 1 ? "_H" : size == 2 ? "_S" : "_D";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddImmOperand(inst, data.imm5.uimm >> (size + 1), kUnsigned, 32);
+  return true;
+}
+// by element, integer: size 1 index H:L:M and a 4-bit Rm; size 2 index H:L and Rm = M:Rm
+static bool NxElemInt(const InstData &data, Instruction &inst, bool acc, bool scalar) {
+  unsigned idx, rm;
+  if (data.size == 1) { idx = (data.H << 2) | (data.L << 1) | data.M; rm = static_cast<unsigned>(data.Rm) & 0xF; }
+  else if (data.size == 2) { idx = (data.H << 1) | data.L; rm = (data.M << 4) | (static_cast<unsigned>(data.Rm) & 0xF); }
+  else return false;
+  if (scalar) inst.function += data.size == 1 ? "_H" : "_S"; else AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  if (acc) AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, static_cast<aarch64::RegNum>(rm));
+  AddImmOperand(inst, idx, kUnsigned, 32);
+  return true;
+}
+// by element, widening (SMULL ...): the arrangement is the narrow source's, Q the "2" form
+static bool NxElemLong(const InstData &data, Instruction &inst) {
+  if (data.size != 1 && data.size != 2) return false;
+  unsigned idx = data.size == 1 ? (data.H << 2) | (data.L << 1) | data.M : (data.H << 1) | data.L;
+  unsigned rm = data.size == 1 ? (static_cast<unsigned>(data.Rm) & 0xF) : (data.M << 4) | (static_cast<unsigned>(data.Rm) & 0xF);
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, static_cast<aarch64::RegNum>(rm));
+  AddImmOperand(inst, idx, kUnsigned, 32);
+  return true;
+}
+bool TryDecodeLD1_ASISDLSEP_R1_R1(const InstData &data, Instruction &inst) { return NxLdSt(data, inst, true, 1, 1, 2, 0, 0); }
+bool TryDecodeLD1_ASISDLSEP_R2_R2(const InstData &data, Instruction &inst) { return NxLdSt(data, inst, true, 2, 1, 2, 0, 0); }
