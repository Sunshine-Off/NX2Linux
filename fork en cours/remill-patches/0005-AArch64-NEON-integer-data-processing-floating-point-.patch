+// ---- NX2Linux: NEON floating-point vectors ----
+static bool NxFSame(const InstData &data, Instruction &inst, bool acc) {
+  if (data.sz && !data.Q) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, data.sz ? 64 : 32);
+  NxQ3(data, inst, acc);
+  return true;
+}
+static bool NxFMisc(const InstData &data, Instruction &inst) {
