+union NxVec { uint8_t b[16]; uint16_t h[8]; uint32_t s[4]; uint64_t d[2]; float f[4]; double g[2]; };
+// UReadV64/UWriteV64 use the `memory` variable of the semantics function: these are macros (statement expressions), not functions
+#define NxRead(src) ({ NxVec v_; auto x_ = UReadV64(src); v_.d[0] = UExtractV64(x_, 0); v_.d[1] = UExtractV64(x_, 1); v_; })
+#define NxWrite(dst, v) do { uint64v2_t o_ = {}; o_ = UInsertV64(o_, 0, (v).d[0]); o_ = UInsertV64(o_, 1, (v).d[1]); UWriteV64(dst, o_); } while (0)
+template <int E> ALWAYS_INLINE static uint64_t NxGet(const NxVec &v, int i) { if constexpr (E == 1) return v.b[i]; else if constexpr (E == 2) return v.h[i]; else if constexpr (E == 4) return v.s[i]; else return v.d[i]; }
+template <int E> ALWAYS_INLINE static int64_t NxGetS(const NxVec &v, int i) { if constexpr (E == 1) return static_cast<int8_t>(v.b[i]); else if constexpr (E == 2) return static_cast<int16_t>(v.h[i]); else if constexpr (E == 4) return static_cast<int32_t>(v.s[i]); else return static_cast<int64_t>(v.d[i]); }
+template <int E> ALWAYS_INLINE static void NxSet(NxVec &v, int i, uint64_t x) { if constexpr (E == 1) v.b[i] = static_cast<uint8_t>(x); else if constexpr (E == 2) v.h[i] = static_cast<uint16_t>(x); else if constexpr (E == 4) v.s[i] = static_cast<uint32_t>(x); else v.d[i] = x; }
+template <int E, int Q> struct NxN { enum { n = Q == 2 ? 1 : (Q ? 16 : 8) / E }; };   // Q: 0 = 64-bit vector, 1 = 128-bit vector, 2 = a scalar (one lane)
+typedef __int128 NxI128;
+// Saturation to a signed or unsigned range of `bits` bits; raises FPSR.QC (bit 27) when it clamps
+ALWAYS_INLINE static uint64_t NxSatS(State &state, NxI128 v, int bits) {
+  const NxI128 hi = (static_cast<NxI128>(1) << (bits - 1)) - 1, lo = -(static_cast<NxI128>(1) << (bits - 1));
+  if (v > hi) { state.fpsr.flat |= (1u << 27); return static_cast<uint64_t>(hi); }
+  if (v < lo) { state.fpsr.flat |= (1u << 27); return static_cast<uint64_t>(lo); }
+  return static_cast<uint64_t>(v);
