+// ---- by element: lane idx of the second source, replicated ----
+#define NX_SAME_E(NAME, BODY) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 src1, V128 src2, I32 idx) { \
+    NxVec a = NxRead(src1), b = NxRead(src2), r = {}; \
+    const int k = static_cast<int>(Read(idx)); \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { constexpr int bits = E * 8; (void) bits; uint64_t x = NxGet<E>(a, i), y = NxGet<E>(b, k); int64_t sx = NxGetS<E>(a, i), sy = NxGetS<E>(b, k); (void) x; (void) y; (void) sx; (void) sy; uint64_t res; BODY; NxSet<E>(r, i, res); } \
+    NxWrite(dst, r); return memory; }
+#define NX_SAME_ACC_E(NAME, BODY) \
+  template <int E, int Q> DEF_SEM(NAME, V128W dst, V128 accv, V128 src1, V128 src2, I32 idx) { \
+    NxVec a = NxRead(src1), b = NxRead(src2), c = NxRead(accv), r = {}; \
+    const int k = static_cast<int>(Read(idx)); \
+    for (int i = 0; i < NxN<E, Q>::n; i++) { constexpr int bits = E * 8; (void) bits; uint64_t x = NxGet<E>(a, i), y = NxGet<E>(b, k), z = NxGet<E>(c, i); int64_t sx = NxGetS<E>(a, i), sy = NxGetS<E>(b, k); (void) sx; (void) sy; uint64_t res; BODY; NxSet<E>(r, i, res); } \
+    NxWrite(dst, r); return memory; }
+NX_SAME_E(NX_MUL_E, res = x * y)
+NX_SAME_E(NX_SQDMULH_E, res = NxSatS(state, (static_cast<NxI128>(sx) * sy * 2) >> bits, bits))
+NX_SAME_E(NX_SQRDMULH_E, res = NxSatS(state, (static_cast<NxI128>(sx) * sy * 2 + (static_cast<NxI128>(1) << (bits - 1))) >> bits, bits))
+NX_SAME_ACC_E(NX_MLA_E, res = z + x * y)
+NX_SAME_ACC_E(NX_MLS_E, res = z - x * y)
+// KIND as in NX_LONG: 0 SMULL, 1 UMULL, 2 SMLAL, 3 UMLAL, 4 SMLSL, 5 UMLSL
+template <int E, int Q, int KIND> DEF_SEM(NX_LONG_E, V128W dst, V128 accv, V128 src1, V128 src2, I32 idx) {
+  NxVec a = NxRead(src1), b = NxRead(src2), c = NxRead(accv), r = {};
+  constexpr int n = 8 / E;
+  constexpr bool S = (KIND % 2 == 0);
+  const int k = static_cast<int>(Read(idx));
+  const NxI128 y = S ? static_cast<NxI128>(NxGetS<E>(b, k)) : static_cast<NxI128>(NxGet<E>(b, k));
