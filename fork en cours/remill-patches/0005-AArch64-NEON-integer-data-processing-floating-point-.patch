+    uint64_t acc = E == 1 ? c.h[i] : E == 2 ? c.s[i] : c.d[i];
+    NxI128 v = KIND <= 1 ? x * y : KIND <= 3 ? x * y + acc : static_cast<NxI128>(acc) - x * y;
+    uint64_t u = static_cast<uint64_t>(v);
+    if constexpr (E == 1) r.h[i] = static_cast<uint16_t>(u); else if constexpr (E == 2) r.s[i] = static_cast<uint32_t>(u); else r.d[i] = u;
+  }
+  NxWrite(dst, r); return memory;
+}
+NX_SAME(NX_ADDV, res = x + y)
+NX_SAME(NX_CMEQV, res = x == y ? NX_ALL1 : 0)
