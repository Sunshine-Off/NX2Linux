diff --git a/lib/Arch/AArch64/Semantics/SIMD.cpp b/lib/Arch/AArch64/Semantics/SIMD.cpp
index bfae8be..73404f4 100644
--- a/lib/Arch/AArch64/Semantics/SIMD.cpp
+++ b/lib/Arch/AArch64/Semantics/SIMD.cpp
@@ -845,12 +845,11 @@ DEF_SEM(EXT, V128W dst, T src1, T src2, I32 src3) {
   auto lsb = Read(src3);
   auto vn = UReadV8(src1);
   auto vm = UReadV8(src2);
+  // Vd = (Vm:Vn) >> (8 * lsb), Vn the low bytes: byte k is Vn[k + lsb], or Vm[k + lsb - count] past the end (the former
+  // code indexed the result backwards and swapped bytes inside each half)
   uint8v16_t result = {};
-  _Pragma("unroll") for (size_t i = 0, max_i = count; i + lsb < max_i; ++i) {
-    result.elems[count - 1 - i] = UExtractV8(vm, i + lsb);
-  }
-  _Pragma("unroll") for (size_t i = lsb; i < count; ++i) {
-    result.elems[count - 1 - i] = UExtractV8(vn, i - lsb);
+  _Pragma("unroll") for (size_t k = 0; k < count; ++k) {
+    result.elems[k] = (k + lsb < count) ? UExtractV8(vn, k + lsb) : UExtractV8(vm, k + lsb - count);
   }
   UWriteV8(dst, result);
   return memory;
