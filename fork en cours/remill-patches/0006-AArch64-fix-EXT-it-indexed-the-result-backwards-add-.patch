diff --git a/lib/Arch/AArch64/Semantics/BITBYTE.cpp b/lib/Arch/AArch64/Semantics/BITBYTE.cpp
index b0c80ae..15f29d1 100644
--- a/lib/Arch/AArch64/Semantics/BITBYTE.cpp
+++ b/lib/Arch/AArch64/Semantics/BITBYTE.cpp
@@ -189,3 +189,49 @@ DEF_ISEL(REV_64_DP_1SRC) = REV64;
 
 DEF_ISEL(RBIT_32_DP_1SRC) = RBIT32;
 DEF_ISEL(RBIT_64_DP_1SRC) = RBIT64;
+
+namespace {
+
+// CRC32 and CRC32C: the accumulator xor the data, shifted out one bit at a time, least significant first (reflected
+// polynomials 0xEDB88320 and 0x82F63B78). Straight-line code, no loop: remill-lift does not finish on a loop here
+template <uint32_t poly>
+ALWAYS_INLINE static uint32_t CrcStep(uint32_t c) {
+  return (c >> 1) ^ (poly & (0u - (c & 1u)));
+}
+template <uint32_t poly>
+ALWAYS_INLINE static uint32_t CrcByte(uint32_t c, uint64_t b) {
+  c ^= static_cast<uint32_t>(b & 0xFF);
+  c = CrcStep<poly>(c); c = CrcStep<poly>(c); c = CrcStep<poly>(c); c = CrcStep<poly>(c);
+  c = CrcStep<poly>(c); c = CrcStep<poly>(c); c = CrcStep<poly>(c); c = CrcStep<poly>(c);
+  return c;
+}
+// bytes = 1, 2, 4 or 8 of data, low byte first
+template <uint32_t poly, int bytes>
+ALWAYS_INLINE static uint32_t CrcData(uint32_t c, uint64_t d) {
+  c = CrcByte<poly>(c, d);
+  if (bytes > 1) c = CrcByte<poly>(c, d >> 8);
+  if (bytes > 2) { c = CrcByte<poly>(c, d >> 16); c = CrcByte<poly>(c, d >> 24); }
+  if (bytes > 4) {
+    c = CrcByte<poly>(c, d >> 32); c = CrcByte<poly>(c, d >> 40);
+    c = CrcByte<poly>(c, d >> 48); c = CrcByte<poly>(c, d >> 56);
+  }
+  return c;
+}
+
+template <typename S, uint32_t poly, int bytes>
+DEF_SEM(CRC32, R32W dst, R32 acc, S data) {
+  uint32_t crc = CrcData<poly, bytes>(Read(acc), static_cast<uint64_t>(Read(data)));   // WriteZExt is a macro: no comma inside its argument
+  WriteZExt(dst, crc);
+  return memory;
+}
+
+}  // namespace
+
+DEF_ISEL(CRC32B_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 1>;
+DEF_ISEL(CRC32H_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 2>;
+DEF_ISEL(CRC32W_32C_DP_2SRC) = CRC32<R32, 0xEDB88320u, 4>;
+DEF_ISEL(CRC32X_64C_DP_2SRC) = CRC32<R64, 0xEDB88320u, 8>;
+DEF_ISEL(CRC32CB_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 1>;
+DEF_ISEL(CRC32CH_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 2>;
+DEF_ISEL(CRC32CW_32C_DP_2SRC) = CRC32<R32, 0x82F63B78u, 4>;
+DEF_ISEL(CRC32CX_64C_DP_2SRC) = CRC32<R64, 0x82F63B78u, 8>;
