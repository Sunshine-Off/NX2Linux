+// Half precision conversions (FCVT, FCVTN, FCVTL with 4H / 8H): the Switch's Cortex-A57 has them although it has no half-precision arithmetic. Written on the bits from the manual's FPConvert, with FPCR's
+// rounding mode, and the flags the manual sets: IOC for a signalling NaN, OFC and IXC for an overflow, UFC and IXC for a tiny inexact result, IXC for any inexact one. FPCR.FZ16 and AHP are not modelled.
+template <int E> ALWAYS_INLINE static uint64_t NxHalfTo(State &state, uint16_t h) {   // exact: every half is a single and a double
+  constexpr int fb = E == 4 ? 23 : 52, eb = E == 4 ? 8 : 11, bias = E == 4 ? 127 : 1023;
+  const uint64_t emax = (1ull << eb) - 1, sign = static_cast<uint64_t>(h >> 15) << (fb + eb);
+  unsigned exp = (h >> 10) & 31, frac = h & 0x3FF;
+  if (exp == 31) {
+    if (!frac) return sign | (emax << fb);
+    if (!(frac >> 9)) state.sr.ioc = 1;
+    return sign | (emax << fb) | (1ull << (fb - 1)) | (static_cast<uint64_t>(frac) << (fb - 10));
+  }
+  if (exp == 0) {
+    if (!frac) return sign;
+    int e = -14;
+    while (!(frac & 0x400)) { frac <<= 1; e--; }
+    return sign | (static_cast<uint64_t>(e + bias) << fb) | (static_cast<uint64_t>(frac & 0x3FF) << (fb - 10));
+  }
+  return sign | (static_cast<uint64_t>(exp - 15 + bias) << fb) | (static_cast<uint64_t>(frac) << (fb - 10));
+}
+template <int E> ALWAYS_INLINE static uint16_t NxToHalf(State &state, uint64_t bits) {
+  constexpr int fb = E == 4 ? 23 : 52, eb = E == 4 ? 8 : 11, bias = E == 4 ? 127 : 1023;
+  const uint64_t emax = (1ull << eb) - 1, fmask = (1ull << fb) - 1;
+  const uint16_t sign = ((bits >> (fb + eb)) & 1) ? 0x8000 : 0;
+  const uint64_t exp = (bits >> fb) & emax, frac = bits & fmask;
+  if (exp == emax) {
+    if (!frac) return sign | 0x7C00;
+    if (!(frac >> (fb - 1))) state.sr.ioc = 1;   // a signalling NaN; the result is quiet with the top bits of the payload
+    return sign | 0x7E00 | static_cast<uint16_t>((frac >> (fb - 10)) & 0x1FF);
+  }
+  if (exp == 0 && frac == 0) return sign;
+  uint64_t m; int e;   // the significand with its hidden bit, and the unbiased exponent
+  if (exp == 0) { e = 1 - bias; m = frac; while (!((m >> fb) & 1)) { m <<= 1; e--; } }
+  else { e = static_cast<int>(exp) - bias; m = frac | (1ull << fb); }
+  const bool tiny = e < -14;
+  int shift = fb - 10 + (tiny ? -14 - e : 0);
+  if (shift > 100) shift = 100;
+  const unsigned __int128 mm = m, one = 1;
+  unsigned __int128 q = mm >> shift;
+  const unsigned __int128 rem = mm & ((one << shift) - 1), half = one << (shift - 1);
+  const bool inexact = rem != 0, neg = sign != 0;
+  const unsigned mode = (state.fpcr.flat >> 22) & 3;   // 0 to nearest even, 1 towards +inf, 2 towards -inf, 3 towards zero
+  const bool up = mode == 0 ? (rem > half || (rem == half && (q & 1))) : mode == 1 ? (!neg && inexact) : mode == 2 ? (neg && inexact) : false;
+  if (up) q++;
+  if (inexact) state.sr.ixc = 1;
+  if (tiny) {
+    if (inexact) state.sr.ufc = 1;
+    return sign | static_cast<uint16_t>(q);   // q = 1024 is the smallest normal number: its bits are already right
+  }
+  if (q == 2048) { q = 1024; e++; }
+  if (e > 15) {
+    state.sr.ofc = 1; state.sr.ixc = 1;
+    const bool to_inf = mode == 0 || (mode == 1 && !neg) || (mode == 2 && neg);
+    return sign | (to_inf ? 0x7C00 : 0x7BFF);
+  }
+  return sign | static_cast<uint16_t>(((e + 15) << 10) | (static_cast<uint32_t>(q) & 0x3FF));
+}
