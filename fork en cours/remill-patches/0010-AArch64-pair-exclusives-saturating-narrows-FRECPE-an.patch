 bool TryDecodeFCVT_SD_FLOATDP1(const InstData &data, Instruction &inst) {
@@ -5413,16 +5410,14 @@ static bool NxFCvtV(const InstData &data, Instruction &inst, bool shift) {
   return true;
 }
 static bool NxFCvtN(const InstData &data, Instruction &inst) {
-  if (!data.sz) return false;   // half precision is not translated
-  inst.function += data.Q ? "_2" : "_1";
+  inst.function += data.sz ? (data.Q ? "_2" : "_1") : (data.Q ? "_H2" : "_H1");   // sz = 0: single to half (4S to 4H), sz = 1: double to single
   AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
   AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
   AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
   return true;
 }
 static bool NxFCvtL(const InstData &data, Instruction &inst) {
-  if (!data.sz) return false;
-  inst.function += data.Q ? "_2" : "_1";
+  inst.function += data.sz ? (data.Q ? "_2" : "_1") : (data.Q ? "_H2" : "_H1");
   AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
   AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
   return true;
@@ -5507,6 +5502,92 @@ bool TryDecodeFRSQRTE_ASISDMISC_R(const InstData &data, Instruction &inst) {
   AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
   return true;
 }
+
+// ---- NX2Linux: pair exclusives, register-form CCMN, saturating narrows, FRECPE and FRECPX ----
+// LDXP / LDAXP / STXP / STLXP: one memory operand of the pair's width (64 bits for two W registers, 128 for two X), the registers, and the three monitor registers
+static void AddMonitorHiOperand(Instruction &inst) {
+  Operand op;
+  op.action = Operand::kActionWrite;
+  op.size = 64;
+  op.type = Operand::kTypeRegister;
+  op.reg.name = "MONITOR_VALUE_HI";
+  op.reg.size = 64;
+  inst.operands.push_back(op);
+}
+static bool NxLdxp(const InstData &data, Instruction &inst, bool x) {
+  inst.is_atomic_read_modify_write = true;
+  AddRegOperand(inst, kActionWrite, x ? kRegX : kRegW, kUseAsValue, data.Rt);
+  AddRegOperand(inst, kActionWrite, x ? kRegX : kRegW, kUseAsValue, data.Rt2);
+  AddBasePlusOffsetMemOp(inst, kActionRead, x ? 128 : 64, data.Rn, 0);
+  AddMonitorOperand(inst);
+  AddMonitorHiOperand(inst);
+  return true;
+}
+static bool NxStxp(const InstData &data, Instruction &inst, bool x) {
+  inst.is_atomic_read_modify_write = true;
+  AddRegOperand(inst, kActionWrite, kRegW, kUseAsValue, data.Rs);
+  AddRegOperand(inst, kActionRead, x ? kRegX : kRegW, kUseAsValue, data.Rt);
+  AddRegOperand(inst, kActionRead, x ? kRegX : kRegW, kUseAsValue, data.Rt2);
+  AddBasePlusOffsetMemOp(inst, kActionWrite, x ? 128 : 64, data.Rn, 0);
+  AddMonitorOperand(inst);
+  AddMonitorHiOperand(inst);
+  return true;
+}
+bool TryDecodeLDXP_LP32_LDSTEXCL(const InstData &data, Instruction &inst) { return NxLdxp(data, inst, false); }
+bool TryDecodeLDXP_LP64_LDSTEXCL(const InstData &data, Instruction &inst) { return NxLdxp(data, inst, true); }
+bool TryDecodeLDAXP_LP32_LDSTEXCL(const InstData &data, Instruction &inst) { return NxLdxp(data, inst, false); }
+bool TryDecodeLDAXP_LP64_LDSTEXCL(const InstData &data, Instruction &inst) { return NxLdxp(data, inst, true); }
+bool TryDecodeSTXP_SP32_LDSTEXCL(const InstData &data, Instruction &inst) { return NxStxp(data, inst, false); }
+bool TryDecodeSTXP_SP64_LDSTEXCL(const InstData &data, Instruction &inst) { return NxStxp(data, inst, true); }
+bool TryDecodeSTLXP_SP32_LDSTEXCL(const InstData &data, Instruction &inst) { return NxStxp(data, inst, false); }
+bool TryDecodeSTLXP_SP64_LDSTEXCL(const InstData &data, Instruction &inst) { return NxStxp(data, inst, true); }
+
+// CCMN <Wn>, <Wm>, #<nzcv>, <cond> and the X form: the semantics (CCMN) already exist for the immediate form
+bool TryDecodeCCMN_32_CONDCMP_REG(const InstData &data, Instruction &inst) {
+  SetConditionalFunctionName(data, inst);
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rm);
+  AddImmOperand(inst, data.nzcv);
+  return true;
+}
+bool TryDecodeCCMN_64_CONDCMP_REG(const InstData &data, Instruction &inst) {
+  SetConditionalFunctionName(data, inst);
+  AddRegOperand(inst, kActionRead, kRegX, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegX, kUseAsValue, data.Rm);
+  AddImmOperand(inst, data.nzcv);
+  return true;
+}
+
+// SQXTN, UQXTN, SQXTUN: the vector forms take the arrangement of the narrow result (and the register they merge into for the "2" forms), the scalar ones the size of the result (B, H, S)
+bool TryDecodeSQXTN_ASIMDMISC_N(const InstData &data, Instruction &inst) { return NxNarrow(data, inst, false); }
+bool TryDecodeUQXTN_ASIMDMISC_N(const InstData &data, Instruction &inst) { return NxNarrow(data, inst, false); }
+bool TryDecodeSQXTUN_ASIMDMISC_N(const InstData &data, Instruction &inst) { return NxNarrow(data, inst, false); }
+static bool NxNarrowScalar(const InstData &data, Instruction &inst) {
+  if (data.size == 3) return false;
+  inst.function += data.size == 0 ? "_B" : data.size == 1 ? "_H" : "_S";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+bool TryDecodeSQXTN_ASISDMISC_N(const InstData &data, Instruction &inst) { return NxNarrowScalar(data, inst); }
+bool TryDecodeUQXTN_ASISDMISC_N(const InstData &data, Instruction &inst) { return NxNarrowScalar(data, inst); }
+bool TryDecodeSQXTUN_ASISDMISC_N(const InstData &data, Instruction &inst) { return NxNarrowScalar(data, inst); }
+
+// FCVT between half precision and single or double (scalar): whole Q registers, the semantics read and write the lanes they need
+static bool NxFcvtHalf(const InstData &data, Instruction &inst) {
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+bool TryDecodeFCVT_SH_FLOATDP1(const InstData &data, Instruction &inst) { return NxFcvtHalf(data, inst); }
+bool TryDecodeFCVT_DH_FLOATDP1(const InstData &data, Instruction &inst) { return NxFcvtHalf(data, inst); }
+bool TryDecodeFCVT_HS_FLOATDP1(const InstData &data, Instruction &inst) { return NxFcvtHalf(data, inst); }
+bool TryDecodeFCVT_HD_FLOATDP1(const InstData &data, Instruction &inst) { return NxFcvtHalf(data, inst); }
+
+// FRECPE and FRECPX, single and double (vector 2S / 4S / 2D, scalar S / D). The half-precision forms stay undecoded: the Switch's CPU has no FP16 arithmetic
+bool TryDecodeFRECPE_ASIMDMISC_R(const InstData &data, Instruction &inst) { return NxFMisc(data, inst); }
+bool TryDecodeFRECPE_ASISDMISC_R(const InstData &data, Instruction &inst) { return TryDecodeFRSQRTE_ASISDMISC_R(data, inst); }
+bool TryDecodeFRECPX_ASISDMISC_R(const InstData &data, Instruction &inst) { return TryDecodeFRSQRTE_ASISDMISC_R(data, inst); }
 bool TryDecodeFMUL_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFDIV_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFMAX_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
