diff --git a/lib/Arch/AArch64/Semantics/DATAXFER.cpp b/lib/Arch/AArch64/Semantics/DATAXFER.cpp
index 6cdf5da..a76a389 100644
--- a/lib/Arch/AArch64/Semantics/DATAXFER.cpp
+++ b/lib/Arch/AArch64/Semantics/DATAXFER.cpp
@@ -349,6 +349,99 @@ DEF_ISEL(STLXR_SR64_LDSTEXCL) = STXR<R64, M64W, true>;
 
 namespace {
 
+// LDXP / LDAXP: the pair is read as two words (not atomically: a torn read only makes the store-exclusive fail, which retries), and the monitor keeps the address and both words. STXP / STLXP store
+// both words with one compare-and-swap of the pair's width against what the load read: 64 bits for two W registers, 128 for two X registers (the runtime does it with cmpxchg16b)
+template <bool kAcquire>
+DEF_SEM(LDXP64, R64W dst1, R64W dst2, MV128 src, R64W monitor, R64W monitor_value, R64W monitor_value_hi) {
+  auto vec = UReadV64(src);
+  auto lo = UExtractV64(vec, 0), hi = UExtractV64(vec, 1);
+  Write(dst1, lo);
+  Write(dst2, hi);
+  Write(monitor, AddressOf(src));
+  Write(monitor_value, lo);
+  Write(monitor_value_hi, hi);
+  if (kAcquire) {
+    memory = __remill_barrier_load_load(memory);
+    memory = __remill_barrier_load_store(memory);
+  }
+  return memory;
+}
+
+template <bool kAcquire>
+DEF_SEM(LDXP32, R32W dst1, R32W dst2, MV64 src, R64W monitor, R64W monitor_value, R64W monitor_value_hi) {
+  auto vec = UReadV32(src);
+  auto lo = UExtractV32(vec, 0), hi = UExtractV32(vec, 1);
+  WriteZExt(dst1, lo);
+  WriteZExt(dst2, hi);
+  Write(monitor, AddressOf(src));
+  Write(monitor_value, (static_cast<uint64_t>(hi) << 32) | static_cast<uint64_t>(lo));
+  Write(monitor_value_hi, 0_u64);
