--- a/lib/Arch/AArch64/Arch.cpp
+++ b/lib/Arch/AArch64/Arch.cpp
@@ -2836,9 +2836,6 @@ bool TryDecodeFCVT_DS_FLOATDP1(const InstData &data, Instruction &inst) {
 }
 
