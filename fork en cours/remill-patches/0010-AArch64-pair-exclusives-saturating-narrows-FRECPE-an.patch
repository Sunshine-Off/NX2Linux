+// FRECPE: FPRecipEstimate / RecipEstimate of the manual, on the bits (single: E = 4, double: E = 8), with FPCR's rounding mode for the overflow case. FPCR.FZ is not modelled (as for FRSQRTE).
+// FRECPX: the exponent inverted, the fraction cleared (a zero or a denormal gives the largest exponent)
+ALWAYS_INLINE static unsigned NxRecipEstimate(unsigned a) { return (((1u << 19) / (a * 2 + 1)) + 1) / 2; }   // 256 <= a < 512
+template <int E> ALWAYS_INLINE static uint64_t NxFrecpe(uint64_t bits, State &state) {
+  constexpr int fb = E == 4 ? 23 : 52, eb = E == 4 ? 8 : 11;
+  const uint64_t fmask = (1ull << fb) - 1, emax = (1ull << eb) - 1;
+  uint64_t sign = bits >> (fb + eb), exp = (bits >> fb) & emax, frac = bits & fmask;
+  if (exp == emax && frac) {   // NaN: quieted, and an invalid operation if it was signalling
+    if (!(frac >> (fb - 1))) state.sr.ioc = 1;
+    return bits | (1ull << (fb - 1));
+  }
+  if (exp == emax) return sign << (fb + eb);   // infinity -> zero
+  if (exp == 0 && frac == 0) { state.sr.dzc = 1; return (sign << (fb + eb)) | (emax << fb); }   // zero -> infinity
+  if (exp == 0 && (frac >> (fb - 2)) == 0) {   // |x| < 2^-128 (single) or 2^-1024 (double): the result overflows
+    const unsigned mode = (state.fpcr.flat >> 22) & 3;
+    const bool to_inf = mode == 0 || (mode == 1 && !sign) || (mode == 2 && sign);
+    state.sr.ofc = 1; state.sr.ixc = 1;
+    return (sign << (fb + eb)) | (to_inf ? (emax << fb) : (((emax - 1) << fb) | fmask));
+  }
+  uint64_t fraction = E == 4 ? frac << 29 : frac;   // 52 bits
+  int64_t e = static_cast<int64_t>(exp);
+  const uint64_t m52 = (1ull << 52) - 1;
+  if (e == 0) {
+    if (!((fraction >> 51) & 1)) { e = -1; fraction = (fraction << 2) & m52; }
+    else fraction = (fraction << 1) & m52;
+  }
+  const unsigned scaled = 256u | static_cast<unsigned>((fraction >> 44) & 0xFF);
+  int64_t re = (E == 4 ? 253 : 2045) - e;
+  uint64_t out = static_cast<uint64_t>(NxRecipEstimate(scaled) & 0xFF) << 44;
+  if (re == 0) out = (1ull << 51) | (out >> 1);
+  else if (re == -1) { out = (1ull << 50) | (out >> 2); re = 0; }
+  return (sign << (fb + eb)) | ((static_cast<uint64_t>(re) & emax) << fb) | (out >> (52 - fb));
