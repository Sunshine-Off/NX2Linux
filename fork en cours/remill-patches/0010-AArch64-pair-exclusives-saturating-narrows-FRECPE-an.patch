+  NxWrite(dst, r); return memory;
+}
+template <int E> ALWAYS_INLINE static uint64_t NxFrecpx(uint64_t bits, State &state) {
+  constexpr int fb = E == 4 ? 23 : 52, eb = E == 4 ? 8 : 11;
+  const uint64_t fmask = (1ull << fb) - 1, emax = (1ull << eb) - 1;
+  uint64_t sign = bits >> (fb + eb), exp = (bits >> fb) & emax, frac = bits & fmask;
+  if (exp == emax && frac) {
+    if (!(frac >> (fb - 1))) state.sr.ioc = 1;
+    return bits | (1ull << (fb - 1));
+  }
+  return (sign << (fb + eb)) | ((exp == 0 ? emax - 1 : (~exp & emax)) << fb);
+}
+template <int E> DEF_SEM(NX_FRECPX, V128W dst, V128 src) {
+  NxVec a = NxRead(src), r = {};
+  if constexpr (E == 4) r.s[0] = static_cast<uint32_t>(NxFrecpx<4>(a.s[0], state)); else r.d[0] = NxFrecpx<8>(a.d[0], state);
