From 0f553a88d4814a6ba092d36f3070cb2071009739 Mon Sep 17 00:00:00 2001
From: shikosu <teovidal01@gmail.com>
Date: Wed, 4 Nov 2026 00:37:59 +0100
Subject: [PATCH] AArch64: cryptographic extension (AES, SHA-1, SHA-256, PMULL)
 and FRSQRTE

AESE/AESD/AESMC/AESIMC call the runtime (nx2_aes: the S-box is computed from its definition there); SHA1C/P/M/H/SU0/SU1, SHA256H/H2/SU0/SU1, PMULL/PMULL2 (8 bit and 64 bit) and FRSQRTE (scalar and vector, single and double) are the pseudocode of the Arm manual. Compared with Unicorn on random and edge inputs, FPSR included for FRSQRTE. The half-precision FRSQRTE stays undecoded.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 lib/Arch/AArch64/Arch.cpp           |  56 +++++++
 lib/Arch/AArch64/Decode.cpp         |  63 --------
 lib/Arch/AArch64/Semantics/SIMD.cpp | 223 ++++++++++++++++++++++++++++
 3 files changed, 279 insertions(+), 63 deletions(-)

diff --git a/lib/Arch/AArch64/Arch.cpp b/lib/Arch/AArch64/Arch.cpp
index efb1a0b..7ba0b77 100644
--- a/lib/Arch/AArch64/Arch.cpp
+++ b/lib/Arch/AArch64/Arch.cpp
@@ -5451,6 +5451,62 @@ static bool NxFmovImm(const InstData &data, Instruction &inst, bool dbl) {
 bool TryDecodeFADD_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFSUB_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFADDP_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
+
+// Cryptographic extension (AES, SHA-1, SHA-256, PMULL) and FRSQRTE. The operands are whole Q registers: the semantics read the lanes they need.
+static bool NxCrypto3(const InstData &data, Instruction &inst) {   // Vd = f(Vd, Vn, Vm)
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+static bool NxCrypto2(const InstData &data, Instruction &inst) {   // Vd = f(Vd, Vn)
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+static bool NxCrypto1(const InstData &data, Instruction &inst) {   // Vd = f(Vn)
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
+bool TryDecodeAESE_B_CRYPTOAES(const InstData &data, Instruction &inst) { return NxCrypto2(data, inst); }
+bool TryDecodeAESD_B_CRYPTOAES(const InstData &data, Instruction &inst) { return NxCrypto2(data, inst); }
+bool TryDecodeAESMC_B_CRYPTOAES(const InstData &data, Instruction &inst) { return NxCrypto1(data, inst); }
+bool TryDecodeAESIMC_B_CRYPTOAES(const InstData &data, Instruction &inst) { return NxCrypto1(data, inst); }
+bool TryDecodeSHA1C_QSV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA1P_QSV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA1M_QSV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA1H_SS_CRYPTOSHA2(const InstData &data, Instruction &inst) { return NxCrypto1(data, inst); }
+bool TryDecodeSHA1SU0_VVV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA1SU1_VV_CRYPTOSHA2(const InstData &data, Instruction &inst) { return NxCrypto2(data, inst); }
+bool TryDecodeSHA256H_QQV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA256H2_QQV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+bool TryDecodeSHA256SU0_VV_CRYPTOSHA2(const InstData &data, Instruction &inst) { return NxCrypto2(data, inst); }
+bool TryDecodeSHA256SU1_VVV_CRYPTOSHA3(const InstData &data, Instruction &inst) { return NxCrypto3(data, inst); }
+// PMULL{2} <Vd>.<Ta>, <Vn>.<Tb>, <Vm>.<Tb>: size 0 = 8 bit polynomials (8B / 16B), size 3 = 64 bit (1D / 2D); the others are unallocated
+bool TryDecodePMULL_ASIMDDIFF_L(const InstData &data, Instruction &inst) {
+  if (data.size != 0 && data.size != 3) return false;
+  AddArrangementSpecifier(inst, data.Q ? 128 : 64, 8UL << data.size);
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rm);
+  return true;
+}
+// FRSQRTE: the vector form (2S / 4S / 2D) and the scalar one (S / D); the half-precision forms stay undecoded
+bool TryDecodeFRSQRTE_ASIMDMISC_R(const InstData &data, Instruction &inst) { return NxFMisc(data, inst); }
+// the Newton-Raphson steps: FRECPS / FRSQRTS, vector and scalar
+bool TryDecodeFRECPS_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
+bool TryDecodeFRSQRTS_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
+bool TryDecodeFRECPS_ASISDSAME_ONLY(const InstData &data, Instruction &inst) { return NxScalarF3(data, inst); }
+bool TryDecodeFRSQRTS_ASISDSAME_ONLY(const InstData &data, Instruction &inst) { return NxScalarF3(data, inst); }
+bool TryDecodeFRSQRTE_ASISDMISC_R(const InstData &data, Instruction &inst) {
+  inst.function += data.sz ? "_D" : "_S";
+  AddRegOperand(inst, kActionWrite, kRegQ, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, kRegQ, kUseAsValue, data.Rn);
+  return true;
+}
 bool TryDecodeFMUL_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFDIV_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
 bool TryDecodeFMAX_ASIMDSAME_ONLY(const InstData &data, Instruction &inst) { return NxFSame(data, inst, false); }
