+// Float to integer with a rounding mode, saturating as ARM does (NaN -> 0, out of range -> the limit, both raising Invalid), optionally scaled by 2^fbits; Inexact when the rounding changed the value.
+// Where x86's own conversion gives 0x80000000 for everything out of range, ARM gives INT_MAX, INT_MIN, 0 or UINT_MAX.
+template <typename I>
+ALWAYS_INLINE static I NxFloatToInt(State &state, double x, int mode, uint32_t fbits) {
+  constexpr bool kSigned = std::is_signed<I>::value;
+  constexpr int kBits = sizeof(I) * 8;
+  if (std::isnan(x)) { state.sr.ioc = 1; return 0; }
+  double scaled = fbits ? __builtin_ldexp(x, static_cast<int>(fbits)) : x;
+  double r = NxRound(scaled, mode);
+  const double lo = kSigned ? -__builtin_ldexp(1.0, kBits - 1) : 0.0;
+  const double hi = kSigned ? __builtin_ldexp(1.0, kBits - 1) : __builtin_ldexp(1.0, kBits);   // one past the largest
+  const I imin = kSigned ? static_cast<I>(static_cast<uint64_t>(1) << (kBits - 1)) : static_cast<I>(0);
+  const I imax = static_cast<I>(~imin);
+  if (r < lo) { state.sr.ioc = 1; return imin; }
+  if (r >= hi) { state.sr.ioc = 1; return imax; }
+  if (r != scaled) state.sr.ixc = 1;
+  return static_cast<I>(r);
+}
