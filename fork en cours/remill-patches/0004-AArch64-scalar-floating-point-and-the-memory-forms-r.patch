+// Pair stores. S and D keep one memory operand of twice the register size; Q cannot (a 256-bit memory operand does not exist), so a pair of Q registers has two 128-bit ones, the second 16 bytes on:
+// STP Qt1, Qt2: operands are Rt, Rt2, [Rn + off], [Rn + off + 16]; with writeback the first memory operand is followed by the base register and the new address, then the second memory operand
+static bool TryDecodeSTP_Vn_LDSTPAIR_UPDATE(const InstData &data, Instruction &inst, RegClass rclass, bool pre) {
+  if (data.opc == 0x3) {
+    return false;  // `if opc == '11' then UnallocatedEncoding();`.
+  }
+  auto size = ReadRegSize(rclass);
+  uint64_t offset = static_cast<uint64_t>(data.imm7.simm7) << (2U + data.opc);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rt);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rt2);
+  if (rclass != kRegQ) {
+    if (pre) AddPreIndexMemOp(inst, kActionWrite, size * 2, data.Rn, offset);
+    else AddPostIndexMemOp(inst, kActionWrite, size * 2, data.Rn, offset);
+    return true;
+  }
+  if (pre) {
+    AddPreIndexMemOp(inst, kActionWrite, 128, data.Rn, offset);
+    AddBasePlusOffsetMemOp(inst, kActionWrite, 128, data.Rn, offset + 16);
+  } else {
+    AddPostIndexMemOp(inst, kActionWrite, 128, data.Rn, offset);
+    AddBasePlusOffsetMemOp(inst, kActionWrite, 128, data.Rn, 16);
+  }
+  return true;
+}
+bool TryDecodeSTP_S_LDSTPAIR_PRE(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegS, true); }
+bool TryDecodeSTP_D_LDSTPAIR_PRE(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegD, true); }
+bool TryDecodeSTP_Q_LDSTPAIR_PRE(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegQ, true); }
+bool TryDecodeSTP_S_LDSTPAIR_POST(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegS, false); }
+bool TryDecodeSTP_D_LDSTPAIR_POST(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegD, false); }
+bool TryDecodeSTP_Q_LDSTPAIR_POST(const InstData &data, Instruction &inst) { return TryDecodeSTP_Vn_LDSTPAIR_UPDATE(data, inst, kRegQ, false); }
