+// ---- NX2Linux: byte and halfword exclusives and release stores, CLREX, DSB and the prefetches ----
+static bool NxLdxr(const InstData &data, Instruction &inst, unsigned bits) {
+  inst.is_atomic_read_modify_write = true;
+  AddRegOperand(inst, kActionWrite, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, kActionRead, bits, data.Rn, 0);
+  AddMonitorOperand(inst);
+  return true;
+}
+static bool NxStxr(const InstData &data, Instruction &inst, unsigned bits) {
+  inst.is_atomic_read_modify_write = true;
+  AddRegOperand(inst, kActionWrite, kRegW, kUseAsValue, data.Rs);
+  AddRegOperand(inst, kActionRead, kRegW, kUseAsValue, data.Rt);
+  AddBasePlusOffsetMemOp(inst, kActionWrite, bits, data.Rn, 0);
+  AddMonitorOperand(inst);
+  return true;
+}
+bool TryDecodeLDXRB_LR32_LDSTEXCL(const InstData &data, Instruction &inst) { return NxLdxr(data, inst, 8); }
