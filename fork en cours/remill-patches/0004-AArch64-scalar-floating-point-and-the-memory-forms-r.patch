+  FWriteV64(dst, v);
+  return memory;
+}
+// FCCMP: when the condition holds the flags are those of FCMP; else the immediate. FCCMPE signals Invalid for any NaN, FCCMP only for a signalling one
+template <bool (*check_cond)(const State &), bool kSignal>
+DEF_SEM(FCCMP_32, V32 src1, V32 src2, I32 nzcv) {
+  if (check_cond(state)) {
+    FCompare(state, FExtractV32(FReadV32(src1), 0), FExtractV32(FReadV32(src2), 0), kSignal);
+  } else {
+    auto nzcv_val = Read(nzcv);
+    FLAG_V = UCmpNeq(UAnd(nzcv_val, 1_u32), 0_u32);
+    FLAG_C = UCmpNeq(UAnd(nzcv_val, 2_u32), 0_u32);
+    FLAG_Z = UCmpNeq(UAnd(nzcv_val, 4_u32), 0_u32);
+    FLAG_N = UCmpNeq(UAnd(nzcv_val, 8_u32), 0_u32);
+  }
+  return memory;
+}
+template <bool (*check_cond)(const State &), bool kSignal>
+DEF_SEM(FCCMP_64, V64 src1, V64 src2, I32 nzcv) {
+  if (check_cond(state)) {
+    FCompare(state, FExtractV64(FReadV64(src1), 0), FExtractV64(FReadV64(src2), 0), kSignal);
+  } else {
+    auto nzcv_val = Read(nzcv);
+    FLAG_V = UCmpNeq(UAnd(nzcv_val, 1_u32), 0_u32);
+    FLAG_C = UCmpNeq(UAnd(nzcv_val, 2_u32), 0_u32);
+    FLAG_Z = UCmpNeq(UAnd(nzcv_val, 4_u32), 0_u32);
+    FLAG_N = UCmpNeq(UAnd(nzcv_val, 8_u32), 0_u32);
+  }
+  return memory;
+}
