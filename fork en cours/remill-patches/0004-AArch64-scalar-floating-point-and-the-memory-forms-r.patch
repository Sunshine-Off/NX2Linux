+template <bool (*check_cond)(const State &), int kUnused>
+DEF_SEM(FCSEL_32, V128W dst, V32 src1, V32 src2) {
+  float32_t v = check_cond(state) ? FExtractV32(FReadV32(src1), 0) : FExtractV32(FReadV32(src2), 0);
+  FWriteV32(dst, v);
+  return memory;
+}
+template <bool (*check_cond)(const State &), int kUnused>
+DEF_SEM(FCSEL_64, V128W dst, V64 src1, V64 src2) {
