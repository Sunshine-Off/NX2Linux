+// Fused multiply-add family. ARM: FMSUB = a - n*m, FNMADD = -a - n*m, FNMSUB = -a + n*m, each with a single rounding
+#define NX_FMA(NAME, BITS, T, NEG_N, NEG_A) \
+  DEF_SEM(NAME##_##BITS, V128W dst, V##BITS src1, V##BITS src2, V##BITS src3) { \
+    T n = FExtractV##BITS(FReadV##BITS(src1), 0); \
+    T m = FExtractV##BITS(FReadV##BITS(src2), 0); \
+    T a = FExtractV##BITS(FReadV##BITS(src3), 0); \
+    T nn = NEG_N ? -n : n; \
+    T aa = NEG_A ? -a : a; \
+    __remill_fpu_exception_clear(kFPUExceptionAll); \
+    BarrierReorder(); \
+    T res = std::fma(nn, m, aa); \
+    BarrierReorder(); \
+    SetFPSRStatusFlags(state, __remill_fpu_exception_test(kFPUExceptionAll)); \
+    res = ArmNaN(res, n, m, a); \
+    FWriteV##BITS(dst, res); \
+    return memory; \
+  }
+NX_FMA(FMSUB, 32, float32_t, true, false)
+NX_FMA(FMSUB, 64, float64_t, true, false)
+NX_FMA(FNMADD, 32, float32_t, true, true)
+NX_FMA(FNMADD, 64, float64_t, true, true)
+NX_FMA(FNMSUB, 32, float32_t, false, true)
+NX_FMA(FNMSUB, 64, float64_t, false, true)
+
+DEF_SEM(FNMUL_32, V128W dst, V32 src1, V32 src2) {
+  auto prod = CheckedFloatBinOp(state, FMul32, FExtractV32(FReadV32(src1), 0), FExtractV32(FReadV32(src2), 0));
+  FWriteV32(dst, -prod);
+  return memory;
+}
+DEF_SEM(FNMUL_64, V128W dst, V64 src1, V64 src2) {
+  auto prod = CheckedFloatBinOp(state, FMul64, FExtractV64(FReadV64(src1), 0), FExtractV64(FReadV64(src2), 0));
+  FWriteV64(dst, -prod);
+  return memory;
+}
+
+// FMAX/FMIN: a NaN operand gives that NaN (quietened by an addition); equal operands of opposite sign (+0, -0) pick the positive for max and the negative for min.
+// FMAXNM/FMINNM: a quiet NaN against a number gives the number.
+template <typename T> ALWAYS_INLINE static T NxMax(T a, T b) {
+  if (std::isnan(a)) return a + a;
+  if (std::isnan(b)) return b + b;
+  if (a == b) return std::signbit(a) ? b : a;
+  return a > b ? a : b;
+}
+template <typename T> ALWAYS_INLINE static T NxMin(T a, T b) {
+  if (std::isnan(a)) return a + a;
+  if (std::isnan(b)) return b + b;
+  if (a == b) return std::signbit(a) ? a : b;
+  return a < b ? a : b;
+}
+template <typename T> ALWAYS_INLINE static T NxMaxNum(T a, T b) {
+  if (std::isnan(a) && !std::isnan(b)) return b;
+  if (std::isnan(b) && !std::isnan(a)) return a;
+  return NxMax(a, b);
+}
+template <typename T> ALWAYS_INLINE static T NxMinNum(T a, T b) {
+  if (std::isnan(a) && !std::isnan(b)) return b;
+  if (std::isnan(b) && !std::isnan(a)) return a;
+  return NxMin(a, b);
+}
+#define NX_MINMAX(NAME, FN, BITS) \
+  DEF_SEM(NAME##_##BITS, V128W dst, V##BITS src1, V##BITS src2) { \
+    __remill_fpu_exception_clear(kFPUExceptionAll); \
+    BarrierReorder(); \
+    auto res = FN(FExtractV##BITS(FReadV##BITS(src1), 0), FExtractV##BITS(FReadV##BITS(src2), 0)); \
+    BarrierReorder(); \
+    SetFPSRStatusFlags(state, __remill_fpu_exception_test(kFPUExceptionAll)); \
+    FWriteV##BITS(dst, res); \
+    return memory; \
+  }
+NX_MINMAX(FMAX, NxMax, 32) NX_MINMAX(FMAX, NxMax, 64)
+NX_MINMAX(FMIN, NxMin, 32) NX_MINMAX(FMIN, NxMin, 64)
+NX_MINMAX(FMAXNM, NxMaxNum, 32) NX_MINMAX(FMAXNM, NxMaxNum, 64)
+NX_MINMAX(FMINNM, NxMinNum, 32) NX_MINMAX(FMINNM, NxMinNum, 64)
+
+#define NX_SQRT(BITS, T) \
+  DEF_SEM(FSQRT_##BITS, V128W dst, V##BITS src) { \
+    T v = FExtractV##BITS(FReadV##BITS(src), 0); \
+    T res = CheckedFloatUnaryOp(state, [](T x) { return sizeof(T) == 4 ? static_cast<T>(__builtin_sqrtf(static_cast<float>(x))) : static_cast<T>(__builtin_sqrt(static_cast<double>(x))); }, v); \
+    FWriteV##BITS(dst, ArmNaN(res, v)); \
+    return memory; \
+  }
+NX_SQRT(32, float32_t) NX_SQRT(64, float64_t)
+
+// Round to an integral value in floating point. The mode is the instruction's (N nearest even, A nearest away, M down, P up, Z toward zero); X and I use the current mode (nearest even here),
+// and X raises Inexact when the value changed. -0 stays -0 (the C functions keep the sign).
+enum : int { kNxRN, kNxRA, kNxRM, kNxRP, kNxRZ };
+ALWAYS_INLINE static double NxRound(double x, int mode) {
+  switch (mode) {
+    case kNxRN: return __builtin_nearbyint(x);
+    case kNxRA: return __builtin_round(x);
+    case kNxRM: return __builtin_floor(x);
+    case kNxRP: return __builtin_ceil(x);
+    default: return __builtin_trunc(x);
+  }
+}
+template <int MODE, bool kInexact>
+DEF_SEM(FRINT_32, V128W dst, V32 src) {
+  float32_t v = FExtractV32(FReadV32(src), 0);
+  float32_t res = static_cast<float32_t>(NxRound(static_cast<double>(v), MODE));
+  if (kInexact && res != v) state.sr.ixc = 1;
+  FWriteV32(dst, res);
+  return memory;
+}
+template <int MODE, bool kInexact>
+DEF_SEM(FRINT_64, V128W dst, V64 src) {
+  float64_t v = FExtractV64(FReadV64(src), 0);
+  float64_t res = NxRound(v, MODE);
+  if (kInexact && res != v) state.sr.ixc = 1;
+  FWriteV64(dst, res);
+  return memory;
+}
