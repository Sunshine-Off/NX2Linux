+// ---- NX2Linux: scalar floating-point instructions that had no decoder ----
+static bool NxFcvtToInt(const InstData &data, Instruction &inst, RegClass ic, RegClass fc) {
+  if (IsUnallocatedFloatEncoding(data)) {
+    return false;
+  }
+  AddRegOperand(inst, kActionWrite, ic, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, fc, kUseAsValue, data.Rn);
+  return true;
+}
+// Fixed-point conversions: the number of fraction bits is 64 - scale; for a 32-bit register scale<5> must be set
+static bool NxFixed(const InstData &data, Instruction &inst, RegClass dst_class, RegClass src_class, bool int_is_src) {
+  if (IsUnallocatedFloatEncoding(data)) {
+    return false;
+  }
+  RegClass ic = int_is_src ? src_class : dst_class;
+  if (ic == kRegW && !(data.scale & 0x20)) {
+    return false;
+  }
+  AddRegOperand(inst, kActionWrite, dst_class, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, src_class, kUseAsValue, data.Rn);
+  AddImmOperand(inst, 64U - data.scale, kUnsigned, 32);
+  return true;
+}
+static bool NxFdW_Fn(const InstData &data, Instruction &inst, RegClass rclass) {
+  if (IsUnallocatedFloatEncoding(data)) {
+    return false;
+  }
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  return true;
+}
+static bool NxFdW_Fn_Fm_Fa(const InstData &data, Instruction &inst, RegClass rclass) {
+  if (IsUnallocatedFloatEncoding(data)) {
+    return false;
+  }
+  AddRegOperand(inst, kActionWrite, rclass, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rm);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Ra);
+  return true;
+}
+static bool NxFccmp(const InstData &data, Instruction &inst, RegClass rclass) {
+  if (IsUnallocatedFloatEncoding(data)) {
+    return false;
+  }
+  SetConditionalFunctionName(data, inst);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rn);
+  AddRegOperand(inst, kActionRead, rclass, kUseAsValue, data.Rm);
+  AddImmOperand(inst, data.nzcv);
+  return true;
+}
+// The scalar forms of SCVTF/UCVTF that read a SIMD&FP register as an integer: sz picks single or double, and becomes a suffix of the instruction's name since the operands differ in size
+static bool NxCvtfSimd(const InstData &data, Instruction &inst, uint32_t fbits) {
+  RegClass rc = data.sz ? kRegD : kRegS;
+  AddRegOperand(inst, kActionWrite, rc, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rc, kUseAsValue, data.Rn);
+  AddImmOperand(inst, fbits, kUnsigned, 32);
+  inst.function += data.sz ? "_D" : "_S";
+  return true;
+}
+static bool NxCvtfSimdShift(const InstData &data, Instruction &inst) {
+  uint32_t immhb = (static_cast<uint32_t>(data.immh.uimm) << 3) | static_cast<uint32_t>(data.immb.uimm);
+  uint32_t fbits;
+  RegClass rc;
+  if (data.immh.uimm & 8) {
+    rc = kRegD; fbits = 128U - immhb; inst.function += "_D";
+  } else if ((data.immh.uimm & 0xC) == 4) {
+    rc = kRegS; fbits = 64U - immhb; inst.function += "_S";
+  } else {
+    return false;  // half precision, or unallocated
+  }
+  AddRegOperand(inst, kActionWrite, rc, kUseAsValue, data.Rd);
+  AddRegOperand(inst, kActionRead, rc, kUseAsValue, data.Rn);
+  AddImmOperand(inst, fbits, kUnsigned, 32);
+  return true;
+}
