+  Write(monitor, AddressOf(src));
+  Write(monitor_value, ZExtTo<uint64_t>(val));
+  return memory;
+}
+template <typename D, typename S>
+DEF_SEM(LDAXR_Sub, D dst, S src, R64W monitor, R64W monitor_value) {
+  auto val = Read(src);
+  WriteZExt(dst, val);
+  Write(monitor, AddressOf(src));
+  Write(monitor_value, ZExtTo<uint64_t>(val));
+  memory = __remill_barrier_load_load(memory);
+  memory = __remill_barrier_load_store(memory);
+  return memory;
+}
+// The exclusive store of a byte or halfword: T is the width of the location, the register is a 32-bit one
+template <typename T, typename D, bool kRelease>
+DEF_SEM(STXR_Sub, R32W status, R32 src, D dst, R64W monitor, R64W monitor_value) {
+  auto addr = AddressOf(dst);
+  if (kRelease) {
+    memory = __remill_barrier_load_store(memory);
+    memory = __remill_barrier_store_store(memory);
+  }
+  if (Read(monitor) == addr) {
+    T expected = TruncTo<T>(Read(monitor_value));
+    if (UCmpXchg(dst, expected, TruncTo<T>(Read(src)))) {
+      WriteZExt(status, 0_u32);
+    } else {
+      WriteZExt(status, 1_u32);
+    }
+  } else {
+    WriteZExt(status, 1_u32);
+  }
+  Write(monitor, 0_u64);
+  return memory;
+}
