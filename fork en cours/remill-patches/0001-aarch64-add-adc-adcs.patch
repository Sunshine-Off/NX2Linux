From 63b348ef95f0fa048384be8f02686a589f08d484 Mon Sep 17 00:00:00 2001
From: shikosu <teovidal01@gmail.com>
Date: Sun, 1 Nov 2026 14:07:18 +0100
Subject: [PATCH] AArch64: add ADC and ADCS (semantics and decoders)

The semantics follow the Arm ARM's AddWithCarry(src1, src2, PSTATE.C), like SBC/SBCS next to them;
ADCS sets N, Z, C and V through AddWithCarryNZCV. The decoders reuse the three-register decoder
(TryDecodeLSLV_*_DP_2SRC) as SBC does, and the `return false` stubs in Decode.cpp go.
Checked against Unicorn's AArch64 core on 81 pairs of edge values x 16 NZCV states, 32 and 64 bits.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 lib/Arch/AArch64/Arch.cpp             | 20 ++++++++++++++++++++
 lib/Arch/AArch64/Decode.cpp           | 12 ------------
 lib/Arch/AArch64/Semantics/BINARY.cpp | 22 ++++++++++++++++++++++
 3 files changed, 42 insertions(+), 12 deletions(-)

diff --git a/lib/Arch/AArch64/Arch.cpp b/lib/Arch/AArch64/Arch.cpp
index c99a538..d11ff51 100644
--- a/lib/Arch/AArch64/Arch.cpp
+++ b/lib/Arch/AArch64/Arch.cpp
@@ -2670,6 +2670,26 @@ bool TryDecodeSBCS_64_ADDSUB_CARRY(const InstData &data, Instruction &inst) {
   return TryDecodeSBC_64_ADDSUB_CARRY(data, inst);
 }
 
+// ADC  <Wd>, <Wn>, <Wm>
+bool TryDecodeADC_32_ADDSUB_CARRY(const InstData &data, Instruction &inst) {
+  return TryDecodeLSLV_32_DP_2SRC(data, inst);
+}
+
+// ADC  <Xd>, <Xn>, <Xm>
+bool TryDecodeADC_64_ADDSUB_CARRY(const InstData &data, Instruction &inst) {
+  return TryDecodeLSLV_64_DP_2SRC(data, inst);
+}
+
+// ADCS  <Wd>, <Wn>, <Wm>
+bool TryDecodeADCS_32_ADDSUB_CARRY(const InstData &data, Instruction &inst) {
+  return TryDecodeADC_32_ADDSUB_CARRY(data, inst);
+}
+
+// ADCS  <Xd>, <Xn>, <Xm>
+bool TryDecodeADCS_64_ADDSUB_CARRY(const InstData &data, Instruction &inst) {
+  return TryDecodeADC_64_ADDSUB_CARRY(data, inst);
+}
+
 // UCVTF  <Hd>, <Wn>
 bool TryDecodeUCVTF_H32_FLOAT2INT(const InstData &data, Instruction &inst) {
   AddRegOperand(inst, kActionWrite, kRegH, kUseAsValue, data.Rd);
